int main()
{
    int datos[70000];

    int i = 0;
    int suma = 0;
    while (i < 70000)
    {
        datos[i] = i % 251;
        suma = suma + datos[i];
        i = i + 1;
    }

    int write_result = file_write("BLOQUES.TXT", datos, 70000);

    if (write_result != 0)
    {
        print_int(write_result);
        return 1;
    }

    i = 0;
    while (i < 70000)
    {
        datos[i] = 0;
        i = i + 1;
    }

    int count = file_read("BLOQUES.TXT", datos);

    if (count < 0)
    {
        print_int(count);
        return 2;
    }

    i = 0;
    int suma2 = 0;
    while (i < 70000)
    {
        suma2 = suma2 + datos[i];
        i = i + 1;
    }

    print_int(write_result);
    print_int(count);
    print_int(suma);
    print_int(suma2);

    return 0;
}
