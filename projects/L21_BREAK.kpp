int main()
{
    int i = 0;
    int j = 0;
    while (i < 3)
    {
        j = 0;
        while (j < 10)
        {
            if (j == 2)
            {
                break;
            }
            j = j + 1;
        }
        i = i + 1;
        if (i == 2)
        {
            break;
        }
    }
    print_int(i);
    print_int(j);
    return 0;
}
