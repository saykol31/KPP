
#pragma once

#include <cstddef>
#include <cstdint>

namespace kpp {

class X86Emitter;

struct KolibriRuntimeResult
{
    std::size_t titleAddressPatch = 0;
};

class KolibriRuntime
{
public:

    // ========================================================
    // VENTANA INICIAL
    // ========================================================

    KolibriRuntimeResult
    emitWindow(
        X86Emitter& emitter);


    // ========================================================
    // PRINT
    // ========================================================

    std::size_t
    emitPrint(
        X86Emitter& emitter,
        std::uint32_t x,
        std::uint32_t y);


    // ========================================================
    // EXIT
    // ========================================================

    void
    emitExit(
        X86Emitter& emitter);
};

}
