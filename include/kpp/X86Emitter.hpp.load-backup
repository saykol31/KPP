#pragma once

#include <cstddef>
#include <cstdint>
#include <vector>

namespace kpp {

class X86Emitter
{
public:

    // --------------------------------------------------------
    // BYTE / RAW
    // --------------------------------------------------------

    void emitByte(
        std::uint8_t value);


    // --------------------------------------------------------
    // MOV
    // --------------------------------------------------------

    void emitMovEaxImm32(
        std::int32_t value);

    void emitMovMemImm32(
        std::uint32_t address,
        std::int32_t value);

    std::size_t emitMovMemImm32Placeholder(
        std::int32_t value);

    void emitMovRegImm32(
        std::uint8_t opcode,
        std::uint32_t value);

    // --------------------------------------------------------
    // ARITHMETIC
    // --------------------------------------------------------

    void emitAddEaxEbx();
    // --------------------------------------------------------
    // INTERRUPT
    // --------------------------------------------------------

    void emitInt(
        std::uint8_t interrupt);


    // --------------------------------------------------------
    // CONTROL
    // --------------------------------------------------------

    void emitRet();

    void emitJmpRel32(
        std::int32_t displacement);

    void emitJeRel32(
        std::int32_t displacement);

    void emitJneRel32(
        std::int32_t displacement);


    // --------------------------------------------------------
    // CMP
    // --------------------------------------------------------

    void emitCmpEaxImm32(
        std::int32_t value);

    void emitCmpAhImm8(
        std::uint8_t value);


    // --------------------------------------------------------
    // PLACEHOLDERS
    // --------------------------------------------------------

    std::size_t emitImm32Placeholder();

    std::size_t emitRel32Placeholder();

    void patch32(
        std::size_t offset,
        std::uint32_t value);

    void patchRel32(
        std::size_t offset,
        std::size_t target);


    // --------------------------------------------------------
    // ACCESS
    // --------------------------------------------------------

    const std::vector<std::uint8_t>&
    code() const;

    std::size_t
    size() const;


private:

    std::vector<std::uint8_t>
        machineCode;
};

}
