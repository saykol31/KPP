#pragma once

#include "IR.hpp"
#include "X86Emitter.hpp"

#include <cstdint>
#include <string>
#include <unordered_map>
#include <vector>

namespace kpp {

class X86Backend
{
public:
    std::vector<std::uint8_t> generate(
        const IRProgram& program);

private:

    struct TemporaryLocation
    {
        enum class Kind
        {
            Register
        };

        Kind kind;
        std::uint8_t registerCode;
    };

    struct VariableLocation
    {
        std::size_t dataOffset;
    };

    struct VariableLoadPatch
    {
        std::string name;
        std::size_t patchOffset;
    };

    struct VariableStorePatch
    {
        std::string name;
        std::size_t patchOffset;
    };

    std::unordered_map<
        std::string,
        TemporaryLocation
    > temporaries;

    std::unordered_map<
        std::string,
        VariableLocation
    > variables;

    X86Emitter emitter;

    void generateFunction(
        const IRFunction& function);

    void resetTemporaries();

    void resetVariables();

    std::size_t allocateVariableData(
        std::vector<std::uint8_t>& data);

    void declareVariable(
        const std::string& name,
        std::size_t dataOffset);

    void bindTemporaryToEax(
        const std::string& temporary);

    void bindTemporaryToEbx(
        const std::string& temporary);

    bool hasTemporary(
        const std::string& temporary) const;

    std::uint8_t getTemporaryRegister(
        const std::string& temporary) const;
};

}
