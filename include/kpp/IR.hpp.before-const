#pragma once

#include <string>
#include <vector>

namespace kpp {

// ============================================================
// K++ IR OPCODES
// ============================================================


    enum class IROpcode
    {
        // ========================================================
        // ESTRUCTURA DEL PROGRAMA
        // ========================================================

        FunctionBegin,
        FunctionEnd,

        // ========================================================
        // VARIABLES Y MEMORIA
        // ========================================================

        Declare,
        Store,
        Load,

        // ========================================================
        // ARITMÉTICA BÁSICA
        // ========================================================

        Add,                    // +
        Sub,                    // -
        Mul,                    // *
        Div,                    // /
        Mod,                    // %

        // ========================================================
        // POTENCIAS Y RAÍCES
        // ========================================================

        Pow,                    // a ^ b
        Sqrt,                   // sqrt(a)

        // ========================================================
        // LOGARITMOS Y EXPONENCIALES
        // ========================================================

        Log,                    // logaritmo natural
        Log10,                  // logaritmo base 10
        Exp,                    // e^x

        // ========================================================
        // TRIGONOMETRÍA
        // ========================================================

        Sin,                    // seno
        Cos,                    // coseno
        Tan,                    // tangente
        Cot,                    // cotangente
        Sec,                    // secante
        Csc,                    // cosecante

        // ========================================================
        // TRIGONOMETRÍA INVERSA
        // ========================================================

        Asin,                   // arco seno
        Acos,                   // arco coseno
        Atan,                   // arco tangente

        // ========================================================
        // FUNCIONES MATEMÁTICAS
        // ========================================================

        Abs,                    // valor absoluto
        Floor,                  // piso
        Ceil,                   // techo
        Round,                  // redondeo
        Min,                    // mínimo
        Max,                    // máximo

        // ========================================================
        // MATEMÁTICA AVANZADA
        // ========================================================

        Factorial,              // n!
        Sum,                    // sumatoria
        Integral,               // integral

        // ========================================================
        // FUNCIONES
        // ========================================================

        Call,
        Return,

        // ========================================================
        // SALIDA
        // ========================================================

        Print,
        PrintInteger,
        PrintFloat,

        // ========================================================
        // COMPARACIONES
        // ========================================================

        CompareEqual,           // ==
        CompareNotEqual,        // !=
        CompareLess,            // <
        CompareLessEqual,       // <=
        CompareGreater,         // >
        CompareGreaterEqual,    // >=

        // ========================================================
        // LÓGICA
        // ========================================================

        LogicalAnd,              // &&
        LogicalOr,               // ||
        LogicalNot,              // !

        // ========================================================
        // CONTROL DE FLUJO
        // ========================================================

        Label,
        Jump,
        JumpIfZero,
        JumpIfNotZero
    };

// ============================================================
// IR INSTRUCTION
// ============================================================

struct IRInstruction
{
    IROpcode opcode;

    // Nombre de variable, función, etc.
    std::string name;

    // Operando textual.
    //
    // Ejemplos:
    //
    //   STORE x, 42
    //   STORE y, %0
    //   RETURN %0
    //
    std::string operand;

    // Resultado producido por la instrucción.
    //
    // Ejemplo:
    //
    //   LOAD x -> %0
    //
    std::string result;

    // Valor inmediato entero.
    //
    // Ejemplo:
    //
    //   STORE x, 42
    //
    int value = 0;
};

// ============================================================
// IR FUNCTION
// ============================================================

struct IRFunction
{
    std::string name;

    std::vector<IRInstruction> instructions;
};

// ============================================================
// IR PROGRAM
// ============================================================

struct IRProgram
{
    std::vector<IRFunction> functions;
};

// ============================================================
// OPCODE NAME
// ============================================================

const char* irOpcodeName(IROpcode opcode);

}
