
#include "kpp/Lexer.hpp"
#include "kpp/Parser.hpp"
#include "kpp/SemanticAnalyzer.hpp"
#include "kpp/IRGenerator.hpp"
#include "kpp/X86Backend.hpp"
#include "kpp/BinaryWriter.hpp"
#include "kpp/KolibriExecutableWriter.hpp"
#include <cstdio>
#include <fstream>
#include <iostream>
#include <sstream>
#include <filesystem>

int main(int argc, char** argv)
{
    if (argc != 2)
    {
        std::cerr
            << "K++ Compiler 0.4\n"
            << "Uso: kpp archivo.cpp\n";

        return 1;
    }

    std::ifstream file(argv[1]);

    if (!file)
    {
        std::cerr
            << "K++: no se pudo abrir: "
            << argv[1]
            << '\n';

        return 1;
    }

    std::stringstream buffer;

    buffer << file.rdbuf();

    // ========================================================
    // LEXER
    // ========================================================

    kpp::Lexer lexer(buffer.str());

    auto tokens = lexer.tokenize();

    // ========================================================
    // PARSER
    // ========================================================

    try
    {
        kpp::Parser parser(tokens);

        auto program = parser.parse();


        // ====================================================
        // AST
        // ====================================================

        std::cout
            << "K++ COMPILER 0.4\n"
            << "================\n\n";

        std::cout
            << "AST\n"
            << "---\n";

        for (const auto& function :
            program->functions)
        {
            std::cout
                << "Program\n"
                << "└── Function: "
                << function->name
                << '\n';

            std::cout
                << "    ├── Return type: "
                << function->returnType
                << '\n';

            std::cout
                << "    └── Body\n";

            for (const auto& statement :
                function->body->statements)
            {
                // ==================================================
                // VARIABLE DECLARATION
                // ==================================================

                if (auto* variable =
                    dynamic_cast<
                        kpp::VariableDeclaration*>(
                        statement.get()))
                {
                    std::cout
                        << "        ├── Variable: "
                        << variable->name
                        << '\n';

                    if (auto* integer =
                        dynamic_cast<
                            kpp::IntegerLiteral*>(
                            variable->initializer.get()))
                    {
                        std::cout
                            << "        │   └── Integer: "
                            << integer->value
                            << '\n';
                    }
                    else if (auto* expression =
                        dynamic_cast<
                            kpp::VariableExpression*>(
                            variable->initializer.get()))
                    {
                        std::cout
                            << "        │   └── Variable: "
                            << expression->name
                            << '\n';
                    }

                    continue;
                }

                // ==================================================
                // PRINT
                // ==================================================

                if (auto* print =
                    dynamic_cast<
                        kpp::PrintStatement*>(
                        statement.get()))
                {
                    std::cout
                        << "        ├── Print: "
                        << print->text
                        << '\n';

                    continue;
                }

                // ==================================================
                // RETURN
                // ==================================================

                if (auto* ret =
                    dynamic_cast<
                        kpp::ReturnStatement*>(
                        statement.get()))
                {
                    std::cout
                        << "        └── Return\n";

                    if (auto* integer =
                        dynamic_cast<
                            kpp::IntegerLiteral*>(
                            ret->expression.get()))
                    {
                        std::cout
                            << "            └── Integer: "
                            << integer->value
                            << '\n';
                    }
                    else if (auto* variable =
                        dynamic_cast<
                            kpp::VariableExpression*>(
                            ret->expression.get()))
                    {
                        std::cout
                            << "            └── Variable: "
                            << variable->name
                            << '\n';
                    }
                }
            }
        }

        // ====================================================
        // SEMANTIC ANALYZER
        // ====================================================

        std::cout
            << "\nSEMANTIC ANALYZER\n"
            << "=================\n";

        kpp::SemanticAnalyzer analyzer;

        if (!analyzer.analyze(*program))
        {
            std::cout
                << "\n✘ Errores semánticos:\n\n";

            for (const auto& error :
                 analyzer.errors())
            {
                std::cout
                    << "  error: "
                    << error.message
                    << '\n';
            }

            return 1;
        }

        std::cout
            << "✔ Programa semánticamente válido\n";

        std::cout
            << "✔ main() encontrada\n";

        std::cout
            << "✔ Tipos válidos\n";

        std::cout
            << "✔ Expresiones válidas\n";

        std::cout
            << "✔ Sentencias válidas\n";

        std::cout
            << "\n✔ K++ frontend OK\n";

        // ========================================================
        // K++ IR
        // ========================================================

        std::cout
            << "\nK++ IR\n"
            << "======\n";

        kpp::IRGenerator irGenerator;

        auto ir =
            irGenerator.generate(*program);

        for (const auto& function :
             ir.functions)
        {
            for (const auto& instruction :
                 function.instructions)
            {
                switch (instruction.opcode)
                {
                    case kpp::IROpcode::FunctionBegin:

                        std::cout
                            << "FUNCTION "
                            << instruction.name
                            << '\n';

                        break;

                    // ========================================================
                    // DECLARE
                    // ========================================================

                    case kpp::IROpcode::Declare:

                        std::cout
                            << "DECLARE "
                            << instruction.name
                            << '\n';

                        break;

                    // ========================================================
                    // STORE
                    // ========================================================

                    case kpp::IROpcode::Store:

                        std::cout
                            << "STORE "
                            << instruction.name;

                        if (!instruction.operand.empty())
                        {
                            std::cout
                                << " <- "
                                << instruction.operand;
                        }
                        else
                        {
                            std::cout
                                << ", "
                                << instruction.value;
                        }

                        std::cout << '\n';

                        break;

                    // ========================================================
                    // LOAD
                    // ========================================================

                    case kpp::IROpcode::Load:

                        std::cout
                            << "LOAD "
                            << instruction.name;

                        if (!instruction.result.empty())
                        {
                            std::cout
                                << " -> "
                                << instruction.result;
                        }

                        std::cout << '\n';

                        break;

                    // ========================================================
                    // ADD
                    // ========================================================

                    case kpp::IROpcode::Add:

                        std::cout
                            << "ADD "
                            << instruction.operand
                            << " -> "
                            << instruction.result
                            << '\n';

                        break;
                    // ========================================================
                    // PRINT
                    // ========================================================

                    case kpp::IROpcode::Print:

                        std::cout
                            << "PRINT "
                            << instruction.name
                            << '\n';

                        break;

                    // ========================================================
                    // PRINT INTEGER
                    // ========================================================

                    case kpp::IROpcode::PrintInteger:

                        std::cout
                            << "PRINT_INT "
                            << instruction.operand
                            << '\n';

                        break;

                    // ========================================================
                    // RETURN
                    // ========================================================

                    case kpp::IROpcode::Return:

                        std::cout
                            << "RETURN ";

                        if (!instruction.operand.empty())
                        {
                            std::cout
                                << instruction.operand;
                        }
                        else
                        {
                            std::cout
                                << instruction.value;
                        }

                        std::cout << '\n';

                        break;

                    // ========================================================
                    // FUNCTION END
                    // ========================================================

                    case kpp::IROpcode::FunctionEnd:

                        std::cout
                            << "END\n";

                        break;
                }
            }
        }

        std::cout
            << "\n✔ K++ IR generada correctamente\n";

        // ========================================================
        // X86 BACKEND
        // ========================================================

        std::cout
            << "\nK++ x86 BACKEND\n"
            << "===============\n";

        kpp::X86Backend x86Backend;

        auto machineCode =
            x86Backend.generate(ir);

        std::cout
            << "Machine code:\n\n";

        for (std::size_t i = 0;
            i < machineCode.size();
            ++i)
        {
            std::printf(
                "%02X ",
                machineCode[i]);

            if ((i + 1) % 16 == 0)
                std::printf("\n");
        }

        if (machineCode.size() % 16 != 0)
            std::printf("\n");

        std::cout
            << "\nBytes generados: "
            << machineCode.size()
            << '\n';

        std::cout
            << "\n✔ K++ x86 backend OK\n";


        // ========================================================
        // BINARY WRITER
        // ========================================================

        std::cout
            << "\nK++ BINARY WRITER\n"
            << "=================\n";

        // ========================================================
        // OUTPUT POR ARCHIVO FUENTE
        // ========================================================

        const std::filesystem::path sourcePath(argv[1]);

        const std::string programName =
            sourcePath.stem().string();

        const std::filesystem::path outputDir =
            "Output";

        std::filesystem::create_directories(outputDir);

        const std::string outputFile =
            (outputDir / (programName + ".raw")).string();

        const std::string kolibriOutput =
            (outputDir / (programName + ".bin")).string();

        std::cout
            << "K++ OUTPUT\n"
            << "==========\n"
            << "Fuente: " << sourcePath.string() << '\n'
            << "Programa: " << programName << '\n'
            << "RAW: " << outputFile << '\n'
            << "BIN: " << kolibriOutput << '\n';

        kpp::BinaryWriter binaryWriter;

        if (!binaryWriter.write(
                outputFile,
                machineCode))
        {
            std::cerr
                << "✘ K++: no se pudo escribir: "
                << outputFile
                << '\n';

            return 1;
        }

        std::cout
            << "Archivo generado: "
            << outputFile
            << '\n';

        std::cout
            << "Tamaño: "
            << machineCode.size()
            << " bytes\n";

        std::cout
            << "\n✔ K++ Binary Writer OK\n";

        // ========================================================
        // KOLIBRIOS EXECUTABLE WRITER
        // ========================================================

        std::cout
            << "\nK++ KOLIBRIOS EXECUTABLE WRITER\n"
            << "================================\n";

        kpp::KolibriExecutableWriter
            kolibriWriter;

        if (!kolibriWriter.write(
                kolibriOutput,
                machineCode))
        {
            std::cerr
                << "✘ K++: no se pudo generar: "
                << kolibriOutput
                << '\n';

            return 1;
        }

        std::cout
            << "Ejecutable generado: "
            << kolibriOutput
            << '\n';

        std::cout
            << "Código x86: "
            << machineCode.size()
            << " bytes\n";

        std::cout
            << "✔ K++ KolibriOS executable OK\n";


    }
    catch (const std::exception& e)
    {
        std::cerr
            << "\n✘ Error: "
            << e.what()
            << '\n';

        return 1;
    }

    return 0;
}
