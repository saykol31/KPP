#include "kpp/Lexer.hpp"

#include <cctype>

namespace kpp {

// ============================================================
// TOKEN TYPE NAME
// ============================================================

const char* tokenTypeName(TokenType type)
{
    switch (type)
    {
        case TokenType::EndOfFile:
            return "EOF";

        case TokenType::Identifier:
            return "Identifier";

        case TokenType::Number:
            return "Number";

        case TokenType::String:
            return "String";

        case TokenType::KwInt:
            return "int";

        case TokenType::KwReturn:
            return "return";

        case TokenType::KwPrint:
            return "print";

        case TokenType::Assign:
            return "=";

        case TokenType::Plus:
            return "Plus";

        case TokenType::LParen:
            return "(";

        case TokenType::RParen:
            return ")";

        case TokenType::LBrace:
            return "{";

        case TokenType::RBrace:
            return "}";

        case TokenType::Semicolon:
            return ";";
    }

    return "Unknown";
}

// ============================================================
// CONSTRUCTOR
// ============================================================

Lexer::Lexer(
    const std::string& source)
    : source(source)
{
}

// ============================================================
// PEEK
// ============================================================

char Lexer::peek() const
{
    if (position >= source.size())
        return '\0';

    return source[position];
}

// ============================================================
// ADVANCE
// ============================================================

char Lexer::advance()
{
    if (position >= source.size())
        return '\0';

    char c = source[position++];

    if (c == '\n')
    {
        ++line;
        column = 1;
    }
    else
    {
        ++column;
    }

    return c;
}

// ============================================================
// SKIP WHITESPACE
// ============================================================

void Lexer::skipWhitespace()
{
    while (std::isspace(
        static_cast<unsigned char>(peek())))
    {
        advance();
    }
}

// ============================================================
// IDENTIFIER / KEYWORD
// ============================================================

Token Lexer::identifier()
{
    const int startLine = line;
    const int startColumn = column;

    std::string text;

    while (
        std::isalnum(
            static_cast<unsigned char>(peek()))
        || peek() == '_')
    {
        text += advance();
    }

    // --------------------------------------------------------
    // KEYWORD: int
    // --------------------------------------------------------

    if (text == "int")
    {
        return {
            TokenType::KwInt,
            text,
            startLine,
            startColumn
        };
    }

    // --------------------------------------------------------
    // KEYWORD: return
    // --------------------------------------------------------

    if (text == "return")
    {
        return {
            TokenType::KwReturn,
            text,
            startLine,
            startColumn
        };
    }

    // --------------------------------------------------------
    // KEYWORD: print
    // --------------------------------------------------------

    if (text == "print")
    {
        return {
            TokenType::KwPrint,
            text,
            startLine,
            startColumn
        };
    }

    // --------------------------------------------------------
    // IDENTIFIER
    // --------------------------------------------------------

    return {
        TokenType::Identifier,
        text,
        startLine,
        startColumn
    };
}

// ============================================================
// NUMBER
// ============================================================

Token Lexer::number()
{
    const int startLine = line;
    const int startColumn = column;

    std::string text;

    while (std::isdigit(
        static_cast<unsigned char>(peek())))
    {
        text += advance();
    }

    return {
        TokenType::Number,
        text,
        startLine,
        startColumn
    };
}

// ============================================================
// STRING
// ============================================================

Token Lexer::stringLiteral()
{
    const int startLine = line;
    const int startColumn = column;

    std::string text;

    // --------------------------------------------------------
    // consumir "
    // --------------------------------------------------------

    advance();

    while (
        peek() != '"'
        && peek() != '\0')
    {
        text += advance();
    }

    // --------------------------------------------------------
    // consumir "
    // --------------------------------------------------------

    if (peek() == '"')
        advance();

    return {
        TokenType::String,
        text,
        startLine,
        startColumn
    };
}

// ============================================================
// TOKENIZE
// ============================================================

std::vector<Token>
Lexer::tokenize()
{
    std::vector<Token> tokens;

    while (true)
    {
        skipWhitespace();

        const int tokenLine = line;
        const int tokenColumn = column;

        char c = peek();

        // ----------------------------------------------------
        // EOF
        // ----------------------------------------------------

        if (c == '\0')
        {
            tokens.push_back({
                TokenType::EndOfFile,
                "",
                tokenLine,
                tokenColumn
            });

            break;
        }

        // ----------------------------------------------------
        // STRING
        // ----------------------------------------------------

        if (c == '"')
        {
            tokens.push_back(
                stringLiteral());

            continue;
        }

        // ----------------------------------------------------
        // IDENTIFIER / KEYWORD
        // ----------------------------------------------------

        if (
            std::isalpha(
                static_cast<unsigned char>(c))
            || c == '_')
        {
            tokens.push_back(
                identifier());

            continue;
        }

        // ----------------------------------------------------
        // NUMBER
        // ----------------------------------------------------

        if (
            std::isdigit(
                static_cast<unsigned char>(c)))
        {
            tokens.push_back(
                number());

            continue;
        }

        // ----------------------------------------------------
        // CARACTERES SIMPLES
        // ----------------------------------------------------

        advance();

        switch (c)
        {
            // ------------------------------------------------
            // =
            // ------------------------------------------------

            case '=':
                tokens.push_back({
                    TokenType::Assign,
                    "=",
                    tokenLine,
                    tokenColumn
                });
                break;

            case '+':
                tokens.push_back({
                    TokenType::Plus,
                    "+",
                    line,
                    column
                });
                break;

            // ------------------------------------------------
            // (
            // ------------------------------------------------

            case '(':
                tokens.push_back({
                    TokenType::LParen,
                    "(",
                    tokenLine,
                    tokenColumn
                });
                break;

            // ------------------------------------------------
            // )
            // ------------------------------------------------

            case ')':
                tokens.push_back({
                    TokenType::RParen,
                    ")",
                    tokenLine,
                    tokenColumn
                });
                break;

            // ------------------------------------------------
            // {
            // ------------------------------------------------

            case '{':
                tokens.push_back({
                    TokenType::LBrace,
                    "{",
                    tokenLine,
                    tokenColumn
                });
                break;

            // ------------------------------------------------
            // }
            // ------------------------------------------------

            case '}':
                tokens.push_back({
                    TokenType::RBrace,
                    "}",
                    tokenLine,
                    tokenColumn
                });
                break;

            // ------------------------------------------------
            // ;
            // ------------------------------------------------

            case ';':
                tokens.push_back({
                    TokenType::Semicolon,
                    ";",
                    tokenLine,
                    tokenColumn
                });
                break;

            // ------------------------------------------------
            // CARACTER DESCONOCIDO
            // ------------------------------------------------

            default:
                break;
        }
    }

    return tokens;
}

}
