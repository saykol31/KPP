#include "kpp/Parser.hpp"

#include <iostream>
#include <stdexcept>
#include <string>

namespace kpp {

// ============================================================
// CONSTRUCTOR
// ============================================================

Parser::Parser(
    const std::vector<Token>& tokens)
    : tokens(tokens)
{
}

// ============================================================
// CURRENT
// ============================================================

const Token& Parser::current() const
{
    if (position >= tokens.size())
        return tokens.back();

    return tokens[position];
}

// ============================================================
// CHECK
// ============================================================

bool Parser::check(TokenType type) const
{
    return current().type == type;
}

// ============================================================
// ADVANCE
// ============================================================

const Token& Parser::advance()
{
    const Token& token = current();

    if (position < tokens.size())
        ++position;

    return token;
}

// ============================================================
// MATCH
// ============================================================

bool Parser::match(TokenType type)
{
    if (!check(type))
        return false;

    advance();

    return true;
}

// ============================================================
// EXPECT
// ============================================================

void Parser::expect(
    TokenType type,
    const char* message)
{
    if (!check(type))
    {
        std::cerr
            << "K++ Parser error at "
            << current().line
            << ":"
            << current().column
            << ": "
            << message
            << '\n';

        throw std::runtime_error(
            "K++ parser error");
    }

    advance();
}

// ============================================================
// PARSE
// ============================================================

std::unique_ptr<Program>
Parser::parse()
{
    auto program =
        std::make_unique<Program>();

    while (!check(TokenType::EndOfFile))
    {
        program->functions.push_back(
            parseFunction());
    }

    return program;
}

// ============================================================
// PARSE FUNCTION
// ============================================================

std::unique_ptr<FunctionDeclaration>
Parser::parseFunction()
{
    // --------------------------------------------------------
    // int
    // --------------------------------------------------------

    expect(
        TokenType::KwInt,
        "se esperaba 'int'");

    // --------------------------------------------------------
    // nombre de función
    // --------------------------------------------------------

    if (!check(TokenType::Identifier))
    {
        throw std::runtime_error(
            "K++: se esperaba nombre de función");
    }

    std::string name =
        advance().text;

    // --------------------------------------------------------
    // (
    // --------------------------------------------------------

    expect(
        TokenType::LParen,
        "se esperaba '('");

    // --------------------------------------------------------
    // )
    // --------------------------------------------------------

    expect(
        TokenType::RParen,
        "se esperaba ')'");

    // --------------------------------------------------------
    // cuerpo
    // --------------------------------------------------------

    auto body =
        parseBlock();

    auto function =
        std::make_unique<FunctionDeclaration>();

    function->returnType = "int";
    function->name = name;
    function->body = std::move(body);

    return function;
}

// ============================================================
// PARSE BLOCK
// ============================================================

std::unique_ptr<Block>
Parser::parseBlock()
{
    expect(
        TokenType::LBrace,
        "se esperaba '{'");

    auto block =
        std::make_unique<Block>();

    while (!check(TokenType::RBrace)
           && !check(TokenType::EndOfFile))
    {
        block->statements.push_back(
            parseStatement());
    }

    expect(
        TokenType::RBrace,
        "se esperaba '}'");

    return block;
}

// ============================================================
// PARSE STATEMENT
// ============================================================

std::unique_ptr<Statement>
Parser::parseStatement()
{
    // ========================================================
    // VARIABLE
    //
    // int x = 42;
    // ========================================================

    if (match(TokenType::KwInt))
    {
        // ----------------------------------------------------
        // nombre
        // ----------------------------------------------------

        if (!check(TokenType::Identifier))
        {
            throw std::runtime_error(
                "K++: se esperaba nombre de variable");
        }

        std::string name =
            advance().text;

        // ----------------------------------------------------
        // =
        // ----------------------------------------------------

        expect(
            TokenType::Assign,
            "se esperaba '='");

        // ----------------------------------------------------
        // expresión inicial
        // ----------------------------------------------------

        auto initializer =
            parseExpression();

        // ----------------------------------------------------
        // ;
        // ----------------------------------------------------

        expect(
            TokenType::Semicolon,
            "se esperaba ';'");

        return std::make_unique<VariableDeclaration>(
            name,
            std::move(initializer));
    }

    // ========================================================
    // RETURN
    //
    // return 42;
    // return x;
    // ========================================================

    if (match(TokenType::KwReturn))
    {
        auto expression =
            parseExpression();

        expect(
            TokenType::Semicolon,
            "se esperaba ';'");

        return std::make_unique<ReturnStatement>(
            std::move(expression));
    }

    // ========================================================
    // PRINT
    //
    // print("Hola");
    // ========================================================

    if (match(TokenType::KwPrint))
    {
        expect(
            TokenType::LParen,
            "se esperaba '(' después de print");

        if (!check(TokenType::String))
        {
            throw std::runtime_error(
                "K++: print() requiere una cadena");
        }

        std::string text =
            advance().text;

        expect(
            TokenType::RParen,
            "se esperaba ')'");

        expect(
            TokenType::Semicolon,
            "se esperaba ';'");

        return std::make_unique<PrintStatement>(
            text);
    }

    // ========================================================
    // ERROR
    // ========================================================

    throw std::runtime_error(
        "K++: sentencia no reconocida");
}

// ============================================================
// PARSE EXPRESSION
// ============================================================

std::unique_ptr<Expression>
Parser::parseExpression()
{
    auto expression = parsePrimary();

    while (match(TokenType::Plus))
    {
        auto right = parsePrimary();

        expression =
            std::make_unique<BinaryExpression>(
                "+",
                std::move(expression),
                std::move(right)
            );
    }

    return expression;
}

// ============================================================
// PARSE PRIMARY
// ============================================================

std::unique_ptr<Expression>
Parser::parsePrimary()
{
    // ========================================================
    // INTEGER
    //
    // 42
    // ========================================================

    if (check(TokenType::Number))
    {
        int value =
            std::stoi(advance().text);

        return std::make_unique<IntegerLiteral>(
            value);
    }

    // ========================================================
    // VARIABLE
    //
    // x
    // ========================================================

    if (check(TokenType::Identifier))
    {
        std::string name =
            advance().text;

        return std::make_unique<VariableExpression>(
            name);
    }

    // ========================================================
    // ERROR
    // ========================================================

    throw std::runtime_error(
        "K++: expresión no reconocida");
}

}
