// ============================================================
// NOMBRE DE OPCODE
// ============================================================

const char* irOpcodeName(IROpcode opcode)
{
    switch (opcode)
    {
        // ====================================================
        // ESTRUCTURA DEL PROGRAMA
        // ====================================================

        case IROpcode::FunctionBegin:
            return "FUNCTION_BEGIN";

        case IROpcode::FunctionEnd:
            return "FUNCTION_END";

        // ====================================================
        // VARIABLES Y MEMORIA
        // ====================================================

        case IROpcode::Declare:
            return "DECLARE";

        case IROpcode::Store:
            return "STORE";

        case IROpcode::Load:
            return "LOAD";

        // ====================================================
        // ARITMÉTICA BÁSICA
        // ====================================================

        case IROpcode::Add:
            return "ADD";

        case IROpcode::Sub:
            return "SUB";

        case IROpcode::Mul:
            return "MUL";

        case IROpcode::Div:
            return "DIV";

        case IROpcode::Mod:
            return "MOD";

        // ====================================================
        // POTENCIAS Y RAÍCES
        // ====================================================

        case IROpcode::Pow:
            return "POW";

        case IROpcode::Sqrt:
            return "SQRT";

        // ====================================================
        // LOGARITMOS Y EXPONENCIALES
        // ====================================================

        case IROpcode::Log:
            return "LOG";

        case IROpcode::Log10:
            return "LOG10";

        case IROpcode::Exp:
            return "EXP";

        // ====================================================
        // TRIGONOMETRÍA
        // ====================================================

        case IROpcode::Sin:
            return "SIN";

        case IROpcode::Cos:
            return "COS";

        case IROpcode::Tan:
            return "TAN";

        case IROpcode::Cot:
            return "COT";

        case IROpcode::Sec:
            return "SEC";

        case IROpcode::Csc:
            return "CSC";

        // ====================================================
        // TRIGONOMETRÍA INVERSA
        // ====================================================

        case IROpcode::Asin:
            return "ASIN";

        case IROpcode::Acos:
            return "ACOS";

        case IROpcode::Atan:
            return "ATAN";

        // ====================================================
        // FUNCIONES MATEMÁTICAS
        // ====================================================

        case IROpcode::Abs:
            return "ABS";

        case IROpcode::Floor:
            return "FLOOR";

        case IROpcode::Ceil:
            return "CEIL";

        case IROpcode::Round:
            return "ROUND";

        case IROpcode::Min:
            return "MIN";

        case IROpcode::Max:
            return "MAX";

        // ====================================================
        // MATEMÁTICA AVANZADA
        // ====================================================

        case IROpcode::Factorial:
            return "FACTORIAL";

        case IROpcode::Sum:
            return "SUM";

        case IROpcode::Integral:
            return "INTEGRAL";

        // ====================================================
        // FUNCIONES
        // ====================================================

        case IROpcode::Call:
            return "CALL";

        case IROpcode::Return:
            return "RETURN";

        // ====================================================
        // SALIDA
        // ====================================================

        case IROpcode::Print:
            return "PRINT";

        case IROpcode::PrintInteger:
            return "PRINT_INT";

        case IROpcode::PrintFloat:
            return "PRINT_FLOAT";

        // ====================================================
        // COMPARACIONES
        // ====================================================

        case IROpcode::CompareEqual:
            return "CMP_EQ";

        case IROpcode::CompareNotEqual:
            return "CMP_NE";

        case IROpcode::CompareLess:
            return "CMP_LT";

        case IROpcode::CompareLessEqual:
            return "CMP_LE";

        case IROpcode::CompareGreater:
            return "CMP_GT";

        case IROpcode::CompareGreaterEqual:
            return "CMP_GE";

        // ====================================================
        // LÓGICA
        // ====================================================

        case IROpcode::LogicalAnd:
            return "AND";

        case IROpcode::LogicalOr:
            return "OR";

        case IROpcode::LogicalNot:
            return "NOT";

        // ====================================================
        // CONTROL DE FLUJO
        // ====================================================

        case IROpcode::Label:
            return "LABEL";

        case IROpcode::Jump:
            return "JUMP";

        case IROpcode::JumpIfZero:
            return "JUMP_IF_ZERO";

        case IROpcode::JumpIfNotZero:
            return "JUMP_IF_NOT_ZERO";
    }

    return "UNKNOWN";
}

// ============================================================
// CREAR TEMPORAL
//
// %0
// %1
// %2
// ...
// ============================================================

std::string IRGenerator::createTemporary()
{
    return "%" + std::to_string(temporaryCounter++);
}

// ============================================================
// GENERAR PROGRAMA IR
// ============================================================

IRProgram IRGenerator::generate(
    const Program& program)
{
    IRProgram ir;

    for (const auto& function :
         program.functions)
    {
        ir.functions.push_back(
            generateFunction(*function));
    }

    return ir;
}

// ============================================================
// GENERAR FUNCIÓN
// ============================================================

IRFunction IRGenerator::generateFunction(
    const FunctionDeclaration& function)
{
    IRFunction irFunction;

    irFunction.name = function.name;

    // --------------------------------------------------------
    // Cada función comienza sus temporales desde %0
    // --------------------------------------------------------

    temporaryCounter = 0;

    // --------------------------------------------------------
    // FUNCTION BEGIN
    // --------------------------------------------------------

    irFunction.instructions.push_back({
        IROpcode::FunctionBegin,
        function.name,
        "",
        "",
        0
    });

    // --------------------------------------------------------
    // BODY
    // --------------------------------------------------------

    if (!function.body)
    {
        throw std::runtime_error(
            "K++ IR: función sin cuerpo");
    }

    for (const auto& statement :
         function.body->statements)
    {
        generateStatement(
            *statement,
            irFunction);
    }

    // --------------------------------------------------------
    // FUNCTION END
    // --------------------------------------------------------

    irFunction.instructions.push_back({
        IROpcode::FunctionEnd,
        "",
        "",
        "",
        0
    });

    return irFunction;
}

// ============================================================
// GENERAR SENTENCIA
// ============================================================

void IRGenerator::generateStatement(
    const Statement& statement,
    IRFunction& function)
{
    // ========================================================
    // VARIABLE DECLARATION
    //
    // int x = 42;
    //
    // ->
    //
    // DECLARE x
    // STORE x, 42
    // ========================================================

    if (auto* variableDeclaration =
        dynamic_cast<const VariableDeclaration*>(
            &statement))
    {
        // ----------------------------------------------------
        // DECLARE
        // ----------------------------------------------------

        function.instructions.push_back({
            IROpcode::Declare,
            variableDeclaration->name,
            "",
            "",
            0
        });

        // ----------------------------------------------------
        // Verificar inicializador
        // ----------------------------------------------------

        if (!variableDeclaration->initializer)
        {
            throw std::runtime_error(
                "K++ IR: variable sin inicializador");
        }

        // ----------------------------------------------------
        // INITIALIZER
        //
        // Generamos cualquier expresión soportada.
        //
        // int x = 42;
        // int x = y;
        // int x = 10 + 20;
        // int x = 10 + 20 * 3;
        // ----------------------------------------------------

        const Expression& initializer =
            *variableDeclaration->initializer;

        // ----------------------------------------------------
        // Literal entero
        //
        // int x = 42;
        //
        // ->
        //
        // STORE x, 42
        // ----------------------------------------------------

        if (auto* integer =
            dynamic_cast<const IntegerLiteral*>(
                &initializer))
        {
            function.instructions.push_back({
                IROpcode::Store,
                variableDeclaration->name,
                "",
                "",
                integer->value
            });

            return;
        }

        // ----------------------------------------------------
        // Cualquier otra expresión
        // ----------------------------------------------------

        std::string temporary =
            generateExpression(
                initializer,
                function);

        function.instructions.push_back({
            IROpcode::Store,
            variableDeclaration->name,
            temporary,
            "",
            0
        });

        return;
    }

    // ========================================================
    // PRINT
    // ========================================================

    if (auto* printStatement =
        dynamic_cast<const PrintStatement*>(&statement))
    {
        function.instructions.push_back({
            IROpcode::Print,
            printStatement->text,
            "",
            "",
            0
        });

        return;
    }

    // ========================================================
    // RETURN
    // ========================================================

    if (auto* returnStatement =
        dynamic_cast<const ReturnStatement*>(
            &statement))
    {
        // ----------------------------------------------------
        // Verificar que exista expresión
        // ----------------------------------------------------

        if (!returnStatement->expression)
        {
            throw std::runtime_error(
                "K++ IR: return sin expresión");
        }

        // ----------------------------------------------------
        // Literal entero
        //
        // return 42;
        // ----------------------------------------------------

        if (auto* integer =
            dynamic_cast<const IntegerLiteral*>(
                returnStatement->expression.get()))
        {
            function.instructions.push_back({
                IROpcode::Return,
                "",
                "",
                "",
                integer->value
            });

            return;
        }

        // ----------------------------------------------------
        // Cualquier otra expresión
        //
        // return x;
        // return x + y;
        // return 10 + 20 * 3;
        // ----------------------------------------------------

        std::string temporary =
            generateExpression(
                *returnStatement->expression,
                function);

        // ----------------------------------------------------
        // PRUEBA DE FUEGO
        //
        // Mostrar expresiones enteras antes de retornar.
        // ----------------------------------------------------

        function.instructions.push_back({
            IROpcode::PrintInteger,
            "",
            temporary,
            "",
            0
        });

        function.instructions.push_back({
            IROpcode::Return,
            "",
            temporary,
            "",
            0
        });

        return;
    }

    // ========================================================
    // SENTENCIA NO SOPORTADA
    // ========================================================

    throw std::runtime_error(
        "K++ IR: sentencia no soportada");
}

// ============================================================
// GENERAR EXPRESIÓN
// ============================================================

std::string IRGenerator::generateExpression(
    const Expression& expression,
    IRFunction& function)
{
    // ========================================================
    // INTEGER
    //
    // Los literales ahora pueden aparecer dentro de
    // expresiones:
    //
    // 10 + 20
    // x * 3
    // (10 + 20) * 3
    //
    // Para mantener el IR actual basado en temporales,
    // generamos una instrucción STORE especial sobre un
    // temporal lógico.
    // ========================================================

    if (auto* integer =
        dynamic_cast<const IntegerLiteral*>(
            &expression))
    {
        std::string result =
            createTemporary();

        function.instructions.push_back({
            IROpcode::Store,
            "",
            "",
            result,
            integer->value
        });

        return result;
    }

    // ========================================================
    // VARIABLE
    //
    // x
    //
    // ->
    //
    // LOAD x -> %0
    // ========================================================

    if (auto* variable =
        dynamic_cast<const VariableExpression*>(
            &expression))
    {
        std::string temporary =
            createTemporary();

        function.instructions.push_back({
            IROpcode::Load,
            variable->name,
            "",
            temporary,
            0
        });

        return temporary;
    }

    // ========================================================
    // BINARY EXPRESSION
    // ========================================================

    if (auto* binary =
        dynamic_cast<const BinaryExpression*>(
            &expression))
    {
        // ----------------------------------------------------
        // Validar operandos
        // ----------------------------------------------------

        if (!binary->left)
        {
            throw std::runtime_error(
                "K++ IR: expresión sin operando izquierdo");
        }

        if (!binary->right)
        {
            throw std::runtime_error(
                "K++ IR: expresión sin operando derecho");
        }

        // ----------------------------------------------------
        // Generar operando izquierdo
        // ----------------------------------------------------

        std::string left =
            generateExpression(
                *binary->left,
                function);

        // ----------------------------------------------------
        // Generar operando derecho
        // ----------------------------------------------------

        std::string right =
            generateExpression(
                *binary->right,
                function);

        // ----------------------------------------------------
        // Resultado
        // ----------------------------------------------------

        std::string result =
            createTemporary();

        // ====================================================
        // ARITMÉTICA
        // ====================================================

        if (binary->op == "+")
        {
            function.instructions.push_back({
                IROpcode::Add,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == "-")
        {
            function.instructions.push_back({
                IROpcode::Sub,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == "*")
        {
            function.instructions.push_back({
                IROpcode::Mul,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == "/")
        {
            function.instructions.push_back({
                IROpcode::Div,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == "%")
        {
            function.instructions.push_back({
                IROpcode::Mod,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        // ====================================================
        // POTENCIA
        // ====================================================

        if (binary->op == "^")
        {
            function.instructions.push_back({
                IROpcode::Pow,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        // ====================================================
        // COMPARACIONES
        // ====================================================

        if (binary->op == "==")
        {
            function.instructions.push_back({
                IROpcode::CompareEqual,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == "!=")
        {
            function.instructions.push_back({
                IROpcode::CompareNotEqual,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == "<")
        {
            function.instructions.push_back({
                IROpcode::CompareLess,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == "<=")
        {
            function.instructions.push_back({
                IROpcode::CompareLessEqual,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == ">")
        {
            function.instructions.push_back({
                IROpcode::CompareGreater,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == ">=")
        {
            function.instructions.push_back({
                IROpcode::CompareGreaterEqual,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        // ====================================================
        // LÓGICA
        // ====================================================

        if (binary->op == "&&")
        {
            function.instructions.push_back({
                IROpcode::LogicalAnd,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        if (binary->op == "||")
        {
            function.instructions.push_back({
                IROpcode::LogicalOr,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        // ====================================================
        // NOT LÓGICO
        //
        // El parser actual representa:
        //
        // !x
        //
        // como:
        //
        // BinaryExpression("!", 0, x)
        //
        // Por tanto, el resultado se genera usando el
        // operando derecho.
        // ====================================================

        if (binary->op == "!")
        {
            function.instructions.push_back({
                IROpcode::LogicalNot,
                "",
                right,
                result,
                0
            });

            return result;
        }

        // ====================================================
        // OPERADOR NO SOPORTADO
        // ====================================================

        throw std::runtime_error(
            "K++ IR: operador no soportado: " +
            binary->op);
    }

    // ========================================================
    // EXPRESIÓN NO SOPORTADA
    // ========================================================

    throw std::runtime_error(
        "K++ IR: expresión no soportada");
}

