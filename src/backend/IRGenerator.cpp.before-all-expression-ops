// ============================================================
// NOMBRE DE OPCODE
// ============================================================

const char* irOpcodeName(IROpcode opcode)
{
    switch (opcode)
    {
        // ====================================================
        // ESTRUCTURA DEL PROGRAMA
        // ====================================================

        case IROpcode::FunctionBegin:
            return "FUNCTION_BEGIN";

        case IROpcode::FunctionEnd:
            return "FUNCTION_END";

        // ====================================================
        // VARIABLES Y MEMORIA
        // ====================================================

        case IROpcode::Declare:
            return "DECLARE";

        case IROpcode::Store:
            return "STORE";

        case IROpcode::Load:
            return "LOAD";

        // ====================================================
        // ARITMÉTICA BÁSICA
        // ====================================================

        case IROpcode::Add:
            return "ADD";

        case IROpcode::Sub:
            return "SUB";

        case IROpcode::Mul:
            return "MUL";

        case IROpcode::Div:
            return "DIV";

        case IROpcode::Mod:
            return "MOD";

        // ====================================================
        // POTENCIAS Y RAÍCES
        // ====================================================

        case IROpcode::Pow:
            return "POW";

        case IROpcode::Sqrt:
            return "SQRT";

        // ====================================================
        // LOGARITMOS Y EXPONENCIALES
        // ====================================================

        case IROpcode::Log:
            return "LOG";

        case IROpcode::Log10:
            return "LOG10";

        case IROpcode::Exp:
            return "EXP";

        // ====================================================
        // TRIGONOMETRÍA
        // ====================================================

        case IROpcode::Sin:
            return "SIN";

        case IROpcode::Cos:
            return "COS";

        case IROpcode::Tan:
            return "TAN";

        case IROpcode::Cot:
            return "COT";

        case IROpcode::Sec:
            return "SEC";

        case IROpcode::Csc:
            return "CSC";

        // ====================================================
        // TRIGONOMETRÍA INVERSA
        // ====================================================

        case IROpcode::Asin:
            return "ASIN";

        case IROpcode::Acos:
            return "ACOS";

        case IROpcode::Atan:
            return "ATAN";

        // ====================================================
        // FUNCIONES MATEMÁTICAS
        // ====================================================

        case IROpcode::Abs:
            return "ABS";

        case IROpcode::Floor:
            return "FLOOR";

        case IROpcode::Ceil:
            return "CEIL";

        case IROpcode::Round:
            return "ROUND";

        case IROpcode::Min:
            return "MIN";

        case IROpcode::Max:
            return "MAX";

        // ====================================================
        // MATEMÁTICA AVANZADA
        // ====================================================

        case IROpcode::Factorial:
            return "FACTORIAL";

        case IROpcode::Sum:
            return "SUM";

        case IROpcode::Integral:
            return "INTEGRAL";

        // ====================================================
        // FUNCIONES
        // ====================================================

        case IROpcode::Call:
            return "CALL";

        case IROpcode::Return:
            return "RETURN";

        // ====================================================
        // SALIDA
        // ====================================================

        case IROpcode::Print:
            return "PRINT";

        case IROpcode::PrintInteger:
            return "PRINT_INT";

        case IROpcode::PrintFloat:
            return "PRINT_FLOAT";

        // ====================================================
        // COMPARACIONES
        // ====================================================

        case IROpcode::CompareEqual:
            return "CMP_EQ";

        case IROpcode::CompareNotEqual:
            return "CMP_NE";

        case IROpcode::CompareLess:
            return "CMP_LT";

        case IROpcode::CompareLessEqual:
            return "CMP_LE";

        case IROpcode::CompareGreater:
            return "CMP_GT";

        case IROpcode::CompareGreaterEqual:
            return "CMP_GE";

        // ====================================================
        // LÓGICA
        // ====================================================

        case IROpcode::LogicalAnd:
            return "AND";

        case IROpcode::LogicalOr:
            return "OR";

        case IROpcode::LogicalNot:
            return "NOT";

        // ====================================================
        // CONTROL DE FLUJO
        // ====================================================

        case IROpcode::Label:
            return "LABEL";

        case IROpcode::Jump:
            return "JUMP";

        case IROpcode::JumpIfZero:
            return "JUMP_IF_ZERO";

        case IROpcode::JumpIfNotZero:
            return "JUMP_IF_NOT_ZERO";
    }

    return "UNKNOWN";
}

// ============================================================
// CREAR TEMPORAL
//
// %0
// %1
// %2
// ...
// ============================================================

std::string IRGenerator::createTemporary()
{
    return "%" + std::to_string(temporaryCounter++);
}

// ============================================================
// GENERAR PROGRAMA IR
// ============================================================

IRProgram IRGenerator::generate(
    const Program& program)
{
    IRProgram ir;

    for (const auto& function :
         program.functions)
    {
        ir.functions.push_back(
            generateFunction(*function));
    }

    return ir;
}

// ============================================================
// GENERAR FUNCIÓN
// ============================================================

IRFunction IRGenerator::generateFunction(
    const FunctionDeclaration& function)
{
    IRFunction irFunction;

    irFunction.name = function.name;

    // --------------------------------------------------------
    // Cada función comienza sus temporales desde %0
    // --------------------------------------------------------

    temporaryCounter = 0;

    // --------------------------------------------------------
    // FUNCTION BEGIN
    // --------------------------------------------------------

    irFunction.instructions.push_back({
        IROpcode::FunctionBegin,
        function.name,
        "",
        "",
        0
    });

    // --------------------------------------------------------
    // BODY
    // --------------------------------------------------------

    for (const auto& statement :
         function.body->statements)
    {
        generateStatement(
            *statement,
            irFunction);
    }

    // --------------------------------------------------------
    // FUNCTION END
    // --------------------------------------------------------

    irFunction.instructions.push_back({
        IROpcode::FunctionEnd,
        "",
        "",
        "",
        0
    });

    return irFunction;
}

// ============================================================
// GENERAR SENTENCIA
// ============================================================

void IRGenerator::generateStatement(
    const Statement& statement,
    IRFunction& function)
{
    // ========================================================
    // VARIABLE DECLARATION
    //
    // int x = 42;
    //
    // ->
    //
    // DECLARE x
    // STORE x, 42
    // ========================================================

    if (auto* variableDeclaration =
        dynamic_cast<const VariableDeclaration*>(
            &statement))
    {
        // ----------------------------------------------------
        // DECLARE
        // ----------------------------------------------------

        function.instructions.push_back({
            IROpcode::Declare,
            variableDeclaration->name,
            "",
            "",
            0
        });

        // ----------------------------------------------------
        // INITIALIZER: INTEGER
        //
        // int x = 42;
        // ----------------------------------------------------

        if (auto* integer =
            dynamic_cast<const IntegerLiteral*>(
                variableDeclaration->initializer.get()))
        {
            function.instructions.push_back({
                IROpcode::Store,
                variableDeclaration->name,
                "",
                "",
                integer->value
            });

            return;
        }

        // ----------------------------------------------------
        // INITIALIZER: VARIABLE
        //
        // int x = y;
        //
        // ->
        //
        // LOAD y -> %0
        // STORE x <- %0
        // ----------------------------------------------------

        if (auto* variable =
            dynamic_cast<const VariableExpression*>(
                variableDeclaration->initializer.get()))
        {
            std::string temporary =
                generateExpression(
                    *variable,
                    function);

            function.instructions.push_back({
                IROpcode::Store,
                variableDeclaration->name,
                temporary,
                "",
                0
            });

            return;
        }

        throw std::runtime_error(
            "K++ IR: inicializador de variable no soportado");
    }

    // ========================================================
    // PRINT
    // ========================================================

    if (auto* printStatement =
        dynamic_cast<const PrintStatement*>(&statement))
    {
        function.instructions.push_back({
            IROpcode::Print,
            printStatement->text,
            "",
            "",
            0
        });

        return;
    }

    // ========================================================
    // RETURN
    // ========================================================

    if (auto* returnStatement =
        dynamic_cast<const ReturnStatement*>(
            &statement))
    {
        // ----------------------------------------------------
        // Verificar que exista expresión
        // ----------------------------------------------------

        if (!returnStatement->expression)
        {
            throw std::runtime_error(
                "K++ IR: return sin expresión");
        }

        // ----------------------------------------------------
        // return 42;
        //
        // ->
        //
        // RETURN 42
        // ----------------------------------------------------

        if (auto* integer =
            dynamic_cast<const IntegerLiteral*>(
                returnStatement->expression.get()))
        {
            function.instructions.push_back({
                IROpcode::Return,
                "",
                "",
                "",
                integer->value
            });

            return;
        }

        // ----------------------------------------------------
        // return x;
        //
        // ->
        //
        // LOAD x -> %0
        // RETURN %0
        // ----------------------------------------------------

        if (auto* variable =
            dynamic_cast<const VariableExpression*>(
                returnStatement->expression.get()))
        {
            std::string temporary =
                generateExpression(
                    *variable,
                    function);

            function.instructions.push_back({
                IROpcode::Return,
                "",
                temporary,
                "",
                0
            });

            return;
        }

        // ----------------------------------------------------
        // return x + y;
        //
        // ->
        //
        // LOAD x -> %0
        // LOAD y -> %1
        // ADD %0, %1 -> %2
        // RETURN %2
        // ----------------------------------------------------

        if (auto* binary =
            dynamic_cast<const BinaryExpression*>(
                returnStatement->expression.get()))
        {
            std::string temporary =
                generateExpression(
                    *binary,
                    function);

            // ------------------------------------------------
            // PRUEBA DE FUEGO:
            // mostrar el resultado entero antes de retornar
            //
            // LOAD x -> %0
            // LOAD y -> %1
            // ADD %0, %1 -> %2
            // PRINT_INT %2
            // RETURN %2
            // ------------------------------------------------

            function.instructions.push_back({
                IROpcode::PrintInteger,
                "",
                temporary,
                "",
                0
            });

            function.instructions.push_back({
                IROpcode::Return,
                "",
                temporary,
                "",
                0
            });

            return;
        }

        // ----------------------------------------------------
        // EXPRESIÓN NO SOPORTADA
        // ----------------------------------------------------

        throw std::runtime_error(
            "K++ IR: expresión de retorno no soportada");
    }

    // ========================================================
    // SENTENCIA NO SOPORTADA
    // ========================================================

    throw std::runtime_error(
        "K++ IR: sentencia no soportada");
}

// ============================================================
// GENERAR EXPRESIÓN
// ============================================================


std::string IRGenerator::generateExpression(
    const Expression& expression,
    IRFunction& function)
{
    // ========================================================
    // INTEGER
    // ========================================================

    if (dynamic_cast<const IntegerLiteral*>(&expression))
    {
        throw std::runtime_error(
            "K++ IR: literal entero usado como expresión "
            "en contexto no soportado");
    }

    // ========================================================
    // VARIABLE
    //
    // x
    //
    // LOAD x -> %0
    // ========================================================

    if (auto* variable =
        dynamic_cast<const VariableExpression*>(&expression))
    {
        std::string temporary =
            createTemporary();

        function.instructions.push_back({
            IROpcode::Load,
            variable->name,
            "",
            temporary,
            0
        });

        return temporary;
    }

    // ========================================================
    // BINARY EXPRESSION
    //
    // x + y
    // ========================================================

    if (auto* binary =
        dynamic_cast<const BinaryExpression*>(&expression))
    {
        // ----------------------------------------------------
        // Generar operando izquierdo
        // ----------------------------------------------------

        std::string left =
            generateExpression(
                *binary->left,
                function);

        // ----------------------------------------------------
        // Generar operando derecho
        // ----------------------------------------------------

        std::string right =
            generateExpression(
                *binary->right,
                function);

        // ----------------------------------------------------
        // Resultado temporal
        // ----------------------------------------------------

        std::string result =
            createTemporary();

        // ----------------------------------------------------
        // Operador +
        // ----------------------------------------------------

        if (binary->op == "+")
        {
            function.instructions.push_back({
                IROpcode::Add,
                "",
                left + ", " + right,
                result,
                0
            });

            return result;
        }

        throw std::runtime_error(
            "K++ IR: operador aritmético no soportado: " +
            binary->op);
    }

    // ========================================================
    // EXPRESIÓN NO SOPORTADA
    // ========================================================

    throw std::runtime_error(
        "K++ IR: expresión no soportada");
}


} // namespace kpp
