

#include "kpp/X86Backend.hpp"
#include "kpp/KolibriRuntime.hpp"

#include <cstdint>
#include <stdexcept>
#include <string>
#include <vector>

namespace kpp {
    void X86Backend::resetTemporaries()
    {
        temporaries.clear();
    }

    void X86Backend::bindTemporaryToEax(
        const std::string& temporary)
    {
        temporaries[temporary] = {
            TemporaryLocation::Kind::Register,
            0
        };
    }

    void X86Backend::bindTemporaryToEbx(
        const std::string& temporary)
    {
        temporaries[temporary] = {
            TemporaryLocation::Kind::Register,
            3
        };
    }

    void X86Backend::resetVariables()
    {
        variables.clear();
    }

    std::size_t
    X86Backend::allocateVariableData(
        std::vector<std::uint8_t>& data)
    {
        const std::size_t offset =
            data.size();

        data.resize(
            data.size() + 4,
            0);

        return offset;
    }

    void X86Backend::declareVariable(
        const std::string& name,
        std::size_t dataOffset)
    {
        variables[name] = {
            dataOffset
        };
    }

    bool X86Backend::hasTemporary(
        const std::string& temporary) const
    {
        return temporaries.find(temporary)
            != temporaries.end();
    }

    std::uint8_t X86Backend::getTemporaryRegister(
        const std::string& temporary) const
    {
        const auto it =
            temporaries.find(temporary);

        if (it == temporaries.end())
        {
            throw std::runtime_error(
                "K++ X86: temporal no encontrado: " +
                temporary);
        }

        return it->second.registerCode;
    }

// ============================================================
// CONSTANTES
// ============================================================

static constexpr std::uint32_t
KOLIBRI_HEADER_SIZE = 36;


// ============================================================
// GENERATE
// ============================================================

std::vector<std::uint8_t>
X86Backend::generate(
    const IRProgram& program)
{
    /*
     * ========================================================
     * STRING POOL
     * ========================================================
     *
     * strings[0] = título
     * strings[1...] = PRINT
     */

    std::vector<std::string> strings;

    std::vector<std::uint8_t> data;

    std::size_t integerBufferOffset = 0;

    // --------------------------------------------------------
    // Título automático
    // --------------------------------------------------------

    strings.push_back(
        "K++ - KolibriOS");


    // --------------------------------------------------------
    // Buscar PRINT
    // --------------------------------------------------------

    for (const auto& function :
         program.functions)
    {
        for (const auto& instruction :
             function.instructions)
        {
            if (instruction.opcode ==
                IROpcode::Print)
            {
                strings.push_back(
                    instruction.name);
            }
        }
    }


    // --------------------------------------------------------
    // Cantidad de PRINT
    // --------------------------------------------------------

    const std::size_t printCount =
        strings.size() > 1
            ? strings.size() - 1
            : 0;


    // ========================================================
    // RUNTIME
    // ========================================================

    KolibriRuntime runtime;

    const KolibriRuntimeResult runtimeResult =
        runtime.emitGraphicsRuntime(
            emitter);


    // ========================================================
    // MAIN BODY
    // ========================================================
    //
    // Aquí comienza realmente el código generado
    // correspondiente al programa C++.
    //
    // START
    //   |
    //   +--> DRAW_WINDOW
    //   |
    //   +--> MAIN_BODY
    //
    // MAIN_BODY
    //   |
    //   +--> PRINT
    //   +--> PRINT
    //   +--> RETURN
    //   |
    //   +--> EVENT_LOOP
    //

    const std::size_t mainBody =
        emitter.size();


    std::vector<std::size_t>
        textPatches;

    std::vector<std::size_t>
        integerBufferPatches;

    std::vector<VariableLoadPatch>
        variableLoadPatches;

    std::vector<VariableStorePatch>
        variableStorePatches;

    std::size_t
        returnEventLoopPatch = 0;

    bool
        hasReturn = false;


    std::size_t
        printIndex = 0;

    resetTemporaries();
    resetVariables();
    // ========================================================
    // GENERAR INSTRUCCIONES IR
    // ========================================================

    for (const auto& function :
         program.functions)
    {
        for (const auto& instruction :
             function.instructions)
        {
            // ------------------------------------------------
            // DECLARE
            // ------------------------------------------------

            if (instruction.opcode ==
                IROpcode::Declare)
            {
                const std::size_t offset =
                    allocateVariableData(data);

                declareVariable(
                    instruction.name,
                    offset);
            }

            // ------------------------------------------------
            // STORE
            // ------------------------------------------------

            else if (instruction.opcode ==
                     IROpcode::Store)
            {
                /*
                 * STORE x, 10
                 *
                 * Generamos:
                 *
                 *     MOV dword [direccion_de_x], 10
                 *
                 * La dirección absoluta se resolverá
                 * después, cuando conozcamos dataBase.
                 */

                const auto variableIt =
                    variables.find(instruction.name);

                if (variableIt == variables.end())
                {
                    throw std::runtime_error(
                        "K++ X86Backend: STORE de variable no declarada: " +
                        instruction.name);
                }

                const std::size_t patchOffset =
                    emitter.emitMovMemImm32Placeholder(
                        instruction.value);

                variableStorePatches.push_back({
                    instruction.name,
                    patchOffset
                });
            }


            // ------------------------------------------------
            // LOAD
            // ------------------------------------------------

            else if (instruction.opcode ==
                     IROpcode::Load)
            {
                /*
                 * LOAD x -> %0
                 *
                 * LOAD y -> %1
                 *
                 * Para permitir operaciones binarias
                 * necesitamos conservar dos operandos
                 * simultáneamente.
                 *
                 * K++ utiliza inicialmente:
                 *
                 *     %0 -> EAX
                 *     %1 -> EBX
                 *
                 * Por tanto:
                 *
                 *     LOAD x -> %0
                 *         MOV EAX, [x]
                 *
                 *     LOAD y -> %1
                 *         MOV EBX, [y]
                 */

                const auto variableIt =
                    variables.find(
                        instruction.name);

                if (variableIt ==
                    variables.end())
                {
                    throw std::runtime_error(
                        "K++ X86Backend: LOAD de variable no declarada: " +
                        instruction.name);
                }

                /*
                 * El número de temporales ya generados
                 * determina inicialmente el registro.
                 *
                 * %0 -> EAX
                 * %1 -> EBX
                 * %2 -> EAX
                 * %3 -> EBX
                 */

                const bool useEax =
                    (temporaries.size() % 2 == 0);

                std::size_t patchOffset = 0;

                if (useEax)
                {
                    patchOffset =
                        emitter.emitMovEaxMem32Placeholder();

                    bindTemporaryToEax(
                        instruction.result);
                }
                else
                {
                    patchOffset =
                        emitter.emitMovEbxMem32Placeholder();

                    bindTemporaryToEbx(
                        instruction.result);
                }

                /*
                 * La dirección absoluta todavía no
                 * conocemos. Se resolverá después
                 * de calcular dataBase.
                 */

                variableLoadPatches.push_back({
                    instruction.name,
                    patchOffset
                });
            }

            // ------------------------------------------------
            // ADD
            // ------------------------------------------------

            else if (instruction.opcode ==
                     IROpcode::Add)
            {
                /*
                 * ADD %0, %1 -> %2
                 *
                 * Actualmente el asignador inicial de K++
                 * utiliza:
                 *
                 *     %0 -> EAX
                 *     %1 -> EBX
                 *
                 * Por tanto:
                 *
                 *     ADD EAX, EBX
                 *
                 * El resultado queda en EAX.
                 */

                const std::string left =
                    instruction.operand.substr(
                        0,
                        instruction.operand.find(","));

                const std::string right =
                    instruction.operand.substr(
                        instruction.operand.find(",") + 2);

                if (!hasTemporary(left))
                {
                    throw std::runtime_error(
                        "K++ X86Backend: ADD usa temporal izquierdo inexistente: " +
                        left);
                }

                if (!hasTemporary(right))
                {
                    throw std::runtime_error(
                        "K++ X86Backend: ADD usa temporal derecho inexistente: " +
                        right);
                }

                const std::uint8_t leftRegister =
                    getTemporaryRegister(left);

                const std::uint8_t rightRegister =
                    getTemporaryRegister(right);

                /*
                 * En esta primera versión del backend
                 * exigimos exactamente:
                 *
                 *     izquierda  = EAX
                 *     derecha    = EBX
                 */

                if (leftRegister != 0)
                {
                    throw std::runtime_error(
                        "K++ X86Backend: ADD requiere el operando izquierdo en EAX");
                }

                if (rightRegister != 3)
                {
                    throw std::runtime_error(
                        "K++ X86Backend: ADD requiere el operando derecho en EBX");
                }

                /*
                 * 01 D8
                 *
                 * ADD EAX, EBX
                 *
                 * Resultado:
                 *
                 *     EAX = EAX + EBX
                 */

                emitter.emitAddEaxEbx();

                /*
                 * El resultado de ADD queda en EAX.
                 */

                bindTemporaryToEax(
                    instruction.result);
            }

            // ------------------------------------------------
            // PRINT
            // ------------------------------------------------

            else if (instruction.opcode ==
                     IROpcode::Print)
            {
                /*
                 * PRINT 1 -> Y=40
                 * PRINT 2 -> Y=70
                 * PRINT 3 -> Y=100
                 * PRINT 4 -> Y=130
                 */

                const std::uint32_t y =
                    40u +
                    static_cast<std::uint32_t>(
                        printIndex * 30u);


                const std::size_t patch =
                    runtime.emitPrint(
                        emitter,
                        y);


                textPatches.push_back(
                    patch);

                ++printIndex;
            }


            // ------------------------------------------------
            // PRINT INTEGER
            // ------------------------------------------------

            else if (instruction.opcode ==
                     IROpcode::PrintInteger)
            {
                if (!hasTemporary(
                        instruction.operand))
                {
                    throw std::runtime_error(
                        "PRINT_INT usa un temporal inexistente: " +
                        instruction.operand);
                }

                const std::uint8_t reg =
                    getTemporaryRegister(
                        instruction.operand);

                /*
                 * Actualmente PRINT_INT recibe
                 * el resultado directamente en EAX.
                 */
                if (reg != 0)
                {
                    throw std::runtime_error(
                        "PRINT_INT actualmente requiere EAX.");
                }

                const std::uint32_t y =
                    40u +
                    static_cast<std::uint32_t>(
                        printIndex * 30u);

                const std::size_t patch =
                    runtime.emitPrintInteger(
                        emitter,
                        y);

                integerBufferPatches.push_back(
                    patch);

                ++printIndex;
            }


            // ------------------------------------------------
            // RETURN
            // ------------------------------------------------

            else if (instruction.opcode ==
                     IROpcode::Return)
            {
                /*
                 * RETURN
                 *
                 * Hay dos formas:
                 *
                 *     RETURN 42
                 *
                 * o:
                 *
                 *     RETURN %0
                 *
                 * En el segundo caso el temporal ya
                 * contiene el resultado en EAX.
                 */

                if (!instruction.operand.empty())
                {
                    /*
                     * RETURN %0
                     *
                     * El temporal ya está en EAX.
                     *
                     * No hacemos MOV EAX, inmediato,
                     * porque destruiríamos el resultado.
                     */

                    const auto temporaryIt =
                        temporaries.find(
                            instruction.operand);

                    if (temporaryIt ==
                        temporaries.end())
                    {
                        throw std::runtime_error(
                            "K++ X86Backend: RETURN de temporal no encontrado: " +
                            instruction.operand);
                    }

                    if (temporaryIt->second.kind !=
                        TemporaryLocation::Kind::Register)
                    {
                        throw std::runtime_error(
                            "K++ X86Backend: RETURN de temporal sin registro: " +
                            instruction.operand);
                    }

                    if (temporaryIt->second.registerCode != 0)
                    {
                        throw std::runtime_error(
                            "K++ X86Backend: RETURN requiere temporal en EAX: " +
                            instruction.operand);
                    }
                }
                else
                {
                    /*
                     * RETURN inmediato.
                     *
                     * Ejemplo:
                     *
                     *     return 42;
                     *
                     * EAX = 42
                     */

                    emitter.emitMovEaxImm32(
                        instruction.value);
                }

                emitter.emitByte(0xE9);

                returnEventLoopPatch =
                    emitter.emitRel32Placeholder();

                hasReturn = true;

                /*
                 * RETURN termina la función.
                 * No debemos generar instrucciones
                 * posteriores de esa función.
                 */
                break;
            }
        }
    }


    // ========================================================
    // RETURN IMPLÍCITO
    // ========================================================

    if (!hasReturn)
    {
        /*
         * Si por alguna razón el programa no contiene
         * RETURN, K++ genera:
         *
         * return 0;
         */

        emitter.emitMovEaxImm32(0);

        emitter.emitByte(0xE9);

        returnEventLoopPatch =
            emitter.emitRel32Placeholder();
    }


    // ========================================================
    // PATCH MAIN
    // ========================================================

    emitter.patchRel32(
        runtimeResult.mainEntryPatch,
        mainBody);

    emitter.patchRel32(
        runtimeResult.redrawMainPatch,
        mainBody);


    // ========================================================
    // PATCH RETURN
    // ========================================================

    emitter.patchRel32(
        returnEventLoopPatch,
        runtimeResult.eventLoopAddress);


    // ========================================================
    // STRING POOL
    // ========================================================

    const std::size_t codeSize =
        emitter.size();


// ========================================================
// INTEGER PRINT BUFFER
// ========================================================

if (!integerBufferPatches.empty())
{
    integerBufferOffset =
        data.size();

    // 15 caracteres + terminador NUL.
    data.resize(
        data.size() + 16,
        0);
}


// ========================================================
// STRING POOL
// ========================================================

std::vector<std::size_t>
    stringOffsets;

    for (const auto& text :
         strings)
    {
        stringOffsets.push_back(
            data.size());

        for (const char c :
             text)
        {
            data.push_back(
                static_cast<std::uint8_t>(
                    c));
        }

        // terminador C
        data.push_back(0);
    }


    // ========================================================
    // DATA BASE
    // ========================================================

    /*
     * Dirección absoluta dentro del BIN:
     *
     * HEADER + CODE + DATA
     */

    const std::uint32_t
        dataBase =
            KOLIBRI_HEADER_SIZE +
            static_cast<std::uint32_t>(
                codeSize);


    // ========================================================
    // PATCH LOAD ADDRESSES
    // ========================================================

    /*
     * Cada LOAD generó previamente:
     *
     *     MOV EAX, [00000000]
     *
     * Ahora que conocemos dataBase podemos resolver
     * la dirección absoluta de cada variable.
     *
     * Dirección:
     *
     *     dataBase + variable.dataOffset
     */

    for (const auto& patch :
         variableLoadPatches)
    {
        const auto variableIt =
            variables.find(patch.name);

        if (variableIt == variables.end())
        {
            throw std::runtime_error(
                "K++ X86Backend: variable LOAD no encontrada durante patch: " +
                patch.name);
        }

        const std::uint32_t
            variableAddress =
                dataBase +
                static_cast<std::uint32_t>(
                    variableIt->second.dataOffset);

        emitter.patch32(
            patch.patchOffset,
            variableAddress);
    }


    // ========================================================
    // ========================================================
// PATCH STORE ADDRESSES
// ========================================================

for (const auto& patch :
     variableStorePatches)
{
    const auto variableIt =
        variables.find(patch.name);

    if (variableIt == variables.end())
    {
        throw std::runtime_error(
            "K++ X86Backend: variable STORE no encontrada durante patch: " +
            patch.name);
    }

    const std::uint32_t
        variableAddress =
            dataBase +
            static_cast<std::uint32_t>(
                variableIt->second.dataOffset);

    emitter.patch32(
        patch.patchOffset,
        variableAddress);
}

// TITLE ADDRESS
    // ========================================================

    const std::uint32_t
        titleAddress =
            dataBase +
            static_cast<std::uint32_t>(
                stringOffsets[0]);


    emitter.patch32(
        runtimeResult.titleAddressPatch,
        titleAddress);


    // ========================================================
    // VALIDAR PRINT PATCHES
    // ========================================================

    if (textPatches.size()
        != printCount)
    {
        throw std::runtime_error(
            "K++: cantidad de patches PRINT incorrecta");
    }


    // ========================================================
    // PATCH PRINT ADDRESSES
    // ========================================================

    for (std::size_t i = 0;
         i < printCount;
         ++i)
    {
        /*
         * strings:
         *
         * [0] = title
         * [1] = PRINT 1
         * [2] = PRINT 2
         * [3] = PRINT 3
         */

        const std::uint32_t
            textAddress =
                dataBase +
                static_cast<std::uint32_t>(
                    stringOffsets[i + 1]);


        emitter.patch32(
            textPatches[i],
            textAddress);
    }


    // ========================================================
    // PATCH INTEGER PRINT BUFFER
    // ========================================================

    if (!integerBufferPatches.empty())
    {
        const std::uint32_t
            integerBufferAddress =
                dataBase +
                static_cast<std::uint32_t>(
                    integerBufferOffset);

        for (const std::size_t patch :
             integerBufferPatches)
        {
            emitter.patch32(
                patch,
                integerBufferAddress);
        }
    }


    // ========================================================
    // CODE + DATA
    // ========================================================

    std::vector<std::uint8_t>
        result =
            emitter.code();

    result.insert(
        result.end(),
        data.begin(),
        data.end());


    return result;
}


// ============================================================
// GENERATE FUNCTION
// ============================================================

void
X86Backend::generateFunction(
    const IRFunction& function)
{
    /*
     * El backend principal genera actualmente
     * el cuerpo directamente desde IRProgram.
     *
     * Esta función se conserva para mantener
     * la arquitectura preparada para futuras
     * funciones C++.
     */

    (void)function;
}

}
