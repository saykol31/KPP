#include "kpp/KolibriRuntime.hpp"
#include "kpp/X86Emitter.hpp"

#include <cstdint>
#include <utility>
#include <vector>

namespace kpp {

// ============================================================
// GRAPHICS RUNTIME
// ============================================================
//
// Arquitectura:
//
// START
//   |
//   +--> DRAW WINDOW
//   |
//   +--> K++ MAIN CODE
//          |
//          +--> PRINT
//          |
//          +--> RETURN
//                 |
//                 +--> EXIT
//
// El EVENT LOOP queda como rutina separada.
// Esto permite que el código generado por K++ sea alcanzable.
// ============================================================


// ============================================================
// EMIT GRAPHICS RUNTIME
// ============================================================

KolibriRuntimeResult
KolibriRuntime::emitGraphicsRuntime(
    X86Emitter& emitter,
    std::size_t printCount)
{
    /*
     * --------------------------------------------------------
     * IMPORTANTE
     * --------------------------------------------------------
     *
     * Esta función conserva la interfaz antigua por ahora.
     *
     * La utilizaremos para generar:
     *
     *     DRAW_WINDOW
     *
     * y los PRINT.
     *
     * El flujo de main() será reorganizado posteriormente
     * desde el backend.
     */

    (void)printCount;


    // ========================================================
    // DRAW WINDOW
    // ========================================================

    const std::size_t
        drawWindow =
            emitter.size();


    // --------------------------------------------------------
    // Begin redraw
    // --------------------------------------------------------

    emitter.emitMovEaxImm32(12);

    emitter.emitMovRegImm32(
        0xBB,
        1);

    emitter.emitInt(0x40);


    // --------------------------------------------------------
    // Create window
    // --------------------------------------------------------

    emitter.emitMovEaxImm32(0);


    // X = 100
    // WIDTH = 400

    emitter.emitMovRegImm32(
        0xBB,
        (100u << 16) + 400u);


    // Y = 100
    // HEIGHT = 180

    emitter.emitMovRegImm32(
        0xB9,
        (100u << 16) + 180u);


    // Work area color

    emitter.emitMovRegImm32(
        0xBA,
        0x14FFFFFF);


    // Title / grab bar color

    emitter.emitMovRegImm32(
        0xBE,
        0x808899FF);


    // EDI = title

    emitter.emitByte(0xBF);

    const std::size_t
        titlePatch =
            emitter.emitImm32Placeholder();

    emitter.emitInt(0x40);


    // --------------------------------------------------------
    // End redraw
    // --------------------------------------------------------

    emitter.emitMovEaxImm32(12);

    emitter.emitMovRegImm32(
        0xBB,
        2);

    emitter.emitInt(0x40);


    // --------------------------------------------------------
    // Return
    // --------------------------------------------------------

    emitter.emitRet();


    // ========================================================
    // RESULT
    // ========================================================

    KolibriRuntimeResult result;

    result.titleAddressPatch =
        titlePatch;

    return result;
}


// ============================================================
// EXIT
// ============================================================

void
KolibriRuntime::emitExit(
    X86Emitter& emitter)
{
    // --------------------------------------------------------
    // KolibriOS application exit
    // --------------------------------------------------------

    emitter.emitMovEaxImm32(-1);

    emitter.emitInt(0x40);
}

}
