#include "kpp/KolibriRuntime.hpp"
#include "kpp/X86Emitter.hpp"

#include <cstdint>

namespace kpp {

// ============================================================
// GRAPHICS RUNTIME
// ============================================================

KolibriRuntimeResult
KolibriRuntime::emitGraphicsRuntime(
    X86Emitter& emitter,
    std::size_t printCount)
{
    /*
     * ========================================================
     * K++ KOLIBRIOS GRAPHICS RUNTIME
     * ========================================================
     *
     * START
     *   |
     *   +--> DRAW_WINDOW
     *   |
     *   +--> EVENT_LOOP
     *
     * EVENT_LOOP
     *   |
     *   +--> event 1 = redraw
     *   +--> event 2 = keyboard
     *   +--> event 3 = button
     *
     * Button 1 = EXIT
     */

    // ========================================================
    // START
    // ========================================================

    emitter.emitByte(0xE8);

    const std::size_t callDrawPatch =
        emitter.emitRel32Placeholder();


    // ========================================================
    // EVENT LOOP
    // ========================================================

    const std::size_t eventLoop =
        emitter.size();

    // mov eax, 10
    emitter.emitMovEaxImm32(10);

    // int 0x40
    emitter.emitInt(0x40);


    // ========================================================
    // EVENT 1 = REDRAW
    // ========================================================

    emitter.emitCmpEaxImm32(1);

    emitter.emitByte(0x0F);
    emitter.emitByte(0x84);

    const std::size_t redrawPatch =
        emitter.emitRel32Placeholder();


    // ========================================================
    // EVENT 2 = KEYBOARD
    // ========================================================

    emitter.emitCmpEaxImm32(2);

    emitter.emitByte(0x0F);
    emitter.emitByte(0x84);

    const std::size_t keyPatch =
        emitter.emitRel32Placeholder();


    // ========================================================
    // EVENT 3 = BUTTON
    // ========================================================

    emitter.emitCmpEaxImm32(3);

    emitter.emitByte(0x0F);
    emitter.emitByte(0x84);

    const std::size_t buttonPatch =
        emitter.emitRel32Placeholder();


    // ========================================================
    // DEFAULT -> EVENT LOOP
    // ========================================================

    emitter.emitByte(0xE9);

    const std::size_t loopPatch =
        emitter.emitRel32Placeholder();


    // ========================================================
    // REDRAW
    // ========================================================

    const std::size_t redraw =
        emitter.size();

    emitter.emitByte(0xE8);

    const std::size_t redrawCallPatch =
        emitter.emitRel32Placeholder();

    emitter.emitByte(0xE9);

    const std::size_t redrawLoopPatch =
        emitter.emitRel32Placeholder();


    // ========================================================
    // KEYBOARD
    // ========================================================

    const std::size_t key =
        emitter.size();

    // mov eax, 2
    emitter.emitMovEaxImm32(2);

    // int 0x40
    emitter.emitInt(0x40);

    // jmp EVENT_LOOP
    emitter.emitByte(0xE9);

    const std::size_t keyLoopPatch =
        emitter.emitRel32Placeholder();


    // ========================================================
    // BUTTON
    // ========================================================

    const std::size_t button =
        emitter.size();

    // mov eax, 17
    emitter.emitMovEaxImm32(17);

    // int 0x40
    emitter.emitInt(0x40);

    // cmp ah, 1
    emitter.emitCmpAhImm8(1);

    // jne EVENT_LOOP
    emitter.emitByte(0x0F);
    emitter.emitByte(0x85);

    const std::size_t buttonNotClosePatch =
        emitter.emitRel32Placeholder();


    // ========================================================
    // EXIT
    // ========================================================

    emitter.emitMovEaxImm32(-1);
    emitter.emitInt(0x40);


    // ========================================================
    // DRAW WINDOW
    // ========================================================

    const std::size_t drawWindow =
        emitter.size();


    // --------------------------------------------------------
    // Begin redraw
    // --------------------------------------------------------

    emitter.emitMovEaxImm32(12);

    // mov ebx, 1
    emitter.emitMovRegImm32(
        0xBB,
        1);

    emitter.emitInt(0x40);


    // --------------------------------------------------------
    // Create window
    // --------------------------------------------------------

    // mov eax, 0
    emitter.emitMovEaxImm32(0);

    // X=100 WIDTH=400
    emitter.emitMovRegImm32(
        0xBB,
        (100u << 16) + 400u);

    // Y=100 HEIGHT=180
    emitter.emitMovRegImm32(
        0xB9,
        (100u << 16) + 180u);

    // work area color
    emitter.emitMovRegImm32(
        0xBA,
        0x14FFFFFF);

    // title color
    emitter.emitMovRegImm32(
        0xBE,
        0x808899FF);

    // EDI = title
    emitter.emitByte(0xBF);

    const std::size_t titlePatch =
        emitter.emitImm32Placeholder();

    emitter.emitInt(0x40);


    // ========================================================
    // PRINTS
    // ========================================================

    std::vector<std::size_t> textPatches;

    for (std::size_t i = 0;
         i < printCount;
         ++i)
    {
        /*
         * Cada PRINT aparece en una línea diferente.
         *
         * PRINT 1 -> Y=40
         * PRINT 2 -> Y=70
         * PRINT 3 -> Y=100
         * PRINT 4 -> Y=130
         */

        const std::uint32_t y =
            40u +
            static_cast<std::uint32_t>(i * 30u);


        // mov eax, 4
        emitter.emitMovEaxImm32(4);


        // X=35 Y=n
        emitter.emitMovRegImm32(
            0xBB,
            (35u << 16) + y);


        // text color
        emitter.emitMovRegImm32(
            0xB9,
            0x80000000);


        // EDX = text
        emitter.emitByte(0xBA);

        const std::size_t textPatch =
            emitter.emitImm32Placeholder();

        textPatches.push_back(
            textPatch);


        // text size
        emitter.emitMovRegImm32(
            0xBE,
            40);


        // int 0x40
        emitter.emitInt(0x40);
    }


    // --------------------------------------------------------
    // End redraw
    // --------------------------------------------------------

    emitter.emitMovEaxImm32(12);

    // mov ebx, 2
    emitter.emitMovRegImm32(
        0xBB,
        2);

    emitter.emitInt(0x40);

    emitter.emitRet();


    // ========================================================
    // PATCH JUMPS
    // ========================================================

    emitter.patchRel32(
        callDrawPatch,
        drawWindow);

    emitter.patchRel32(
        redrawPatch,
        redraw);

    emitter.patchRel32(
        keyPatch,
        key);

    emitter.patchRel32(
        buttonPatch,
        button);

    emitter.patchRel32(
        loopPatch,
        eventLoop);

    emitter.patchRel32(
        redrawCallPatch,
        drawWindow);

    emitter.patchRel32(
        redrawLoopPatch,
        eventLoop);

    emitter.patchRel32(
        keyLoopPatch,
        eventLoop);

    emitter.patchRel32(
        buttonNotClosePatch,
        eventLoop);


    // ========================================================
    // RESULT
    // ========================================================

    KolibriRuntimeResult result;

    result.titleAddressPatch =
        titlePatch;

    result.textAddressPatches =
        std::move(textPatches);

    return result;
}


// ============================================================
// EXIT
// ============================================================

void KolibriRuntime::emitExit(
    X86Emitter& emitter)
{
    // mov eax, -1
    emitter.emitMovEaxImm32(-1);

    // int 0x40
    emitter.emitInt(0x40);
}

}
