// El parche relativo de la casa para los saltos
// internos de las rutinas transcritas: destino -
// (hueco + 4), parcheado en el acto.
void parche_rel(int pos, int destino)
{
    parche32(pos, destino - (pos + 4));
}


// emitRecordLine del runtime, transcrito entero: la
// linea de dibujo (largo) entra en EDX y la rutina
// la registra en el historial de la Konsole. Los
// huecos de direccion (primera visible, cuenta,
// cabeza, base del buffer de lineas) son del
// runtime: quedan a cero (costura).
void em_registra_linea(int largo)
{
    int bas;
    int p_noviva;
    int p_nollena;
    int copia;
    int p_copia;
    int p_guardar;
    int p_sigue;
    int p_viva;
    int p_fin;
    int p_hist;
    int p_histfin;
    int p_guarda;
    int fin;
    em_byte(49);
    em_byte(201);
    anota_lista(3, em_mov_eax_moffs_hueco());
    em_add_eax_imm(41);
    em_byte(59);
    em_byte(5);
    anota_lista(1, em_hueco());
    em_byte(15);
    em_byte(130);
    p_noviva = em_hueco();
    em_byte(131);
    em_byte(201);
    em_byte(1);
    parche_rel(p_noviva, bytebuffer_get_size(dcod));
    anota_lista(1, em_mov_eax_moffs_hueco());
    em_cmp_eax_imm32(512);
    em_byte(15);
    em_byte(133);
    p_nollena = em_hueco();
    em_byte(131);
    em_byte(201);
    em_byte(2);
    parche_rel(p_nollena, bytebuffer_get_size(dcod));
    em_byte(81);
    anota_lista(2, em_mov_eax_moffs_hueco());
    em_byte(193);
    em_byte(224);
    em_byte(6);
    em_byte(5);
    anota_lista(0, em_hueco());
    em_byte(137);
    em_byte(198);
    em_byte(199);
    em_byte(6);
    em_dword(largo);
    em_byte(137);
    em_byte(247);
    em_byte(131);
    em_byte(199);
    em_byte(4);
    em_mov_ecx_imm(40);
    copia = bytebuffer_get_size(dcod);
    em_byte(138);
    em_byte(2);
    em_byte(136);
    em_byte(7);
    em_byte(66);
    em_byte(71);
    em_byte(73);
    p_copia = em_jne_hueco();
    parche_rel(p_copia, copia);
    anota_lista(2, em_mov_eax_moffs_hueco());
    em_add_eax_imm(1);
    em_cmp_eax_imm32(512);
    em_byte(15);
    em_byte(130);
    p_guardar = em_hueco();
    em_mov_eax_imm(0);
    parche_rel(p_guardar, bytebuffer_get_size(dcod));
    anota_lista(2, em_mov_mem_eax_hueco());
    anota_lista(1, em_mov_eax_moffs_hueco());
    em_cmp_eax_imm32(512);
    em_byte(15);
    em_byte(131);
    p_sigue = em_hueco();
    em_add_eax_imm(1);
    anota_lista(1, em_mov_mem_eax_hueco());
    parche_rel(p_sigue, bytebuffer_get_size(dcod));
    em_byte(89);
    em_byte(247);
    em_byte(193);
    em_dword(1);
    em_byte(15);
    em_byte(133);
    p_viva = em_hueco();
    em_byte(247);
    em_byte(193);
    em_dword(2);
    em_byte(15);
    em_byte(132);
    p_fin = em_hueco();
    anota_lista(3, em_mov_eax_moffs_hueco());
    em_byte(131);
    em_byte(232);
    em_byte(1);
    em_byte(15);
    em_byte(137);
    p_hist = em_hueco();
    em_mov_eax_imm(0);
    parche_rel(p_hist, bytebuffer_get_size(dcod));
    anota_lista(3, em_mov_mem_eax_hueco());
    em_byte(233);
    p_histfin = em_hueco();
    parche_rel(p_viva, bytebuffer_get_size(dcod));
    anota_lista(1, em_mov_eax_moffs_hueco());
    em_add_eax_imm(0 - 41);
    em_byte(15);
    em_byte(141);
    p_guarda = em_hueco();
    em_mov_eax_imm(0);
    parche_rel(p_guarda, bytebuffer_get_size(dcod));
    anota_lista(3, em_mov_mem_eax_hueco());
    fin = bytebuffer_get_size(dcod);
    parche_rel(p_fin, fin);
    parche_rel(p_histfin, fin);
}


// Print desde EDX: registrar la linea de 40 y
// llamar al refresco del runtime (E8 con hueco,
// costura).
void em_print_desde_edx()
{
    int bas;
    em_registra_linea(40);
    em_byte(232);
    registra_ref(em_hueco());
}


// emitPrintInteger del runtime, transcrito entero:
// convierte EAX a texto hacia atras desde el fin
// del buffer de impresion entera y registra la
// linea de 16. Devuelve el hueco del MOV EDI
// inicial, que el cierre apunta al fin del buffer.
int em_print_integer_rt()
{
    int bas;
    int pos_buf;
    int p_signo;
    int p_cero;
    int conv;
    int p_conv;
    int p_fincero;
    int p_sinmenos;
    em_push_eax();
    em_push_ebx();
    pos_buf = bytebuffer_get_size(dcod) + 1;
    em_mov_edi_imm(0);
    em_byte(79);
    em_byte(198);
    em_byte(7);
    em_byte(0);
    em_byte(49);
    em_byte(219);
    em_byte(133);
    em_byte(192);
    em_byte(15);
    em_byte(137);
    p_signo = em_hueco();
    em_mov_ebx_imm(1);
    em_byte(247);
    em_byte(216);
    parche_rel(p_signo, bytebuffer_get_size(dcod));
    em_cmp_eax_imm32(0);
    p_cero = em_je_hueco();
    em_byte(49);
    em_byte(210);
    em_mov_ecx_imm(10);
    conv = bytebuffer_get_size(dcod);
    em_byte(49);
    em_byte(210);
    em_byte(247);
    em_byte(241);
    em_byte(128);
    em_byte(194);
    em_byte(48);
    em_byte(79);
    em_byte(136);
    em_byte(23);
    em_cmp_eax_imm32(0);
    p_conv = em_jne_hueco();
    p_fincero = em_jmp_hueco();
    parche_rel(p_cero, bytebuffer_get_size(dcod));
    em_byte(79);
    em_byte(198);
    em_byte(7);
    em_byte(48);
    parche_rel(p_conv, conv);
    parche_rel(p_fincero, bytebuffer_get_size(dcod));
    em_byte(131);
    em_byte(251);
    em_byte(0);
    p_sinmenos = em_je_hueco();
    em_byte(79);
    em_byte(198);
    em_byte(7);
    em_byte(45);
    parche_rel(p_sinmenos, bytebuffer_get_size(dcod));
    em_byte(137);
    em_byte(250);
    em_registra_linea(16);
    em_byte(232);
    registra_ref(em_hueco());
    em_pop_ebx();
    em_pop_eax();
    return pos_buf;
}


// El hueco del buffer de impresion entera.
void registra_dibuf(int pos)
{
    int r;
    r = da_add(dibuf_pos, pos);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    ndibuf = ndibuf + 1;
}


// FileWritePatch: funcion, arreglo, desplazamiento
// de la ruta en DATA, huecos y capacidad.
void registra_fw(int fun, int arr, int ruta, int phue, int ahue, int cap, int dhue)
{
    int r;
    r = da_add(dfw_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dfw_arr, arr);
    r = da_add(dfw_ruta, ruta);
    r = da_add(dfw_phue, phue);
    r = da_add(dfw_ahue, ahue);
    r = da_add(dfw_hue, dhue);
    r = da_add(dfw_cap, cap);
    nfw = nfw + 1;
}


// FileReadPatch: los mismos campos.
void registra_fr(int fun, int arr, int ruta, int phue, int ahue, int cap, int dhue)
{
    int r;
    r = da_add(dfr_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dfr_arr, arr);
    r = da_add(dfr_ruta, ruta);
    r = da_add(dfr_phue, phue);
    r = da_add(dfr_ahue, ahue);
    r = da_add(dfr_hue, dhue);
    r = da_add(dfr_cap, cap);
    nfr = nfr + 1;
}


// La ruta de un archivo se copia a DATA en el
// paseo (bytes y NUL) y su desplazamiento se
// devuelve.
int copia_ruta(int nom)
{
    int off;
    int j;
    off = bytebuffer_get_size(ddat);
    j = 0;
    while (j < texto_len(nom))
    {
        bytebuffer_append(ddat, texto_char(nom, j));
        j = j + 1;
    }
    bytebuffer_append(ddat, 0);
    return off;
}


void agrega_ceros(int n)
{
    int i;
    i = 0;
    while (i < n)
    {
        bytebuffer_append(ddat, 0);
        i = i + 1;
    }
}


// El bloque de textos del menu: 84 bytes en el
// orden del oraculo (EDIT, CORTAR, COPIAR,
// SELECCIONAR TODO, PEGAR, ELIMINAR, KONSOLE.TXT,
// FILE, OPEN, SAVE, CLOSE; cada palabra con su
// NUL, el ultimo incluido).
void agrega_menu_datos()
{
    int mb[84];
    int i;
    mb[0] = 69;
    mb[1] = 68;
    mb[2] = 73;
    mb[3] = 84;
    mb[4] = 0;
    mb[5] = 67;
    mb[6] = 79;
    mb[7] = 82;
    mb[8] = 84;
