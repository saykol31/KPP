// 1 si el nodo trae acceso a campo: el token que sigue
// al nombre en la tabla es un Dot (la misma senal que
// usa el recorrido del Parser).
int es_campo(int nodo)
{
    int nval[256];
    int tok_tipo[256];
    int nombre = nval[nodo];
    int siguiente = nombre + 1;
    int tt = tok_tipo[siguiente];
    if (tt == TokenType::Dot)
    {
        return 1;
    }
    return 0;
}


// El token del tipo declarado de una global, o -1.
int tipo_de_global(int tok)
{
    int nhijo1[256];
    int nsig[256];
    int nkind[256];
    int nval[256];
    int nini[256];
    int d = nhijo1[0];
    while (d != 0 - 1)
    {
        if (nkind[d] == NodeKind::VariableDeclaration)
        {
            int dn = nval[d];
            if (mismo_texto(dn, tok) == 1)
            {
                return nini[d];
            }
        }
        d = nsig[d];
    }
    return 0 - 1;
}


// El token del tipo de una variable: el ambito local
// manda (la sombra); si no, la global.
int tipo_de(int tok)
{
    int i = busca_local(tok);
    if (i != 0 - 1)
    {
        return da_get(dssim_tipo, i);
    }
    return tipo_de_global(tok);
}


// El tamano del arreglo: SOLO ambitos locales, como
// lookupArraySize de Stage 0. Una global devuelve 0.
int tamano_de(int tok)
{
    int i = busca_local(tok);
    if (i != 0 - 1)
    {
        return da_get(dssim_tam, i);
    }
    return 0;
}


// El nodo de la declaracion de una funcion, o -1.
int nodo_de_funcion(int tok)
{
    int nhijo1[256];
    int nsig[256];
    int nkind[256];
    int nval[256];
    int d = nhijo1[0];
    while (d != 0 - 1)
    {
        if (nkind[d] == NodeKind::FunctionDeclaration)
        {
            int dn = nval[d];
            if (mismo_texto(dn, tok) == 1)
            {
                return d;
            }
        }
        d = nsig[d];
    }
    return 0 - 1;
}


// ------------------------------------------------------------
// LA TABLA DE CAMPOS: filas planas (estructura, campo,
// codigo de tipo), llenada por registra_estructuras.
// La primera fila que coincide manda, como el mapa de
// Stage 0, que conserva la primera version de un campo.
// ------------------------------------------------------------

void agrega_campo(int estructura, int campo, int codigo)
{
    // Guarda de la arena (M-5): el primer da_add
    // hace de guarda — si devuelve -1, acusa el 50
    // de siempre y la fila no nace; si agrega,
    // agregan los otros dos y la cuenta avanza.
    int ri = da_add(dscampo_struct, estructura);
    if (ri == 0 - 1)
    {
        anota_error(50);
        return;
    }
    da_add(dscampo_tok, campo);
    da_add(dscampo_tipo, codigo);
    nscampo = nscampo + 1;
}


int busca_campo_fila(int estructura, int campo)
{
    int i = 0;
    for (i = 0; i < nscampo; i = i + 1)
    {
        int fs = da_get(dscampo_struct, i);
        int ms = mismo_texto(fs, estructura);
        if (ms == 1)
        {
            int fc = da_get(dscampo_tok, i);
            int mf = mismo_texto(fc, campo);
            if (mf == 1)
            {
                return 1;
            }
        }
    }
    return 0;
}


// El codigo TokenType del tipo de un campo, o -1 si
// el campo no esta en la tabla.
int codigo_de_campo(int estructura, int campo)
{
    int i = 0;
    for (i = 0; i < nscampo; i = i + 1)
    {
        int fs = da_get(dscampo_struct, i);
        int ms = mismo_texto(fs, estructura);
        if (ms == 1)
        {
            int fc = da_get(dscampo_tok, i);
            int mf = mismo_texto(fc, campo);
            if (mf == 1)
            {
                return da_get(dscampo_tipo, i);
            }
        }
    }
    return 0 - 1;
}


// El tipo de un campo en la representacion del
// catalogo: -4 int, -5 string, -1 si no se conoce.
int tipo_de_campo(int estructura, int campo)
{
    int c = codigo_de_campo(estructura, campo);
    if (c == TokenType::KwInt)
    {
        return 0 - TokenType::KwInt;
    }
    if (c == TokenType::KwString)
    {
        return 0 - TokenType::KwString;
    }
    return 0 - 1;
}


// La clase de un tipo: 1 int, 2 string, 3 con nombre.
int clase_tipo(int t)
{
    if (t == 0 - TokenType::KwInt)
    {
        return 1;
    }
    if (t == 0 - TokenType::KwString)
    {
        return 2;
    }
    if (es_int(t) == 1)
    {
        return 1;
    }
    if (es_string(t) == 1)
    {
        return 2;
    }
    return 3;
}


int tipos_iguales(int a, int b)
{
    int ca = clase_tipo(a);
    int cb = clase_tipo(b);
    if (ca != cb)
    {
        return 0;
    }
    if (ca == 3)
    {
        return mismo_texto(a, b);
    }
    return 1;
}


// 1 si un tipo inferido vale int: el -4 sintetico o un
// token cuyo texto es int. Otro negativo nunca vale.
int es_tipo_int_inferido(int it)
{
    if (it == 0 - TokenType::KwInt)
    {
        return 1;
    }
    if (it < 0)
    {
        return 0;
    }
    return es_int(it);
}


// ------------------------------------------------------------
// INFERIR TIPO (inferExpressionType de Stage 0).
// ------------------------------------------------------------

int inferir_tipo(int n)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    if (n == 0 - 1)
    {
        return 0 - 1;
    }
    if (nkind[n] == NodeKind::IntegerLiteral)
    {
        return 0 - TokenType::KwInt;
    }
    if (nkind[n] == NodeKind::StringLiteral)
    {
        return 0 - TokenType::KwString;
    }
    if (nkind[n] == NodeKind::VariableExpression)
    {
        int base = nval[n];
        int tt = tipo_de(base);
        if (tt == 0 - 1)
        {
            return 0 - 1;
        }
        if (es_campo(n) == 0)
        {
            return tt;
        }
        int campo = nhijo1[n];
        return tipo_de_campo(tt, campo);
    }
    if (nkind[n] == NodeKind::ArrayAccessExpression)
    {
        int base = nval[n];
        int tt = tipo_de(base);
        if (tt == 0 - 1)
        {
            return 0 - 1;
        }
        if (es_int(tt) == 0)
        {
            return 0 - 1;
        }
        int idx = nhijo1[n];
        if (idx == 0 - 1)
        {
            return 0 - 1;
        }
        int it = inferir_tipo(idx);
        if (es_tipo_int_inferido(it) == 0)
        {
            return 0 - 1;
        }
        return 0 - TokenType::KwInt;
    }
    if (nkind[n] == NodeKind::CallExpression)
    {
        int cal = nval[n];
        if (es_file_read(cal) == 1)
        {
            return 0 - TokenType::KwInt;
        }
        if (es_file_write(cal) == 1)
        {
            return 0 - TokenType::KwInt;
        }
        int fd = nodo_de_funcion(cal);
        if (fd == 0 - 1)
        {
            return 0 - 1;
        }
        int nini[256];
        return nini[fd];
    }
    if (nkind[n] == NodeKind::BinaryExpression)
    {
        int izq = nhijo1[n];
        if (izq == 0 - 1)
        {
            return 0 - 1;
        }
        int der = nsig[izq];
        if (der == 0 - 1)
        {
            return 0 - 1;
        }
        int lt = inferir_tipo(izq);
        int rt = inferir_tipo(der);
        if (lt == 0 - 1)
        {
            return 0 - 1;
        }
        if (rt == 0 - 1)
        {
            return 0 - 1;
        }
        int li = es_tipo_int_inferido(lt);
        int ri = es_tipo_int_inferido(rt);
        if (li == 1)
        {
            if (ri == 1)
            {
                return 0 - TokenType::KwInt;
            }
        }
        return 0 - 2;
    }
    return 0 - 1;
}


// ------------------------------------------------------------
// ANALIZA EXPRESION (analyzeExpression de Stage 0).
// ------------------------------------------------------------

void analiza_expresion(int n)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int nsize[256];
    if (n == 0 - 1)
    {
        return;
    }
    if (nkind[n] == NodeKind::IntegerLiteral)
    {
        return;
    }
    if (nkind[n] == NodeKind::StringLiteral)
    {
        return;
    }
    if (nkind[n] == NodeKind::VariableExpression)
    {
        int base = nval[n];
        int tt = tipo_de(base);
        if (tt == 0 - 1)
        {
            anota_error(27);
            return;
        }
        if (es_campo(n) == 1)
        {
            if (busca_struct(tt) == 0)
            {
                anota_error(28);
                return;
            }
            int campotok = nhijo1[n];
            int fc = codigo_de_campo(tt, campotok);
            if (fc == 0 - 1)
            {
                anota_error(29);
                return;
            }
            if (fc != TokenType::KwInt)
            {
                if (fc != TokenType::KwString)
                {
                    anota_error(30);
                    return;
                }
            }
            return;
        }
        if (es_int(tt) == 0)
        {
            if (es_string(tt) == 0)
            {
                anota_error(30);
                return;
            }
        }
        return;
    }
    if (nkind[n] == NodeKind::ArrayAccessExpression)
    {
        int base = nval[n];
        int tt = tipo_de(base);
        if (tt == 0 - 1)
        {
            anota_error(31);
            return;
        }
        int tam = tamano_de(base);
        if (tam <= 0)
        {
            anota_error(23);
            return;
        }
        if (es_int(tt) == 0)
        {
            anota_error(25);
            return;
        }
        int idx = nhijo1[n];
        if (idx == 0 - 1)
        {
            anota_error(32);
            return;
        }
        if (nkind[idx] == NodeKind::IntegerLiteral)
        {
            int lv = nval[idx];
            if (lv < 0)
            {
                anota_error(24);
                return;
            }
            if (lv >= tam)
            {
                anota_error(24);
                return;
            }
        }
        analiza_expresion(idx);
        int itx = inferir_tipo(idx);
        if (es_tipo_int_inferido(itx) == 0)
        {
            anota_error(26);
            return;
        }
        return;
    }
    if (nkind[n] == NodeKind::CallExpression)
    {
        int cal = nval[n];
        // La bandera de sentencia se consume al
        // entrar: vale para ESTA llamada y no para
        // las que cuelguen de sus argumentos, que
        // ya son contexto de valor.
        int en_sent = llamada_en_sentencia;
        llamada_en_sentencia = 0;
        int a1 = nhijo1[n];
        int nargs = 0;
        int x = a1;
        while (x != 0 - 1)
        {
            nargs = nargs + 1;
            x = nsig[x];
        }
        int a2 = 0 - 1;
        int a3 = 0 - 1;
        if (a1 != 0 - 1)
        {
            a2 = nsig[a1];
            if (a2 != 0 - 1)
            {
                a3 = nsig[a2];
            }
        }
        if (es_file_read(cal) == 1)
        {
            if (nargs != 2)
            {
                anota_error(40);
                return;
            }
            if (nkind[a1] != NodeKind::StringLiteral)
            {
                anota_error(41);
                return;
            }
            if (nkind[a2] != NodeKind::VariableExpression)
            {
                anota_error(42);
                return;
            }
            int anombre = nval[a2];
            int atipo = tipo_de(anombre);
            if (atipo == 0 - 1)
            {
                anota_error(43);
                return;
            }
            if (es_int(atipo) == 0)
            {
                anota_error(44);
                return;
            }
            int cap = tamano_de(anombre);
            if (cap <= 0)
            {
                anota_error(45);
                return;
            }
            return;
        }
        if (es_file_write(cal) == 1)
        {
            if (nargs != 3)
            {
                anota_error(46);
                return;
            }
            if (nkind[a1] != NodeKind::StringLiteral)
            {
                anota_error(41);
                return;
            }
            if (nkind[a2] != NodeKind::VariableExpression)
            {
                anota_error(42);
                return;
            }
            int anombre = nval[a2];
            int atipo = tipo_de(anombre);
            if (atipo == 0 - 1)
            {
                anota_error(43);
                return;
            }
            if (es_int(atipo) == 0)
            {
                anota_error(44);
                return;
            }
            int cap = tamano_de(anombre);
            if (cap <= 0)
            {
                anota_error(45);
                return;
            }
            analiza_expresion(a3);
            int itc = inferir_tipo(a3);
            if (es_tipo_int_inferido(itc) == 0)
            {
                anota_error(47);
                return;
            }
            if (nkind[a3] == NodeKind::IntegerLiteral)
            {
                int cv = nval[a3];
                if (cv < 0)
                {
                    anota_error(48);
                    return;
                }
                if (cv > cap)
                {
                    anota_error(49);
                    return;
                }
            }
            return;
        }
        if (busca_funcion(cal) == 0)
        {
            anota_error(33);
            return;
        }
        int fd = nodo_de_funcion(cal);
        if (en_sent == 0)
        {
            int nini[256];
            if (es_void(nini[fd]) == 1)
            {
                anota_error(54);
                return;
            }
        }
        if (nargs != nsize[fd])
        {
            anota_error(34);
            return;
        }
        int arg = a1;
        while (arg != 0 - 1)
        {
            analiza_expresion(arg);
            arg = nsig[arg];
        }
        return;
    }
    if (nkind[n] == NodeKind::BinaryExpression)
    {
        int izq = nhijo1[n];
        if (izq == 0 - 1)
        {
            anota_error(35);
            anota_error(36);
            return;
        }
        analiza_expresion(izq);
        int der = nsig[izq];
        if (der == 0 - 1)
        {
            anota_error(36);
        }
        else
        {
            analiza_expresion(der);
        }
        int op = nval[n];
        if (op < 14)
        {
            anota_error(37);
            return;
        }
        if (op > 28)
        {
            // El segundo tramo valido (Ampliacion 4):
            // los operadores de bits, 42 a 45. Fuera
            // de los dos tramos el operador no existe.
            if (op < 42)
            {
                anota_error(37);
                return;
            }
            if (op > 45)
            {
                anota_error(37);
                return;
            }
        }
        return;
    }
}


// ============================================================
// INICIA EL GENERADOR.
//
// El papel del driver en miniatura, como en las demas
// piezas migradas: inicia la biblioteca y hace nacer
// las regiones en el orden del plan de solape —
// Source sobre el bloque A (1024) y Frontend sobre el
// bloque B (1024), que esta pieza no usa (su fuente,
// sus tokens y sus nodos son las copias selladas de
// las filas del Lexer y del Parser, migradas en sus
// piezas en M-3 y M-4), y Compiler sobre el bloque C
// con la reserva entera del bloque (131072), donde
// viven el IR, el registro de ambitos y la piscina.
// Backend y Output nacen en sus fases, en las piezas
// que las gobiernan. No imprime nada: la corriente de
// la sonda queda intacta.
// ============================================================

void inicia_irgen()
{
    inicia_arena();
    region_source = arena_create(1024);
    region_frontend = arena_create(1024);
    region_compiler = arena_create(131072);
}


// ============================================================
// CREA LAS ESTRUCTURAS.
//
// Los seis DynamicArray del IR nacen a 2048 — la
// vieja guarda de emite_ir como capacidad de
// nacimiento — y los cinco del registro de ambitos a
// 256, la vieja guarda de registra_var. La piscina
// nace la ultima, con el literal de la biblioteca
// (4 celdas): es la estructura que mas crece, y
// naciendo la ultima sus crecimientos se extienden en
// el sitio. Los crea genera_ir() al arrancar cada
// programa, y los movimientos de la sonda en los
// suyos.
// ============================================================

void crea_ir()
{
    diop = da_create(region_compiler, 2048);
    dinombre = da_create(region_compiler, 2048);
    dioperando = da_create(region_compiler, 2048);
    diresultado = da_create(region_compiler, 2048);
    diaux = da_create(region_compiler, 2048);
    divalor = da_create(region_compiler, 2048);
    dvscope_tok = da_create(region_compiler, 256);
    dvscope_campo = da_create(region_compiler, 256);
    dvscope_ref = da_create(region_compiler, 256);
    dvscope_tam = da_create(region_compiler, 256);
    dvscope_nivel = da_create(region_compiler, 256);
    dpiscina = string_pool_create(region_compiler);
}


// ============================================================
// LA PISCINA DE TEXTO.
// ============================================================

int agrega_car(int c)
{
    int r = string_pool_add_char(dpiscina, c);
    if (r < 0)
    {
        errores_ir = errores_ir + 1;
    }
    else
    {
        pool_len = pool_len + 1;
    }
    return 0;
}


int agrega_token(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int ini = tok_inicio[tok];
    int n = tok_largo[tok];
    int i = 0;
    for (i = 0; i < n; i = i + 1)
    {
        int c = fuente[ini + i];
        int a = agrega_car(c);
    }
    return 0;
}


int agrega_tramo(int ini, int largo)
{
    int i = 0;
    for (i = 0; i < largo; i = i + 1)
    {
        int c = string_pool_get_char(dpiscina, ini, i);
        int a = agrega_car(c);
    }
    return 0;
}


int agrega_numero(int n)
{
    if (n >= 10)
    {
        int a = agrega_numero(n / 10);
    }
    int d = n - (n / 10) * 10;
    int b = agrega_car(48 + d);
    return 0;
}


int empaqueta_ref(int ini)
{
    int largo = pool_len - ini;
    if (largo >= 128)
    {
        errores_ir = errores_ir + 1;
        return 0;
    }
    return ini * 128 + largo;
}


int ref_token(int tok)
{
    int tok_largo[256];
    int largo_tok = tok_largo[tok];
    if (largo_tok >= 128)
    {
        errores_ir = errores_ir + 1;
        return 0;
    }
    int ini = pool_len;
    int a = agrega_token(tok);
    int r = empaqueta_ref(ini);
    return r;
}


int ref_temp()
{
    int ini = pool_len;
    int a = agrega_car(37);
    int b = agrega_numero(ntemp);
    ntemp = ntemp + 1;
    int r = empaqueta_ref(ini);
    return r;
}


// ============================================================
// EMITIR UNA INSTRUCCION.
// ============================================================

int emite_ir(int op, int nombre, int operando, int resultado, int aux, int valor)
{
    if (da_add(diop, op) < 0)
    {
        errores_ir = errores_ir + 1;
        return 0;
    }
    int a = da_add(dinombre, nombre);
    int b = da_add(dioperando, operando);
    int c = da_add(diresultado, resultado);
    int d = da_add(diaux, aux);
    int e = da_add(divalor, valor);
    nir = nir + 1;
    return 0;
}


void sale_ambito_gen()
{
    while (1)
    {
        if (nvar == 0)
        {
            break;
        }
        int u = da_get(dvscope_nivel, nvar - 1);
        if (u != nivel)
        {
            break;
        }
        nvar = nvar - 1;
    }
    nivel = nivel - 1;
}


void registra_var(int tok, int campo, int ref, int tam)
{
    if (nvar < da_count(dvscope_tok))
    {
        da_set(dvscope_tok, nvar, tok);
        da_set(dvscope_campo, nvar, campo);
        da_set(dvscope_ref, nvar, ref);
        da_set(dvscope_tam, nvar, tam);
        da_set(dvscope_nivel, nvar, nivel);
        nvar = nvar + 1;
        return;
    }
    if (da_add(dvscope_tok, tok) < 0)
    {
        errores_ir = errores_ir + 1;
        return;
    }
    int a = da_add(dvscope_campo, campo);
    int b = da_add(dvscope_ref, ref);
    int c = da_add(dvscope_tam, tam);
    int d = da_add(dvscope_nivel, nivel);
    nvar = nvar + 1;
}


int busca_var_gen(int tok, int campo)
{
    int i = nvar - 1;
    for (i = nvar - 1; i >= 0; i = i - 1)
    {
        int t = da_get(dvscope_tok, i);
        if (mismo_texto(t, tok) == 1)
        {
            int c = da_get(dvscope_campo, i);
            if (c == campo)
            {
                return i;
            }
            if (c >= 0)
            {
                if (campo >= 0)
                {
                    if (mismo_texto(c, campo) == 1)
                    {
                        return i;
                    }
                }
            }
        }
    }
    return -1;
}


int resuelve(int tok)
{
    int f = busca_var_gen(tok, -1);
    if (f >= 0)
    {
        int r = da_get(dvscope_ref, f);
        return r;
    }
    return ref_token(tok);
}


// ============================================================
// LA DECLARACION DE STRUCT DE UN TIPO, o -1.
// ============================================================

int struct_de(int tipo)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int d = nhijo1[0];
    while (d >= 0)
    {
        int k = nkind[d];
        if (k == NodeKind::StructDeclaration)
        {
            int nt = nval[d];
            if (mismo_texto(nt, tipo) == 1)
            {
                return d;
            }
        }
        d = nsig[d];
    }
    return -1;
}


// ============================================================
// AYUDANTES DE LAS EXPRESIONES (IR-3).
// ============================================================

int agrega_ref(int ref)
{
    int ini = ref / 128;
    int largo = ref - ini * 128;
    int a = agrega_tramo(ini, largo);
    return 0;
}


int une_refs(int a, int b)
{
    int ini = pool_len;
    int x = agrega_ref(a);
    int c1 = agrega_car(44);
    int c2 = agrega_car(32);
    int y = agrega_ref(b);
    int r = empaqueta_ref(ini);
    return r;
}


int op_binaria(int op)
{
    if (op == 14)
    {
        return IROpcode::Add;
    }
    if (op == 15)
    {
        return IROpcode::Sub;
    }
    if (op == 16)
    {
        return IROpcode::Mul;
    }
    if (op == 17)
    {
        return IROpcode::Div;
    }
    if (op == 18)
    {
        return IROpcode::Mod;
    }
    if (op == 19)
    {
        return IROpcode::Pow;
    }
    if (op == 20)
    {
        return IROpcode::CompareEqual;
    }
    if (op == 21)
    {
        return IROpcode::CompareNotEqual;
    }
    if (op == 22)
    {
        return IROpcode::CompareLess;
    }
    if (op == 23)
    {
        return IROpcode::CompareLessEqual;
    }
    if (op == 24)
    {
        return IROpcode::CompareGreater;
    }
    if (op == 25)
    {
        return IROpcode::CompareGreaterEqual;
    }
    if (op == 26)
    {
        return IROpcode::LogicalAnd;
    }
    if (op == 27)
    {
        return IROpcode::LogicalOr;
    }
    if (op == 28)
    {
        return IROpcode::LogicalNot;
    }
    if (op == 42)
    {
        return IROpcode::BitwiseAnd;
    }
    if (op == 43)
    {
        return IROpcode::BitwiseOr;
    }
    if (op == 44)
    {
        return IROpcode::ShiftLeft;
    }
    if (op == 45)
    {
        return IROpcode::ShiftRight;
    }
    return -1;
}


int capacidad_de(int tok)
{
    int f = busca_var_gen(tok, -1);
    if (f >= 0)
    {
        int t = da_get(dvscope_tam, f);
        return t;
    }
    return 0;
}


// ============================================================
// GENERAR EXPRESION (completa, IR-3).
// ============================================================
//
// Devuelve la referencia al temporal que guarda el
// valor de la expresion.

int genera_expresion(int e)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int k = nkind[e];
    if (k == NodeKind::IntegerLiteral)
    {
        int t = ref_temp();
        int v = nval[e];
        int em = emite_ir(IROpcode::Const, 0, 0, t, 0, v);
        return t;
    }
    if (k == NodeKind::StringLiteral)
    {
        int t2 = ref_temp();
        int nt = nval[e];
        int nombre = ref_token(nt);
        int em2 = emite_ir(IROpcode::StringConst, nombre, 0, t2, 0, 0);
        return t2;
    }
    if (k == NodeKind::VariableExpression)
    {
        int h = nhijo1[e];
        int t3 = ref_temp();
        int nt3 = nval[e];
        if (h >= 0)
        {
            int nom3 = resuelve_campo(nt3, h);
            int em3 = emite_ir(IROpcode::Load, nom3, 0, t3, 0, 0);
            return t3;
        }
        int nom4 = resuelve(nt3);
        int em4 = emite_ir(IROpcode::Load, nom4, 0, t3, 0, 0);
        return t3;
    }
    if (k == NodeKind::ArrayAccessExpression)
    {
        int hi = nhijo1[e];
        int ti = genera_expresion(hi);
        int t4 = ref_temp();
        int nt4 = nval[e];
        int nom5 = resuelve(nt4);
        int em5 = emite_ir(IROpcode::ArrayLoad, nom5, ti, t4, 0, 0);
        return t4;
    }
    if (k == NodeKind::BinaryExpression)
    {
        int izq = nhijo1[e];
        int der = nsig[izq];
        int ti2 = genera_expresion(izq);
        int td = genera_expresion(der);
        int t5 = ref_temp();
        int op = nval[e];
        int iop2 = op_binaria(op);
        if (iop2 < 0)
        {
            errores_ir = errores_ir + 1;
        }
        if (iop2 == IROpcode::LogicalNot)
        {
            int em6 = emite_ir(iop2, 0, td, t5, 0, 0);
            return t5;
        }
        int par = une_refs(ti2, td);
        int em7 = emite_ir(iop2, 0, par, t5, 0, 0);
        return t5;
    }
    if (k == NodeKind::CallExpression)
    {
        int ct = nval[e];
        int a1 = nhijo1[e];
        if (es_file_read(ct) == 1)
        {
            int a2 = nsig[a1];
            int t6 = ref_temp();
            int ruta1 = nval[a1];
            int nom6 = ref_token(ruta1);
            int arr1 = nval[a2];
            int ident1 = resuelve(arr1);
            int cap1 = capacidad_de(arr1);
            if (cap1 == 0)
            {
                errores_ir = errores_ir + 1;
            }
            int em8 = emite_ir(IROpcode::FileRead, nom6, ident1, t6, 0, cap1);
            return t6;
        }
        if (es_file_write(ct) == 1)
        {
            int a2w = nsig[a1];
            int a3w = nsig[a2w];
            int tc = genera_expresion(a3w);
            int t7 = ref_temp();
            int ruta2 = nval[a1];
            int nom7 = ref_token(ruta2);
            int arr2 = nval[a2w];
            int ident2 = resuelve(arr2);
            int cap2 = capacidad_de(arr2);
            if (cap2 == 0)
            {
                errores_ir = errores_ir + 1;
            }
            int em9 = emite_ir(IROpcode::FileWrite, nom7, ident2, t7, tc, cap2);
            return t7;
        }
        int temps[256];
        int base = temps_tope;
        int narg = 0;
        int arg = a1;
        while (arg >= 0)
        {
            int ta = genera_expresion(arg);
            if (narg < 32)
            {
                int hueco = base + narg;
                if (hueco < 256)
                {
                    temps[hueco] = ta;
                    narg = narg + 1;
                    temps_tope = base + narg;
                }
            }
            else
            {
                errores_ir = errores_ir + 1;
            }
            arg = nsig[arg];
        }
        int unidos = 0;
        if (narg > 0)
        {
            int ini_u = pool_len;
            int j = 0;
            for (j = 0; j < narg; j = j + 1)
            {
                if (j > 0)
                {
                    int c1 = agrega_car(44);
                    int c2 = agrega_car(32);
                }
                int tj = temps[base + j];
                int aj = agrega_ref(tj);
            }
            unidos = empaqueta_ref(ini_u);
        }
        temps_tope = base;
        int t8 = ref_temp();
        int nom8 = ref_token(ct);
        int em10 = emite_ir(IROpcode::Call, nom8, unidos, t8, 0, 0);
        return t8;
    }
    return 0;
}


int ref_etiqueta()
{
    int ini = pool_len;
    int a = agrega_car(76);
    int b = agrega_numero(netiq);
    netiq = netiq + 1;
    int r = empaqueta_ref(ini);
    return r;
}


// ============================================================
// ES CAMPO — la lectura doble de hijo1 en la
// asignacion: si el token que sigue al nombre del
// destino es Dot (38), hijo1 es el token del campo;
// si es LBracket, hijo1 es el nodo del indice.
// ============================================================

int es_campo_gen(int s)
{
    int nini[256];
    int tok_tipo[256];
    int ini = nini[s];
    int t = tok_tipo[ini + 1];
    if (t == 38)
    {
        return 1;
    }
    return 0;
}


// ============================================================
// RESOLVER UN CAMPO — el nombre aplanado registrado
// (base, campo); si no esta (una global de struct,
// que no se aplana), se compone el texto nombre.
// campo en la piscina, como hace Stage 0 al caer
// en el nombre original.
// ============================================================

int resuelve_campo(int tok, int campo)
{
    int f = busca_var_gen(tok, campo);
    if (f >= 0)
    {
        int r = da_get(dvscope_ref, f);
        return r;
    }
    int ini = pool_len;
    int a = agrega_token(tok);
    int b = agrega_car(46);
    int c = agrega_token(campo);
    int r = empaqueta_ref(ini);
    return r;
}


// ============================================================
// GENERAR UN BLOQUE con su ambito: lo usan la
// sentencia Block y los bloques de if/while.
// ============================================================

void genera_bloque(int b)
{
    int nhijo1[256];
    int nsig[256];
    entra_ambito();
    int s = nhijo1[b];
    while (s >= 0)
    {
        genera_sentencia(s);
        s = nsig[s];
    }
    sale_ambito_gen();
}


// ============================================================
// GENERAR SENTENCIA (cobertura IR-1 e IR-2).
// ============================================================

void genera_sentencia(int s)
{
    int nkind[256];
    int nini[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int naux[256];
    int nsize[256];
    int campotok[256];
    int fin_pila[256];
    int k = nkind[s];
    if (k == NodeKind::VariableDeclaration)
    {
        int nt = nval[s];
        int ini_m = pool_len;
        int a1 = agrega_token(nt);
        int a2 = agrega_car(64);
        int a3 = agrega_numero(contvar);
        int mangled = empaqueta_ref(ini_m);
        int largo_m = pool_len - ini_m;
        contvar = contvar + 1;
        int tam = nsize[s];
        registra_var(nt, -1, mangled, tam);
        int e1 = emite_ir(IROpcode::Declare, mangled, 0, 0, 0, tam);
        int tipo = nini[s];
        int est = struct_de(tipo);
        if (est >= 0)
        {
            int ci = naux[est];
            int cc = nsize[est];
            int j = 0;
            for (j = 0; j < cc; j = j + 1)
            {
                int ct = campotok[ci + j];
                int ini_f = pool_len;
                int b1 = agrega_tramo(ini_m, largo_m);
                int b2 = agrega_car(46);
                int b3 = agrega_token(ct);
                int fmang = empaqueta_ref(ini_f);
                registra_var(nt, ct, fmang, 0);
                int e2 = emite_ir(IROpcode::Declare, fmang, 0, 0, 0, 0);
            }
        }
        int ini = nhijo1[s];
        if (ini >= 0)
        {
            int ki = nkind[ini];
            if (ki == NodeKind::IntegerLiteral)
            {
                int t = ref_temp();
                int v = nval[ini];
                int e3 = emite_ir(IROpcode::Const, 0, 0, t, 0, v);
                int e4 = emite_ir(IROpcode::Store, mangled, t, 0, 0, 0);
                return;
            }
            int t2 = genera_expresion(ini);
            int e5 = emite_ir(IROpcode::Store, mangled, t2, 0, 0, 0);
            return;
        }
        return;
    }
    if (k == NodeKind::AssignmentStatement)
    {
        int valor = naux[s];
        int h = nhijo1[s];
        int nt2 = nval[s];
        if (h >= 0)
        {
            if (es_campo_gen(s) == 1)
            {
                int tv = genera_expresion(valor);
                int dest = resuelve_campo(nt2, h);
                int e6 = emite_ir(IROpcode::Store, dest, tv, 0, 0, 0);
                return;
            }
            int ti = genera_expresion(h);
            int tv2 = genera_expresion(valor);
            int arr = resuelve(nt2);
            int e7 = emite_ir(IROpcode::ArrayStore, arr, ti, tv2, 0, 0);
            return;
        }
        int tv3 = genera_expresion(valor);
        int dest2 = resuelve(nt2);
        int e8 = emite_ir(IROpcode::Store, dest2, tv3, 0, 0, 0);
        return;
    }
    if (k == NodeKind::Block)
    {
        genera_bloque(s);
        return;
    }
    if (k == NodeKind::IfStatement)
    {
        int cond = nhijo1[s];
        int tc = genera_expresion(cond);
        int fin = ref_etiqueta();
        int els = ref_etiqueta();
        int entonces = nsig[cond];
        int sino = -1;
        if (entonces >= 0)
        {
            sino = nsig[entonces];
        }
        int destino = fin;
        if (sino >= 0)
        {
            destino = els;
        }
        int e9 = emite_ir(IROpcode::JumpIfZero, destino, tc, 0, 0, 0);
        if (entonces >= 0)
        {
            genera_bloque(entonces);
        }
        if (sino >= 0)
        {
            int e10 = emite_ir(IROpcode::Jump, fin, 0, 0, 0, 0);
            int e11 = emite_ir(IROpcode::Label, els, 0, 0, 0, 0);
            genera_bloque(sino);
        }
        int e12 = emite_ir(IROpcode::Label, fin, 0, 0, 0, 0);
        return;
    }
    if (k == NodeKind::WhileStatement)
    {
        int ini_e = ref_etiqueta();
        int fin_e = ref_etiqueta();
        int e13 = emite_ir(IROpcode::Label, ini_e, 0, 0, 0, 0);
        int cond2 = nhijo1[s];
        int tc2 = genera_expresion(cond2);
        int e14 = emite_ir(IROpcode::JumpIfZero, fin_e, tc2, 0, 0, 0);
        int cuerpo = nsig[cond2];
        if (cuerpo >= 0)
        {
            fin_pila[fin_tope] = fin_e;
            fin_tope = fin_tope + 1;
            genera_bloque(cuerpo);
            fin_tope = fin_tope - 1;
        }
        int e15 = emite_ir(IROpcode::Jump, ini_e, 0, 0, 0, 0);
        int e16 = emite_ir(IROpcode::Label, fin_e, 0, 0, 0, 0);
        return;
    }
    if (k == NodeKind::ForStatement)
    {
        // El for (Ampliacion 3): los hijos cuelgan en
        // cadena — el inicio (si lo hay), la condicion
        // (siempre: el Parser siembra el literal 1 si
        // venia vacia), el paso (si lo hay) y el
        // cuerpo. El inicio se genera una vez, antes de
        // la etiqueta de la condicion; el salto en
        // falso cae en la etiqueta de fin, que la pila
        // guarda durante el cuerpo (el break cae ahi);
        // el paso se genera tras el cuerpo y el salto
        // de vuelta cierra el ciclo. La forma de saltos
        // es la del while, con el inicio delante y el
        // paso detras.
        int pf = nhijo1[s];
        int iniciog = 0 - 1;
        if (nkind[pf] == NodeKind::VariableDeclaration)
        {
            iniciog = pf;
            pf = nsig[pf];
        }
        else
        {
            if (nkind[pf] == NodeKind::AssignmentStatement)
            {
                iniciog = pf;
                pf = nsig[pf];
            }
        }
        int condf = pf;
        pf = nsig[pf];
        int pasof = 0 - 1;
        int cuerpof = pf;
        if (nkind[pf] == NodeKind::AssignmentStatement)
        {
            pasof = pf;
            cuerpof = nsig[pf];
        }
        if (iniciog >= 0)
        {
            genera_sentencia(iniciog);
        }
        int in_e = ref_etiqueta();
        int fn_e = ref_etiqueta();
        int e23 = emite_ir(IROpcode::Label, in_e, 0, 0, 0, 0);
        int tcf = genera_expresion(condf);
        int e24 = emite_ir(IROpcode::JumpIfZero, fn_e, tcf, 0, 0, 0);
        if (cuerpof >= 0)
        {
            fin_pila[fin_tope] = fn_e;
            fin_tope = fin_tope + 1;
            genera_bloque(cuerpof);
            fin_tope = fin_tope - 1;
        }
        if (pasof >= 0)
        {
            genera_sentencia(pasof);
        }
        int e25 = emite_ir(IROpcode::Jump, in_e, 0, 0, 0, 0);
        int e26 = emite_ir(IROpcode::Label, fn_e, 0, 0, 0, 0);
        return;
    }
    if (k == NodeKind::BreakStatement)
    {
        // El break (Ampliacion 2): salta a la etiqueta
        // de fin del while mas interno, la de la cima
        // de la pila que mantiene la rama de while.
        int destino = fin_pila[fin_tope - 1];
        int eb = emite_ir(IROpcode::Jump, destino, 0, 0, 0, 0);
        return;
    }
    if (k == NodeKind::PrintStatement)
    {
        int ep = nhijo1[s];
        int tp = genera_expresion(ep);
        int e17 = emite_ir(IROpcode::Print, 0, tp, 0, 0, 0);
        return;
    }
    if (k == NodeKind::PrintIntegerStatement)
    {
        int ei = nhijo1[s];
        int ti2 = genera_expresion(ei);
        int e18 = emite_ir(IROpcode::PrintInteger, 0, ti2, 0, 0, 0);
        return;
    }
    if (k == NodeKind::ReturnStatement)
    {
        int e = nhijo1[s];
        if (e < 0)
        {
            // Sin expresion: en una funcion void es
            // el return; de la Ampliacion 1 y SI se
            // emite, como Return de valor 0 (el mismo
            // que emite el Stage 0). En una int el
            // analizador ya lo acuso (codigo 13) y
            // aqui no se emite.
            if (fun_es_void == 1)
            {
                int e0 = emite_ir(IROpcode::Return, 0, 0, 0, 0, 0);
            }
            return;
        }
        int ke = nkind[e];
        if (ke == NodeKind::IntegerLiteral)
        {
            int v = nval[e];
            int e19 = emite_ir(IROpcode::Return, 0, 0, 0, 0, v);
            return;
        }
        int t = genera_expresion(e);
        int e20 = emite_ir(IROpcode::Return, 0, t, 0, 0, 0);
        return;
    }
    if (k == NodeKind::CallStatement)
    {
        // La llamada como sentencia (Ampliacion 1):
        // la llamada se genera y su temporal queda
        // sin leer — descartado, como en el Stage 0.
        int tc = genera_expresion(nhijo1[s]);
        return;
    }
}


// ============================================================
// GENERAR FUNCION.
// ============================================================

void genera_funcion(int f)
{
    int nini[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int naux[256];
    int nsize[256];
    int partok[256];
    ntemp = 0;
    contvar = 0;
    netiq = 0;
    fun_es_void = es_void(nini[f]);
    fin_tope = 0;
    temps_tope = 0;
    entra_ambito();
    int nt = nval[f];
    int nombre = ref_token(nt);
    int params = 0;
    int inicio = naux[f];
    int cant = nsize[f];
    if (cant > 0)
    {
        int ini_p = pool_len;
        int j = 0;
        for (j = 0; j < cant; j = j + 1)
        {
            if (j > 0)
            {
                int c1 = agrega_car(44);
                int c2 = agrega_car(32);
            }
            int pt = partok[inicio + j];
            int a = agrega_token(pt);
        }
        params = empaqueta_ref(ini_p);
    }
    int e1 = emite_ir(IROpcode::FunctionBegin, nombre, params, 0, 0, 0);
    int cuerpo = nhijo1[f];
    if (cuerpo >= 0)
    {
        int s = nhijo1[cuerpo];
        while (s >= 0)
        {
            genera_sentencia(s);
            s = nsig[s];
        }
    }
    int e2 = emite_ir(IROpcode::FunctionEnd, 0, 0, 0, 0, 0);
    sale_ambito_gen();
}


// ============================================================
// GENERAR EL PROGRAMA.
// ============================================================

void genera_ir()
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int nsize[256];
    // La puerta de la arena (M-6): cada programa
    // nace en un mundo nuevo — inicia_irgen y
    // crea_ir antes del reseteo de contadores de
    // siempre, como la puerta de analiza() en M-5.
    inicia_irgen();
    crea_ir();
    nir = 0;
    pool_len = 0;
    nvar = 0;
    nivel = 0;
    errores_ir = 0;
    int d = nhijo1[0];
    while (d >= 0)
    {
        int k = nkind[d];
        if (k == NodeKind::VariableDeclaration)
        {
            int nt = nval[d];
            int nombre = ref_token(nt);
            int tam = nsize[d];
            int e = emite_ir(IROpcode::Declare, nombre, 0, 0, 0, tam);
        }
        d = nsig[d];
    }
    d = nhijo1[0];
    while (d >= 0)
    {
        int k2 = nkind[d];
        if (k2 == NodeKind::FunctionDeclaration)
        {
            genera_funcion(d);
        }
        d = nsig[d];
    }
}


// ============================================================
// REGISTRA_REF (codigo nuevo de D-2, cierra E-2).
//
// La lista de los huecos de llamada al refresco del
// runtime que los emisores de impresion del Backend dejan
// en el codigo (la refreshCallPatchList de Stage 0). Es el
// espejo de registra_ret(): la lista dref_pos la crea
// genera() al nacer y la cuenta vive en nref.
// ============================================================

void registra_ref(int pos)
{
    if (nref < da_count(dref_pos))
    {
        da_set(dref_pos, nref, pos);
    }
    else
    {
        da_add(dref_pos, pos);
    }
    nref = nref + 1;
}


// ============================================================
// MISMO_TMP y REF_CANONICO (codigo nuevo de D-2, D2-11).
//
// mismo_tmp dice si dos refs de la piscina tienen el
// mismo texto, como las claves std::string de los mapas
// de Stage 0. ref_canonico traduce la ref que genera()
// calcula al partir el operando de una operacion binaria
// (el sub-ref de la cadena compuesta que une_refs del
// IRGenerator construye) a la ref de ligadura del
// temporal vivo de ese texto, que es la que la
// maquinaria de temporales conoce. Si ningun temporal
// vivo tiene ese texto, devuelve la ref tal cual y la
// busqueda de siempre acusa.
// ============================================================

int mismo_tmp(int a, int b)
{
    int i;
    if (texto_len(a) != texto_len(b))
    {
        return 0;
    }
    i = 0;
    while (i < texto_len(a))
    {
        if (texto_char(a, i) != texto_char(b, i))
        {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int ref_canonico(int ref)
{
    int i;
    i = 0;
    while (i < ntmp)
    {
        if (mismo_tmp(da_get(dtmp_nom, i), ref) == 1)
        {
            return da_get(dtmp_nom, i);
        }
        i = i + 1;
    }
    return ref;
}


// ============================================================
// INICIA LA BIBLIOTECA.
//
// Pone a cero la contabilidad y los tres bloques, y
// escribe el plan de solape: la region 1 (Source) vive
// en el bloque 0 (A), la 2 (Frontend) en el 1 (B), la 3
// (Compiler) en el 2 (C), la 4 (Backend) en el 1 (B, su
// segunda vida) y la 5 (Output) en el 0 (A, su segunda
// vida). Los tamanos de bloque de esta pieza: A con
// 1024 celdas, B con 262144, C con 512.
// ============================================================

void inicia_arena()
{
    int bloque_a[1024];
    int bloque_b[1048576];
    int bloque_c[131072];
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int i;
    i = 0;
    while (i < 1024)
    {
        bloque_a[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 1048576)
    {
        bloque_b[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 131072)
    {
        bloque_c[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 6)
    {
        reg_bloque[i] = 0;
        reg_reserva[i] = 0;
        reg_usado[i] = 0;
        reg_viva[i] = 0;
        plan_bloque[i] = 0;
        i = i + 1;
    }
    plan_bloque[1] = 0;
    plan_bloque[2] = 1;
    plan_bloque[3] = 2;
    plan_bloque[4] = 1;
    plan_bloque[5] = 0;
    tam_bloque[0] = 1024;
    tam_bloque[1] = 1048576;
    tam_bloque[2] = 131072;
    i = 0;
    while (i < 3)
    {
        bloque_dueno[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 129)
    {
        est_region[i] = 0;
        est_base[i] = 0;
        est_cuenta[i] = 0;
        est_cap[i] = 0;
        est_tipo[i] = 0;
        est_viva[i] = 0;
        i = i + 1;
    }
    errores_arena = 0;
    nest = 0;
    prov_nacq = 0;
    region_source = 0;
    region_frontend = 0;
    region_compiler = 0;
    region_backend = 0;
    region_output = 0;
}


void memory_release(int block)
{
    int bloque_dueno[3];
    bloque_dueno[block - 1] = 0;
}


void invalida_estructuras(int arena)
{
    int est_region[129];
    int est_viva[129];
    int e;
    e = 1;
    while (e <= nest)
    {
        if (est_region[e] == arena)
        {
            est_viva[e] = 0;
        }
        e = e + 1;
    }
}


void arena_destroy(int arena)
{
    int reg_bloque[6];
    int reg_usado[6];
    int reg_viva[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
    reg_viva[arena] = 0;
    memory_release(reg_bloque[arena] + 1);
}


// ============================================================
// ACCESO A CELDAS.
//
// La capa de acceso interna de la via V2: cada bloque es
// un arreglo declarado y estas dos subrutinas son las
// unicas que lo indexan por numero de bloque. Si un dia
// se migra a la via V1, este es el interior que se
// reescribe por peek/poke; la API publica no se entera.
// ============================================================

int celda_get(int bloque, int off)
{
    int bloque_a[1024];
    int bloque_b[1048576];
    int bloque_c[131072];
    int r;
    r = 0;
    if (bloque == 0)
    {
        r = bloque_a[off];
    }
    else
    {
        if (bloque == 1)
        {
            r = bloque_b[off];
        }
        else
        {
            r = bloque_c[off];
        }
    }
    return r;
}


void celda_set(int bloque, int off, int v)
{
    int bloque_a[1024];
    int bloque_b[1048576];
    int bloque_c[131072];
    if (bloque == 0)
    {
        bloque_a[off] = v;
    }
    else
    {
        if (bloque == 1)
        {
            bloque_b[off] = v;
        }
        else
        {
            bloque_c[off] = v;
        }
    }
}


int string_pool_len(int pool, int ref)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return ref - (ref / 128) * 128;
}


// ============================================================
// BYTEBUFFER.
//
// El buffer de bytes que crece: el codigo del Emitter y
// la imagen de los Writers. Una celda por byte, como
// hoy, y cada byte guardado en 0..255.
// bytebuffer_append agrega un byte al final y devuelve
// su offset — la semantica de los placeholders del
// Emitter, que ya devuelven el offset de su hueco.
// bytebuffer_patch escribe en un offset ya entregado y
// dentro de la cuenta: es el patch32 / patchRel32 de hoy
// sin guarda de 256. bytebuffer_write copia count bytes
// desde otro ByteBuffer (desde su src_offset) y los
// agrega al final de este: lo que los Writers hacen al
// ensamblar cabecera + codigo + datos; el intervalo de
// origen se valida entero antes de copiar, asi que una
// copia invalida acusa y no escribe nada.
// bytebuffer_get lee un byte por offset, validado.
// ============================================================

int bytebuffer_create(int arena)
{
    return est_crea(arena, 3, 8);
}


int bytebuffer_append(int bb, int byte)
{
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(bb, byte & 255);
}


void bytebuffer_patch(int bb, int offset, int byte)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[bb]], est_base[bb] + offset, byte & 255);
}


int bytebuffer_get(int bb, int offset)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[bb]], est_base[bb] + offset);
}


int bytebuffer_get_size(int bb)
{
    int est_cuenta[129];
    if (est_valida(bb, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[bb];
}


// ============================================================
// REINICIA EL RUNTIME.
//
// Pone a cero el estado, fija los tamanos medidos de
// las regiones en hueco y crea las estructuras en
// BackendArena: el ByteBuffer del prefijo, los tres
// arreglos del registro de parches y las catorce
// listas DATA, nacidos a 256 como manda la norma de
// la casa. El llamador crea BackendArena antes
// (region_backend), como en las demas piezas.
// ============================================================

void reinicia_rt()
{
    errores_rt = 0;
    nreg = 0;
    npl_buf = 0;
    npl_cnt = 0;
    npl_cab = 0;
    npl_vis = 0;
    npl_cur = 0;
    npl_top = 0;
    npl_alt = 0;
    npl_est = 0;
    npl_agr = 0;
    npl_men = 0;
    npl_sel = 0;
    npl_len = 0;
    npl_clip = 0;
    npl_txt = 0;
    tam_raton = 358;
    tam_refresco = 62;
    tam_lineas = 239;
    tam_barra = 157;
    tam_edit = 378;
    tam_file = 267;
    tam_copiar = 189;
    tam_pegar = 94;
    tam_vaciar = 30;
    tam_iedit = 58;
    tam_icortar = 63;
    tam_icopiar = 58;
    tam_isel = 48;
    tam_ipegar = 42;
    tam_ieliminar = 58;
    tam_ifile = 58;
    tam_iopen = 42;
    tam_isave = 42;
    tam_iclose = 42;
    tam_escritura = 355;
    tam_lectura = 408;
    dir_bucle = 0;
    dir_redraw = 0;
    dir_tecla = 0;
    dir_boton = 0;
    dir_raton = 0;
    dir_ventana = 0;
    dir_refresco = 0;
    dir_lineas = 0;
    dir_barra = 0;
    dir_edit = 0;
    dir_file = 0;
    dir_copiar = 0;
    dir_pegar = 0;
    dir_vaciar = 0;
    dir_iedit = 0;
    dir_icortar = 0;
    dir_icopiar = 0;
    dir_isel = 0;
    dir_ipegar = 0;
    dir_ieliminar = 0;
    dir_ifile = 0;
    dir_iopen = 0;
    dir_isave = 0;
    dir_iclose = 0;
    res_draw = 0;
    res_main = 0;
    res_bucle = 0;
    res_titulo = 0;
    res_cap = 0;
    res_refresco = 0;
    dir_escritura = 0;
    dir_lectura = 0;
    res_esc_scratch = 0;
    res_esc_params = 0;
    res_lec_scratch = 0;
    res_lec_params = 0;
    dcod = bytebuffer_create(region_backend);
    dreg_pos = da_create(region_backend, 256);
    dreg_clase = da_create(region_backend, 256);
    dreg_dueno = da_create(region_backend, 256);
    dpl_buf = da_create(region_backend, 256);
    dpl_cnt = da_create(region_backend, 256);
    dpl_cab = da_create(region_backend, 256);
    dpl_vis = da_create(region_backend, 256);
    dpl_cur = da_create(region_backend, 256);
    dpl_top = da_create(region_backend, 256);
    dpl_alt = da_create(region_backend, 256);
    dpl_est = da_create(region_backend, 256);
    dpl_agr = da_create(region_backend, 256);
    dpl_men = da_create(region_backend, 256);
    dpl_sel = da_create(region_backend, 256);
    dpl_len = da_create(region_backend, 256);
    dpl_clip = da_create(region_backend, 256);
    dpl_txt = da_create(region_backend, 256);
}


// ============================================================
// EMISORES.
//
// La base de emision de la casa sobre el ByteBuffer
// dcod: em_byte anota un byte, em_dword un dword
// little-endian, em_hueco reserva el dword de un
// parche y devuelve su posicion (la semantica de los
// placeholders del Emitter) y parche32 escribe un
// dword en un offset ya entregado. Encima, las
// primitivas del prefijo: las mismas codificaciones
// de X86Emitter.cpp de Stage 0, en decimal como en
// las demas piezas. Los huecos con retorno devuelven
// la posicion del rel32 o del imm32. em_hueco_cero
// emite la region en hueco: n bytes a cero.
// anota_lista anota la posicion de un imm32 en una
// de las catorce listas DATA de la pieza — el indice
// sigue el orden del estado: 0 lineBuffer, 1
// lineCount, 2 lineHead, 3 firstVisible, 4
// repaintCursor, 5 thumbTop, 6 thumbHeight, 7
// dragState, 8 dragGrab, 9 menuAbierto, 10
// seleccion, 11 clipLen, 12 clipBuffer y 13
// menuTexto — e incrementa su contador; los
// emisores de operando de memoria (em_mov_eax_mem,
// em_mov_ebx_mem, em_mov_mem_eax, em_sub_eax_mem y
// em_add_eax_mem) emiten su imm32 a cero y lo
// anotan. em_jle_hueco y em_jbe_hueco son los
// saltos con signo y sin signo del dibujo, y
// em_and_eax_imm y em_add_eax_imm sus inmediatos.
// R-3 suma los saltos que piden la barra y el
// raton (em_jb_hueco, em_ja_hueco, em_jae_hueco,
// em_jge_hueco y em_jns_hueco) y los operandos de
// memoria de sus cuentas (em_mov_ecx_mem,
// em_sub_ebx_mem, em_cmp_eax_mem, em_add_ecx_mem,
// em_div_mem y em_mul_mem). R-4 suma los
// operandos con la direccion DATA como
// inmediato (em_mov_edi_dir, em_mov_edx_dir,
// em_mov_esi_dir, em_mov_eax_dir, em_add_eax_dir
// y em_sub_eax_dir: el opcode y un imm32
// anotado en su lista) y em_cmp_ebx_mem
// (cmp ebx, [dir]).
// ============================================================

void em_byte(int b)
{
    bytebuffer_append(dcod, b & 255);
}


void em_dword(int v)
{
    em_byte(v & 255);
    em_byte((v >> 8) & 255);
    em_byte((v >> 16) & 255);
    em_byte((v >> 24) & 255);
}


int em_hueco()
{
    int pos;
    pos = bytebuffer_get_size(dcod);
    em_dword(0);
    return pos;
}


void parche32(int pos, int v)
{
    bytebuffer_patch(dcod, pos, v & 255);
    bytebuffer_patch(dcod, pos + 1, (v >> 8) & 255);
    bytebuffer_patch(dcod, pos + 2, (v >> 16) & 255);
    bytebuffer_patch(dcod, pos + 3, (v >> 24) & 255);
}


void anota_lista(int cual, int pos)
{
    int r;
    if (cual < 0)
    {
        errores_rt = errores_rt + 1;
        return;
    }
    if (cual > 13)
    {
        errores_rt = errores_rt + 1;
        return;
    }
    r = 0;
    if (cual == 0)
    {
        r = da_add(dpl_buf, pos);
        if (r >= 0)
        {
            npl_buf = npl_buf + 1;
        }
    }
    if (cual == 1)
    {
        r = da_add(dpl_cnt, pos);
        if (r >= 0)
        {
            npl_cnt = npl_cnt + 1;
        }
    }
    if (cual == 2)
    {
        r = da_add(dpl_cab, pos);
        if (r >= 0)
        {
            npl_cab = npl_cab + 1;
        }
    }
    if (cual == 3)
    {
        r = da_add(dpl_vis, pos);
        if (r >= 0)
        {
            npl_vis = npl_vis + 1;
        }
    }
    if (cual == 4)
    {
        r = da_add(dpl_cur, pos);
        if (r >= 0)
        {
            npl_cur = npl_cur + 1;
        }
    }
    if (cual == 5)
    {
        r = da_add(dpl_top, pos);
        if (r >= 0)
        {
            npl_top = npl_top + 1;
        }
    }
    if (cual == 6)
    {
        r = da_add(dpl_alt, pos);
        if (r >= 0)
        {
            npl_alt = npl_alt + 1;
        }
    }
    if (cual == 7)
    {
        r = da_add(dpl_est, pos);
        if (r >= 0)
        {
            npl_est = npl_est + 1;
        }
    }
    if (cual == 8)
    {
        r = da_add(dpl_agr, pos);
        if (r >= 0)
        {
            npl_agr = npl_agr + 1;
        }
    }
    if (cual == 9)
    {
        r = da_add(dpl_men, pos);
        if (r >= 0)
        {
            npl_men = npl_men + 1;
        }
    }
    if (cual == 10)
    {
        r = da_add(dpl_sel, pos);
        if (r >= 0)
        {
            npl_sel = npl_sel + 1;
        }
    }
    if (cual == 11)
    {
        r = da_add(dpl_len, pos);
        if (r >= 0)
        {
            npl_len = npl_len + 1;
        }
    }
    if (cual == 12)
    {
        r = da_add(dpl_clip, pos);
        if (r >= 0)
        {
            npl_clip = npl_clip + 1;
        }
    }
    if (cual == 13)
    {
        r = da_add(dpl_txt, pos);
        if (r >= 0)
        {
            npl_txt = npl_txt + 1;
        }
    }
    if (r < 0)
    {
        errores_rt = errores_rt + 1;
    }
}


