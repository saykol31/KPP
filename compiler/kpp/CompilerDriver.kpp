// ============================================================
// NATIVAS Y CIERRE DE B-9.
//
// Los emisores nuevos, las dos rutinas del runtime
// transcritas (emitRecordLine y emitPrintInteger),
// el registro de los parches de archivo, la
// construccion de DATA y las pasadas del cierre.
// ============================================================

void em_mov_edx_eax()
