    }
    if (op == IROpcode::Print)
    {
        agrega_sal(80);
        agrega_sal(82);
        agrega_sal(73);
        agrega_sal(78);
        agrega_sal(84);
        agrega_sal(10);
        return;
    }
    if (op == IROpcode::PrintInteger)
    {
        agrega_sal(80);
        agrega_sal(82);
        agrega_sal(73);
        agrega_sal(78);
        agrega_sal(84);
        agrega_sal(95);
        agrega_sal(73);
        agrega_sal(78);
        agrega_sal(84);
        agrega_sal(69);
        agrega_sal(71);
        agrega_sal(69);
        agrega_sal(82);
        agrega_sal(10);
        return;
    }
    if (op == IROpcode::CompareEqual)
    {
        agrega_sal(67);
        agrega_sal(79);
        agrega_sal(77);
        agrega_sal(80);
        agrega_sal(65);
        agrega_sal(82);
        agrega_sal(69);
        agrega_sal(95);
        agrega_sal(69);
        agrega_sal(81);
        agrega_sal(85);
        agrega_sal(65);
        agrega_sal(76);
        agrega_sal(10);
        return;
    }
    if (op == IROpcode::CompareNotEqual)
    {
        agrega_sal(67);
        agrega_sal(79);
        agrega_sal(77);
        agrega_sal(80);
        agrega_sal(65);
        agrega_sal(82);
        agrega_sal(69);
        agrega_sal(95);
        agrega_sal(78);
        agrega_sal(79);
        agrega_sal(84);
        agrega_sal(95);
        agrega_sal(69);
        agrega_sal(81);
        agrega_sal(85);
        agrega_sal(65);
        agrega_sal(76);
        agrega_sal(10);
        return;
    }
    if (op == IROpcode::CompareLess)
    {
        agrega_sal(67);
        agrega_sal(79);
        agrega_sal(77);
        agrega_sal(80);
        agrega_sal(65);
        agrega_sal(82);
