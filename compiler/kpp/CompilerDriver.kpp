    em_setne_al();
    em_movzx_eax_al();
}


int busca_etq(int fun, int etq)
{
    int i;
    i = 0;
    while (i < netq)
    {
        if (da_get(detq_fun, i) == fun && da_get(detq_etq, i) == etq)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


void registra_etq(int fun, int etq, int pos)
{
    int r;
    r = da_add(detq_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(detq_etq, etq);
    r = da_add(detq_pos, pos);
    netq = netq + 1;
}


void registra_cf2(int fun, int etiq, int pos)
{
    int r;
    r = da_add(dcf_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    registra_cf(etiq, pos);
}


void rellena_cf()
{
    int i;
    int fila;
    i = 0;
    while (i < ncf)
    {
        fila = busca_etq(da_get(dcf_fun, i), da_get(dcf_etiq, i));
        if (fila < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        parche32(da_get(dcf_pos, i), da_get(detq_pos, fila) - (da_get(dcf_pos, i) + 4));
        i = i + 1;
    }
}


