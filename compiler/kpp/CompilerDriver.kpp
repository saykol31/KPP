void emite_escritura()
{
    int f1;
    int f2;
    int f3;
    int f4;
    int f5;
    int f6;
    int f7;
    int s1;
    int bucle;
    int terminado;
    int usa_resto;
    int conv;
    int conv_vuelta;
    int vuelta;
    int exito;
    int fracaso;
    int epilogo;
    // FILE_WRITE de emitFileIoRuntime: valida
    // (ruta y arreglo no nulos, cantidad y
    // capacidad no negativas, cantidad <=
    // capacidad), carga las bases ESI =
    // parametros y EDI = scratch (anotadas en
    // los res_ de archivos: las rellena quien
    // ensambla con DATA), crea/reescribe una
    // sola vez con la subfuncion 2 y escribe en
    // bloques de 65536 con la 3, convirtiendo
    // cada celda int32 en un byte del scratch.
    // Devuelve 0 o -1. Los saltos se parchean
    // en el sitio, como en el oraculo.
    em_prologo_io();
    em_carga_eax_esp(32);
    em_cmp_eax_imm(0);
    f1 = em_je_hueco();
    em_carga_eax_esp(44);
    em_cmp_eax_imm(0);
    f2 = em_je_hueco();
    em_carga_ecx_esp(28);
    em_cmp_reg_imm(249, 0);
    f3 = em_jl_hueco();
    em_carga_edx_esp(24);
    em_cmp_reg_imm(250, 0);
    f4 = em_jl_hueco();
    em_carga_ecx_esp(28);
    em_carga_edx_esp(24);
    em_byte(57);
    em_byte(209);
    f5 = em_ja_hueco();
    em_guarda_imm_esp(0, 0);
    em_carga_eax_esp(28);
    em_guarda_eax_esp(4);
    em_carga_eax_esp(44);
    em_guarda_eax_esp(12);
    res_esc_params = em_mov_esi_hueco();
    res_esc_scratch = em_mov_edi_hueco();
    em_mov_esi_dword(0, 2);
    em_mov_esi_dword(4, 0);
    em_mov_esi_dword(8, 0);
    em_mov_esi_dword(12, 0);
    em_mov_esi_dword(16, 0);
    em_byte(198);
    em_byte(70);
    em_byte(20);
    em_byte(0);
    em_carga_eax_esp(32);
    em_byte(137);
    em_byte(70);
    em_byte(21);
    em_byte(137);
    em_byte(243);
    em_mov_eax_imm(70);
    em_int(64);
    em_cmp_eax_imm(0);
    f6 = em_jne_hueco();
    bucle = bytebuffer_get_size(dcod);
    em_carga_eax_esp(4);
    em_byte(133);
    em_byte(192);
    terminado = em_jle_hueco();
    em_carga_eax_esp(4);
    em_cmp_reg_imm(248, 65536);
    usa_resto = em_jbe_hueco();
    em_mov_eax_imm(65536);
    parche32(usa_resto,
             bytebuffer_get_size(dcod) - (usa_resto + 4));
    em_guarda_eax_esp(8);
    em_carga_ebx_esp(12);
    em_byte(137);
    em_byte(250);
    em_carga_ecx_esp(8);
    conv = bytebuffer_get_size(dcod);
    em_byte(139);
    em_byte(3);
    em_byte(136);
    em_byte(2);
    em_byte(131);
    em_byte(195);
    em_byte(4);
    em_byte(66);
    em_byte(73);
    conv_vuelta = em_jne_hueco();
    parche32(conv_vuelta, conv - (conv_vuelta + 4));
    em_guarda_ebx_esp(12);
    em_mov_esi_dword(0, 3);
    em_carga_eax_esp(0);
    em_byte(137);
    em_byte(70);
    em_byte(4);
    em_mov_esi_dword(8, 0);
    em_carga_eax_esp(8);
    em_byte(137);
    em_byte(70);
    em_byte(12);
    em_byte(137);
    em_byte(126);
    em_byte(16);
    em_byte(137);
    em_byte(243);
    em_mov_eax_imm(70);
    em_int(64);
    em_cmp_eax_imm(0);
    f7 = em_jne_hueco();
    em_carga_eax_esp(0);
    em_byte(3);
    em_byte(68);
    em_byte(36);
    em_byte(8);
    em_guarda_eax_esp(0);
    em_carga_eax_esp(4);
    em_byte(43);
    em_byte(68);
    em_byte(36);
    em_byte(8);
    em_guarda_eax_esp(4);
    vuelta = em_jmp_hueco();
    parche32(vuelta, bucle - (vuelta + 4));
    exito = bytebuffer_get_size(dcod);
    em_byte(49);
    em_byte(192);
    s1 = em_jmp_hueco();
    fracaso = bytebuffer_get_size(dcod);
    em_mov_eax_imm(-1);
    epilogo = bytebuffer_get_size(dcod);
    em_epilogo_io();
    parche32(terminado, exito - (terminado + 4));
    parche32(f1, fracaso - (f1 + 4));
    parche32(f2, fracaso - (f2 + 4));
    parche32(f3, fracaso - (f3 + 4));
    parche32(f4, fracaso - (f4 + 4));
    parche32(f5, fracaso - (f5 + 4));
    parche32(f6, fracaso - (f6 + 4));
    parche32(f7, fracaso - (f7 + 4));
    parche32(s1, epilogo - (s1 + 4));
}


void emite_lectura()
{
    int f1;
    int f2;
    int f3;
    int s1;
    int bucle;
    int terminado;
    int usa_resto;
    int conv;
    int conv_vuelta;
    int vuelta;
    int estado_eof;
    int estado_error;
    int estado_normal;
    int eof;
    int continua_eof;
    int error;
    int parcial;
    int sin_datos;
    int proceso;
    int invalido;
    int cero;
    int eof_tras_copia;
    int bloque_corto;
    int exito;
    int fracaso;
    int epilogo;
    // FILE_READ de emitFileIoRuntime: valida
    // (ruta y arreglo no nulos, capacidad
    // positiva), carga las bases como la
    // escritura y lee con la subfuncion 0 en
    // bloques de 65536, convirtiendo cada byte
    // del scratch en una celda int32. El EOF
    // (6) es exito corto y un error con datos
    // devuelve el total parcial; sin datos,
    // -1. Los saltos se parchean en el sitio,
    // como en el oraculo.
    em_prologo_io();
    em_carga_eax_esp(32);
    em_cmp_eax_imm(0);
    f1 = em_je_hueco();
    em_carga_eax_esp(44);
    em_cmp_eax_imm(0);
    f2 = em_je_hueco();
    em_carga_ecx_esp(28);
    em_cmp_reg_imm(249, 0);
    f3 = em_jle_hueco();
    em_guarda_imm_esp(0, 0);
    em_carga_eax_esp(28);
    em_guarda_eax_esp(4);
    em_carga_eax_esp(44);
    em_guarda_eax_esp(12);
    em_guarda_imm_esp(16, 0);
    res_lec_params = em_mov_esi_hueco();
    res_lec_scratch = em_mov_edi_hueco();
    em_mov_esi_dword(0, 0);
    em_mov_esi_dword(4, 0);
    em_mov_esi_dword(8, 0);
    em_mov_esi_dword(12, 0);
    em_byte(137);
    em_byte(126);
    em_byte(16);
    em_byte(198);
    em_byte(70);
    em_byte(20);
    em_byte(0);
    em_carga_eax_esp(32);
    em_byte(137);
    em_byte(70);
    em_byte(21);
    bucle = bytebuffer_get_size(dcod);
    em_carga_eax_esp(4);
    em_byte(133);
    em_byte(192);
    terminado = em_jle_hueco();
    em_carga_eax_esp(4);
    em_cmp_reg_imm(248, 65536);
    usa_resto = em_jbe_hueco();
    em_mov_eax_imm(65536);
    parche32(usa_resto,
             bytebuffer_get_size(dcod) - (usa_resto + 4));
    em_guarda_eax_esp(8);
    em_guarda_eax_esp(20);
    em_carga_eax_esp(0);
    em_byte(137);
    em_byte(70);
    em_byte(4);
    em_mov_esi_dword(8, 0);
    em_carga_eax_esp(8);
    em_byte(137);
    em_byte(70);
    em_byte(12);
    em_guarda_imm_esp(16, 0);
    em_byte(137);
    em_byte(243);
    em_mov_eax_imm(70);
    em_int(64);
    em_cmp_eax_imm(6);
    estado_eof = em_je_hueco();
    em_cmp_eax_imm(0);
    estado_error = em_jne_hueco();
    estado_normal = em_jmp_hueco();
    eof = bytebuffer_get_size(dcod);
    em_guarda_imm_esp(16, 1);
    continua_eof = em_jmp_hueco();
    error = bytebuffer_get_size(dcod);
    em_carga_eax_esp(0);
    em_byte(133);
    em_byte(192);
    parcial = em_jne_hueco();
    sin_datos = em_jmp_hueco();
    proceso = bytebuffer_get_size(dcod);
    em_carga_eax_esp(8);
    em_byte(57);
    em_byte(195);
    invalido = em_ja_hueco();
    em_guarda_ebx_esp(8);
    em_byte(133);
    em_byte(219);
    cero = em_je_hueco();
    em_byte(137);
    em_byte(250);
    em_carga_ebx_esp(12);
    em_carga_ecx_esp(8);
    conv = bytebuffer_get_size(dcod);
    em_byte(15);
    em_byte(182);
    em_byte(2);
    em_byte(137);
    em_byte(3);
    em_byte(66);
    em_byte(131);
    em_byte(195);
    em_byte(4);
    em_byte(73);
    conv_vuelta = em_jne_hueco();
    parche32(conv_vuelta, conv - (conv_vuelta + 4));
    em_guarda_ebx_esp(12);
    em_carga_eax_esp(0);
    em_byte(3);
    em_byte(68);
    em_byte(36);
    em_byte(8);
    em_guarda_eax_esp(0);
    em_carga_eax_esp(4);
    em_byte(43);
    em_byte(68);
    em_byte(36);
    em_byte(8);
    em_guarda_eax_esp(4);
    em_carga_eax_esp(16);
    em_byte(133);
    em_byte(192);
    eof_tras_copia = em_jne_hueco();
    em_carga_eax_esp(8);
    em_byte(59);
    em_byte(68);
    em_byte(36);
    em_byte(20);
    bloque_corto = em_jb_hueco();
    vuelta = em_jmp_hueco();
    parche32(vuelta, bucle - (vuelta + 4));
    exito = bytebuffer_get_size(dcod);
    em_carga_eax_esp(0);
    s1 = em_jmp_hueco();
    fracaso = bytebuffer_get_size(dcod);
    em_mov_eax_imm(-1);
    epilogo = bytebuffer_get_size(dcod);
    em_epilogo_io();
    parche32(terminado, exito - (terminado + 4));
    parche32(estado_eof, eof - (estado_eof + 4));
    parche32(continua_eof, proceso - (continua_eof + 4));
    parche32(estado_normal, proceso - (estado_normal + 4));
    parche32(estado_error, error - (estado_error + 4));
    parche32(parcial, exito - (parcial + 4));
    parche32(sin_datos, fracaso - (sin_datos + 4));
    parche32(invalido, error - (invalido + 4));
    parche32(cero, exito - (cero + 4));
    parche32(eof_tras_copia, exito - (eof_tras_copia + 4));
    parche32(bloque_corto, exito - (bloque_corto + 4));
    parche32(f1, fracaso - (f1 + 4));
    parche32(f2, fracaso - (f2 + 4));
    parche32(f3, fracaso - (f3 + 4));
    parche32(s1, epilogo - (s1 + 4));
}


void emite_grafico()
{
    int p;
    // MASCARA DE EVENTOS (funcion 40, 0x27).
    em_mov_eax_imm(40);
    em_mov_reg_imm(187, 39);
    em_int(64);
    // START: call DRAW_WINDOW, jmp al cuerpo.
    res_draw = em_call_hueco();
    registra_parche(res_draw, 0, 1);
    res_main = em_jmp_hueco();
    // BUCLE DE EVENTOS (funcion 10).
    dir_bucle = bytebuffer_get_size(dcod);
    res_bucle = dir_bucle;
    em_mov_eax_imm(10);
    em_int(64);
    // DESPACHO: 1 redraw, 2 tecla, 3 boton, 6 raton.
    em_cmp_eax_imm(1);
    p = em_je_hueco();
    registra_parche(p, 2, 1);
    em_cmp_eax_imm(2);
    p = em_je_hueco();
    registra_parche(p, 3, 1);
    em_cmp_eax_imm(3);
    p = em_je_hueco();
    registra_parche(p, 4, 1);
    em_cmp_eax_imm(6);
    p = em_je_hueco();
    registra_parche(p, 5, 3);
    // Evento desconocido: volver al bucle.
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // REDRAW: call DRAW_WINDOW y volver al bucle.
    dir_redraw = bytebuffer_get_size(dcod);
    p = em_call_hueco();
    registra_parche(p, 0, 1);
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // TECLA: funcion 2 y volver al bucle.
    dir_tecla = bytebuffer_get_size(dcod);
    em_mov_eax_imm(2);
    em_int(64);
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // BOTON: funcion 17; el id llega en AH. Las
    // islas del menu se registran con su duena: los
    // renglones de EDIT en R-4 y los de FILE en R-5.
    dir_boton = bytebuffer_get_size(dcod);
    em_mov_eax_imm(17);
    em_int(64);
    em_cmp_ah_imm8(2);
    p = em_je_hueco();
    registra_parche(p, 14, 4);
    em_cmp_ah_imm8(8);
    p = em_je_hueco();
    registra_parche(p, 20, 5);
    em_cmp_ah_imm8(9);
    p = em_je_hueco();
    registra_parche(p, 21, 5);
    em_cmp_ah_imm8(10);
    p = em_je_hueco();
    registra_parche(p, 22, 5);
    em_cmp_ah_imm8(11);
    p = em_je_hueco();
    registra_parche(p, 23, 5);
    em_cmp_ah_imm8(3);
    p = em_je_hueco();
    registra_parche(p, 15, 4);
    em_cmp_ah_imm8(4);
    p = em_je_hueco();
    registra_parche(p, 16, 4);
    em_cmp_ah_imm8(5);
    p = em_je_hueco();
    registra_parche(p, 17, 4);
    em_cmp_ah_imm8(6);
    p = em_je_hueco();
    registra_parche(p, 18, 4);
    em_cmp_ah_imm8(7);
    p = em_je_hueco();
    registra_parche(p, 19, 4);
    // Boton 1 = cerrar (cae a la salida); otro
    // cualquiera vuelve al bucle.
    em_cmp_ah_imm8(1);
    p = em_jne_hueco();
    registra_parche(p, 1, 1);
    // SALIDA.
    emite_salida();
    // RATON: portado en R-3.
    dir_raton = bytebuffer_get_size(dcod);
    emite_raton();
    // DRAW WINDOW: begin redraw, la ventana de
    // 500 x 220 en (100, 100) con su titulo, las
    // llamadas a las rutinas de dibujo registradas
    // con sus duenas, el titulo reafirmado con la
    // funcion 71.1 y end redraw.
    dir_ventana = bytebuffer_get_size(dcod);
    em_mov_eax_imm(12);
    em_mov_reg_imm(187, 1);
    em_int(64);
    em_mov_eax_imm(0);
    em_mov_reg_imm(187, 6554100);
    em_mov_reg_imm(185, 6554100);
    em_mov_reg_imm(186, 335544320);
    em_mov_reg_imm(190, -2138531329);
    em_byte(191);
    res_titulo = em_hueco();
    em_int(64);
    p = em_call_hueco();
    registra_parche(p, 7, 2);
    p = em_call_hueco();
    registra_parche(p, 9, 4);
    p = em_call_hueco();
    registra_parche(p, 10, 5);
    em_mov_eax_imm(71);
    em_mov_reg_imm(187, 1);
    em_byte(185);
    res_cap = em_hueco();
    em_int(64);
    em_mov_eax_imm(12);
    em_mov_reg_imm(187, 2);
    em_int(64);
    em_ret();
    // REFRESCO: portado en R-2. Su direccion es
    // el refreshOutputAddress del Result.
    dir_refresco = bytebuffer_get_size(dcod);
    res_refresco = dir_refresco;
    emite_refresco();
    // DIBUJO DE LINEAS: portado en R-2.
    dir_lineas = bytebuffer_get_size(dcod);
    emite_lineas();
    // BARRA: portada en R-3.
    dir_barra = bytebuffer_get_size(dcod);
    emite_barra();
    // DIBUJA_EDIT: portado en R-4.
    dir_edit = bytebuffer_get_size(dcod);
    emite_edit();
    // DIBUJA_FILE: portado en R-5.
    dir_file = bytebuffer_get_size(dcod);
    emite_file();
    // COPIAR, PEGAR y VACIAR: portados en R-4.
    dir_copiar = bytebuffer_get_size(dcod);
    emite_copiar();
    dir_pegar = bytebuffer_get_size(dcod);
    emite_pegar();
    dir_vaciar = bytebuffer_get_size(dcod);
    emite_vaciar();
    // ISLAS DE EDIT: portadas en R-4.
    dir_iedit = bytebuffer_get_size(dcod);
    emite_isla_edit();
    dir_icortar = bytebuffer_get_size(dcod);
    emite_isla_cortar();
    dir_icopiar = bytebuffer_get_size(dcod);
    emite_isla_copiar();
    dir_isel = bytebuffer_get_size(dcod);
    emite_isla_sel();
    dir_ipegar = bytebuffer_get_size(dcod);
    emite_isla_pegar();
    dir_ieliminar = bytebuffer_get_size(dcod);
    emite_isla_eliminar();
    // ISLAS DE FILE: portadas en R-5.
    dir_ifile = bytebuffer_get_size(dcod);
    emite_isla_file();
    dir_iopen = bytebuffer_get_size(dcod);
    emite_isla_open();
    dir_isave = bytebuffer_get_size(dcod);
    emite_isla_save();
    dir_iclose = bytebuffer_get_size(dcod);
    emite_isla_close();
    // PASADAS INTERNAS del prefijo: la de R-1,
    // la de R-2, la de R-3, la de R-4 y la de R-5.
    rellena_registro(1);
    rellena_registro(2);
    rellena_registro(3);
    rellena_registro(4);
    rellena_registro(5);
}


// ============================================================
// RUTINAS DE ARCHIVO (en la pieza Runtime son la
// cola de emite_grafico; en el Ensamblador van
// aparte, diferencia D4): se emiten tras el
// prefijo grafico SOLO cuando el programa usa
// archivos, como en generate() de Stage 0, que
// llama a emitFileIoRuntime bajo
// needsFileIoRuntime. La pasada de la duena 6
// las cierra (sin filas: no registran parches).
// ============================================================

void emite_archivos()
{
    dir_escritura = bytebuffer_get_size(dcod);
    emite_escritura();
    dir_lectura = bytebuffer_get_size(dcod);
    emite_lectura();
    rellena_registro(6);
}


// ============================================================
// REINICIA EL BACKEND.
//
// Pone a cero el andamiaje (el codigo y las tablas de
// entrada del generador: seis arreglos paralelos — iop,
// inombre, ioperando, iresultado, iaux, ivalor — y la
// piscina de texto pool, donde el nombre, el operando,
// el resultado y el auxiliary de cada instruccion son
// referencias ini * 128 + largo) y crea las estructuras
// de las siete listas: 18 DynamicArray en BackendArena,
// nacidos a 256 elementos — el 256 de la norma vieja
// como capacidad inicial, ya no como techo: crecen por
// la geometria de la biblioteca. El llamador crea
// BackendArena antes (region_backend) y los handles
// quedan en los escalares compartidos. La rebanada B-1
// agrega al final los nacimientos de la maquinaria:
// las 24 tablas del modulo ESTADO DE LA MAQUINARIA y
// los dos ByteBuffer, codigo y datos.
// ============================================================

void reinicia_back()
{
    int codigo[256];
    int iop[256];
    int inombre[256];
    int ioperando[256];
    int iresultado[256];
    int iaux[256];
    int ivalor[256];
    int pool[256];
    int i;
    i = 0;
    while (i < 256)
    {
        codigo[i] = 0;
        iop[i] = 0;
        inombre[i] = 0;
        ioperando[i] = 0;
        iresultado[i] = 0;
        iaux[i] = 0;
        ivalor[i] = 0;
        pool[i] = 0;
        i = i + 1;
    }
    nir = 0;
    pool_len = 0;
    ncod = 0;
    errores_back = 0;
    nvl = 0;
    nvs = 0;
    nsp = 0;
    nrl = 0;
    nsc = 0;
    ncf = 0;
    nfc = 0;
    ntmp = 0;
    ncon = 0;
    nvar = 0;
    nglo = 0;
    nctx = 0;
    nsv = 0;
    frame_activo = 0;
    frame_slots = 0;
    dvl_fun = da_create(region_backend, 256);
    dvl_nom = da_create(region_backend, 256);
    dvl_pos = da_create(region_backend, 256);
    dvs_fun = da_create(region_backend, 256);
    dvs_nom = da_create(region_backend, 256);
    dvs_pos = da_create(region_backend, 256);
    dsp_tmp = da_create(region_backend, 256);
    dsp_pos = da_create(region_backend, 256);
    dsp_dat = da_create(region_backend, 256);
    drl_tmp = da_create(region_backend, 256);
    drl_pos = da_create(region_backend, 256);
    drl_dat = da_create(region_backend, 256);
    dsc_pos = da_create(region_backend, 256);
    dsc_idx = da_create(region_backend, 256);
    dcf_etiq = da_create(region_backend, 256);
    dcf_pos = da_create(region_backend, 256);
    dfc_fun = da_create(region_backend, 256);
    dfc_pos = da_create(region_backend, 256);
    dtmp_nom = da_create(region_backend, 256);
    dtmp_kind = da_create(region_backend, 256);
    dtmp_reg = da_create(region_backend, 256);
    dtmp_off = da_create(region_backend, 256);
    dcon_nom = da_create(region_backend, 256);
    dcon_val = da_create(region_backend, 256);
    dvar_nom = da_create(region_backend, 256);
    dvar_dat = da_create(region_backend, 256);
    dvar_stack = da_create(region_backend, 256);
    dvar_soff = da_create(region_backend, 256);
    dvar_cap = da_create(region_backend, 256);
    dglo_nom = da_create(region_backend, 256);
    dglo_dat = da_create(region_backend, 256);
    dglo_stack = da_create(region_backend, 256);
    dglo_soff = da_create(region_backend, 256);
    dglo_cap = da_create(region_backend, 256);
    dctx_fun = da_create(region_backend, 256);
    dctx_ini = da_create(region_backend, 256);
    dctx_n = da_create(region_backend, 256);
    dsv_nom = da_create(region_backend, 256);
    dsv_dat = da_create(region_backend, 256);
    dsv_stack = da_create(region_backend, 256);
    dsv_soff = da_create(region_backend, 256);
    dsv_cap = da_create(region_backend, 256);
    dcod = bytebuffer_create(region_backend);
    ddat = bytebuffer_create(region_backend);
}


// ============================================================
// REGISTRO DE LAS SIETE LISTAS.
//
// Una funcion por lista, con la misma disciplina: el
// primer campo hace de guarda — si su da_add devuelve
// -1, la arena no pudo crecer: la funcion acusa en
// errores_back (la biblioteca ya acuso en
// errores_arena) y no escribe nada mas. Los campos
// paralelos comparten la cuenta del primero porque
// nacen con la misma capacidad y crecen a la par. Los
// campos de texto de Stage 0 (functionName, name,
// temporary, label) viajan como referencias a la
// piscina: un entero por campo. El orden de los campos
// es el de los structs de X86Backend.hpp.
// ============================================================

// VariableLoadPatch: funcion, nombre, offset del hueco.
void registra_vl(int fun, int nom, int pos)
{
    int r;
    r = da_add(dvl_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dvl_nom, nom);
    r = da_add(dvl_pos, pos);
    nvl = nvl + 1;
}


// VariableStorePatch: funcion, nombre, offset del hueco.
void registra_vs(int fun, int nom, int pos)
{
    int r;
    r = da_add(dvs_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dvs_nom, nom);
    r = da_add(dvs_pos, pos);
    nvs = nvs + 1;
}


// TemporarySpillPatch: temporal, offset del hueco,
// offset de datos (el slot, firmado).
void registra_spill(int tmp, int pos, int dat)
{
    int r;
    r = da_add(dsp_tmp, tmp);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dsp_pos, pos);
    r = da_add(dsp_dat, dat);
    nsp = nsp + 1;
}


// TemporaryReloadPatch: temporal, offset del hueco,
// offset de datos (el slot, firmado).
void registra_reload(int tmp, int pos, int dat)
{
    int r;
    r = da_add(drl_tmp, tmp);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(drl_pos, pos);
    r = da_add(drl_dat, dat);
    nrl = nrl + 1;
}


// StringConstPatch: offset del hueco, indice de la
// cadena en la piscina.
void registra_sc(int pos, int idx)
{
    int r;
    r = da_add(dsc_pos, pos);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dsc_idx, idx);
    nsc = nsc + 1;
}


// ControlFlowPatch: etiqueta, offset del hueco.
void registra_cf(int etiq, int pos)
{
    int r;
    r = da_add(dcf_etiq, etiq);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dcf_pos, pos);
    ncf = ncf + 1;
}


// FunctionCallPatch: funcion, offset del hueco.
void registra_fc(int fun, int pos)
{
    int r;
    r = da_add(dfc_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dfc_pos, pos);
    nfc = nfc + 1;
}


// ============================================================
// TEMPORALES.
//
//
// El mapa de temporales y su asignador, transcritos de
// X86Backend.cpp. busca_tmp da la fila por nombre o -1.
// inserta_tmp escribe una fila con la disciplina de la
// casa: si la fila ya existe fisicamente la reescribe
// con da_set; si es nueva entra por da_add con el nombre
// de guarda. liga_tmp liga o actualiza (la actualizacion
// a registro pone el desplazamiento a cero y la de
// memoria el registro a cero, como la inicializacion
// por agregado del oraculo). libera_tmp es el erase:
// la ultima fila ocupa el hueco, y la constante del
// temporal se borra con el, como en freeTemporary.
// tmp_en_registro devuelve el nombre del dueno de un
// registro o -1. reinicia_temporales pone las cuentas
// a cero: las filas quedan para reuso.
// ============================================================

int busca_tmp(int nom)
{
    int i;
    i = 0;
    while (i < ntmp)
    {
        if (da_get(dtmp_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


int inserta_tmp(int fila, int nom, int kind, int reg, int off)
{
    int r;
    if (fila < da_count(dtmp_nom))
    {
        da_set(dtmp_nom, fila, nom);
        da_set(dtmp_kind, fila, kind);
        da_set(dtmp_reg, fila, reg);
        da_set(dtmp_off, fila, off);
        return 1;
    }
    r = da_add(dtmp_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dtmp_kind, kind);
    r = da_add(dtmp_reg, reg);
    r = da_add(dtmp_off, off);
    return 1;
}


void liga_tmp(int nom, int kind, int reg, int off)
{
    int f;
    int nueva;
    f = busca_tmp(nom);
    nueva = 0;
    if (f < 0)
    {
        f = ntmp;
        nueva = 1;
    }
    if (inserta_tmp(f, nom, kind, reg, off) == 1)
    {
        if (nueva == 1)
        {
            ntmp = ntmp + 1;
        }
    }
}


void liga_tmp_eax(int nom)
{
    liga_tmp(nom, 0, 0, 0);
}


void liga_tmp_ebx(int nom)
{
    liga_tmp(nom, 0, 3, 0);
}


void liga_tmp_mem(int nom, int off)
{
    liga_tmp(nom, 1, 0, off);
}


int busca_const_fila(int nom)
{
    int i;
    i = 0;
    while (i < ncon)
    {
        if (da_get(dcon_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


int busca_const(int nom)
{
    int f;
    f = busca_const_fila(nom);
    if (f < 0)
    {
        return -1;
    }
    return da_get(dcon_val, f);
}


int inserta_con(int fila, int nom, int val)
{
    int r;
    if (fila < da_count(dcon_nom))
    {
        da_set(dcon_nom, fila, nom);
        da_set(dcon_val, fila, val);
        return 1;
    }
    r = da_add(dcon_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dcon_val, val);
    return 1;
}


void anota_const(int nom, int val)
{
    int f;
    int nueva;
    f = busca_const_fila(nom);
    nueva = 0;
    if (f < 0)
    {
        f = ncon;
        nueva = 1;
    }
    if (inserta_con(f, nom, val) == 1)
    {
        if (nueva == 1)
        {
            ncon = ncon + 1;
        }
    }
}


void libera_tmp(int nom)
{
    int f;
    int u;
    int c;
    f = busca_tmp(nom);
    if (f >= 0)
    {
        u = ntmp - 1;
        if (f != u)
        {
            da_set(dtmp_nom, f, da_get(dtmp_nom, u));
            da_set(dtmp_kind, f, da_get(dtmp_kind, u));
            da_set(dtmp_reg, f, da_get(dtmp_reg, u));
            da_set(dtmp_off, f, da_get(dtmp_off, u));
        }
        ntmp = ntmp - 1;
    }
    c = busca_const_fila(nom);
    if (c >= 0)
    {
        u = ncon - 1;
        if (c != u)
        {
            da_set(dcon_nom, c, da_get(dcon_nom, u));
            da_set(dcon_val, c, da_get(dcon_val, u));
        }
        ncon = ncon - 1;
    }
}


int tmp_en_registro(int cod)
{
    int i;
    i = 0;
    while (i < ntmp)
    {
        if (da_get(dtmp_kind, i) == 0)
        {
            if (da_get(dtmp_reg, i) == cod)
            {
                return da_get(dtmp_nom, i);
            }
        }
        i = i + 1;
    }
    return -1;
}


int eax_ocupado()
{
    if (tmp_en_registro(0) >= 0)
    {
        return 1;
    }
    return 0;
}


int ebx_ocupado()
{
    if (tmp_en_registro(3) >= 0)
    {
        return 1;
    }
    return 0;
}


void reinicia_temporales()
{
    ntmp = 0;
    ncon = 0;
}


// ============================================================
// MARCO Y RETENES.
//
//
// El marco EBP de la funcion en curso. abre_marco y
// cierra_marco fijan solo el estado (la emision del
// prologo y del cierre es de B-2). ranura_marco es
// allocateFrameSlot: sin marco activo acusa y devuelve
// 0; con marco, entrega -4, -8, -12... en orden, y la
// misma ranura sirve a los derrames y a las locales de
// pila. Los tres retenes son los emitMov*FramePlace-
// holder del oraculo: sin marco acusan y devuelven -1;
// con marco emiten MOV registro, [EBP + 0] (8B 85 para
// EAX, 8B 9D para EBX, 8B 8D para ECX, con el desplaza-
// miento de 32 bits a cero) en el ByteBuffer de codigo
// y devuelven el offset del hueco, size + 2.
// ============================================================

void abre_marco()
{
    frame_activo = 1;
    frame_slots = 0;
}


void cierra_marco()
{
    frame_activo = 0;
}


int ranura_marco()
{
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    frame_slots = frame_slots + 1;
    return 0 - (4 * frame_slots);
}


int emite_reten_eax()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x85);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}


int emite_reten_ebx()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x9D);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}


int emite_reten_ecx()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x8D);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}


// ============================================================
// DERRAME Y RECARGA.
//
//
// derrama_tmp es spillTemporary: el temporal debe
// existir y vivir en registro; pide su ranura al marco,
// emite MOV [EBP + 0], registro (89 85 si es EAX,
// 89 9D si es EBX) en el ByteBuffer de codigo, registra
// el parche en la lista de derrames de M-1 con el offset
// del hueco (size + 2 antes de emitir) y liga el
// temporal a memoria. Un registro que no sea EAX ni EBX
// acusa despues de consumir la ranura, como el throw
// del oraculo. asigna_registro es allocateRegisterFor-
// Temporary con su politica exacta: si el temporal ya
// vive en registro devuelve el suyo; si EAX esta libre
// lo liga a EAX; si EBX esta libre, a EBX; si no,
// derrama el dueno de EAX y liga a EAX (la rama de
// derramar EBX del oraculo es inalcanzable: si ambos
// estan ocupados, el de EAX siempre existe).
// registro_de es getTemporaryRegister y recarga_tmp es
// reloadTemporary: emite el reten de EAX, registra el
// parche en la lista de recargas y liga el temporal a
// EAX sin desalojar a nadie, como el oraculo.
// ============================================================

void derrama_tmp(int nom)
{
    int f;
    int reg;
    int off;
    int pos;
    f = busca_tmp(nom);
    if (f < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    if (da_get(dtmp_kind, f) != 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    reg = da_get(dtmp_reg, f);
    off = ranura_marco();
    if (off == 0)
    {
        return;
    }
    pos = 0;
    if (reg == 0)
    {
        pos = bytebuffer_get_size(dcod) + 2;
        bytebuffer_append(dcod, 0x89);
        bytebuffer_append(dcod, 0x85);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
    }
    else
    {
        if (reg == 3)
        {
            pos = bytebuffer_get_size(dcod) + 2;
            bytebuffer_append(dcod, 0x89);
            bytebuffer_append(dcod, 0x9D);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
        }
        else
        {
            errores_back = errores_back + 1;
            return;
        }
    }
    registra_spill(nom, pos, off);
    liga_tmp_mem(nom, off);
}


int asigna_registro(int nom)
{
    int f;
    int ocupante;
    f = busca_tmp(nom);
    if (f >= 0)
    {
        if (da_get(dtmp_kind, f) == 0)
        {
            return da_get(dtmp_reg, f);
        }
    }
    if (eax_ocupado() == 0)
    {
        liga_tmp_eax(nom);
        return 0;
    }
    if (ebx_ocupado() == 0)
    {
        liga_tmp_ebx(nom);
        return 3;
    }
    ocupante = tmp_en_registro(0);
    derrama_tmp(ocupante);
    liga_tmp_eax(nom);
    return 0;
}


int registro_de(int nom)
{
    int f;
    f = busca_tmp(nom);
    if (f < 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    if (da_get(dtmp_kind, f) != 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    return da_get(dtmp_reg, f);
}


// ============================================================
// VARIABLES Y CONTEXTOS.
//
//
// El mapa de variables del contexto vivo, el de
// globales y los contextos guardados por funcion.
// declara_var es declareVariable (residencia en DATA,
// con capacidad si es arreglo); declara_var_pila
// transcribe la escritura de la local de pila;
// declara_global registra en el mapa de globales.
// reinicia_variables es resetVariables: vacia el
// contexto vivo y lo siembra con los globales, que se
// ven en todas las funciones. reserva_datos es
// allocateVariableData: devuelve el offset actual del
// ByteBuffer de datos y lo crece en 4 * n ceros.
// guarda_contexto copia las filas del contexto vivo a
// las filas guardadas y anota el directorio (funcion,
// fila inicial, filas); contexto_de devuelve la entrada
// mas reciente de una funcion o -1. Los contextos los
// leeran las pasadas de resolucion de B-2 en adelante.
// ============================================================

int busca_var(int nom)
{
    int i;
    i = 0;
    while (i < nvar)
    {
        if (da_get(dvar_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


int inserta_var(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dvar_nom))
    {
        da_set(dvar_nom, fila, nom);
        da_set(dvar_dat, fila, dat);
        da_set(dvar_stack, fila, stack);
        da_set(dvar_soff, fila, soff);
        da_set(dvar_cap, fila, cap);
        return 1;
    }
    r = da_add(dvar_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dvar_dat, dat);
    r = da_add(dvar_stack, stack);
    r = da_add(dvar_soff, soff);
    r = da_add(dvar_cap, cap);
    return 1;
}


void declara_var(int nom, int dat, int cap)
{
    int f;
    int nueva;
    f = busca_var(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nvar;
        nueva = 1;
    }
    if (inserta_var(f, nom, dat, 0, 0, cap) == 1)
    {
        if (nueva == 1)
        {
            nvar = nvar + 1;
        }
    }
}


void declara_var_pila(int nom, int soff, int cap)
{
    int f;
    int nueva;
    f = busca_var(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nvar;
        nueva = 1;
    }
    if (inserta_var(f, nom, 0, 1, soff, cap) == 1)
    {
        if (nueva == 1)
        {
            nvar = nvar + 1;
        }
    }
}


int busca_glo(int nom)
{
    int i;
    i = 0;
    while (i < nglo)
    {
        if (da_get(dglo_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


int inserta_glo(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dglo_nom))
    {
        da_set(dglo_nom, fila, nom);
        da_set(dglo_dat, fila, dat);
        da_set(dglo_stack, fila, stack);
        da_set(dglo_soff, fila, soff);
        da_set(dglo_cap, fila, cap);
        return 1;
    }
    r = da_add(dglo_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dglo_dat, dat);
    r = da_add(dglo_stack, stack);
    r = da_add(dglo_soff, soff);
    r = da_add(dglo_cap, cap);
    return 1;
}


void declara_global(int nom, int dat, int cap)
{
    int f;
    int nueva;
    f = busca_glo(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nglo;
        nueva = 1;
    }
    if (inserta_glo(f, nom, dat, 0, 0, cap) == 1)
    {
        if (nueva == 1)
        {
            nglo = nglo + 1;
        }
    }
}


void reinicia_variables()
{
    int i;
    nvar = 0;
    i = 0;
    while (i < nglo)
    {
        if (inserta_var(i, da_get(dglo_nom, i), da_get(dglo_dat, i), da_get(dglo_stack, i), da_get(dglo_soff, i), da_get(dglo_cap, i)) == 1)
        {
            nvar = nvar + 1;
        }
        i = i + 1;
    }
}


int reserva_datos(int n)
{
    int off;
    int i;
    off = bytebuffer_get_size(ddat);
    i = 0;
    while (i < 4 * n)
    {
        bytebuffer_append(ddat, 0);
        i = i + 1;
    }
    return off;
}


int inserta_sv(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dsv_nom))
    {
        da_set(dsv_nom, fila, nom);
        da_set(dsv_dat, fila, dat);
        da_set(dsv_stack, fila, stack);
        da_set(dsv_soff, fila, soff);
        da_set(dsv_cap, fila, cap);
        return 1;
    }
    r = da_add(dsv_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dsv_dat, dat);
    r = da_add(dsv_stack, stack);
    r = da_add(dsv_soff, soff);
    r = da_add(dsv_cap, cap);
    return 1;
}


int inserta_ctx(int fila, int fun, int ini, int n)
{
    int r;
    if (fila < da_count(dctx_fun))
    {
        da_set(dctx_fun, fila, fun);
        da_set(dctx_ini, fila, ini);
        da_set(dctx_n, fila, n);
        return 1;
    }
    r = da_add(dctx_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dctx_ini, ini);
    r = da_add(dctx_n, n);
    return 1;
}


void guarda_contexto(int fun)
{
    int i;
    int ini;
    ini = nsv;
    i = 0;
    while (i < nvar)
    {
        if (inserta_sv(nsv, da_get(dvar_nom, i), da_get(dvar_dat, i), da_get(dvar_stack, i), da_get(dvar_soff, i), da_get(dvar_cap, i)) == 0)
        {
            return;
        }
        nsv = nsv + 1;
        i = i + 1;
    }
    if (inserta_ctx(nctx, fun, ini, nvar) == 1)
    {
        nctx = nctx + 1;
    }
}


int contexto_de(int fun)
{
    int i;
    i = nctx - 1;
    while (i >= 0)
    {
        if (da_get(dctx_fun, i) == fun)
        {
            return i;
        }
        i = i - 1;
    }
    return -1;
}


// ============================================================
// ENTRADA IR.
//
// El programa que consume generate(): una lista plana
// de instrucciones (opcode, nombre, operando,
// resultado, valor) con los Declare globales al frente
// — dir_nglob marca cuantos son. registra_ir es la
// unica puerta de entrada, con la disciplina de
// insercion y reuso de la casa. Los textos viven en
// dpool y se referencian ini * 128 + largo, el formato
// de la piscina de la biblioteca; quien produce el IR
// interna los nombres (una sola referencia por texto),
// y el operando de parametros de un FunctionBegin se
// construye de modo que la referencia de cada
// parametro es la de su subcadena dentro del operando,
// que es la que el parseo de genera() devuelve. Este
// es el arnes de entrada de la pieza sola: en el
// compilador ensamblado el IR llega por el mango del
// generador (M-6).
// ============================================================

void reinicia_ir()
{
    dir_op = da_create(region_backend, 256);
    dir_nom = da_create(region_backend, 256);
    dir_ope = da_create(region_backend, 256);
    dir_res = da_create(region_backend, 256);
    dir_val = da_create(region_backend, 256);
    dir_aux = da_create(region_backend, 256);
    dpool = string_pool_create(region_backend);
    ndir = 0;
    dir_nglob = 0;
}


void registra_ir(int op, int nom, int ope, int res, int val)
{
    if (ndir < da_count(dir_op))
    {
        da_set(dir_op, ndir, op);
        da_set(dir_nom, ndir, nom);
        da_set(dir_ope, ndir, ope);
        da_set(dir_res, ndir, res);
        da_set(dir_val, ndir, val);
        da_set(dir_aux, ndir, 0);
    }
    else
    {
        da_add(dir_op, op);
        da_add(dir_nom, nom);
        da_add(dir_ope, ope);
        da_add(dir_res, res);
        da_add(dir_val, val);
        da_add(dir_aux, 0);
    }
    ndir = ndir + 1;
}


// El auxiliar de la ultima instruccion registrada
// (el temporal de conteo de FileWrite).
void registra_aux(int ref)
{
    da_set(dir_aux, ndir - 1, ref);
}


int texto_len(int ref)
{
    return string_pool_len(dpool, ref);
}


int texto_ini(int ref)
{
    return ref / 128;
}


int texto_char(int ref, int i)
{
    return string_pool_get_char(dpool, texto_ini(ref), i);
}


int texto_es_main(int ref)
{
    if (texto_len(ref) != 4)
    {
        return 0;
    }
    if (texto_char(ref, 0) != 109)
    {
        return 0;
    }
    if (texto_char(ref, 1) != 97)
    {
        return 0;
    }
    if (texto_char(ref, 2) != 105)
    {
        return 0;
    }
    if (texto_char(ref, 3) != 110)
    {
        return 0;
    }
    return 1;
}


