// El titulo de la piscina: "K++ - KolibriOS" y su
// NUL, 16 bytes.
void agrega_titulo_datos()
{
    int tb[15];
    int i;
    tb[0] = 75;
    tb[1] = 43;
    tb[2] = 43;
    tb[3] = 32;
    tb[4] = 45;
    tb[5] = 32;
    tb[6] = 75;
    tb[7] = 111;
    tb[8] = 108;
    tb[9] = 105;
    tb[10] = 98;
    tb[11] = 114;
    tb[12] = 105;
    tb[13] = 79;
    tb[14] = 83;
    i = 0;
    while (i < 15)
    {
        bytebuffer_append(ddat, tb[i]);
        i = i + 1;
    }
    bytebuffer_append(ddat, 0);
}


// La construccion de DATA del cierre, en el orden
// exacto del oraculo, y al final la base: 36 (la
// cabecera) + el tamano del codigo.
void construye_datos()
{
    int codigo;
    int i;
    int t;
    int r;
    codigo = bytebuffer_get_size(dcod);
    if (ndibuf > 0)
    {
        off_entero = bytebuffer_get_size(ddat);
        agrega_ceros(16);
    }
    o_cabeza = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_cuenta = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_primera = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_cursor = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_lineas = bytebuffer_get_size(ddat);
    agrega_ceros(32768);
    o_pulgar = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_altura = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_arrastre = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_agarre = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_menu = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_selec = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_cliplen = bytebuffer_get_size(ddat);
    agrega_ceros(4);
    o_clip = bytebuffer_get_size(ddat);
    agrega_ceros(12 + 512 * 42);
    o_texto = bytebuffer_get_size(ddat);
    agrega_menu_datos();
    o_titulo = bytebuffer_get_size(ddat);
    agrega_titulo_datos();
    nsco = 0;
    i = 0;
    while (i < ntextos)
    {
        t = da_get(dtextos_nom, i);
        r = da_add(dsco_off, bytebuffer_get_size(ddat));
        if (r < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        nsco = nsco + 1;
        r = 0;
        while (r < texto_len(t))
        {
            bytebuffer_append(ddat, texto_char(t, r));
            r = r + 1;
        }
        bytebuffer_append(ddat, 0);
        i = i + 1;
    }
    if (necesita_io == 1)
    {
        o_scratch = bytebuffer_get_size(ddat);
        agrega_ceros(65536);
        while (bytebuffer_get_size(ddat) - (bytebuffer_get_size(ddat) / 4) * 4 != 0)
        {
            bytebuffer_append(ddat, 0);
        }
        o_params = bytebuffer_get_size(ddat);
        agrega_ceros(25);
    }
    base_datos = 36 + codigo;
}


// El relleno de las constantes de cadena: el
// indice fuera de la piscina acusa y detiene la
// pasada.
void rellena_sc()
{
    int i;
    int pos;
    int idx;
    i = 0;
    while (i < nsc)
    {
        pos = da_get(dsc_pos, i);
        idx = da_get(dsc_idx, i);
        if (idx >= nsco)
        {
            errores_back = errores_back + 1;
            return;
        }
        parche32(pos, base_datos + da_get(dsco_off, idx));
        i = i + 1;
    }
}


// La fila de un nombre en el contexto guardado de
// una funcion, o -1.
int busca_sv(int ci, int nom)
{
    int ini;
    int n;
    int k;
    ini = da_get(dctx_ini, ci);
    n = da_get(dctx_n, ci);
    k = 0;
    while (k < n)
    {
        if (da_get(dsv_nom, ini + k) == nom)
        {
            return ini + k;
        }
        k = k + 1;
    }
    return -1;
}


// La resolucion de los parches de archivo (fase 5
// del oraculo): escribe vale 1 para las escrituras
// y 0 para las lecturas. Revalida la funcion, el
// arreglo en su contexto guardado, la capacidad,
// los limites y que ambos huecos sigan a cero, y
// parcha las dos direcciones absolutas. El primer
// error detiene la pasada.
void resuelve_io(int escribe)
{
    int n;
    int i;
    int fun;
    int arr;
    int ruta;
    int phue;
    int ahue;
    int cap;
    int dhue;
    int ci;
    int fila;
    int acap;
    int aoff;
    int total;
    int cs;
    int ceros;
    int k;
    if (escribe == 1)
    {
        n = nfw;
    }
    else
    {
        n = nfr;
    }
    i = 0;
    while (i < n)
    {
        if (escribe == 1)
        {
            fun = da_get(dfw_fun, i);
            arr = da_get(dfw_arr, i);
            ruta = da_get(dfw_ruta, i);
            phue = da_get(dfw_phue, i);
            ahue = da_get(dfw_ahue, i);
            cap = da_get(dfw_cap, i);
            dhue = da_get(dfw_hue, i);
        }
        else
        {
            fun = da_get(dfr_fun, i);
            arr = da_get(dfr_arr, i);
            ruta = da_get(dfr_ruta, i);
            phue = da_get(dfr_phue, i);
            ahue = da_get(dfr_ahue, i);
            cap = da_get(dfr_cap, i);
            dhue = da_get(dfr_hue, i);
        }
        if (texto_len(fun) == 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        ci = contexto_de(fun);
        if (ci < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (texto_len(arr) == 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        fila = busca_sv(ci, arr);
        if (fila < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (da_get(dsv_stack, fila) == 1)
        {
            errores_back = errores_back + 1;
            return;
        }
        acap = da_get(dsv_cap, fila);
        if (acap == 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (cap == 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (cap != acap)
        {
            errores_back = errores_back + 1;
            return;
        }
        aoff = da_get(dsv_dat, fila);
        total = bytebuffer_get_size(ddat);
        if (aoff >= total)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (acap > (total - aoff) / 4)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (ruta >= total)
        {
            errores_back = errores_back + 1;
            return;
        }
        cs = bytebuffer_get_size(dcod);
        if (phue > cs)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (cs - phue < 4)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (ahue > cs)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (cs - ahue < 4)
        {
            errores_back = errores_back + 1;
            return;
        }
        if (phue == ahue)
        {
            errores_back = errores_back + 1;
            return;
        }
        ceros = 1;
        k = 0;
        while (k < 4)
        {
            if (bytebuffer_get(dcod, phue + k) != 0)
            {
                ceros = 0;
            }
            if (bytebuffer_get(dcod, ahue + k) != 0)
            {
                ceros = 0;
            }
            k = k + 1;
        }
        if (ceros == 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        parche32(phue, base_datos + ruta);
        parche32(ahue, base_datos + aoff);
        if (escribe == 1)
        {
            parche_rel(dhue, dir_escritura);
        }
        else
        {
            parche_rel(dhue, dir_lectura);
        }
        i = i + 1;
    }
}


// Los derrames: el hueco recibe el desplazamiento
// del marco, tal cual (negativo).
void rellena_sp9()
{
    int i;
    i = 0;
    while (i < nsp)
    {
        parche32(da_get(dsp_pos, i), da_get(dsp_dat, i));
        i = i + 1;
    }
}


// Las recargas: idem.
void rellena_rl9()
{
    int i;
    i = 0;
    while (i < nrl)
    {
        parche32(da_get(drl_pos, i), da_get(drl_dat, i));
        i = i + 1;
    }
}


// Las cargas de variable: dataBase + el
// desplazamiento en DATA del contexto guardado.
void rellena_vl9()
{
    int i;
    int ci;
    int fila;
    i = 0;
    while (i < nvl)
    {
        ci = contexto_de(da_get(dvl_fun, i));
        if (ci < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        fila = busca_sv(ci, da_get(dvl_nom, i));
        if (fila < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        parche32(da_get(dvl_pos, i), base_datos + da_get(dsv_dat, fila));
        i = i + 1;
    }
}


// Los almacenes de variable: idem.
void rellena_vs9()
{
    int i;
    int ci;
    int fila;
    i = 0;
    while (i < nvs)
    {
        ci = contexto_de(da_get(dvs_fun, i));
        if (ci < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        fila = busca_sv(ci, da_get(dvs_nom, i));
        if (fila < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        parche32(da_get(dvs_pos, i), base_datos + da_get(dsv_dat, fila));
        i = i + 1;
    }
}


// El buffer de impresion entera: cada hueco
// recibe el fin del buffer (su desplazamiento en
// DATA + 16), en direccion absoluta.
void rellena_dibuf()
{
    int dirbuf;
    int i;
    if (ndibuf > 0)
    {
        dirbuf = base_datos + off_entero + 16;
        i = 0;
        while (i < ndibuf)
        {
            parche32(da_get(dibuf_pos, i), dirbuf);
            i = i + 1;
        }
    }
}


// La pasada de cierre completa, en el orden del
// oraculo tras rellena_fc(): construir DATA y la
// base, constantes de cadena, archivo (escrituras
// y luego lecturas), derrames, recargas, cargas,
// almacenes y el buffer de impresion entera.
void cierra_genera()
{
    construye_datos();
    rellena_sc();
    resuelve_io(1);
    resuelve_io(0);
    rellena_sp9();
    rellena_rl9();
    rellena_vl9();
    rellena_vs9();
    rellena_dibuf();
}


// ============================================================
// GENERA: EL ESQUELETO DE GENERATE().
//
// La transcripcion del generate() de Stage 0 en su
// esqueleto: las dos pasadas previas, el paseo por la
// lista plana y el cierre. En el oraculo el paseo
// recorre las IRFunction una a una y llama a
// finishCurrentFunctionFrame al final de cada una;
// en la lista plana ese cierre es el FunctionEnd
// (opcode 1), que en la cadena del oraculo no tiene
// rama. El FunctionBegin tambien llama al cierre
// antes de abrir su marco, como en el oraculo.
//
// Las listas dent_*, dret_pos y dtextos_nom son las
// locales de generate() en el oraculo (functionEntries,
// returnEventLoopPatches y los textos recogidos):
// nacen en cada llamada a genera(). Los parches que
// el paseo registra (vl, vs, sc, spill, reload y los
// del event loop en dret_pos) quedan pendientes: su
// resolucion contra dataBase es la pasada final de
// B-9, y los del runtime (la entrada del principal y
// el destino del event loop) son del runtime, tambien
// B-9. El parche del tamano del marco si se resuelve
// en el paseo, en cierra_funcion, como en el oraculo.
//
// La rama de parametros de FunctionBegin: en el
// oraculo la rama de DATA es inalcanzable (el marco
// acaba de abrirse y frameActive ya vale), asi que
// solo se transcribe la viva, la de la pila. La
// diagnostica del asignador que el oraculo escribe en
// cerr no es parte del binario y no se transcribe.
// ============================================================

void registra_entrada(int fun, int pos)
{
    if (ndent < da_count(dent_fun))
    {
        da_set(dent_fun, ndent, fun);
        da_set(dent_pos, ndent, pos);
    }
    else
    {
        da_add(dent_fun, fun);
        da_add(dent_pos, pos);
    }
    ndent = ndent + 1;
}


void registra_ret(int pos)
{
    if (nret < da_count(dret_pos))
    {
        da_set(dret_pos, nret, pos);
    }
    else
    {
        da_add(dret_pos, pos);
    }
    nret = nret + 1;
}


void registra_texto(int nom)
{
    if (ntextos < da_count(dtextos_nom))
    {
        da_set(dtextos_nom, ntextos, nom);
    }
    else
    {
        da_add(dtextos_nom, nom);
    }
    ntextos = ntextos + 1;
}


void cierra_funcion()
{
    if (frame_activo == 0)
    {
        return;
    }
    em_mov_eax_imm(0);
    em_mov_esp_ebp();
    em_pop_ebp();
    if (texto_es_main(fun_actual) == 1)
    {
        em_byte(233);
        registra_ret(em_hueco());
    }
    else
    {
        em_ret();
    }
    parche32(pos_marco, frame_slots * 4);
    cierra_marco();
}


void genera()
{
    int i;
    int op;
    int nom;
    int ope;
    int res;
    int val;
    int fila;
    int reg;
    int off;
    int pos;
    int j;
    int dup;
    int ppos;
    int indice;
    int largo;
    int coma;
    int fin;
    int a;
    int z;
    int refpar;
    int izq;
    int der;
    int fila2;
    int ki;
    int ri;
    int kd;
    int rd;
    int tb;
    int i2;
    int n2;
    int cte;
    int dereax;
    int argx;
    int narg;
    int src;
    int oix;
    int kv;
    int rv;
    int ova;
    int aux;
    int cap;
    int ruta;
    int phue;
    int ahue;
    int nula;
    dent_fun = da_create(region_backend, 256);
    dent_pos = da_create(region_backend, 256);
    dret_pos = da_create(region_backend, 256);
    dref_pos = da_create(region_backend, 256);
    dtextos_nom = da_create(region_backend, 256);
    ndent = 0;
    nret = 0;
    nref = 0;
    ntextos = 0;
    detq_fun = da_create(region_backend, 256);
    detq_etq = da_create(region_backend, 256);
    detq_pos = da_create(region_backend, 256);
    dcf_fun = da_create(region_backend, 256);
    netq = 0;
    darg = da_create(region_backend, 256);
    ndarg = 0;
    dshr_nom = da_create(region_backend, 256);
    dshr_tam = da_create(region_backend, 256);
    dshr_off = da_create(region_backend, 256);
    dfun_nom = da_create(region_backend, 256);
    ddcl_nom = da_create(region_backend, 256);
    nshr = 0;
    nfunarr = 0;
    ndcl = 0;
    dibuf_pos = da_create(region_backend, 256);
    dfw_fun = da_create(region_backend, 256);
    dfw_arr = da_create(region_backend, 256);
    dfw_ruta = da_create(region_backend, 256);
    dfw_phue = da_create(region_backend, 256);
    dfw_ahue = da_create(region_backend, 256);
    dfw_cap = da_create(region_backend, 256);
    dfw_hue = da_create(region_backend, 256);
    dfr_fun = da_create(region_backend, 256);
    dfr_arr = da_create(region_backend, 256);
    dfr_ruta = da_create(region_backend, 256);
    dfr_phue = da_create(region_backend, 256);
    dfr_ahue = da_create(region_backend, 256);
    dfr_cap = da_create(region_backend, 256);
    dfr_hue = da_create(region_backend, 256);
    dsco_off = da_create(region_backend, 256);
    ndibuf = 0;
    nfw = 0;
    nfr = 0;
    nsco = 0;
    nprint = 0;
    necesita_io = 0;
    base_datos = 0;
    off_entero = 0;
    o_cabeza = 0;
    o_cuenta = 0;
    o_primera = 0;
    o_cursor = 0;
    o_lineas = 0;
    o_pulgar = 0;
    o_altura = 0;
    o_arrastre = 0;
    o_agarre = 0;
    o_menu = 0;
    o_selec = 0;
    o_cliplen = 0;
    o_clip = 0;
    o_texto = 0;
    o_titulo = 0;
    o_scratch = 0;
    o_params = 0;
    i = dir_nglob;
    while (i < ndir)
    {
        if (da_get(dir_op, i) == 9)
        {
            necesita_io = 1;
        }
        if (da_get(dir_op, i) == 10)
        {
            necesita_io = 1;
        }
        i = i + 1;
    }
    fun_actual = 0;
    pos_main = 0;
    idx_sc = 0;
    i = dir_nglob;
    while (i < ndir)
    {
        if (da_get(dir_op, i) == 3)
        {
            registra_texto(da_get(dir_nom, i));
        }
        i = i + 1;
    }
    i = dir_nglob;
    while (i < ndir)
    {
        if (da_get(dir_op, i) == 0)
        {
            ndcl = 0;
        }
        else if (da_get(dir_op, i) == 4 && da_get(dir_val, i) > 0)
        {
            src = fuente_de(da_get(dir_nom, i));
            if (busca_dcl(src) < 0)
            {
                registra_dcl(src);
                fila = busca_shr(src);
                if (fila < 0)
                {
                    registra_shr(src, da_get(dir_val, i));
                }
                else if (da_get(dir_val, i) > da_get(dshr_tam, fila))
                {
                    da_set(dshr_tam, fila, da_get(dir_val, i));
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < dir_nglob)
    {
        if (da_get(dir_op, i) == 4)
        {
            off = reserva_datos(1);
            declara_global(da_get(dir_nom, i), off, 0);
        }
        i = i + 1;
    }
    i = dir_nglob;
    while (i < ndir)
    {
        op = da_get(dir_op, i);
        nom = da_get(dir_nom, i);
        ope = da_get(dir_ope, i);
        res = da_get(dir_res, i);
        val = da_get(dir_val, i);
        aux = da_get(dir_aux, i);
        if (op == 1)
        {
            cierra_funcion();
        }
        if (op == 0)
        {
            cierra_funcion();
            if (texto_len(nom) == 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            dup = 0;
            j = 0;
            while (j < ndent)
            {
                if (da_get(dent_fun, j) == nom)
                {
