//
// Aplica, sobre el codigo ya cerrado por genera(),
// los parches que generate() de Stage 0 resuelve
// contra el Result del Runtime y que el genera() de
// la pieza no puede ver, porque su mundo termina en
// el prefijo. Los parches tocan posiciones ajenas
// entre si, asi que el orden entre pasadas no cambia
// el resultado; se sigue el de generate().
//
// - PATCH MAIN: el salto E9 de la cabecera del
//   prefijo (res_main, medido por el Runtime) al
//   cuerpo de main (pos_main, medido por el Backend
//   en su paseo). Relativo, con parche_rel.
// - PATCH RETURN: cada salto de retorno de main
//   registrado por el Backend en dret_pos, al bucle
//   de eventos del prefijo (res_bucle).
// - LAS CATORCE LISTAS: cada posicion registrada por
//   los emisores del prefijo contra direcciones
//   moffs, rellenada con base_datos mas el offset de
//   su lista en la DATA que construye_datos() acaba
//   de construir — el mismo emparejamiento, lista a
//   offset, que el Result de Stage 0 declara.
// - PATCH TITULO: el puntero y la caption de la
//   ventana (res_titulo, res_cap) a la direccion del
//   titulo en la DATA (base_datos + o_titulo).
// - PATCH DIRECCIONES DE ARCHIVO, solo si el
//   programa usa archivos: las cuatro direcciones
//   del Result de archivo (las params y el scratch
//   de escritura y de lectura) a base_datos +
//   o_params y base_datos + o_scratch, la DATA que
//   el Backend aparto al final para las rutinas.
// ============================================================

void parche_lista(int lista, int cuenta, int destino)
{
    int i;
    int pos;
    i = 0;
    while (i < cuenta)
    {
        pos = da_get(lista, i);
        parche32(pos, destino);
        i = i + 1;
    }
}


void rellena_costura()
{
    int i;
    int pos;
    parche_rel(res_main, pos_main);
    i = 0;
    while (i < nret)
    {
        pos = da_get(dret_pos, i);
        parche_rel(pos, res_bucle);
        i = i + 1;
    }
    parche_lista(dpl_buf, npl_buf, base_datos + o_lineas);
    parche_lista(dpl_cnt, npl_cnt, base_datos + o_cuenta);
    parche_lista(dpl_cab, npl_cab, base_datos + o_cabeza);
    parche_lista(dpl_vis, npl_vis, base_datos + o_primera);
    parche_lista(dpl_cur, npl_cur, base_datos + o_cursor);
    parche_lista(dpl_top, npl_top, base_datos + o_pulgar);
    parche_lista(dpl_alt, npl_alt, base_datos + o_altura);
    parche_lista(dpl_est, npl_est, base_datos + o_arrastre);
    parche_lista(dpl_agr, npl_agr, base_datos + o_agarre);
    parche_lista(dpl_men, npl_men, base_datos + o_menu);
    parche_lista(dpl_sel, npl_sel, base_datos + o_selec);
    parche_lista(dpl_len, npl_len, base_datos + o_cliplen);
    parche_lista(dpl_clip, npl_clip, base_datos + o_clip);
    parche_lista(dpl_txt, npl_txt, base_datos + o_texto);
    parche32(res_titulo, base_datos + o_titulo);
    parche32(res_cap, base_datos + o_titulo);
    if (ens_necesita_io == 1)
    {
        parche32(res_esc_scratch, base_datos + o_scratch);
        parche32(res_esc_params, base_datos + o_params);
        parche32(res_lec_scratch, base_datos + o_scratch);
        parche32(res_lec_params, base_datos + o_params);
    }
    i = 0;
    while (i < nref)
    {
        pos = da_get(dref_pos, i);
        parche_rel(pos, res_refresco);
        i = i + 1;
    }
}


// ============================================================
// LA ESCRITURA DEL EJECUTABLE (D6).
//
// pon32_imagen escribe un entero de 32 bits en
// little-endian dentro de imagen, el arreglo que
// escribe_bin y el comparten por nombre (el
// mecanismo de arreglos compartidos de la casa), y
// devuelve la posicion siguiente. Los valores que
// escribe son tamanos, nunca negativos.
//
// escribe_bin compone el archivo final como el
// Writer de Stage 0: la cabecera de 36 bytes del
// enum Menuet01 — la firma MENUET01, la version, el
// inicio en 36, el fin de la imagen y, con la pila
// de 4096, el fin de memoria y el tope de pila; los
// campos de parametros y ruta a cero —, despues el
// codigo (el prefijo, el bloque de archivos si lo
// hay y el cuerpo, ya un solo dcod) y la DATA. Lo
// escribe a SALIDA.BIN con file_write, la forma que
// la pieza BinaryWriter declara suya.
// ============================================================

int pon32_imagen(int pos, int v)
{
    int imagen[1048576];
    int r;
    r = v;
    imagen[pos] = r - (r / 256) * 256;
    r = r / 256;
    imagen[pos + 1] = r - (r / 256) * 256;
    r = r / 256;
    imagen[pos + 2] = r - (r / 256) * 256;
    r = r / 256;
    imagen[pos + 3] = r - (r / 256) * 256;
    return pos + 4;
}


void escribe_bin()
{
    int imagen[1048576];
    int total;
    int i;
    int tam_cod;
    int tam_dat;
    int fin;
    int r;
    tam_cod = bytebuffer_get_size(dcod);
    tam_dat = bytebuffer_get_size(ddat);
    fin = 36 + tam_cod + tam_dat;
    imagen[0] = 77;
    imagen[1] = 69;
    imagen[2] = 78;
    imagen[3] = 85;
    imagen[4] = 69;
    imagen[5] = 84;
    imagen[6] = 48;
    imagen[7] = 49;
    total = 8;
    total = pon32_imagen(total, 1);
    total = pon32_imagen(total, 36);
    total = pon32_imagen(total, fin);
    total = pon32_imagen(total, fin + 4096);
    total = pon32_imagen(total, fin + 4096);
    total = pon32_imagen(total, 0);
    total = pon32_imagen(total, 0);
    i = 0;
    while (i < tam_cod)
    {
        imagen[total] = bytebuffer_get(dcod, i);
        total = total + 1;
        i = i + 1;
    }
    i = 0;
    while (i < tam_dat)
    {
        imagen[total] = bytebuffer_get(ddat, i);
        total = total + 1;
        i = i + 1;
    }
    r = file_write("SALIDA.BIN", imagen, total);
}


// ============================================================
// LA NECESIDAD DE DATA Y LA CAPACIDAD DE LA REGION.
//
// datos_del_ir() calcula, sobre el IR ya registrado
// y antes de que genera() emita nada, cuantos bytes
// de DATA va a construir el paseo: simula sus
// mismas pasadas de reserva (los Declare globales a
// 4, los arreglos compartidos al maximo por fuente
// con alias y sombras, las rutas de archivo, los
// textos de StringConst) y suma lo fijo de
// construye_datos (16 de los escalares del runtime,
// 32768 del buffer de lineas, 28 de pulgar a
// cliplen, 21516 del portapapeles, 84 del menu y 16
// del titulo), el buffer de impresion entera (16,
// si hay algun PrintInteger: la cota superior, el
// paseo lo abre solo si alguna impresion lo usa) y,
// si el IR usa archivos, el scratch de 65536 con
// su alineacion exacta y los 25 de parametros.
//
// capacidad_region() convierte la necesidad en la
// reserva con que se crea la region del backend
// para este programa: la DATA exacta, una cota de
// codigo de 96 celdas por instruccion y una cota
// de estructuras de 32768 + 128 por instruccion,
// con el margen x2 de la casa (la banda x1.4-x3.5
// de las capacidades diferenciadas, 2026-11-20).
// Sin memoria dinamica: la region nace con su
// tamano, derivado del trabajo, y no crece.
// ============================================================

int datos_del_ir()
{
    int n;
    int i;
    int f;
    int datos;
    int src;
    int pos;
    int esta;
    int io;
    int fsrc[512];
    int fmax[512];
    int nf;
    int varr[512];
    int nv;
    int rsrc[512];
    int nr;
    n = ndir;
    nf = 0;
    i = dir_nglob;
    while (i < n)
    {
        if (da_get(dir_op, i) == 4)
        {
            src = fuente_de(da_get(dir_nom, i));
            pos = -1;
            f = 0;
            while (f < nf)
            {
                if (fsrc[f] == src)
                {
                    pos = f;
                }
                f = f + 1;
            }
            if (pos < 0)
            {
                fsrc[nf] = src;
                fmax[nf] = da_get(dir_val, i);
                nf = nf + 1;
            }
            else
            {
                if (da_get(dir_val, i) > fmax[pos])
                {
                    fmax[pos] = da_get(dir_val, i);
                }
            }
        }
        i = i + 1;
    }
    datos = 0;
    i = 0;
    while (i < dir_nglob)
    {
        if (da_get(dir_op, i) == 4)
        {
            datos = datos + 4;
        }
        i = i + 1;
    }
    nv = 0;
    nr = 0;
    i = dir_nglob;
    while (i < n)
    {
        if (da_get(dir_op, i) == 0)
        {
            nv = 0;
        }
        if (da_get(dir_op, i) == 4)
        {
            if (da_get(dir_val, i) > 0)
            {
                src = fuente_de(da_get(dir_nom, i));
                esta = 0;
                f = 0;
                while (f < nv)
                {
                    if (varr[f] == src)
                    {
                        esta = 1;
                    }
                    f = f + 1;
                }
                if (esta == 1)
                {
                    datos = datos + 4 * da_get(dir_val, i);
                }
                else
                {
                    varr[nv] = src;
                    nv = nv + 1;
                    esta = 0;
                    f = 0;
                    while (f < nr)
                    {
                        if (rsrc[f] == src)
                        {
                            esta = 1;
                        }
                        f = f + 1;
                    }
                    if (esta == 0)
                    {
                        rsrc[nr] = src;
                        nr = nr + 1;
                        f = 0;
                        while (f < nf)
                        {
                            if (fsrc[f] == src)
                            {
                                datos = datos + 4 * fmax[f];
                            }
                            f = f + 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    io = 0;
    i = dir_nglob;
    while (i < n)
    {
        if (da_get(dir_op, i) == 9)
        {
            io = 1;
            datos = datos + texto_len(da_get(dir_nom, i)) + 1;
        }
        if (da_get(dir_op, i) == 10)
        {
            io = 1;
            datos = datos + texto_len(da_get(dir_nom, i)) + 1;
        }
        i = i + 1;
    }
    i = dir_nglob;
    while (i < n)
    {
        if (da_get(dir_op, i) == 3)
        {
            datos = datos + texto_len(da_get(dir_nom, i)) + 1;
        }
        i = i + 1;
    }
    datos = datos + 54428;
    esta = 0;
    i = 0;
    while (i < n)
    {
        if (da_get(dir_op, i) == 42)
        {
            esta = 1;
        }
        i = i + 1;
    }
    if (esta == 1)
    {
        datos = datos + 16;
    }
    if (io == 1)
    {
        datos = datos + 65536;
        datos = datos + (4 - datos % 4) % 4;
        datos = datos + 25;
    }
    return datos;
}


int capacidad_region()
{
    int d;
    int n;
    d = datos_del_ir();
    n = ndir;
    return (d + 96 * n + 32768 + 128 * n) * 2;
}


// ============================================================
// EL PARO DE D-2.
//
// El paro de D-1 con los dos contadores de la mitad
// trasera: si una etapa acusa, la cadena se detiene y no
// se escribe SALIDA.BIN. Los contadores, en orden fijo:
// errores (lexer y parser), serr_count (semantico),
// errores_ir (generador de IR), errores_arena (la arena
// compartida), errores_driver (el driver), errores_back
// (el backend) y errores_rt (el runtime).
// ============================================================

void paro(int etapa)
{
    print("D-2 DETENIDO");
    print_int(etapa);
    print_int(errores);
    print_int(serr_count);
    print_int(errores_ir);
    print_int(errores_arena);
    print_int(errores_driver);
    print_int(errores_back);
    print_int(errores_rt);
}


// ============================================================
// EL PUENTE DE IR (codigo nuevo de D-2).
//
// El IRGenerator deja el IR en seis DynamicArray de su
// region (diop, dinombre, dioperando, diresultado, diaux,
// divalor) y los caracteres en su piscina (dpiscina), con
// las cuentas en nir y pool_len. El puente los copia a los
// arreglos planos fir_* (compartidos por nombre entre las
// funciones que los tocan: en K++ los arreglos no viven en
// el nivel superior), que son el vehiculo entre mundos:
// cada mundo de la mitad trasera abre su arena de cero y
// lo que cruza vive en los planos, como entre las etapas
// delanteras de D-1. Las cotas son los techos del propio
// IRGenerator (2048 instrucciones; la piscina, 8192
// caracteres): si el IR los pasara, el puente acusa en
// errores_driver y la cadena se detiene en la etapa 6.
// Las cuentas salvadas quedan en nir_tras y pool_tras,
// porque reinicia_back pone nir a cero en cada mundo.
// ============================================================

void puente_ir()
{
    int fir_op[2048];
    int fir_nom[2048];
    int fir_ope[2048];
    int fir_res[2048];
    int fir_aux[2048];
    int fir_val[2048];
    int fir_pool[8192];
    int i;
    nir_tras = nir;
    pool_tras = pool_len;
    if (nir_tras > 2048)
    {
        errores_driver = errores_driver + 1;
        return;
    }
    if (pool_tras > 8192)
    {
        errores_driver = errores_driver + 1;
        return;
    }
    i = 0;
    while (i < nir_tras)
    {
        fir_op[i] = da_get(diop, i);
        fir_nom[i] = da_get(dinombre, i);
        fir_ope[i] = da_get(dioperando, i);
        fir_res[i] = da_get(diresultado, i);
        fir_aux[i] = da_get(diaux, i);
        fir_val[i] = da_get(divalor, i);
        i = i + 1;
    }
    i = 0;
    while (i < pool_tras)
    {
        fir_pool[i] = string_pool_get_char(dpiscina, i, 0);
        i = i + 1;
    }
}


// ============================================================
// LOS DOS MUNDOS DE LA MITAD TRASERA (codigo nuevo de
// D-2, el patron de mundo2/mundo_trabajo de B-10).
//
// Cada mundo abre la arena de cero (inicia_arena) y hace
// los nacimientos de la casa: source, frontend y compiler
// a 256, frontend se destruye y backend nace sobre el
// bloque B. El mundo de sondeo nace a 32768, como el
// mundo2 de B-10: registra el IR y calcula la capacidad
// con capacidad_region(). El mundo de trabajo nace con
// esa capacidad y, como el main del Ensamblador de E-1,
// reinicia el runtime antes que el backend (el dcod que
// queda en pie es el del backend, y el prefijo del
// runtime se emite dentro de el: el mecanismo sellado de
// la pieza unida). El sondeo no reinicia el runtime: solo
// dimensiona.
// ============================================================

void mundo_sondeo()
{
    int rf;
    int rb;
    inicia_arena();
    region_source = arena_create(256);
    rf = arena_create(256);
    region_compiler = arena_create(256);
    arena_destroy(rf);
    rb = arena_create(32768);
    region_backend = rb;
    reinicia_back();
    reinicia_ir();
}

void mundo_ensamblador(int cap)
{
    int rf;
    int rb;
    inicia_arena();
    region_source = arena_create(256);
    rf = arena_create(256);
    region_compiler = arena_create(256);
    arena_destroy(rf);
    rb = arena_create(cap);
    region_backend = rb;
    reinicia_rt();
    reinicia_back();
    reinicia_ir();
}


// ============================================================
// LA CARGA INTERNA (codigo nuevo de D-2).
//
// Registra en el mundo en pie el IR que el puente dejo en
// los arreglos planos, con las mismas llamadas y la misma
// cola que el cargador de IR.TXT de E-1 (retirado):
// registra_ir y registra_aux por instruccion, la piscina
// caracter a caracter con string_pool_add_char, pool_len,
// dir_nglob en el primer FUNCTION_BEGIN (op 0) y
// ens_necesita_io si alguna instruccion es de archivo
// (op 9 u op 10). Se llama dos veces: en el mundo de
// sondeo y en el de trabajo.
// ============================================================

void carga_ir_memoria()
{
    int fir_op[2048];
    int fir_nom[2048];
    int fir_ope[2048];
    int fir_res[2048];
    int fir_aux[2048];
    int fir_val[2048];
    int fir_pool[8192];
    int i;
    int r;
    int op;
    i = 0;
    while (i < nir_tras)
    {
        registra_ir(fir_op[i], fir_nom[i], fir_ope[i],
                    fir_res[i], fir_val[i]);
        registra_aux(fir_aux[i]);
        i = i + 1;
    }
    i = 0;
    while (i < pool_tras)
    {
        r = string_pool_add_char(dpool, fir_pool[i]);
        i = i + 1;
    }
    pool_len = pool_tras;
    dir_nglob = ndir;
    i = 0;
    while (i < ndir)
    {
        if (da_get(dir_op, i) == 0)
        {
            dir_nglob = i;
            i = ndir;
        }
        else
        {
            i = i + 1;
        }
    }
    ens_necesita_io = 0;
    i = 0;
    while (i < ndir)
    {
        op = da_get(dir_op, i);
        if (op == 9)
        {
            ens_necesita_io = 1;
        }
        if (op == 10)
        {
            ens_necesita_io = 1;
        }
        i = i + 1;
    }
}


// ============================================================
// MAIN — EL COMPILADOR ENTERO (codigo nuevo de D-2).
//
// El orden es el de src/main.cpp de Stage 0, de la fuente
// al BIN: Lexer, Parser, SemanticAnalyzer, IRGenerator,
// y detras la mitad trasera del Ensamblador (el prefijo
// del runtime, el bloque de archivos si el programa usa
// archivos, genera(), la costura y la escritura). Tras
// cada etapa, la vigilancia: si un contador acusa, paro
// y vuelta con 1, sin escribir el BIN. La fuente se lee
// de FUENTE.KPP y el ejecutable se escribe en SALIDA.BIN
// (las convenciones de la casa). Cada etapa abre su
// propio mundo en su puerta, como en las piezas selladas.
// ============================================================

int main()
{
    int fuente[1024];
    print("COMPILADOR D-2");
    int n = file_read("FUENTE.KPP", fuente);
    if (n < 0)
    {
        print("D-2 SIN FUENTE");
        print_int(n);
        return 1;
    }
    total = n;
    reinicia();
    escanea();
    if (errores != 0)
    {
        paro(1);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(1);
        return 1;
    }
    int raiz = parse_programa();
    if (errores != 0)
    {
        paro(2);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(2);
        return 1;
    }
    puente_nodos();
    if (errores_driver != 0)
    {
        paro(3);
        return 1;
    }
    analiza();
    if (serr_count != 0)
    {
        paro(4);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(4);
        return 1;
    }
    genera_ir();
    if (errores_ir != 0)
    {
        paro(5);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(5);
        return 1;
    }
    puente_ir();
    if (errores_driver != 0)
    {
        paro(6);
        return 1;
    }
    mundo_sondeo();
    carga_ir_memoria();
    cap_trabajo = capacidad_region();
    if (errores_arena != 0)
    {
        paro(6);
        return 1;
    }
    if (errores_back != 0)
    {
        paro(6);
        return 1;
    }
    mundo_ensamblador(cap_trabajo);
    carga_ir_memoria();
    emite_grafico();
    if (ens_necesita_io == 1)
    {
        emite_archivos();
    }
    genera();
    rellena_costura();
    if (errores_back != 0)
    {
        paro(7);
        return 1;
    }
    if (errores_rt != 0)
    {
        paro(7);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(7);
        return 1;
    }
    escribe_bin();
    if (errores_arena != 0)
    {
        paro(8);
        return 1;
    }
    print("SALIDA.BIN ESCRITO");
    print_int(ndir);
    print_int(cap_trabajo);
    return 0;
}
