}

void escribe_ref(int ref)
{
    int ini = ref / 128;
    agrega_entero(ini);
    agrega_sal(10);
    int largo = ref - ini * 128;
    agrega_entero(largo);
    agrega_sal(10);
}

void escribe_ir()
{
    int bufsal[65536];
    nsal = 0;
    int i = 0;
    while (i < nir)
    {
        int op = da_get(diop, i);
        escribe_op(op);
        escribe_ref(da_get(dinombre, i));
        escribe_ref(da_get(dioperando, i));
        escribe_ref(da_get(diresultado, i));
        escribe_ref(da_get(diaux, i));
        agrega_entero(da_get(divalor, i));
        agrega_sal(10);
        i = i + 1;
    }
    agrega_entero(pool_len);
    agrega_sal(10);
    i = 0;
    while (i < pool_len)
    {
        int ch = string_pool_get_char(dpiscina, i, 0);
        agrega_entero(ch);
        agrega_sal(10);
        i = i + 1;
    }
    if (errores_driver != 0)
    {
        return;
    }
    int r = file_write("IR.TXT", bufsal, nsal);
    if (r != 0)
    {
        errores_driver = errores_driver + 1;
    }
}

// ============================================================
// LA VIGILANCIA ENTRE ETAPAS (codigo nuevo de D-1).
//
// paro imprime la detencion: el letrero, la etapa (1 LEXER,
// 2 PARSER, 3 PUENTE, 4 SEMANTICO, 5 IR, 6 SALIDA) y los
// contadores en orden fijo: errores (lexer y parser),
// serr_count, errores_ir, errores_arena y errores_driver.
// ============================================================

void paro(int etapa)
{
    print("D-1 DETENIDO");
    print_int(etapa);
    print_int(errores);
    print_int(serr_count);
    print_int(errores_ir);
    print_int(errores_arena);
    print_int(errores_driver);
}

// ============================================================
// MAIN — EL DRIVER (codigo nuevo de D-1).
//
// El orden es el de src/main.cpp de Stage 0: leer la fuente,
// Lexer, Parser, SemanticAnalyzer, IRGenerator. Tras cada
// etapa, la vigilancia: si un contador acusa, paro y vuelta
// con 1, sin escribir el IR. La fuente se lee de FUENTE.KPP
// (la convencion de la casa) y el IR se escribe en IR.TXT.
// Cada etapa abre su propio mundo en su puerta (reinicia,
// analiza y genera llaman a sus inicia_*), como en las
// piezas selladas: lo que cruza entre etapas vive en los
// arreglos planos compartidos por nombre.
// ============================================================

int main()
{
    int fuente[1024];
    print("COMPILADOR D-1");
    int n = file_read("FUENTE.KPP", fuente);
    if (n < 0)
    {
        print("D-1 SIN FUENTE");
        print_int(n);
        return 1;
    }
    total = n;
    reinicia();
    escanea();
    if (errores != 0)
    {
        paro(1);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(1);
        return 1;
    }
    int raiz = parse_programa();
    if (errores != 0)
    {
        paro(2);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(2);
        return 1;
    }
    puente_nodos();
    if (errores_driver != 0)
    {
        paro(3);
        return 1;
    }
    analiza();
    if (serr_count != 0)
    {
        paro(4);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(4);
        return 1;
    }
    genera();
    if (errores_ir != 0)
    {
        paro(5);
        return 1;
    }
    if (errores_arena != 0)
    {
        paro(5);
        return 1;
    }
    escribe_ir();
    if (errores_driver != 0)
    {
        paro(6);
        return 1;
    }
    print("IR.TXT ESCRITO");
    print_int(nir);
    print_int(pool_len);
    return 0;
}
