    parche32(f_cambio, destino - (f_cambio + 4));
    p = em_jmp_hueco();
    registra_parche(p, 1, 3);
}


void emite_isla_edit()
{
    // La isla del boton EDIT: si su menu esta
    // abierto lo cierra; si no, lo abre. En
    // ambos casos redibuja y vuelve al bucle
    // (las llamadas y el salto se registran
    // con duena 4).
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int cerrar = em_je_hueco();
    em_mov_eax_imm(1);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    registra_parche(em_jmp_hueco(), 1, 4);
    parche32(cerrar,
             bytebuffer_get_size(dcod) - (cerrar + 4));
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    registra_parche(em_jmp_hueco(), 1, 4);
}


void emite_isla_cortar()
{
    // CORTAR: con el menu EDIT abierto y la
    // seleccion activa, copia y vacia, cierra
    // el menu y redibuja; si la guarda falla,
    // vuelve al bucle sin actuar.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int g1 = em_jne_hueco();
    em_mov_eax_mem(10);
    em_cmp_eax_imm(0);
    int g2 = em_je_hueco();
    registra_parche(em_call_hueco(), 11, 4);
    registra_parche(em_call_hueco(), 13, 4);
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    parche32(g2, salir - (g2 + 4));
    registra_parche(em_jmp_hueco(), 1, 4);
}


