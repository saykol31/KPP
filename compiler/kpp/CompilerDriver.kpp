// ============================================================
// CompilerDriver.kpp — Stage 1, el compilador entero.
//
// Rebanada D-2 (2026-11-24): la cadena entera fuente -> BIN
// en un solo programa. Unifica el CompilerDriver de D-1
// (Lexer + Parser + SemanticAnalyzer + IRGenerator bajo un
// main, sellado en 39682d1) con el Ensamblador de E-1
// (KolibriRuntime + X86Backend + la costura, sellado en
// 2847d67), y cierra los dos huecos que el mapa de E-1 dejo
// registrados: E-2 (los huecos de llamada al refresco que
// genera() descartaba: sin ellos el BIN de un programa con
// Print salia con la llamada a cero) y E-3 (el hueco de la
// llamada de E/S de archivos, que resuelve_io no
// rellenaba). Trae ademas la reparacion B-10 (sellada en
// 6853993 sobre X86Backend.kpp): la region del backend del
// mundo de trabajo nace dimensionada por el programa que
// se compila, con datos_del_ir() y capacidad_region()
// trasplantados byte a byte de aquella pieza.
//
// LA COSTURA INTERNA: el IR ya no viaja por IR.TXT. El
// puente_ir() copia las seis columnas y la piscina que el
// IRGenerator deja en su region (diop y familia, dpiscina)
// a los arreglos planos fir_*; carga_ir_memoria() los
// registra en el mundo del backend con las mismas llamadas
// (registra_ir, registra_aux, string_pool_add_char) y la
// misma cola (pool_len, dir_nglob, ens_necesita_io) que el
// cargador de E-1, que se retira con sus ayudantes. Como la
// capacidad del mundo de trabajo depende del IR, la mitad
// trasera corre dos mundos, el patron de B-10: un mundo de
// sondeo (la region nace a 32768, se registra el IR y se
// calcula la capacidad) y el mundo de trabajo (la region
// nace con esa capacidad y se registra el IR otra vez).
// Los arreglos planos son el vehiculo porque cada mundo
// abre su arena de cero en su puerta: lo que cruza entre
// mundos vive en los arreglos planos compartidos por
// nombre, como entre las etapas delanteras de D-1.
//
// PROPAGACION DE ERRORES: la de D-1 llega hasta el final.
// Ocho etapas vigiladas: 1 LEXER, 2 PARSER, 3 PUENTE,
// 4 SEMANTICO, 5 IR, 6 PUENTE_IR (el puente, el sondeo y
// el calculo de capacidad), 7 ENSAMBLA (emision, genera()
// y la costura) y 8 SALIDA (la escritura del BIN). Si una
// etapa acusa, paro(etapa) lo imprime con todos los
// contadores y no se escribe SALIDA.BIN.
//
// DIFERENCIAS DECLARADAS contra las piezas selladas
// (todo lo demas es trasplante byte a byte):
// D2-1  Los dos main de sonda se descartan; el de D-2 es
//       el unico (principio de entrada unica). El paro es
//       el de D-2: imprime ademas errores_back y
//       errores_rt. El escritor de IR.TXT de D-1 y el
//       cargador de IR.TXT de E-1 se retiran, con sus
//       ayudantes y sus sondas (sonda_* de E-1).
// D2-2  Geometria de arena unificada: A = 1024,
//       B = 1048576 (el bloque fisico de B-10), C = 131072
//       (el que la mitad delantera necesita). Las copias
//       que quedan son las del Ensamblador, que apagan
//       los tres bloques enteros en inicia_arena, con los
//       numeros de tamano sustituidos.
// D2-3  Colisiones Driver x Ensamblador, resueltas como
//       en D-1 (sufijo a la copia que cede): el genera()
//       del IRGenerator pasa a genera_ir, y sus
//       busca_var y busca_const pasan a busca_var_gen y
//       busca_const_gen. El genera() del Backend conserva
//       el nombre: es la transcripcion de generate().
// D2-4  E-2: los huecos que la impresion descartaba en
//       el local bas quedan registrados. Los trece huecos
//       de direccion de em_registra_linea() se anotan en
//       las listas del Result del runtime con anota_
//       lista() (0 buffer de lineas, 1 cuenta, 2 cabeza,
//       3 primera visible: el emparejamiento de
//       emitRecordLine de Stage 0, cuyas referencias
//       viven en esas listas) y los rellena la pasada
//       que ya existia en rellena_costura(). El hueco de
//       la llamada al refresco de em_print_desde_edx() y
//       em_print_integer_rt() se registra con
//       registra_ref() (lista dref_pos, espejo de la
//       refreshCallPatchList de Stage 0) y rellena_
//       costura() lo parchea contra res_refresco.
// D2-5  E-3: registra_fr() y registra_fw() guardan un
//       campo mas, dhue (el hueco de la llamada de E/S,
//       el pos que em_hueco() ya devolvia en genera()), y
//       resuelve_io() lo parchea con parche_rel contra
//       dir_lectura o dir_escritura, las entradas que
//       emite_archivos() fija antes de genera().
// D2-6  genera() crea tres listas mas al nacer: dref_pos,
//       dfr_hue y dfw_hue, y pone nref a cero.
// D2-7  imagen, el arreglo de escribe_bin() y
//       pon32_imagen(), sube de 60000 a 1048576 celdas:
//       la capacidad sigue al trabajo (el BIN oraculo
//       mayor, L18 bloques, mide 406139 bytes; margen
//       x2.58, dentro de la banda x1.4-x3.5). El arreglo
//       datos_ir[8192] del cargador desaparece con el
//       cargador: su oficio lo heredan los arreglos
//       planos del puente (2048 instrucciones, 8192
//       caracteres de piscina, los techos del propio
//       IRGenerator, vigilados en el puente).
// D2-8  Codigo nuevo de D-2: el estado del puente
//       (nir_tras, pool_tras, cap_trabajo), registra_ref(),
//       puente_ir(), mundo_sondeo(), mundo_ensamblador(),
//       carga_ir_memoria(), el paro y el main.
// D2-9  datos_del_ir() y capacidad_region() se
//       trasplantan de X86Backend.kpp (B-10) byte a byte;
//       sus llamadas (fuente_de, texto_*) ya vivian en el
//       Ensamblador, identicas.
// D2-10 Los globales quedan consolidados en una seccion:
//       solo los que el codigo trasplantado y el nuevo
//       referencian, cada uno con su declaracion sellada
//       (las once comunes a las dos piezas son identicas).
//       Los techos delanteros acusados en D-1 (fuente
//       1024, tokens 256, nodos 256) quedan como estaban:
//       no son de esta rebanada.
// D2-11 La identidad de los temporales en el operando.
//       busca_tmp() compara refs de la piscina, y las
//       sondas selladas registraban cada temporal con el
//       sub-ref de la cadena del operando (refs_ope), con
//       lo que la igualdad de refs bastaba. El
//       IRGenerator real liga cada temporal con su propia
//       ref y compone el operando como cadena nueva
//       (une_refs): el sub-ref que genera() calcula al
//       partir el operando por la coma es otra ref del
//       mismo texto y la busqueda fallaba — la cadena
//       entera no caminaba con operaciones binarias.
//       Stage 0 no tiene el problema: sus temporales son
//       claves std::string. El arreglo vive solo en el
//       parseo: tras calcular izq y der en las seis
//       ramas binarias de genera(), ref_canonico()
//       (codigo nuevo) los traduce a la ref de ligadura
//       del temporal vivo del mismo texto (mismo_tmp(),
//       codigo nuevo); si no hay temporal con ese texto,
//       la ref queda como estaba y la busqueda acusa
//       como siempre. La maquinaria de temporales no se
//       toca (su identidad por ref es su contrato
//       sellado, probado por las sondas de B-1) y en los
//       flujos de sonda, donde el sub-ref ya es la ref
//       de ligadura, ref_canonico devuelve la misma ref:
//       la corriente de B-9/B-10 se conserva.
// ============================================================


// ============================================================
// CompilerDriver.kpp — Stage 1, el DRIVER del compilador.
//
// Rebanada D-1 (2026-11-23): el nacimiento del CompilerDriver.
// Un solo programa que unifica las cuatro piezas delanteras
// selladas — Lexer, Parser, SemanticAnalyzer, IRGenerator —
// bajo un main orquestador: lee FUENTE.KPP, corre las cuatro
// etapas en el orden de src/main.cpp de Stage 0 y escribe el
// IR en IR.TXT, en el formato exacto del imprime_ir de la
// pieza IRGenerator (el que el Ensamblador de E-1 consume).
//
// REQUISITO DE NACIMIENTO: la propagacion de errores de
// capacidad. Tras cada etapa el Driver comprueba los
// contadores de esa pieza y los de la arena; si alguno es
// distinto de cero, la cadena se detiene ahi, lo imprime
// (etapa y contadores) y NO escribe el IR. Cada pieza acusa
// en su contador: el Driver es quien escucha.
//
// La unificacion sigue el patron de E-1: biblioteca de apoyo
// una sola vez, funciones reales trasplantadas byte a byte,
// mains sonda y cargadores descartados. Las diferencias
// declaradas con las piezas selladas son solo estas:
//   D1  La biblioteca nace con los maximos por bloque de las
//       cuatro piezas (A 1024, B 8192, C 131072): bloque_b
//       pasa de 1024 a 8192 en inicia_arena, celda_get y
//       celda_set de la copia del IRGenerator.
//   D2  El Lexer entra por su copia en cadena (la escanea del
//       Parser: mismo algoritmo sellado, almacenamiento en
//       fuente[] y tok_*[] en vez de bfuente y las dt_*).
//   D3  El enum TokenType es el del Parser (46 miembros); el
//       del SA (41) es su prefijo exacto y no se trasplanta.
//   D4  mismo_texto existe en tres piezas con el mismo codigo
//       (solo difieren los comentarios): se conserva una.
//   D5  es_file_read, es_file_write y es_void existen en el SA
//       y en el IRGenerator con la misma semantica (variantes
//       de estilo): se conserva una copia.
//   D6  es_campo es DOS funciones distintas con un nombre: la
//       del SA (sobre un nodo) se queda; la del IRGenerator
//       (sobre una sentencia) se renombra es_campo_gen.
//   D7  sale_ambito es DOS funciones distintas con un nombre:
//       la del SA (su pila de simbolos) se queda; la del
//       IRGenerator (su registro de variables) se renombra
//       sale_ambito_gen.
//   D8  Fuera: los mains sonda, los cargadores de tablas y
//       los ayudantes de sonda de las cuatro piezas.
//   D10 tok_count y nnodos se declaran en el bloque de
//       estado de cada pieza (son los escalares del contrato
//       compartido): en la union se conserva una sola
//       declaracion, la del Parser.
//   D9  Codigo nuevo del Driver: el puente de nodos (de las
//       tablas DynamicArray del Parser a los arreglos planos
//       del contrato AST que leen el SA y el IRGenerator),
//       el escritor de IR a archivo y la vigilancia entre
//       etapas. El escritor reproduce el recorrido de
//       imprime_ir; su tabla de nombres de opcode se genera
//       mecanicamente de imprime_op. Como el Driver no
//       escribe IR cuando errores_ir acusa, el archivo nunca
//       lleva el errores_ir final que imprime_ir anade.
//
// Techos de la cadena tal como quedo sellada (se acusan, no
// se corrigen en esta rebanada): la fuente cabe en 1024
// bytes, la tabla de tokens en 256 y los arreglos de nodos
// del contrato en 256; el puente acusa si nnodos pasa de 256.
// ============================================================

// Tabla de tokens: el enum TokenType de include/kpp/Token.hpp
// (Stage 0) traducido 1:1. Los valores salen del ORDEN de
// declaracion (0, 1, 2, ...), igual que en C++.
// CONTRATO: el orden es sagrado. Un token nuevo va AL FINAL,
// nunca en el medio — mover un miembro renumera los que
// siguen y rompe la correspondencia con el Lexer y con
// EXPECTED.txt. Acceso con ambito: TokenType::KwIf.

enum TokenType
{
    // CONTROL
    EndOfFile,

    // LITERALES / IDENTIFICADORES
    Identifier,
    Number,
    String,

    // TIPOS / PALABRAS CLAVE
    KwInt,
    KwString,
    KwStruct,
    KwEnum,
    KwReturn,
    KwPrint,
    KwIf,
    KwElse,
    KwWhile,

    // ASIGNACION
    Assign,

    // OPERADORES ARITMETICOS
    Plus,
    Minus,
    Multiply,
    Divide,
    Modulo,

    // POTENCIA / RAIZ
    Power,

    // COMPARACION
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,

    // LOGICOS
    LogicalAnd,
    LogicalOr,
    LogicalNot,

    // PARENTESIS / BLOQUES
    LParen,
    RParen,
    LBracket,
    RBracket,
    LBrace,
    RBrace,

    // SEPARADORES
    Comma,
    Semicolon,
    ColonColon,
    Dot,

    // AMPLIACIONES (al final, nunca en medio)
    KwVoid,
    KwBreak,
    KwFor,
    BitwiseAnd,
    BitwiseOr,
    ShiftLeft,
    ShiftRight
};


// Tabla de clases de nodo: copia IDENTICA del enum de
// SemanticAnalyzer.kpp (contrato entre emisor y consumidor).
// El orden lo fija aquella lista; un nodo nuevo va AL FINAL.

enum NodeKind
{
    // DECLARACIONES
    Program,
    FunctionDeclaration,
    StructDeclaration,
    EnumDeclaration,

    // SENTENCIAS
    Block,
    VariableDeclaration,
    AssignmentStatement,
    IfStatement,
    WhileStatement,
    ReturnStatement,
    PrintStatement,
    PrintIntegerStatement,

    // EXPRESIONES
    IntegerLiteral,
    StringLiteral,
    VariableExpression,
    ArrayAccessExpression,
    CallExpression,
    BinaryExpression,

    // AMPLIACIONES (al final, nunca en medio)
    CallStatement,
    BreakStatement,
    ForStatement
};


enum IROpcode
{
    // ESTRUCTURA DEL PROGRAMA
    FunctionBegin,
    FunctionEnd,

    // CONSTANTES
    Const,
    StringConst,

    // VARIABLES Y MEMORIA
    Declare,
    Store,
    Load,
    ArrayLoad,
    ArrayStore,

    // FILE I/O
    FileRead,
    FileWrite,

    // ARITMETICA BASICA
    Add,
    Sub,
    Mul,
    Div,
    Mod,

    // POTENCIAS Y RAICES
    Pow,
    Sqrt,

    // LOGARITMOS Y EXPONENCIALES
    Log,
    Log10,
    Exp,

    // TRIGONOMETRIA
    Sin,
    Cos,
    Tan,
    Cot,
    Sec,
    Csc,

    // TRIGONOMETRIA INVERSA
    Asin,
    Acos,
    Atan,

    // FUNCIONES MATEMATICAS
    Abs,
    Floor,
    Ceil,
    Round,
    Min,
    Max,

    // MATEMATICA AVANZADA
    Factorial,
    Sum,
    Integral,

    // FUNCIONES
    Call,
    Return,

    // SALIDA
    Print,
    PrintInteger,
    PrintFloat,

    // COMPARACIONES
    CompareEqual,
    CompareNotEqual,
    CompareLess,
    CompareLessEqual,
    CompareGreater,
    CompareGreaterEqual,

    // LOGICA
    LogicalAnd,
    LogicalOr,
    LogicalNot,

    // CONTROL DE FLUJO
    Label,
    Jump,
    JumpIfZero,
    JumpIfNotZero,

    // BITS (Ampliacion 4, al final)
    BitwiseAnd,
    BitwiseOr,
    ShiftLeft,
    ShiftRight
};


// ============================================================
// ENSAMBLADOR — PIEZA DE STAGE 1 (REBANADA E-1).
// ============================================================
//
// El nacimiento del Ensamblador, por decision de
// Esequiel (2026-11-23): antes que el CompilerDriver
// completo, nace la pieza que cierra la costura que
// R-7 dejo medida — en Stage 0 todo el ensamblaje
// vive dentro de X86Backend::generate() y en Stage 1
// nadie consumia los Results de las piezas.
//
// La pieza es UN programa: unifica la mitad trasera
// del compilador con la biblioteca de apoyo una sola
// vez — los emisores de la pieza Runtime (el prefijo
// grafico y las rutinas de archivo), genera() de la
// pieza X86Backend y la produccion del archivo final
// de los Writers (la cabecera Menuet01 de la pieza
// ExecutableWriter; la escritura con file_write, la
// forma que la pieza BinaryWriter declara suya).
// Recibe un IR y produce un ejecutable, como el
// generate() de Stage 0.
//
// EL FLUJO, en el orden de generate() de Stage 0:
//
// 1. El mundo: inicia_arena y las regiones, con la
//    region de trabajo a 262144 celdas (D5).
// 2. reinicia_rt() y luego reinicia_back(): los dos
//    crean dcod; el que queda vivo es el del Backend,
//    y los registros y listas del Runtime quedan en
//    pie apuntando a sus propias estructuras.
// 3. carga_ir(): lee IR.TXT en el formato exacto de
//    imprime_ir() de la pieza IRGenerator y lo deja
//    en las listas del Backend por registra_ir, la
//    unica puerta; dir_nglob queda en la primera
//    FunctionBegin, como en el paseo de genera().
// 4. emite_grafico(): siembra el prefijo grafico en
//    dcod (2587 bytes) y cierra sus registros.
// 5. emite_archivos(), SOLO si el IR usa archivos:
//    el bloque de 763 bytes tras el prefijo (D4).
// 6. genera(): el cuerpo del usuario tras el bloque
//    presente, y la DATA tras el codigo. Como el
//    prefijo ya vive en dcod, base_datos y cada
//    posicion registrada nacen en el marco del
//    ensamblaje sin tocar una linea de genera().
//    genera() resuelve por dentro lo suyo: las
//    llamadas Print y de archivo del cuerpo, las
//    direcciones de sus rutinas internas y, si hay
//    archivos, las direcciones phue/ahue del cuerpo.
// 7. rellena_costura(): lo que generate() de Stage 0
//    resuelve contra el Result del Runtime y este
//    genera() no puede ver: el salto de la cabecera
//    al cuerpo de main (res_main contra pos_main),
//    los retornos de main al bucle de eventos
//    (dret_pos contra res_bucle), las catorce listas
//    DATA contra los offsets de la DATA construida,
//    el titulo (res_titulo y res_cap contra
//    o_titulo) y, si hay archivos, las cuatro
//    direcciones del Result de archivo contra
//    o_scratch y o_params.
// 8. escribe_bin(): la cabecera de 36 bytes, el
//    codigo y la DATA, a SALIDA.BIN con file_write.
//
// PRUEBA DE NACIMIENTO (E-1): con el IR del programa
// minimo L00 (un main con return 0), el BIN producido
// es byte a byte el de Stage 0: 57086 bytes, MD5
// 7822747da0b8ec68e8151cf5445e63b5. Los huecos que la
// pieza Backend deja sin registrar (las lineas de
// Print y los huecos de refresco y de llamada de
// archivo de su costura abierta de B-2) no aparecen
// en L00; su plomeria es materia de E-2 y E-3.
//
// DIFERENCIAS DECLARADAS frente a las piezas
// selladas (los modulos trasplantados van byte a
// byte; esto es todo lo que cambia):
//
// D1 La biblioteca arena va una sola vez: las dos
//    copias selladas son identicas modulo a modulo
//    (verificado por el constructor) y se toma la
//    del Backend. Los 11 ayudantes em_* y parche32,
//    tambien identicos en ambas piezas, van en la
//    copia del Runtime.
// D2 En la biblioteca, el bloque B pasa de 32768 a
//    262144 celdas: la DATA de un programa entero
//    (54428 celdas; 120000 con el scratch de E/S) no
//    cabe en el bloque sellado — con B en 32768 la
//    construccion de la DATA se detiene a mitad y lo
//    acusa errores_arena. Precedente de la casa: la
//    pieza Backend ya ajusto B de 1024 a 32768 al
//    incorporar la biblioteca, y la regla de
//    Esequiel (2026-11-20) es capacidades crecibles
//    cambiando numeros y recompilando.
// D3 Los main sonda y las funciones de sonda de
//    ambas piezas quedan fuera; entra el main del
//    Ensamblador y su codigo nuevo.
// D4 emite_grafico se parte en dos: en la pieza
//    Runtime emite el bloque de archivos siempre;
//    Stage 0 lo emite solo cuando el programa usa
//    archivos, y un L00 con el bloque no seria el
//    BIN del oraculo. El prefijo cierra con las
//    pasadas 1..5 y el bloque pasa a emite_archivos().
// D5 La reserva de la region de trabajo es 262144
//    (consecuencia de D2, pedida por el main nuevo).
// D6 Codigo nuevo: el estado propio, el cargador del
//    IR, la tabla de nombres de operacion,
//    rellena_costura(), pon32_imagen(), escribe_bin()
//    y main().
//
// CAPACIDADES DE LA REBANADA: el archivo IR cabe en
// 8192 bytes y la imagen en 60000 bytes (L00 pide
// 57086); son numeros de la pieza, crecibles como
// todos los de la casa.
// ============================================================

enum Menuet01
{
    HeaderSize = 36,
    StackSize = 4096,
    Version = 1,
    OffSignature = 0,
    OffVersion = 8,
    OffStart = 12,
    OffImageEnd = 16,
    OffMemoryEnd = 20,
    OffStackTop = 24,
    OffParameters = 28,
    OffPath = 32
};


// Constantes de la E/S de archivos (los constexpr de KolibriRuntime.hpp;
// SubWriteBlock no tiene constante nombrada en Stage 0: sale del texto
// del contrato).
enum KolibriFileIo
{
    Function = 70,
    SubRead = 0,
    SubWrite = 2,
    SubWriteBlock = 3,
    Eof = 6,
    MaxBytes = 65536,
    EncodingRaw = 0
};


// Bloque de parametros de la funcion 70: 25 bytes EMPAQUETADOS.
// pathAddress va en +21, pegado al flag de 1 byte: sin relleno.
// (En Stage 0 lo blindan static_asserts; aqui los offsets se escriben
// a mano en el arreglo de bytes, y esta tabla es la referencia.)
enum FileIoParams
{
    Size = 25,
    OffSubfunction = 0,
    OffOffsetLow = 4,
    OffOffsetHigh = 8,
    OffByteCount = 12,
    OffBufferAddress = 16,
    OffEncodingFlag = 20,
    OffPathAddress = 21
};


enum TemporaryLocationKind
{
    Register,
    Memory
};


// ============================================================
// ESTADO COMPARTIDO (DATA) — consolidado en D-2 (D2-10).
//
// Cada declaracion es byte a byte la de su pieza
// sellada; las once comunes al Driver y al
// Ensamblador son identicas y quedan una vez.
// ============================================================

