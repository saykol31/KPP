int fuente_de(int nom)
{
    int k;
    k = 0;
    while (k < texto_len(nom))
    {
        if (texto_char(nom, k) == 64)
        {
            return texto_ini(nom) * 128 + k;
        }
        k = k + 1;
    }
    return nom;
}


