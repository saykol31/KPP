int imprime_fila()
{
    int serr_codigo[256];
    print_int(nsstruct);
    print_int(nsglobal);
    print_int(nsfunc);
    print_int(serr_count);
    int i = 0;
    while (i < serr_count)
    {
        int c = serr_codigo[i];
        print_int(c);
        i = i + 1;
    }
    return 0;
}

