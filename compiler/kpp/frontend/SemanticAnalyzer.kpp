// SemanticAnalyzer.kpp — Stage 1, pieza 3 (analizador semantico), arranque.
// Tabla de clases de nodo: las clases del AST de Stage 0 (include/kpp/AST.hpp)
// traducidas a un enum de K++.
// DIFERENCIA CON STAGE 0: alli NO existe este enum. El AST es una jerarquia
// de clases y el SemanticAnalyzer.cpp reparte el trabajo con dynamic_cast:
// la clase del nodo ES su clase. K++ no tiene clases ni herencia, asi que
// en Stage 1 la clase del nodo pasa a ser un dato: un codigo entero en un
// arreglo paralelo (node_kind[]), y el reparto sera una cadena de if con
// estos nombres: node_kind[i] == NodeKind::IfStatement.
// CONTRATO NUEVO, nace aqui: el orden lo fija esta lista y queda congelado
// con la misma regla de TokenType — un nodo nuevo va AL FINAL, nunca en el
// medio. El Parser.kpp llevara una copia IDENTICA de este enum cuando
// empiece a emitir nodos: es la tabla que emisor y consumidor comparten.
// Solo son clases de nodo las que en AST.hpp heredan de ASTNode, Expression
// o Statement. Parameter, StructField y EnumValue son piezas internas de
// otros nodos, no nodos: no estan en la lista.
// Debajo del enum vive la implementacion, por rebanadas: la SA-1 (los
// registros) nacio el 2026-11-13 sobre el contrato AST definitivo del
// Parser (rebanada 15) — los nodos llegan en nkind/nini/nfin/nhijo1/
// nsig/nval/naux/nsize y los nombres se comparan por token.

enum NodeKind
{
    // DECLARACIONES
    Program,
    FunctionDeclaration,
    StructDeclaration,
    EnumDeclaration,

    // SENTENCIAS
    Block,
    VariableDeclaration,
    AssignmentStatement,
    IfStatement,
    WhileStatement,
    ReturnStatement,
    PrintStatement,
    PrintIntegerStatement,

    // EXPRESIONES
    IntegerLiteral,
    StringLiteral,
    VariableExpression,
    ArrayAccessExpression,
    CallExpression,
    BinaryExpression
};

// Tabla de tipos de token: la lista del Lexer
// (Token.hpp de Stage 0), con el mismo orden y la
// misma regla — un tipo nuevo va AL FINAL. Este
// archivo lleva su copia identica, como el Parser
// lleva la suya: emisor y consumidores comparten la
// tabla sin compartir el archivo. La SA-2 es la
// primera rebanada que la nombra (el tipo declarado
// de una variable se lee del tok_tipo de su token).

enum TokenType
{
    EndOfFile,
    Identifier,
    Number,
    String,
    KwInt,
    KwString,
    KwStruct,
    KwEnum,
    KwReturn,
    KwPrint,
    KwIf,
    KwElse,
    KwWhile,
    Assign,
    Plus,
    Minus,
    Multiply,
    Divide,
    Modulo,
    Power,
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    LogicalAnd,
    LogicalOr,
    LogicalNot,
    LParen,
    RParen,
    LBracket,
    RBracket,
    LBrace,
    RBrace,
    Comma,
    Semicolon,
    ColonColon,
    Dot
};

// ============================================================
// REBANADA SA-1 — LOS REGISTROS (traduccion de la primera
// mitad de SemanticAnalyzer::analyze() de Stage 0).
//
// Antes de mirar ningun cuerpo, el analizador registra
// los nombres del programa en tres pasadas, en el orden
// de Stage 0: estructuras, variables globales y
// funciones. Registrar las funciones antes de los
// cuerpos es lo que permite las llamadas hacia
// adelante, sin prototipos.
//
// DOS DECISIONES DE DISENO (de Esequiel, 2026-11-13):
//   - Los errores semanticos son CODIGOS, no textos:
//     serr_codigo[] guarda un numero por error, en el
//     orden en que se anota. El catalogo de abajo es
//     la unica lista; un codigo nuevo va AL FINAL,
//     con la misma regla de TokenType y NodeKind.
//   - Los tipos son INDICES DE TOKEN, no cadenas: el
//     nombre de un tipo vive en fuente[] y se compara
//     con mismo_texto (la forma probada: cada carga a
//     una variable local antes de comparar).
//
// ============================================================
// CATALOGO DE ERRORES (por codigo).
//
// Los errores del analisis se guardan como codigos en
// serr_codigo[], en el orden en que se anotan. El catalogo
// crece solo AL FINAL: nunca renumerar, porque las
// aceptaciones de las sondas dependen de los codigos.
//
//   SA-1 (registros):
//     1  estructura declarada mas de una vez
//     2  variable global declarada mas de una vez
//     3  funcion declarada mas de una vez
//     4  el programa no tiene funcion main
//   SA-2 (ambitos y sentencias):
//     5  parametro duplicado en la funcion
//     6  tipo de retorno de funcion no soportado
//     7  funcion sin cuerpo
//     8  variable ya declarada en este ambito
//     9  arreglo cuyo tipo no es int
//     10 arreglo con inicializador
//     11 tipo de variable no declarado o no soportado
//     12 variable no declarada (destino de asignacion)
//     13 return sin expresion
//     14 print sin expresion
//     15 print_int sin expresion
//   SA-3 (expresiones):
//     16 tipo incompatible en el inicializador
//     17 if sin condicion
//     18 if sin bloque
//     19 while sin condicion
//     20 while sin bloque
//     21 asignacion sin expresion
//     22 tipo incompatible en la asignacion
//     23 la variable no es un arreglo (asignacion o acceso)
//     24 indice de arreglo fuera de limites (literal)
//     25 los arreglos solo admiten elementos int
//     26 el indice del arreglo debe ser de tipo int
//     27 variable no declarada (en una expresion)
//     28 la variable no es una estructura
//     29 el campo no existe en la estructura
//     30 tipo de variable no soportado (en una expresion)
//     31 arreglo no declarado (en una expresion)
//     32 falta el indice del arreglo
//     33 funcion no declarada (en una llamada)
//     34 cantidad de argumentos incorrecta en la llamada
//     35 expresion binaria sin operando izquierdo
//     36 expresion binaria sin operando derecho
//     37 operador no soportado
//     38 campo duplicado en la estructura
//     39 tipo de campo no soportado (no int ni string)
//     40 file_read no recibe exactamente dos argumentos
//     41 el primer argumento no es una ruta literal
//     42 el segundo argumento no es una variable arreglo
//     43 arreglo no declarado (en file_read o file_write)
//     44 la nativa requiere un arreglo de tipo int
//     45 la nativa requiere capacidad positiva del arreglo
//     46 file_write no recibe exactamente tres argumentos
//     47 el tercer argumento de file_write no es int
//     48 file_write no admite una cantidad negativa
//     49 la cantidad de file_write supera la capacidad
//     50 una tabla del analizador se lleno (tope 256)
//     51 el intervalo de una tabla lateral es invalido
//
// REPRESENTACION DE TIPOS EN LA SA-3.
//
// Un tipo es el indice de su token (el tipo declarado de
// una variable, el tipo de retorno de una funcion, el
// nombre de una estructura). Cuando el tipo NACE de una
// expresion — un literal, una suma, una nativa — no hay
// token de declaracion que lo nombre: inferir_tipo lo
// devuelve como el codigo de su TokenType en negativo
// (-4 vale int, -5 vale string), -1 si el tipo no se
// conoce y -2 si los operandos son incompatibles, el
// centinela de Stage 0. tipos_iguales normaliza ambos
// lados antes de comparar.
// ============================================================
//
// LA REPRESENTACION: los nodos llegan en los arreglos
// del contrato AST definitivo (nkind/nini/nfin/
// nhijo1/nsig/nval/naux/nsize) y los tokens en la
// tabla del contrato (tok_tipo/tok_inicio/tok_largo/
// tok_valor sobre fuente[]). El nombre de una
// declaracion es el TOKEN guardado en nval. El
// recorrido de las declaraciones del programa es el
// ordinario del contrato: hijo1 del Program y luego
// puro nsig.
//
// LOS REGISTROS: tres listas planas de tokens
// (sstruct_tok, sglobal_tok, sfuncion_tok). Un nombre
// duplicado anota su error y NO se registra dos
// veces — la lista guarda nombres unicos, como el
// mapa de Stage 0: la primera declaracion es la que
// queda. hay_main se levanta al ver cualquier funcion
// llamada main, duplicada o no (Stage 0 lo mira antes
// del chequeo de duplicado).
//
// LA SONDA (main): cuatro tablas de nodos cargadas a
// mano con inicia_nodosN — el mismo arco del Parser
// con sus inicia_tokens — que cargan lo que SA-1 lee:
// nkind, nval, nhijo1, nsig, naux y nsize de cada
// nodo, y los tokens de nombre de cada declaracion.
// Cada corrida imprime una fila: estructuras,
// globales, funciones, cantidad de errores y los
// codigos en orden.
// ============================================================

int tok_count;
int nnodos;
int nsstruct;
int nsglobal;
int nsfunc;
int hay_main;
int serr_count;

int anota_error(int codigo)
{
    int serr_codigo[256];
    if (serr_count < 256)
    {
        serr_codigo[serr_count] = codigo;
        serr_count = serr_count + 1;
    }
    return 0;
}

int mismo_texto(int a, int b)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    // Cada largo y cada caracter se lee primero a una
    // variable local y se compara despues, en
    // sentencias separadas: la forma probada
    // (sonda_mismo_texto.kpp).
    int la = tok_largo[a];
    int lb = tok_largo[b];
    if (la != lb)
    {
        return 0;
    }
    int ia = tok_inicio[a];
    int ib = tok_inicio[b];
    int i = 0;
    while (i < la)
    {
        int ca = fuente[ia + i];
        int cb = fuente[ib + i];
        if (ca != cb)
        {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int es_main(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int largo = tok_largo[tok];
    if (largo != 4)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    int c0 = fuente[base + 0];
    int c1 = fuente[base + 1];
    int c2 = fuente[base + 2];
    int c3 = fuente[base + 3];
    if (c0 != 109)
    {
        return 0;
    }
    if (c1 != 97)
    {
        return 0;
    }
    if (c2 != 105)
    {
        return 0;
    }
    if (c3 != 110)
    {
        return 0;
    }
    return 1;
}

int busca_struct(int tok)
{
    int sstruct_tok[256];
    int i = 0;
    while (i < nsstruct)
    {
        int t = sstruct_tok[i];
        if (mismo_texto(t, tok) == 1)
        {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int busca_global(int tok)
{
    int sglobal_tok[256];
    int i = 0;
    while (i < nsglobal)
    {
        int t = sglobal_tok[i];
        if (mismo_texto(t, tok) == 1)
        {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int busca_funcion(int tok)
{
    int sfuncion_tok[256];
    int i = 0;
    while (i < nsfunc)
    {
        int t = sfuncion_tok[i];
        if (mismo_texto(t, tok) == 1)
        {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int registra_estructuras()
{
    int nhijo1[256];
    int nsig[256];
    int nkind[256];
    int nval[256];
    int naux[256];
    int nsize[256];
    int campotipo[256];
    int campotok[256];
    int sstruct_tok[256];
    int d = nhijo1[0];
    while (d != 0 - 1)
    {
        if (nkind[d] == NodeKind::StructDeclaration)
        {
            int nombre = nval[d];
            if (busca_struct(nombre) == 1)
            {
                int e = anota_error(1);
            }
            else
            {
                if (nsstruct >= 256)
                {
                    int eg = anota_error(50);
                }
                else
                {
                    sstruct_tok[nsstruct] = nombre;
                    nsstruct = nsstruct + 1;
                    // Los campos nacen en esta misma pasada,
                    // como en Stage 0: la tabla de campos de
                    // la SA-3 se llena aqui, campo a campo,
                    // en el orden de la declaracion.
                    int inicio = naux[d];
                    int cantidad = nsize[d];
                    // El intervalo se valida ANTES de leer:
                    // inicio no negativo, cantidad no
                    // negativa, inicio + cantidad dentro
                    // de la tabla lateral (256). Intervalo
                    // invalido: acusa 51 y no se lee nada
                    // (la estructura queda registrada sin
                    // campos). La misma disciplina que en
                    // Win2WSL: validar a la entrada.
                    int malo = 0;
                    if (inicio < 0)
                    {
                        malo = 1;
                    }
                    if (cantidad < 0)
                    {
                        malo = 1;
                    }
                    if (inicio + cantidad > 256)
                    {
                        malo = 1;
                    }
                    if (malo == 1)
                    {
                        int er = anota_error(51);
                        cantidad = 0;
                    }
                    int j = 0;
                    while (j < cantidad)
                    {
                        int ftok = campotok[inicio + j];
                        int fcodigo = campotipo[inicio + j];
                        if (busca_campo_fila(nombre, ftok) == 1)
                        {
                            int e2 = anota_error(38);
                        }
                        if (fcodigo != TokenType::KwInt)
                        {
                            if (fcodigo != TokenType::KwString)
                            {
                                int e3 = anota_error(39);
                            }
                        }
                        int a = agrega_campo(nombre, ftok, fcodigo);
                        j = j + 1;
                    }
                }
            }
        }
        d = nsig[d];
    }
    return 0;
}

int registra_globales()
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int sglobal_tok[256];
    int d = nhijo1[0];
    while (d != 0 - 1)
    {
        int k = nkind[d];
        if (k == NodeKind::VariableDeclaration)
        {
            int nombre = nval[d];
            if (busca_global(nombre) == 1)
            {
                int e = anota_error(2);
            }
            else
            {
                if (nsglobal >= 256)
                {
                    int eg = anota_error(50);
                }
                else
                {
                    sglobal_tok[nsglobal] = nombre;
                    nsglobal = nsglobal + 1;
                }
            }
        }
        d = nsig[d];
    }
    return 0;
}

int registra_funciones()
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int sfuncion_tok[256];
    int d = nhijo1[0];
    while (d != 0 - 1)
    {
        int k = nkind[d];
        if (k == NodeKind::FunctionDeclaration)
        {
            int nombre = nval[d];
            if (es_main(nombre) == 1)
            {
                hay_main = 1;
            }
            if (busca_funcion(nombre) == 1)
            {
                int e = anota_error(3);
            }
            else
            {
                if (nsfunc >= 256)
                {
                    int eg = anota_error(50);
                }
                else
                {
                    sfuncion_tok[nsfunc] = nombre;
                    nsfunc = nsfunc + 1;
                }
            }
        }
        d = nsig[d];
    }
    return 0;
}

int analiza()
{
    serr_count = 0;
    nsstruct = 0;
    nsglobal = 0;
    nsfunc = 0;
    hay_main = 0;
    nscampo = 0;
    int a = registra_estructuras();
    int b = registra_globales();
    int c = registra_funciones();
    int d = analiza_cuerpos();
    // El chequeo de main va DESPUES de los cuerpos:
    // su posicion en analyze() de Stage 0 (en la
    // SA-1 iba tras los registros porque aun no
    // habia cuerpos que analizar).
    if (hay_main == 0)
    {
        int e = anota_error(4);
    }
    return serr_count;
}

// ============================================================
// REBANADA SA-2 — AMBITOS Y SENTENCIAS (traduccion de
// analyzeFunction y de la mitad de sentencias de
// analyzeStatement de Stage 0).
//
// LOS AMBITOS: una sola tabla plana de simbolos con
// SELLO DE PROFUNDIDAD (la forma de las tablas
// laterales del Parser, no la pila de mapas de
// Stage 0):
//
//   ssim_tok[i]    token del nombre
//   ssim_tipo[i]   token del tipo (el nini de su
//                  declaracion; en un parametro, el
//                  token int de la cabecera — la
//                  tabla partok solo guarda nombres
//                  y el Parser solo admite parametros
//                  int)
//   ssim_tam[i]    tamano del arreglo (0 = escalar)
//   ssim_nivel[i]  profundidad en que nacio
//
// entra_ambito sube el nivel; sale_ambito retira los
// simbolos del nivel que cierra (trunca desde el
// final: los de un nivel siempre son los ultimos) y
// baja. La busqueda local recorre desde el final —
// el simbolo mas interno gana: eso es la sombra. Si
// la busqueda local falla, se cae al registro de
// globales de la SA-1, como lookupVariable en
// Stage 0. El chequeo de duplicado mira SOLO el
// nivel actual, como scopes.back() en Stage 0: una
// declaracion en un bloque puede sombrear a la de
// afuera sin error.
//
// Cada funcion arranca con la tabla vacia y su
// ambito (los cuerpos de las sentencias compuestas
// abren el suyo; el bloque del cuerpo NO abre otro:
// sus sentencias viven en el ambito de la funcion,
// como en analyzeFunction).
//
// LO QUE SA-2 NO MIRA TODAVIA — llega en SA-3,
// exactamente donde Stage 0 llama a analyzeExpression
// o a inferExpressionType: el inicializador de una
// declaracion y su tipo, el tipo del valor de una
// asignacion, las condiciones de if/while y las
// expresiones de return/print. Los chequeos de
// existencia y de forma de SA-2 ya quedan en su
// sitio para que SA-3 inserte los suyos en el orden
// de Stage 0.
// ============================================================

int nsim;
int nivel;

int entra_ambito()
{
    nivel = nivel + 1;
    return 0;
}

int sale_ambito()
{
    int ssim_nivel[256];
    int sigue = 1;
    while (sigue == 1)
    {
        if (nsim == 0)
        {
            sigue = 0;
        }
        else
        {
            int u = ssim_nivel[nsim - 1];
            if (u != nivel)
            {
                sigue = 0;
            }
            else
            {
                nsim = nsim - 1;
            }
        }
    }
    nivel = nivel - 1;
    return 0;
}

int registra_simbolo(int tok, int tipo, int tam)
{
    int ssim_tok[256];
    int ssim_tipo[256];
    int ssim_tam[256];
    int ssim_nivel[256];
    if (nsim >= 256)
    {
        int e = anota_error(50);
        return 0;
    }
    ssim_tok[nsim] = tok;
    ssim_tipo[nsim] = tipo;
    ssim_tam[nsim] = tam;
    ssim_nivel[nsim] = nivel;
    nsim = nsim + 1;
    return 0;
}

int busca_local(int tok)
{
    int ssim_tok[256];
    int i = nsim - 1;
    while (i >= 0)
    {
        int t = ssim_tok[i];
        if (mismo_texto(t, tok) == 1)
        {
            return i;
        }
        i = i - 1;
    }
    return 0 - 1;
}

int busca_en_actual(int tok)
{
    int ssim_tok[256];
    int ssim_nivel[256];
    int i = 0;
    while (i < nsim)
    {
        int t = ssim_tok[i];
        int nv = ssim_nivel[i];
        if (nv == nivel)
        {
            if (mismo_texto(t, tok) == 1)
            {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

int es_int(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int largo = tok_largo[tok];
    if (largo != 3)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    int c0 = fuente[base + 0];
    int c1 = fuente[base + 1];
    int c2 = fuente[base + 2];
    if (c0 != 105)
    {
        return 0;
    }
    if (c1 != 110)
    {
        return 0;
    }
    if (c2 != 116)
    {
        return 0;
    }
    return 1;
}

int camina_bloque(int b)
{
    int nhijo1[256];
    int nsig[256];
    int e = entra_ambito();
    int s = nhijo1[b];
    while (s != 0 - 1)
    {
        int r = analiza_sentencia(s);
        s = nsig[s];
    }
    int x = sale_ambito();
    return 0;
}

int analiza_sentencia(int s)
{
    int nkind[256];
    int nini[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int naux[256];
    int nsize[256];
    int tok_tipo[256];
    if (nkind[s] == NodeKind::Block)
    {
        int c = camina_bloque(s);
        return 0;
    }
    if (nkind[s] == NodeKind::VariableDeclaration)
    {
        int nombre = nval[s];
        int tipo = nini[s];
        if (busca_en_actual(nombre) == 1)
        {
            int e = anota_error(8);
            return 0;
        }
        if (nsize[s] > 0)
        {
            if (es_int(tipo) == 0)
            {
                int e2 = anota_error(9);
                return 0;
            }
            if (nhijo1[s] != 0 - 1)
            {
                int e3 = anota_error(10);
                return 0;
            }
        }
        // El inicializador se analiza ANTES de validar el
        // tipo declarado y ANTES de registrar la variable:
        // int x = x; acusa la x de dentro (orden de Stage 0).
        int init = nhijo1[s];
        if (init != 0 - 1)
        {
            int a = analiza_expresion(init);
        }
        int tt = tok_tipo[tipo];
        int valido = 0;
        if (tt == TokenType::KwInt)
        {
            valido = 1;
        }
        if (tt == TokenType::KwString)
        {
            valido = 1;
        }
        if (tt == TokenType::Identifier)
        {
            if (busca_struct(tipo) == 1)
            {
                valido = 1;
            }
        }
        if (valido == 0)
        {
            int e4 = anota_error(11);
            return 0;
        }
        if (init != 0 - 1)
        {
            int it = inferir_tipo(init);
            if (it == 0 - 2)
            {
                int e5 = anota_error(16);
            }
            else
            {
                if (it != 0 - 1)
                {
                    if (tipos_iguales(it, tipo) == 0)
                    {
                        int e6 = anota_error(16);
                    }
                }
            }
        }
        int r = registra_simbolo(nombre, tipo, nsize[s]);
        return 0;
    }
    if (nkind[s] == NodeKind::AssignmentStatement)
    {
        int nombre = nval[s];
        int iloc = busca_local(nombre);
        if (iloc == 0 - 1)
        {
            if (busca_global(nombre) == 0)
            {
                int e = anota_error(12);
                return 0;
            }
        }
        int campo = es_campo(s);
        int idx = nhijo1[s];
        if (campo == 0)
        {
            if (idx != 0 - 1)
            {
                int tam = tamano_de(nombre);
                if (tam <= 0)
                {
                    int e2 = anota_error(23);
                    return 0;
                }
                if (nkind[idx] == NodeKind::IntegerLiteral)
                {
                    int lv = nval[idx];
                    if (lv < 0)
                    {
                        int e3 = anota_error(24);
                        return 0;
                    }
                    if (lv >= tam)
                    {
                        int e4 = anota_error(24);
                        return 0;
                    }
                }
                int ttipo = tipo_de(nombre);
                if (es_int(ttipo) == 0)
                {
                    int e5 = anota_error(25);
                    return 0;
                }
                int a = analiza_expresion(idx);
                int itx = inferir_tipo(idx);
                if (es_tipo_int_inferido(itx) == 0)
                {
                    int e6 = anota_error(26);
                    return 0;
                }
            }
        }
        int valor = naux[s];
        if (valor == 0 - 1)
        {
            int e7 = anota_error(21);
            return 0;
        }
        int a2 = analiza_expresion(valor);
        int destino = tipo_de(nombre);
        if (campo == 1)
        {
            if (busca_struct(destino) == 1)
            {
                int fct = tipo_de_campo(destino, idx);
                if (fct != 0 - 1)
                {
                    destino = fct;
                }
            }
        }
        int it2 = inferir_tipo(valor);
        if (it2 == 0 - 2)
        {
            int e8 = anota_error(22);
        }
        else
        {
            if (it2 != 0 - 1)
            {
                if (tipos_iguales(it2, destino) == 0)
                {
                    int e9 = anota_error(22);
                }
            }
        }
        return 0;
    }
    if (nkind[s] == NodeKind::IfStatement)
    {
        int cond = nhijo1[s];
        if (cond == 0 - 1)
        {
            int e = anota_error(17);
            int e2 = anota_error(18);
            return 0;
        }
        int a = analiza_expresion(cond);
        int thenb = nsig[cond];
        if (thenb == 0 - 1)
        {
            int e3 = anota_error(18);
            return 0;
        }
        int c1 = camina_bloque(thenb);
        int els = nsig[thenb];
        if (els != 0 - 1)
        {
            int c2 = camina_bloque(els);
        }
        return 0;
    }
    if (nkind[s] == NodeKind::WhileStatement)
    {
        int cond = nhijo1[s];
        if (cond == 0 - 1)
        {
            int e = anota_error(19);
            int e2 = anota_error(20);
            return 0;
        }
        int a = analiza_expresion(cond);
        int cuerpo = nsig[cond];
        if (cuerpo == 0 - 1)
        {
            int e3 = anota_error(20);
            return 0;
        }
        int c1 = camina_bloque(cuerpo);
        return 0;
    }
    if (nkind[s] == NodeKind::ReturnStatement)
    {
        if (nhijo1[s] == 0 - 1)
        {
            int e = anota_error(13);
            return 0;
        }
        int a = analiza_expresion(nhijo1[s]);
        return 0;
    }
    if (nkind[s] == NodeKind::PrintStatement)
    {
        if (nhijo1[s] == 0 - 1)
        {
            int e = anota_error(14);
            return 0;
        }
        int a = analiza_expresion(nhijo1[s]);
        return 0;
    }
    if (nkind[s] == NodeKind::PrintIntegerStatement)
    {
        if (nhijo1[s] == 0 - 1)
        {
            int e = anota_error(15);
            return 0;
        }
        int a = analiza_expresion(nhijo1[s]);
        return 0;
    }
    return 0;
}

int analiza_funcion(int f)
{
    int nini[256];
    int nhijo1[256];
    int nsig[256];
    int naux[256];
    int nsize[256];
    int partok[256];
    nsim = 0;
    nivel = 0;
    int e0 = entra_ambito();
    int tipo_ret = nini[f];
    if (es_int(tipo_ret) == 0)
    {
        int e = anota_error(6);
    }
    int pini = naux[f];
    int pcant = nsize[f];
    // El intervalo de parametros se valida con la
    // misma disciplina que el de campos: inicio no
    // negativo, cantidad no negativa, inicio +
    // cantidad dentro de partok (256). Invalido:
    // acusa 51 y la funcion se analiza sin parametros.
    int malo = 0;
    if (pini < 0)
    {
        malo = 1;
    }
    if (pcant < 0)
    {
        malo = 1;
    }
    if (pini + pcant > 256)
    {
        malo = 1;
    }
    if (malo == 1)
    {
        int er = anota_error(51);
        pcant = 0;
    }
    int j = 0;
    while (j < pcant)
    {
        int t = partok[pini + j];
        if (busca_en_actual(t) == 1)
        {
            int e2 = anota_error(5);
        }
        else
        {
            int r = registra_simbolo(t, tipo_ret, 0);
        }
        j = j + 1;
    }
    int cuerpo = nhijo1[f];
    if (cuerpo == 0 - 1)
    {
        int e3 = anota_error(7);
        int x = sale_ambito();
        return 0;
    }
    int s = nhijo1[cuerpo];
    while (s != 0 - 1)
    {
        int r2 = analiza_sentencia(s);
        s = nsig[s];
    }
    int x2 = sale_ambito();
    return 0;
}

int analiza_cuerpos()
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int d = nhijo1[0];
    while (d != 0 - 1)
    {
        int k = nkind[d];
        if (k == NodeKind::FunctionDeclaration)
        {
            int r = analiza_funcion(d);
        }
        d = nsig[d];
    }
    return 0;
}
// ============================================================
// REBANADA SA-3 — LAS EXPRESIONES (traduccion de
// analyzeExpression e inferExpressionType de Stage 0).
//
// Dos recorridos sobre la misma expresion: analiza la
// camina anotando errores, e inferir_tipo devuelve su
// tipo en la representacion del catalogo (token, -4/-5
// para los tipos que nacen de una expresion, -1 si no
// se conoce, -2 si los operandos son incompatibles).
//
// Las nativas file_read y file_write se reconocen por
// el TEXTO del nombre, como print_int en el Parser.
// La combinacion campo+indice en una asignacion no
// tiene codigo: el AST de Stage 1 guarda una sola cosa
// en hijo1 y esa forma no es construible. El chequeo
// de tipo de parametro de las llamadas de Stage 0 no
// tiene datos aqui (partok guarda solo nombres y el
// Parser solo admite parametros int): queda fuera.
// Como en Stage 0, el tamano de un arreglo SOLO se
// conoce en los ambitos locales: una global usada con
// indice o en una nativa acusa que no es un arreglo.
// ============================================================

int nscampo;

int es_string(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int largo = tok_largo[tok];
    if (largo != 6)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    int c0 = fuente[base + 0];
    int c1 = fuente[base + 1];
    int c2 = fuente[base + 2];
    int c3 = fuente[base + 3];
    int c4 = fuente[base + 4];
    int c5 = fuente[base + 5];
    if (c0 != 115)
    {
        return 0;
    }
    if (c1 != 116)
    {
        return 0;
    }
    if (c2 != 114)
    {
        return 0;
    }
    if (c3 != 105)
    {
        return 0;
    }
    if (c4 != 110)
    {
        return 0;
    }
    if (c5 != 103)
    {
        return 0;
    }
    return 1;
}

int es_file_read(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int largo = tok_largo[tok];
    if (largo != 9)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    int c0 = fuente[base + 0];
    int c1 = fuente[base + 1];
    int c2 = fuente[base + 2];
    int c3 = fuente[base + 3];
    int c4 = fuente[base + 4];
    int c5 = fuente[base + 5];
    int c6 = fuente[base + 6];
    int c7 = fuente[base + 7];
    int c8 = fuente[base + 8];
    if (c0 != 102)
    {
        return 0;
    }
    if (c1 != 105)
    {
        return 0;
    }
    if (c2 != 108)
    {
        return 0;
    }
    if (c3 != 101)
    {
        return 0;
    }
    if (c4 != 95)
    {
        return 0;
    }
    if (c5 != 114)
    {
        return 0;
    }
    if (c6 != 101)
    {
        return 0;
    }
    if (c7 != 97)
    {
        return 0;
    }
    if (c8 != 100)
    {
        return 0;
    }
    return 1;
}

int es_file_write(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int largo = tok_largo[tok];
    if (largo != 10)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    int c0 = fuente[base + 0];
    int c1 = fuente[base + 1];
    int c2 = fuente[base + 2];
    int c3 = fuente[base + 3];
    int c4 = fuente[base + 4];
    int c5 = fuente[base + 5];
    int c6 = fuente[base + 6];
    int c7 = fuente[base + 7];
    int c8 = fuente[base + 8];
    int c9 = fuente[base + 9];
    if (c0 != 102)
    {
        return 0;
    }
    if (c1 != 105)
    {
        return 0;
    }
    if (c2 != 108)
    {
        return 0;
    }
    if (c3 != 101)
    {
        return 0;
    }
    if (c4 != 95)
    {
        return 0;
    }
    if (c5 != 119)
    {
        return 0;
    }
    if (c6 != 114)
    {
        return 0;
    }
    if (c7 != 105)
    {
        return 0;
    }
    if (c8 != 116)
    {
        return 0;
    }
    if (c9 != 101)
    {
        return 0;
    }
    return 1;
}

// 1 si el nodo trae acceso a campo: el token que sigue
// al nombre en la tabla es un Dot (la misma senal que
// usa el recorrido del Parser).
int es_campo(int nodo)
{
    int nval[256];
    int tok_tipo[256];
    int nombre = nval[nodo];
    int siguiente = nombre + 1;
    int tt = tok_tipo[siguiente];
    if (tt == TokenType::Dot)
    {
        return 1;
    }
    return 0;
}

// El token del tipo declarado de una global, o -1.
int tipo_de_global(int tok)
{
    int nhijo1[256];
    int nsig[256];
    int nkind[256];
    int nval[256];
    int nini[256];
    int d = nhijo1[0];
    while (d != 0 - 1)
    {
        if (nkind[d] == NodeKind::VariableDeclaration)
        {
            int dn = nval[d];
            if (mismo_texto(dn, tok) == 1)
            {
                return nini[d];
            }
        }
        d = nsig[d];
    }
    return 0 - 1;
}

// El token del tipo de una variable: el ambito local
// manda (la sombra); si no, la global.
int tipo_de(int tok)
{
    int ssim_tipo[256];
    int i = busca_local(tok);
    if (i != 0 - 1)
    {
        return ssim_tipo[i];
    }
    return tipo_de_global(tok);
}

// El tamano del arreglo: SOLO ambitos locales, como
// lookupArraySize de Stage 0. Una global devuelve 0.
int tamano_de(int tok)
{
    int ssim_tam[256];
    int i = busca_local(tok);
    if (i != 0 - 1)
    {
        return ssim_tam[i];
    }
    return 0;
}

// El nodo de la declaracion de una funcion, o -1.
int nodo_de_funcion(int tok)
{
    int nhijo1[256];
    int nsig[256];
    int nkind[256];
    int nval[256];
    int d = nhijo1[0];
    while (d != 0 - 1)
    {
        if (nkind[d] == NodeKind::FunctionDeclaration)
        {
            int dn = nval[d];
            if (mismo_texto(dn, tok) == 1)
            {
                return d;
            }
        }
        d = nsig[d];
    }
    return 0 - 1;
}

// ------------------------------------------------------------
// LA TABLA DE CAMPOS: filas planas (estructura, campo,
// codigo de tipo), llenada por registra_estructuras.
// La primera fila que coincide manda, como el mapa de
// Stage 0, que conserva la primera version de un campo.
// ------------------------------------------------------------

int agrega_campo(int estructura, int campo, int codigo)
{
    int scampo_struct[256];
    int scampo_tok[256];
    int scampo_tipo[256];
    if (nscampo >= 256)
    {
        int e = anota_error(50);
        return 0;
    }
    scampo_struct[nscampo] = estructura;
    scampo_tok[nscampo] = campo;
    scampo_tipo[nscampo] = codigo;
    nscampo = nscampo + 1;
    return 0;
}

int busca_campo_fila(int estructura, int campo)
{
    int scampo_struct[256];
    int scampo_tok[256];
    int i = 0;
    while (i < nscampo)
    {
        int fs = scampo_struct[i];
        int ms = mismo_texto(fs, estructura);
        if (ms == 1)
        {
            int fc = scampo_tok[i];
            int mf = mismo_texto(fc, campo);
            if (mf == 1)
            {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// El codigo TokenType del tipo de un campo, o -1 si
// el campo no esta en la tabla.
int codigo_de_campo(int estructura, int campo)
{
    int scampo_struct[256];
    int scampo_tok[256];
    int scampo_tipo[256];
    int i = 0;
    while (i < nscampo)
    {
        int fs = scampo_struct[i];
        int ms = mismo_texto(fs, estructura);
        if (ms == 1)
        {
            int fc = scampo_tok[i];
            int mf = mismo_texto(fc, campo);
            if (mf == 1)
            {
                return scampo_tipo[i];
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// El tipo de un campo en la representacion del
// catalogo: -4 int, -5 string, -1 si no se conoce.
int tipo_de_campo(int estructura, int campo)
{
    int c = codigo_de_campo(estructura, campo);
    if (c == TokenType::KwInt)
    {
        return 0 - TokenType::KwInt;
    }
    if (c == TokenType::KwString)
    {
        return 0 - TokenType::KwString;
    }
    return 0 - 1;
}

// La clase de un tipo: 1 int, 2 string, 3 con nombre.
int clase_tipo(int t)
{
    if (t == 0 - TokenType::KwInt)
    {
        return 1;
    }
    if (t == 0 - TokenType::KwString)
    {
        return 2;
    }
    if (es_int(t) == 1)
    {
        return 1;
    }
    if (es_string(t) == 1)
    {
        return 2;
    }
    return 3;
}

int tipos_iguales(int a, int b)
{
    int ca = clase_tipo(a);
    int cb = clase_tipo(b);
    if (ca != cb)
    {
        return 0;
    }
    if (ca == 3)
    {
        return mismo_texto(a, b);
    }
    return 1;
}

// 1 si un tipo inferido vale int: el -4 sintetico o un
// token cuyo texto es int. Otro negativo nunca vale.
int es_tipo_int_inferido(int it)
{
    if (it == 0 - TokenType::KwInt)
    {
        return 1;
    }
    if (it < 0)
    {
        return 0;
    }
    return es_int(it);
}

// ------------------------------------------------------------
// INFERIR TIPO (inferExpressionType de Stage 0).
// ------------------------------------------------------------

int inferir_tipo(int n)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    if (n == 0 - 1)
    {
        return 0 - 1;
    }
    if (nkind[n] == NodeKind::IntegerLiteral)
    {
        return 0 - TokenType::KwInt;
    }
    if (nkind[n] == NodeKind::StringLiteral)
    {
        return 0 - TokenType::KwString;
    }
    if (nkind[n] == NodeKind::VariableExpression)
    {
        int base = nval[n];
        int tt = tipo_de(base);
        if (tt == 0 - 1)
        {
            return 0 - 1;
        }
        if (es_campo(n) == 0)
        {
            return tt;
        }
        int campo = nhijo1[n];
        return tipo_de_campo(tt, campo);
    }
    if (nkind[n] == NodeKind::ArrayAccessExpression)
    {
        int base = nval[n];
        int tt = tipo_de(base);
        if (tt == 0 - 1)
        {
            return 0 - 1;
        }
        if (es_int(tt) == 0)
        {
            return 0 - 1;
        }
        int idx = nhijo1[n];
        if (idx == 0 - 1)
        {
            return 0 - 1;
        }
        int it = inferir_tipo(idx);
        if (es_tipo_int_inferido(it) == 0)
        {
            return 0 - 1;
        }
        return 0 - TokenType::KwInt;
    }
    if (nkind[n] == NodeKind::CallExpression)
    {
        int cal = nval[n];
        if (es_file_read(cal) == 1)
        {
            return 0 - TokenType::KwInt;
        }
        if (es_file_write(cal) == 1)
        {
            return 0 - TokenType::KwInt;
        }
        int fd = nodo_de_funcion(cal);
        if (fd == 0 - 1)
        {
            return 0 - 1;
        }
        int nini[256];
        return nini[fd];
    }
    if (nkind[n] == NodeKind::BinaryExpression)
    {
        int izq = nhijo1[n];
        if (izq == 0 - 1)
        {
            return 0 - 1;
        }
        int der = nsig[izq];
        if (der == 0 - 1)
        {
            return 0 - 1;
        }
        int lt = inferir_tipo(izq);
        int rt = inferir_tipo(der);
        if (lt == 0 - 1)
        {
            return 0 - 1;
        }
        if (rt == 0 - 1)
        {
            return 0 - 1;
        }
        int li = es_tipo_int_inferido(lt);
        int ri = es_tipo_int_inferido(rt);
        if (li == 1)
        {
            if (ri == 1)
            {
                return 0 - TokenType::KwInt;
            }
        }
        return 0 - 2;
    }
    return 0 - 1;
}

// ------------------------------------------------------------
// ANALIZA EXPRESION (analyzeExpression de Stage 0).
// ------------------------------------------------------------

int analiza_expresion(int n)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int nsize[256];
    if (n == 0 - 1)
    {
        return 0;
    }
    if (nkind[n] == NodeKind::IntegerLiteral)
    {
        return 0;
    }
    if (nkind[n] == NodeKind::StringLiteral)
    {
        return 0;
    }
    if (nkind[n] == NodeKind::VariableExpression)
    {
        int base = nval[n];
        int tt = tipo_de(base);
        if (tt == 0 - 1)
        {
            int e = anota_error(27);
            return 0;
        }
        if (es_campo(n) == 1)
        {
            if (busca_struct(tt) == 0)
            {
                int e2 = anota_error(28);
                return 0;
            }
            int campotok = nhijo1[n];
            int fc = codigo_de_campo(tt, campotok);
            if (fc == 0 - 1)
            {
                int e3 = anota_error(29);
                return 0;
            }
            if (fc != TokenType::KwInt)
            {
                if (fc != TokenType::KwString)
                {
                    int e4 = anota_error(30);
                    return 0;
                }
            }
            return 0;
        }
        if (es_int(tt) == 0)
        {
            if (es_string(tt) == 0)
            {
                int e5 = anota_error(30);
                return 0;
            }
        }
        return 0;
    }
    if (nkind[n] == NodeKind::ArrayAccessExpression)
    {
        int base = nval[n];
        int tt = tipo_de(base);
        if (tt == 0 - 1)
        {
            int e = anota_error(31);
            return 0;
        }
        int tam = tamano_de(base);
        if (tam <= 0)
        {
            int e2 = anota_error(23);
            return 0;
        }
        if (es_int(tt) == 0)
        {
            int e3 = anota_error(25);
            return 0;
        }
        int idx = nhijo1[n];
        if (idx == 0 - 1)
        {
            int e4 = anota_error(32);
            return 0;
        }
        if (nkind[idx] == NodeKind::IntegerLiteral)
        {
            int lv = nval[idx];
            if (lv < 0)
            {
                int e5 = anota_error(24);
                return 0;
            }
            if (lv >= tam)
            {
                int e6 = anota_error(24);
                return 0;
            }
        }
        int a = analiza_expresion(idx);
        int itx = inferir_tipo(idx);
        if (es_tipo_int_inferido(itx) == 0)
        {
            int e7 = anota_error(26);
            return 0;
        }
        return 0;
    }
    if (nkind[n] == NodeKind::CallExpression)
    {
        int cal = nval[n];
        int a1 = nhijo1[n];
        int nargs = 0;
        int x = a1;
        while (x != 0 - 1)
        {
            nargs = nargs + 1;
            x = nsig[x];
        }
        int a2 = 0 - 1;
        int a3 = 0 - 1;
        if (a1 != 0 - 1)
        {
            a2 = nsig[a1];
            if (a2 != 0 - 1)
            {
                a3 = nsig[a2];
            }
        }
        if (es_file_read(cal) == 1)
        {
            if (nargs != 2)
            {
                int e = anota_error(40);
                return 0;
            }
            if (nkind[a1] != NodeKind::StringLiteral)
            {
                int e2 = anota_error(41);
                return 0;
            }
            if (nkind[a2] != NodeKind::VariableExpression)
            {
