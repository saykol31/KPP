// ============================================================
// TABLA LITERAL 3 — LA SONDA DE STRUCT.
//
// struct Punto
// {
//     int x;
//     int y;
//     string nombre;
// };
// int main()
// {
//     int r = 3;
//     print(r);
//     return 0;
// }
//
// Generada mecanicamente desde esa fuente: 33 tokens,
// mismo formato que las tablas anteriores. El ';' tras
// la '}' es un token mas de la tabla: Stage 0 lo exige
// al cerrar la declaracion.
// ============================================================

int inicia_tokens3()
{
    int tipo[64];
    int tinicio[64];
    int tlargo[64];
    int tvalor[64];

    tipo[0] = TokenType::KwStruct;   tinicio[0] = 0;    tlargo[0] = 6;
    tipo[1] = TokenType::Identifier; tinicio[1] = 7;    tlargo[1] = 5;
    tipo[2] = TokenType::LBrace;     tinicio[2] = 13;   tlargo[2] = 1;
    tipo[3] = TokenType::KwInt;      tinicio[3] = 19;   tlargo[3] = 3;
    tipo[4] = TokenType::Identifier; tinicio[4] = 23;   tlargo[4] = 1;
    tipo[5] = TokenType::Semicolon;  tinicio[5] = 24;   tlargo[5] = 1;
    tipo[6] = TokenType::KwInt;      tinicio[6] = 30;   tlargo[6] = 3;
