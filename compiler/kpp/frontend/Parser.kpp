// Parser.kpp — Stage 1, pieza 2 (parser), rebanada 8.
// Traduccion de src/frontend/Parser.cpp (Stage 0) a K++, en el
// estilo de subrutinas con estado compartido:
//
//   - El cursor de Stage 0 (Parser::position, un miembro de la
//     clase) aqui es un escalar compartido en DATA: int pos;
//     Todas las subrutinas lo leen y lo mueven a pelo, como en
//     un GOSUB de MSX BASIC. Es el primer consumidor real de
//     los escalares compartidos (bateria L19).
//   - current/check/match/advance/expect de Stage 0 pasan a
//     subrutinas: actual(), es(), consume(), espera().
//   - Los tokens llegan en arreglos paralelos compartidos por
//     nombre (tipo/tinicio/tlargo), el formato del Lexer.
//     En esta rebanada la tabla es LITERAL: los 27 tokens de
//     FUENTE.KPP segun EXPECTED.txt (pieza 1, P00 sellada).
//     La rebanada de acople la sustituira por la salida real
//     del Lexer sin tocar a los consumidores.
//   - Los nodos salen en arreglos paralelos (nkind/nini/nfin:
//     clase del nodo y su rango de tokens), con la copia
//     identica de NodeKind que pide el contrato de
//     SemanticAnalyzer.kpp.
//   - Rebanada 2: la cadena de expresiones de Stage 0 ya
//     esta traducida (parse_or ... parse_primario) y las
//     sentencias la usan de verdad: inicializadores,
//     condiciones, argumentos de print, return y la
//     asignacion. Los nodos de expresion cuelgan de los
//     de sentencia por hijo1/hijo2/nsig.
//   - Rebanada 3: la declaracion de funcion completa de
//     Stage 0 — parametros int en tabla lateral (Parameter
//     no es un NodeKind) — y la bifurcacion de parse():
//     int nombre; es global, int nombre( es funcion,
//     la misma bifurcacion que Stage 0 gano con L19.
//   - Rebanada 4: la declaracion de estructura de Stage 0
//     (parseStruct): campos int/string en tabla lateral
//     (StructField no es un NodeKind: campotipo/campotok,
//     como Parameter en partok), el tipo guardado como
//     codigo TokenType donde Stage 0 guarda el texto, y
//     el ';' obligatorio tras la '}' que Stage 0 exige.
//   - Rebanada 5: la declaracion de enumeracion de
//     Stage 0 (parseEnum) y el pliegue de la constante
//     Enum::Miembro a literal entero en parse_primario
//     — la primera rama del identificador, como en
//     Stage 0. Las constantes viven en tabla lateral
//     (EnumValue no es un NodeKind) con su valor ya
//     calculado, y los nombres se comparan por
//     contenido con mismo_texto sobre el arreglo
//     fuente[] que la tabla 4 carga: el mapa de texto
//     de Stage 0 (enumConstants) escrito con
//     posiciones, porque este Parser no guarda texto.
//     Correccion en campo (la misma noche):
//     mismo_texto lee cada largo y cada caracter a
//     variables locales antes de comparar — comparar
//     dos cargas calculadas dentro de una sola
//     expresion devolvia siempre distinto
//     (sonda_mismo_texto.kpp).
//   - Rebanada 6: el else if de Stage 0 — la ultima
//     pieza del grupo de control de flujo. El else
//     seguido de if envuelve el if anidado en un
//     Block sintetico de una sola sentencia, como en
//     el parseStatement original. La tabla 5 ejercita
//     a la vez el while y el else, traducidos en la
//     rebanada 1 pero sin corrida de aceptacion
//     propia hasta hoy.
//   - Rebanada 7: print_int como sentencia propia
//     (PrintIntegerStatement) — la pieza que
//     faltaba del grupo de impresion. print_int
//     no es palabra clave: llega como Identifier
//     y se reconoce por su texto con
//     es_print_int, como el chequeo de Stage 0;
//     la rama va antes de la asignacion en
//     parse_sentencia y la expresion cuelga de
//     hijo1. La tabla 6 lo ejercita con una
//     variable, una llamada anidada y un
//     literal, junto a un print que sigue
//     siendo PrintStatement.
//   - Rebanada 8: la declaracion de tipo
//     personalizado (Persona p;) y la asignacion
//     a campo (p.edad = 30;) — la ultima pieza
//     de parseStatement. La declaracion se
//     decide como en Stage 0, sin tabla de
//     tipos: dos Identifier seguidos. La
//     asignacion a campo guarda el token del
//     campo en hijo1, el mismo pliegue que la
//     lectura de la rebanada 2. Con esta
//     rebanada el Parser queda completo.
//
// Aceptacion de la rebanada (en campo, Studio):
//   Tabla de FUENTE: 1, 4, 0, 27, 14, 1, 3 (como en la
//   rebanada 2). Tabla 2 (declaraciones): 2, 4, 0, 43,
//   18, 2, 2 — funciones, sentencias, errores, tokens,
//   nodos, parametros y FunctionDeclaration.
//   Tabla 3 (struct): 1, 3, 0, 33, 10, 3, 1 — funciones,
//   sentencias, errores, tokens, nodos, campos y
//   StructDeclaration.
//   Tabla 4 (enum): 1, 5, 0, 47, 14, 3, 1, 21 —
//   funciones, sentencias, errores, tokens, nodos,
//   constantes, EnumDeclaration y la suma de los
//   literales (0 + 10 + 11 del pliegue, mas el 0 del
//   return): la prueba numerica de que cada
//   Color::Miembro cayo en su valor.
//   Tabla 5 (else if): 1, 11, 0, 74, 40, 1, 2, 6 —
//   funciones, sentencias, errores, tokens, nodos,
//   WhileStatement, IfStatement y Block: el 2 de
//   if es el anidado del else if, y el 6 de bloques
//   incluye el sintetico que lo envuelve.
//   Tabla 6 (print_int): 2, 7, 0, 50, 22, 3, 1, 1
//   — funciones, sentencias, errores, tokens,
//   nodos, PrintIntegerStatement, CallExpression
//   (la de doble(v) dentro del print_int) y
//   PrintStatement: el 3 contra el 1 prueba que
//   print_int ya no cae en la asignacion ni se
//   disfraza de llamada.
//   Tabla 7 (Persona): 1, 4, 0, 36, 11, 2, 1, 1
//   — funciones, sentencias, errores, tokens,
//   nodos, campos, VariableDeclaration y
//   AssignmentStatement: la Persona p; es la
//   unica declaracion y el p.edad = 30 la
//   unica asignacion de la corrida.
//
// Tabla de tokens: el enum TokenType de include/kpp/Token.hpp
// (Stage 0) traducido 1:1. Los valores salen del ORDEN de
// declaracion (0, 1, 2, ...), igual que en C++.
// CONTRATO: el orden es sagrado. Un token nuevo va AL FINAL,
// nunca en el medio — mover un miembro renumera los que
// siguen y rompe la correspondencia con el Lexer y con
// EXPECTED.txt. Acceso con ambito: TokenType::KwIf.

enum TokenType
{
    // CONTROL
    EndOfFile,

    // LITERALES / IDENTIFICADORES
    Identifier,
    Number,
    String,

    // TIPOS / PALABRAS CLAVE
    KwInt,
    KwString,
    KwStruct,
    KwEnum,
    KwReturn,
    KwPrint,
    KwIf,
    KwElse,
    KwWhile,

    // ASIGNACION
    Assign,

    // OPERADORES ARITMETICOS
    Plus,
    Minus,
    Multiply,
    Divide,
    Modulo,

    // POTENCIA / RAIZ
    Power,

    // COMPARACION
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,

    // LOGICOS
    LogicalAnd,
    LogicalOr,
    LogicalNot,

    // PARENTESIS / BLOQUES
    LParen,
    RParen,
    LBracket,
    RBracket,
    LBrace,
    RBrace,

    // SEPARADORES
    Comma,
    Semicolon,
    ColonColon,
    Dot
};

// Tabla de clases de nodo: copia IDENTICA del enum de
// SemanticAnalyzer.kpp (contrato entre emisor y consumidor).
// El orden lo fija aquella lista; un nodo nuevo va AL FINAL.

enum NodeKind
{
    // DECLARACIONES
    Program,
    FunctionDeclaration,
    StructDeclaration,
    EnumDeclaration,

    // SENTENCIAS
    Block,
    VariableDeclaration,
    AssignmentStatement,
    IfStatement,
    WhileStatement,
    ReturnStatement,
    PrintStatement,
    PrintIntegerStatement,

    // EXPRESIONES
    IntegerLiteral,
    StringLiteral,
    VariableExpression,
    ArrayAccessExpression,
    CallExpression,
    BinaryExpression
};

// ============================================================
// ESTADO COMPARTIDO (DATA) — el corazon del estilo subrutina
// ============================================================

int pos;
int ntok;
int nnodos;
int errores;
int nfun;
int nsent;
int npar;
int ncam;
int nconst;

// ============================================================
// MAQUINARIA DEL CURSOR (Parser::current/check/match/expect)
// ============================================================

int actual()
{
    int tipo[64];
    if (pos < ntok)
    {
        return tipo[pos];
    }
    return TokenType::EndOfFile;
}

int es(int t)
{
    if (actual() == t)
    {
        return 1;
    }
    return 0;
}

int consume()
{
    int tipo[64];
    int t = TokenType::EndOfFile;
    if (pos < ntok)
    {
        t = tipo[pos];
        pos = pos + 1;
    }
    return t;
}

int espera(int t)
{
    if (es(t) == 1)
    {
        int c = consume();
        return 1;
    }
    errores = errores + 1;
    return 0;
}

// ============================================================
// NODOS.
//
// El nodo es un indice. Sus datos viven en arreglos
// paralelos compartidos por nombre:
//
// nkind  clase del nodo (NodeKind).
// nini   primer token del nodo.
// nfin   token siguiente al ultimo del nodo.
// nhijo1 hijo izquierdo / primer hijo / indice de arreglo.
// nhijo2 hijo derecho / valor de una asignacion.
// nsig   siguiente hermano (argumentos de una llamada).
// nval   carga util: valor de un literal entero, codigo
//        TokenType del operador de un nodo binario, o
//        indice del token del nombre (variable, llamada).
// ============================================================

int emite(int kind, int ini)
{
    int nkind[256];
    int nini[256];
    int nfin[256];
    int nhijo1[256];
    int nhijo2[256];
    int nsig[256];
    int nval[256];
    int nparam_cantidad[256];
    int ncampo_cantidad[256];
    int nconst_cantidad[256];
    int nsize[256];
    nkind[nnodos] = kind;
    nini[nnodos] = ini;
    nfin[nnodos] = pos;
    nhijo1[nnodos] = 0 - 1;
    nhijo2[nnodos] = 0 - 1;
    nsig[nnodos] = 0 - 1;
    nval[nnodos] = 0;
    nparam_cantidad[nnodos] = 0;
    ncampo_cantidad[nnodos] = 0;
    nconst_cantidad[nnodos] = 0;
    nsize[nnodos] = 0;
    nnodos = nnodos + 1;
    return nnodos - 1;
}

int pon_hijo1(int nodo, int hijo)
{
    int nhijo1[256];
    nhijo1[nodo] = hijo;
    return 0;
}

int pon_hijo2(int nodo, int hijo)
{
    int nhijo2[256];
    nhijo2[nodo] = hijo;
    return 0;
}

int pon_sig(int nodo, int hermano)
{
    int nsig[256];
    nsig[nodo] = hermano;
    return 0;
}

// Las cantidades de las declaraciones viven en arrays
// propios desde la rebanada 10: nsig es SOLO el siguiente
// hermano (su unico uso vivo, la cadena de argumentos de
// las llamadas). El inicio de cada grupo sigue en hijo2.
int pon_cant_params(int nodo, int cantidad)
{
    int nparam_cantidad[256];
    nparam_cantidad[nodo] = cantidad;
    return 0;
}

int pon_cant_campos(int nodo, int cantidad)
{
    int ncampo_cantidad[256];
    ncampo_cantidad[nodo] = cantidad;
    return 0;
}

int pon_cant_consts(int nodo, int cantidad)
{
    int nconst_cantidad[256];
    nconst_cantidad[nodo] = cantidad;
    return 0;
}

int pon_val(int nodo, int valor)
{
    int nval[256];
    nval[nodo] = valor;
    return 0;
}

// El tamano del arreglo de una VariableDeclaration
// (rebanada 11): 0 = no es arreglo. Es un atributo del
// nodo, como en Stage 0 (arraySize).
int pon_size(int nodo, int tam)
{
    int nsize[256];
    nsize[nodo] = tam;
    return 0;
}

int nodo_ini(int nodo)
{
    int nini[256];
    if (nodo >= 0)
    {
        return nini[nodo];
    }
    return pos;
}

// Constructor de binarios: el BinaryExpression de Stage 0,
// con el operador guardado como codigo TokenType en nval
// (Stage 0 lo guarda como texto: "==", "+", ...).
int emite_bin(int op, int izq, int der)
{
    int n = emite(NodeKind::BinaryExpression, nodo_ini(izq));
    int a = pon_hijo1(n, izq);
    int b = pon_hijo2(n, der);
    int c = pon_val(n, op);
    return n;
}

int emite_lit(int valor, int ini)
{
    int n = emite(NodeKind::IntegerLiteral, ini);
    int a = pon_val(n, valor);
    return n;
}

int cuenta(int kind)
{
    int nkind[256];
    int total = 0;
    int i = 0;
    while (i < nnodos)
    {
        if (nkind[i] == kind)
        {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}

// Suma de los valores (nval) de todos los
// IntegerLiteral: la prueba numerica del pliegue de
// constantes de enum — cada Enum::Miembro ya es un
// literal con su valor.
int suma_literales()
{
    int nkind[256];
    int nval[256];
    int total = 0;
    int i = 0;
    while (i < nnodos)
    {
        if (nkind[i] == NodeKind::IntegerLiteral)
        {
            total = total + nval[i];
        }
        i = i + 1;
    }
    return total;
}

// Suma de las cantidades de parametros de todas las
// FunctionDeclaration, leidas de nparam_cantidad (la
// prueba de la rebanada 10: la cantidad ya no vive en
// nsig).
int params_total()
{
    int nkind[256];
    int nparam_cantidad[256];
    int total = 0;
    int i = 0;
    while (i < nnodos)
    {
        if (nkind[i] == NodeKind::FunctionDeclaration)
        {
            int c = nparam_cantidad[i];
            total = total + c;
        }
        i = i + 1;
    }
    return total;
}

// Suma de las cantidades de campos de todas las
// StructDeclaration, leidas de ncampo_cantidad.
int campos_total()
{
    int nkind[256];
    int ncampo_cantidad[256];
    int total = 0;
    int i = 0;
    while (i < nnodos)
    {
        if (nkind[i] == NodeKind::StructDeclaration)
        {
            int c = ncampo_cantidad[i];
            total = total + c;
        }
        i = i + 1;
    }
    return total;
}

// Suma de las cantidades de constantes de todas las
// EnumDeclaration, leidas de nconst_cantidad.
int consts_total()
{
    int nkind[256];
    int nconst_cantidad[256];
    int total = 0;
    int i = 0;
    while (i < nnodos)
    {
        if (nkind[i] == NodeKind::EnumDeclaration)
        {
            int c = nconst_cantidad[i];
            total = total + c;
        }
        i = i + 1;
    }
    return total;
}

// Suma de los tamanos (nsize) de todas las
// VariableDeclaration: la prueba de la rebanada 11 —
// el tamano del arreglo ya es un atributo del nodo,
// no un token que se analiza y se tira.
int tamanos_total()
{
    int nkind[256];
    int nsize[256];
    int total = 0;
    int i = 0;
    while (i < nnodos)
    {
        if (nkind[i] == NodeKind::VariableDeclaration)
        {
            int c = nsize[i];
            total = total + c;
        }
        i = i + 1;
    }
    return total;
}

// Suma de los nombres (nval, indice de token) de
// todas las VariableDeclaration: la otra prueba de
// la rebanada 11 — el nombre ya llega a nval en las
// ramas de sentencia, como ya llegaba en la global.
int suma_nombres()
{
    int nkind[256];
    int nval[256];
    int total = 0;
    int i = 0;
    while (i < nnodos)
    {
        if (nkind[i] == NodeKind::VariableDeclaration)
        {
            int c = nval[i];
            total = total + c;
        }
        i = i + 1;
    }
    return total;
}

// ============================================================
// CADENA DE EXPRESIONES.
//
// Traduccion nivel a nivel de la cadena de precedencia
// de Parser.cpp (parseExpression ... parsePrimary).
// Cada nivel es una subrutina que devuelve el indice del
// nodo raiz de su subarbol, o -1 si no hubo expresion.
//
// PRECEDENCIA:
//
// 1.  ||
// 2.  &&
// 3.  == !=
// 4.  < <= > >=
// 5.  + -
// 6.  * / %
// 7.  ^
// 8.  ! -
// 9.  primarios
// ============================================================

int parse_expresion()
{
    return parse_or();
}

// ============================================================
// PARSE OR.
//
// a || b
// ============================================================

int parse_or()
{
    int izq = parse_and();
    while (es(TokenType::LogicalOr) == 1)
    {
        int c = consume();
        int der = parse_and();
        izq = emite_bin(TokenType::LogicalOr, izq, der);
    }
    return izq;
}

// ============================================================
// PARSE AND.
//
// a && b
// ============================================================

int parse_and()
{
    int izq = parse_igualdad();
    while (es(TokenType::LogicalAnd) == 1)
    {
        int c = consume();
        int der = parse_igualdad();
        izq = emite_bin(TokenType::LogicalAnd, izq, der);
    }
    return izq;
}

// ============================================================
// PARSE EQUALITY.
//
// a == b
// a != b
// ============================================================

int parse_igualdad()
{
    int izq = parse_comparacion();
    int sigue = 1;
    while (sigue == 1)
    {
        int op = 0;
        if (es(TokenType::Equal) == 1)
        {
            op = TokenType::Equal;
        }
        if (es(TokenType::NotEqual) == 1)
        {
            op = TokenType::NotEqual;
        }
        if (op == 0)
        {
            sigue = 0;
        }
        if (sigue == 1)
        {
            int c = consume();
            int der = parse_comparacion();
            izq = emite_bin(op, izq, der);
        }
    }
    return izq;
}

// ============================================================
// PARSE COMPARISON.
//
// a < b
// a <= b
// a > b
// a >= b
// ============================================================

int parse_comparacion()
{
    int izq = parse_termino();
    int sigue = 1;
    while (sigue == 1)
    {
        int op = 0;
        if (es(TokenType::Less) == 1)
        {
            op = TokenType::Less;
        }
        if (es(TokenType::LessEqual) == 1)
        {
            op = TokenType::LessEqual;
        }
        if (es(TokenType::Greater) == 1)
        {
            op = TokenType::Greater;
        }
        if (es(TokenType::GreaterEqual) == 1)
        {
            op = TokenType::GreaterEqual;
        }
        if (op == 0)
        {
            sigue = 0;
        }
        if (sigue == 1)
        {
            int c = consume();
            int der = parse_termino();
            izq = emite_bin(op, izq, der);
        }
    }
    return izq;
}

// ============================================================
// PARSE TERM.
//
// a + b
// a - b
// ============================================================

int parse_termino()
{
    int izq = parse_factor();
    int sigue = 1;
    while (sigue == 1)
    {
        int op = 0;
        if (es(TokenType::Plus) == 1)
        {
            op = TokenType::Plus;
        }
        if (es(TokenType::Minus) == 1)
        {
            op = TokenType::Minus;
        }
        if (op == 0)
        {
            sigue = 0;
        }
        if (sigue == 1)
        {
            int c = consume();
            int der = parse_factor();
            izq = emite_bin(op, izq, der);
        }
    }
    return izq;
}

// ============================================================
// PARSE FACTOR.
//
// a * b
// a / b
// a % b
// ============================================================

int parse_factor()
{
    int izq = parse_potencia();
    int sigue = 1;
    while (sigue == 1)
    {
        int op = 0;
        if (es(TokenType::Multiply) == 1)
        {
            op = TokenType::Multiply;
        }
        if (es(TokenType::Divide) == 1)
        {
            op = TokenType::Divide;
        }
        if (es(TokenType::Modulo) == 1)
        {
            op = TokenType::Modulo;
        }
        if (op == 0)
        {
            sigue = 0;
        }
        if (sigue == 1)
        {
            int c = consume();
            int der = parse_potencia();
            izq = emite_bin(op, izq, der);
        }
    }
    return izq;
}

// ============================================================
// PARSE POWER.
//
// a ^ b
//
// La potencia se mantiene separada para poder darle
// posteriormente asociatividad propia (nota de Stage 0).
// ============================================================

int parse_potencia()
{
    int izq = parse_unario();
    while (es(TokenType::Power) == 1)
    {
        int c = consume();
        int der = parse_unario();
        izq = emite_bin(TokenType::Power, izq, der);
    }
    return izq;
}

// ============================================================
// PARSE UNARY.
//
// !a
// -a
//
// Stage 0 no tiene nodo unario: lo pliega a binario con
// un cero a la izquierda (!x -> 0 ! x, -x -> 0 - x).
// Esta traduccion conserva el pliegue.
// ============================================================

int parse_unario()
{
    if (es(TokenType::LogicalNot) == 1)
    {
        int ini = pos;
        int c = consume();
        int der = parse_unario();
        int cero = emite_lit(0, ini);
        return emite_bin(TokenType::LogicalNot, cero, der);
    }
    if (es(TokenType::Minus) == 1)
    {
        int ini = pos;
        int c = consume();
        int der = parse_unario();
        int cero = emite_lit(0, ini);
        return emite_bin(TokenType::Minus, cero, der);
    }
    return parse_primario();
}

// ============================================================
// PARSE PRIMARY.
//
// 42
// "HOLA"
// x
// x[0]
// f(a, b)
// p.campo
// (x + 10)
//
// El nombre de una variable o llamada se guarda como
// indice de su token en nval: el texto vive en la fuente
// y se recupera por tinicio/tlargo cuando haga falta.
//
// La constante de enum con :: (Enum::Miembro) se
// pliega a literal entero consultando la tabla de
// constantes, como en Stage 0 (rebanada 5).
// ============================================================

int parse_primario()
{
    int tvalor[64];
    int ini = pos;
    int t = actual();

    // Numero: el valor ya viene calculado en tvalor.
    if (t == TokenType::Number)
    {
        int v = tvalor[pos];
        int c = consume();
        return emite_lit(v, ini);
    }

    // Cadena: nval guarda el indice del token.
    if (t == TokenType::String)
    {
        int c = consume();
        int n = emite(NodeKind::StringLiteral, ini);
        int a = pon_val(n, ini);
        return n;
    }

    // Identificador: variable, acceso, llamada o campo.
    if (t == TokenType::Identifier)
    {
        int c = consume();

        // Constante de enum: Enum::Miembro — la primera
        // rama, como en el parsePrimary de Stage 0. Se
        // pliega a literal entero con el valor guardado
        // en la tabla de constantes; si el nombre no
        // esta, es error (el "enumerador no declarado"
        // de Stage 0).
        if (es(TokenType::ColonColon) == 1)
        {
            int c0 = consume();
            int mtok = pos;
            int ok0 = espera(TokenType::Identifier);
            int v = busca_const(ini, mtok);
            if (v == 0 - 1)
            {
                errores = errores + 1;
                return 0 - 1;
            }
            return emite_lit(v, ini);
        }

        // Acceso a arreglo: x[indice]
        if (es(TokenType::LBracket) == 1)
        {
            int c1 = consume();
            int idx = parse_expresion();
            int ok = espera(TokenType::RBracket);
            int n = emite(NodeKind::ArrayAccessExpression, ini);
            int a = pon_hijo1(n, idx);
            int b = pon_val(n, ini);
            return n;
        }

        // Llamada: f(a, b) — los argumentos cuelgan de
        // hijo1 y se encadenan entre si por nsig.
        if (es(TokenType::LParen) == 1)
        {
            int c1 = consume();
            int n = emite(NodeKind::CallExpression, ini);
            int b = pon_val(n, ini);
            int primero = 0 - 1;
            int ultimo = 0 - 1;
            if (es(TokenType::RParen) == 0)
            {
                int sigue = 1;
                while (sigue == 1)
                {
                    int arg = parse_expresion();
                    if (primero == 0 - 1)
                    {
                        primero = arg;
                        int a1 = pon_hijo1(n, arg);
                    }
                    if (ultimo != 0 - 1)
                    {
                        int a2 = pon_sig(ultimo, arg);
                    }
                    ultimo = arg;
                    int seguir = 0;
                    if (es(TokenType::Comma) == 1)
                    {
                        int c2 = consume();
                        seguir = 1;
                    }
                    if (seguir == 0)
                    {
                        sigue = 0;
                    }
                }
            }
            int ok = espera(TokenType::RParen);
            return n;
        }

        // Acceso a campo: p.campo — hijo1 guarda el
        // indice del token del campo (no un nodo).
        if (es(TokenType::Dot) == 1)
        {
            int c1 = consume();
            int campo = pos;
            int ok = espera(TokenType::Identifier);
            int n = emite(NodeKind::VariableExpression, ini);
            int a = pon_val(n, ini);
            int b = pon_hijo1(n, campo);
            return n;
        }

        // Variable simple.
        int n = emite(NodeKind::VariableExpression, ini);
        int a = pon_val(n, ini);
        return n;
    }

    // Expresion entre parentesis: no emite nodo propio.
    if (t == TokenType::LParen)
    {
        int c = consume();
        int e = parse_expresion();
        int ok = espera(TokenType::RParen);
        return e;
    }

    // Nada reconocido: error y avance para no ciclar.
    errores = errores + 1;
    int c2 = consume();
    return 0 - 1;
}

// ============================================================
// SENTENCIAS (Parser::parseStatement, nucleo de la rebanada)
// ============================================================

int parse_sentencia()
{
    int tvalor[80];
    int ini = pos;
    int t = actual();

    // Declaracion de variable: int nombre [N] [= expr];
    // (tambien string). El inicializador, si lo hay, se
    // analiza de verdad y cuelga de hijo1. Los datos de
    // la declaracion son atributos del nodo (rebanada
    // 11): el nombre en nval, el tamano en nsize.
    if (t == TokenType::KwInt)
    {
        int c1 = consume();
        int nombre = pos;
        int ok = espera(TokenType::Identifier);
        int tam = 0;
        if (es(TokenType::LBracket) == 1)
        {
            int c2 = consume();
            int npos = pos;
            int ok2 = espera(TokenType::Number);
            if (ok2 == 1)
            {
                tam = tvalor[npos];
                if (tam <= 0)
                {
                    errores = errores + 1;
                }
            }
            int ok3 = espera(TokenType::RBracket);
        }
        int init = 0 - 1;
        if (es(TokenType::Assign) == 1)
        {
            int c3 = consume();
            init = parse_expresion();
        }
        int ok4 = espera(TokenType::Semicolon);
        int n = emite(NodeKind::VariableDeclaration, ini);
        int v = pon_val(n, nombre);
        int s = pon_size(n, tam);
        if (init != 0 - 1)
        {
            int a = pon_hijo1(n, init);
        }
        nsent = nsent + 1;
        return 1;
    }
    if (t == TokenType::KwString)
    {
        int c1 = consume();
        int nombre = pos;
        int ok = espera(TokenType::Identifier);
        int tam = 0;
        if (es(TokenType::LBracket) == 1)
        {
            int c2 = consume();
            int npos = pos;
            int ok2 = espera(TokenType::Number);
            if (ok2 == 1)
            {
                tam = tvalor[npos];
                if (tam <= 0)
                {
                    errores = errores + 1;
                }
            }
            int ok3 = espera(TokenType::RBracket);
        }
        int init = 0 - 1;
        if (es(TokenType::Assign) == 1)
        {
            int c3 = consume();
            init = parse_expresion();
        }
        int ok4 = espera(TokenType::Semicolon);
        int n = emite(NodeKind::VariableDeclaration, ini);
        int v = pon_val(n, nombre);
        int s = pon_size(n, tam);
        if (init != 0 - 1)
        {
            int a = pon_hijo1(n, init);
        }
        nsent = nsent + 1;
        return 1;
    }

    // if (condicion) bloque [else bloque | else if ...]
    // La condicion ya no se salta: se analiza y cuelga
    // de hijo1 del nodo If. Los bloques caen detras
    // del nodo, en orden de emision.
    if (t == TokenType::KwIf)
    {
        int c1 = consume();
        int ok = espera(TokenType::LParen);
        int cond = parse_expresion();
        int ok2 = espera(TokenType::RParen);
        int n = emite(NodeKind::IfStatement, ini);
        int a = pon_hijo1(n, cond);
        nsent = nsent + 1;
        int b = parse_bloque();
        if (es(TokenType::KwElse) == 1)
        {
            int c2 = consume();
            // La decision se lee una sola vez, antes de
            // analizar nada: tras el if anidado, el
            // token actual ya es otro.
            int esif = es(TokenType::KwIf);
            if (esif == 1)
            {
                // ELSE IF (Stage 0): el if anidado va
                // envuelto en un Block sintetico de una
                // sola sentencia. El Block se emite y
                // la sentencia if cae detras de el, en
                // orden de emision, igual que las
                // sentencias de un bloque real.
                int nb = emite(NodeKind::Block, pos);
                int s = parse_sentencia();
            }
            if (esif == 0)
            {
                int b2 = parse_bloque();
            }
        }
        return 1;
    }

    // while (condicion) bloque
    if (t == TokenType::KwWhile)
    {
        int c1 = consume();
        int ok = espera(TokenType::LParen);
        int cond = parse_expresion();
        int ok2 = espera(TokenType::RParen);
        int n = emite(NodeKind::WhileStatement, ini);
        int a = pon_hijo1(n, cond);
        nsent = nsent + 1;
        int b = parse_bloque();
        return 1;
    }

    // print ( expr );
    if (t == TokenType::KwPrint)
    {
        int c1 = consume();
        int ok = espera(TokenType::LParen);
        int e = parse_expresion();
        int ok2 = espera(TokenType::RParen);
        int ok3 = espera(TokenType::Semicolon);
        int n = emite(NodeKind::PrintStatement, ini);
        int a = pon_hijo1(n, e);
        nsent = nsent + 1;
        return 1;
    }

    // return [expr];
    if (t == TokenType::KwReturn)
    {
        int c1 = consume();
        int e = 0 - 1;
        if (es(TokenType::Semicolon) == 0)
        {
            e = parse_expresion();
        }
        int ok = espera(TokenType::Semicolon);
        int n = emite(NodeKind::ReturnStatement, ini);
        if (e != 0 - 1)
        {
            int a = pon_hijo1(n, e);
        }
        nsent = nsent + 1;
        return 1;
    }

    // print_int(expr); — print_int no es palabra
    // clave: llega como Identifier y se reconoce
    // por su texto (es_print_int), igual que en
    // Stage 0. La rama va ANTES de la asignacion:
    // si el identificador es print_int, la
    // sentencia es PrintIntegerStatement y su
    // expresion cuelga de hijo1. La condicion va
    // anidada: el && de K++ no cortocircuita y
    // es_print_int solo debe llamarse si el
    // token es Identifier.
    if (t == TokenType::Identifier)
    {
        if (es_print_int(ini) == 1)
        {
            int c1 = consume();
            int ok = espera(TokenType::LParen);
            int e = parse_expresion();
            int ok2 = espera(TokenType::RParen);
            int ok3 = espera(TokenType::Semicolon);
            int n = emite(NodeKind::PrintIntegerStatement, ini);
            int a = pon_hijo1(n, e);
            nsent = nsent + 1;
            return 1;
        }
    }

    // Declaracion de tipo personalizado:
    // Persona p; — dos Identifier seguidos solo
    // pueden ser una declaracion (Stage 0 lo
    // decide asi, sin consultar ninguna tabla
    // de tipos: si el tipo existe es asunto del
    // semantico). Sin inicializador y sin
    // arreglo. El nodo es el mismo
    // VariableDeclaration: el tipo queda en el
    // token inicial y el nombre en el siguiente,
    // guardado ademas en nval (rebanada 11: nval
    // es el nombre en toda VariableDeclaration).
    if (t == TokenType::Identifier)
    {
        if (mira(1, TokenType::Identifier) == 1)
        {
            int c1 = consume();
            int nombre = pos;
            int c2 = consume();
            int ok = espera(TokenType::Semicolon);
            int n = emite(NodeKind::VariableDeclaration, ini);
            int v = pon_val(n, nombre);
            nsent = nsent + 1;
            return 1;
        }
    }

    // Asignacion: nombre = expr;  /  nombre[i] = expr;
    // El nombre queda en nval (indice de su token); el
    // indice, si lo hay, en hijo1; el valor en hijo2.
    if (t == TokenType::Identifier)
    {
        int c1 = consume();
        int idx = 0 - 1;
        if (es(TokenType::LBracket) == 1)
        {
            int c2 = consume();
            idx = parse_expresion();
            int ok = espera(TokenType::RBracket);
        }
        // Acceso a campo: nombre.campo — el token
        // del campo queda guardado para hijo1 (no
        // es un nodo), el mismo pliegue que la
        // lectura de parse_primario.
        int campo = 0 - 1;
        if (es(TokenType::Dot) == 1)
        {
            int c5 = consume();
            campo = pos;
            int ok5 = espera(TokenType::Identifier);
        }
        int ok2 = espera(TokenType::Assign);
        int valor = parse_expresion();
        int ok3 = espera(TokenType::Semicolon);
        int n = emite(NodeKind::AssignmentStatement, ini);
        int a = pon_val(n, ini);
        int b = pon_hijo2(n, valor);
        if (idx != 0 - 1)
        {
            int c3 = pon_hijo1(n, idx);
        }
        if (campo != 0 - 1)
        {
            int c6 = pon_hijo1(n, campo);
        }
        nsent = nsent + 1;
        return 1;
    }

    // Nada reconocido: error y avance para no ciclar.
    errores = errores + 1;
    int c4 = consume();
    return 0;
}

// ============================================================
// BLOQUES Y FUNCIONES (Parser::parseBlock / parseFunction)
// ============================================================

int parse_bloque()
{
    int ini = pos;
    int ok = espera(TokenType::LBrace);
    int n = emite(NodeKind::Block, ini);
    int sigue = 1;
    while (sigue == 1)
    {
        if (pos >= ntok)
        {
            sigue = 0;
        }
        if (es(TokenType::RBrace) == 1)
        {
            sigue = 0;
        }
        if (sigue == 1)
        {
            int s = parse_sentencia();
        }
    }
    int ok2 = espera(TokenType::RBrace);
    return 1;
}

int pon_param(int tok)
{
    int partok[64];
    partok[npar] = tok;
    npar = npar + 1;
    return 0;
}

int parse_funcion()
{
    int ini = pos;
    int ok = espera(TokenType::KwInt);
    int nombre = pos;
    int ok2 = espera(TokenType::Identifier);
    int ok3 = espera(TokenType::LParen);

    // Parametros: solamente int (FASE 4.2.1 de Stage 0).
    // Parameter no es un NodeKind: los parametros viven
    // en su tabla lateral partok, y la funcion guarda en
    // hijo2 el inicio de los suyos y cuantos son en
    // nparam_cantidad (rebanada 10; antes nsig).
    int pini = npar;
    if (es(TokenType::RParen) == 0)
    {
        int sigue = 1;
        while (sigue == 1)
        {
            int ok4 = espera(TokenType::KwInt);
            int ptok = pos;
            int ok5 = espera(TokenType::Identifier);
            int r = pon_param(ptok);
            int seguir = 0;
            if (es(TokenType::Comma) == 1)
            {
                int c = consume();
                seguir = 1;
            }
            if (seguir == 0)
            {
                sigue = 0;
            }
        }
    }
    int ok6 = espera(TokenType::RParen);

    int n = emite(NodeKind::FunctionDeclaration, ini);
    int a = pon_val(n, nombre);
    int b = pon_hijo2(n, pini);
    int c = pon_cant_params(n, npar - pini);
    nfun = nfun + 1;

    int bloque = nnodos;
    int bl = parse_bloque();
    int d = pon_hijo1(n, bloque);
    return 1;
}

// ============================================================
// CAMPOS DE STRUCT (la tabla lateral de parseStruct).
//
// StructField no es un NodeKind (contrato de
// SemanticAnalyzer.kpp): los campos viven en su tabla
// lateral, como los parametros en partok. campotipo
// guarda el tipo como codigo TokenType (KwInt/KwString)
// donde Stage 0 guarda el texto ("int"/"string") — el
// mismo criterio que la rebanada 2 aplico a los
// operadores. campotok guarda el indice del token del
// nombre del campo.
// ============================================================

int pon_campo(int tipo, int tok)
{
    int campotipo[64];
    int campotok[64];
    campotipo[ncam] = tipo;
    campotok[ncam] = tok;
    ncam = ncam + 1;
    return 0;
}

// ============================================================
// PARSE STRUCT (Parser::parseStruct).
//
// struct Nombre
// {
//     int campo;
//     string campo;
// };
//
// Tipos de campo admitidos: int y string, nada mas
// (Stage 0 no admite structs anidados). La estructura
// guarda su nombre en nval, el inicio de sus campos en
// hijo2 y cuantos son en ncampo_cantidad (rebanada 10;
// antes nsig). La declaracion cierra
// con ';' tras la '}', como exige Stage 0.
// ============================================================

int parse_estructura()
{
    int ini = pos;
    int ok = espera(TokenType::KwStruct);
    int nombre = pos;
    int ok2 = espera(TokenType::Identifier);
    int ok3 = espera(TokenType::LBrace);

    int cini = ncam;
    int sigue = 1;
    while (sigue == 1)
    {
        if (es(TokenType::RBrace) == 1)
        {
            sigue = 0;
        }
        if (pos >= ntok)
        {
            sigue = 0;
        }
        if (sigue == 1)
        {
            int tipo = 0;
            if (es(TokenType::KwInt) == 1)
            {
                tipo = TokenType::KwInt;
            }
            if (es(TokenType::KwString) == 1)
            {
                tipo = TokenType::KwString;
            }
            if (tipo == 0)
            {
                errores = errores + 1;
                int cx = consume();
            }
            if (tipo != 0)
            {
                int c = consume();
                int ctok = pos;
                int ok4 = espera(TokenType::Identifier);
                int ok5 = espera(TokenType::Semicolon);
                int r = pon_campo(tipo, ctok);
            }
        }
    }
    int ok6 = espera(TokenType::RBrace);
    int ok7 = espera(TokenType::Semicolon);

    int n = emite(NodeKind::StructDeclaration, ini);
    int a = pon_val(n, nombre);
    int b = pon_hijo2(n, cini);
    int c = pon_cant_campos(n, ncam - cini);
    return 1;
}

// ============================================================
// CONSTANTES DE ENUM (el enumConstants de Stage 0).
//
// EnumValue no es un NodeKind (contrato de
// SemanticAnalyzer.kpp): las constantes viven en su
// tabla lateral, como los parametros en partok y los
// campos en campotok. Tres columnas por constante:
// constenum guarda el token del nombre del enum,
// constok el token del nombre del miembro y
// constvalor el valor ya calculado (el automatico o
// el explicito tras el '=').
//
// Stage 0 busca por texto ("Color::Rojo") en un mapa.
// Aqui no hay texto: hay tinicio/tlargo, que son la
// direccion del nombre dentro de la fuente. Por eso
// la tabla 4 carga ademas el arreglo fuente[] con los
// caracteres de su fuente, y mismo_texto compara dos
// nombres caracter a caracter — la misma igualdad
// por contenido del mapa, escrita con posiciones.
// En las tablas sin '::' nada de esto se mueve.
// ============================================================

int mismo_texto(int a, int b)
{
    int tinicio[64];
    int tlargo[64];
    int fuente[512];
    // Cada largo y cada caracter se lee primero a una
    // variable local y se compara despues, en
    // sentencias separadas. La forma directa —
    // comparar dos cargas calculadas dentro de una
    // sola expresion — devolvio siempre distinto en
    // campo, con el IR correcto: es la forma que esta
    // funcion evita a proposito
    // (sonda_mismo_texto.kpp).
    int la = tlargo[a];
    int lb = tlargo[b];
    if (la != lb)
    {
        return 0;
    }
    int ia = tinicio[a];
    int ib = tinicio[b];
    int i = 0;
    while (i < la)
    {
        int ca = fuente[ia + i];
        int cb = fuente[ib + i];
        if (ca != cb)
        {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int pon_const(int etok, int tok, int valor)
{
    int constenum[64];
    int constok[64];
    int constvalor[64];
    constenum[nconst] = etok;
    constok[nconst] = tok;
    constvalor[nconst] = valor;
    nconst = nconst + 1;
    return 0;
}

// busca_const(etok, mtok): el valor de la constante
// etok::mtok, o -1 si no esta declarada. Los valores
// de enum nunca son negativos (Stage 0 solo admite
// numeros tras el '='), asi que -1 es centinela
// limpio.
int busca_const(int etok, int mtok)
{
    int constenum[64];
    int constok[64];
    int constvalor[64];
    int i = 0;
    while (i < nconst)
    {
        if (mismo_texto(etok, constenum[i]) == 1)
        {
            if (mismo_texto(mtok, constok[i]) == 1)
            {
                return constvalor[i];
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ============================================================
// ES PRINT INT (el chequeo de texto de Stage 0).
//
// print_int no es palabra clave en K++: el Lexer lo
// entrega como Identifier, y Stage 0 lo reconoce en
// parseStatement comparando el texto del token
// (current().text == "print_int"). Aqui el nombre se
// reconoce caracter a caracter sobre fuente[], con
// el largo primero. Cada caracter se lee a una
// variable local antes de comparar — la forma
// probada en campo por mismo_texto: dos cargas
// calculadas comparadas dentro de una sola
// expresion devuelven siempre distinto.
// ============================================================

int es_print_int(int tok)
{
    int tinicio[80];
    int tlargo[80];
    int fuente[512];
    int largo = tlargo[tok];
    if (largo != 9)
    {
        return 0;
    }
    int base = tinicio[tok];
    int c0 = fuente[base + 0];
    int c1 = fuente[base + 1];
    int c2 = fuente[base + 2];
    int c3 = fuente[base + 3];
    int c4 = fuente[base + 4];
    int c5 = fuente[base + 5];
    int c6 = fuente[base + 6];
    int c7 = fuente[base + 7];
    int c8 = fuente[base + 8];
    if (c0 != 112)
    {
        return 0;
    }
    if (c1 != 114)
    {
        return 0;
    }
    if (c2 != 105)
    {
        return 0;
    }
    if (c3 != 110)
    {
        return 0;
    }
    if (c4 != 116)
    {
        return 0;
    }
    if (c5 != 95)
    {
        return 0;
    }
    if (c6 != 105)
    {
        return 0;
    }
    if (c7 != 110)
    {
        return 0;
    }
    if (c8 != 116)
    {
        return 0;
    }
    return 1;
}

// ============================================================
// PARSE ENUM (Parser::parseEnum).
//
// enum Nombre
// {
//     Miembro,
//     Miembro = 10,
//     Miembro
// };
//
// El valor corre solo desde 0; tras un valor
// explicito el siguiente continua en ese valor + 1
// (el nextValue de Stage 0). Un miembro repetido
// dentro del mismo enum es error — el chequeo del
// mapa de Stage 0, limitado a este enum: el mismo
// nombre en OTRO enum es legal (bateria L08). La
// declaracion cierra con ';' tras la '}', como la
// de struct. El nodo guarda su nombre en nval, el
// inicio de sus constantes en hijo2 y cuantas son
// en nconst_cantidad (rebanada 10; antes nsig).
// ============================================================

int parse_enum()
{
    int tvalor[64];
    int constok[64];
    int ini = pos;
    int ok = espera(TokenType::KwEnum);
    int nombre = pos;
    int ok2 = espera(TokenType::Identifier);
    int ok3 = espera(TokenType::LBrace);

    int cini = nconst;
    int siguiente = 0;
    int sigue = 1;
    while (sigue == 1)
    {
        if (es(TokenType::RBrace) == 1)
        {
            sigue = 0;
        }
        if (pos >= ntok)
        {
            sigue = 0;
        }
        if (sigue == 1)
        {
            int mtok = pos;
            int ok4 = espera(TokenType::Identifier);
            int valor = siguiente;
            if (es(TokenType::Assign) == 1)
            {
                int c = consume();
                valor = tvalor[pos];
                int ok5 = espera(TokenType::Number);
            }
            siguiente = valor + 1;

            int dup = 0;
            int i = cini;
            while (i < nconst)
            {
                if (mismo_texto(mtok, constok[i]) == 1)
                {
                    dup = 1;
                }
                i = i + 1;
            }
            if (dup == 1)
            {
                errores = errores + 1;
            }
            if (dup == 0)
            {
                int r = pon_const(nombre, mtok, valor);
            }

            if (es(TokenType::RBrace) == 0)
            {
                int ok6 = espera(TokenType::Comma);
            }
        }
    }
    int ok7 = espera(TokenType::RBrace);
    int ok8 = espera(TokenType::Semicolon);

    int n = emite(NodeKind::EnumDeclaration, ini);
    int a = pon_val(n, nombre);
    int b = pon_hijo2(n, cini);
    int c = pon_cant_consts(n, nconst - cini);
    return 1;
}

// ============================================================
// PROGRAMA (Parser::parse, nivel superior de la rebanada)
// ============================================================

// mira(salto, t): el checkAhead de Stage 0 — el tipo del
// token que esta `salto` posiciones adelante, sin consumir.
int mira(int salto, int t)
{
    int tipo[64];
    if (pos + salto < ntok)
    {
        if (tipo[pos + salto] == t)
        {
            return 1;
        }
    }
    return 0;
}

// int nombre; a nivel de programa: el escalar compartido
// (parseGlobalVariable de Stage 0, la bifurcacion de L19).
int parse_global()
{
    int ini = pos;
    int c = consume();
    int nombre = pos;
    int ok = espera(TokenType::Identifier);
    int ok2 = espera(TokenType::Semicolon);
    int n = emite(NodeKind::VariableDeclaration, ini);
    int a = pon_val(n, nombre);
    return 1;
}

int parse_programa()
{
    int ini = pos;
    int n = emite(NodeKind::Program, ini);
    while (pos < ntok)
    {
        int hecho = 0;
        if (es(TokenType::KwStruct) == 1)
        {
            // struct primero y enum detras, el orden
            // del parse() de Stage 0.
            int e = parse_estructura();
            hecho = 1;
        }
        if (es(TokenType::KwEnum) == 1)
        {
            int en = parse_enum();
            hecho = 1;
        }
        if (es(TokenType::KwInt) == 1)
        {
            // La bifurcacion de Stage 0 (parse()):
            // int nombre;  -> variable global
            // int nombre(  -> funcion
            if (mira(2, TokenType::Semicolon) == 1)
            {
                int g = parse_global();
            }
            if (mira(2, TokenType::Semicolon) == 0)
            {
                int f = parse_funcion();
            }
            hecho = 1;
        }
        if (hecho == 0)
        {
            errores = errores + 1;
            int c = consume();
        }
    }
    return 1;
}

