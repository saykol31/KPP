// Deja el estado compartido como recien nacido, para
// correr las demas tablas en el mismo programa.
int reinicia()
{
    pos = 0;
    nnodos = 0;
    errores = 0;
    nfun = 0;
    nsent = 0;
    npar = 0;
    ncam = 0;
    nconst = 0;
    return 0;
}

