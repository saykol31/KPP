// Lexer.kpp — Stage 1, pieza 1, rebanada 1 (BORRADOR sin compilar)
// Lee FUENTE.KPP una sola vez y vuelca (tipo, inicio, largo) por token.
// Codigos de token: orden de TokenType en include/kpp/Token.hpp (Stage 0).
// Reglas que este borrador respeta, todas verificadas contra Stage 0:
//   - Todo en main, sin funciones auxiliares: K++ no pasa arreglos por
//     parametro, y un return de temporal auto-imprime (correccion 2026-11-08).
//   - && NO cortocircuita en K++: baja a una sola AND con los dos lados
//     evaluados (IRGenerator.cpp / X86Backend.cpp). Ningun fuente[pos]
//     va a la derecha de un &&: los guardas de fin de fuente van en
//     if separados, y los escaneos usan un flag sigue, no break (no existe).
//   - Sin literales de caracter en K++: se comparan codigos numericos.
//   - // salta hasta fin de linea; / solo sigue siendo Divide (b35d47c).
//   - String sin escapes, igual que el Lexer.cpp de Stage 0.
//   - & y | sueltos y : suelta no son tokens: se cuentan en errores
//     (Stage 0 los rechaza con error; la fuente de prueba no los usa).
//   - La clasificacion de palabras clave usa ifs anidados guardados
//     por largo, nunca && con indices: asi ningun indice sale del
//     identificador escaneado.
// Salida: por token, tipo, inicio y largo (3 print_int por token),
// y al final ntok y errores. Aceptacion: 27 tokens, 0 errores con
// FUENTE.KPP, y los mismos numeros en tu KolibriOS.

int main()
{
    int fuente[1024];
    int tok_tipo[256];
    int tok_inicio[256];
    int tok_largo[256];

    int total = 0;
    int pos = 0;
    int ntok = 0;
    int inicio = 0;
    int largo = 0;
    int tipo = 0;
    int c = 0;
    int d = 0;
    int sigue = 0;
    int hay_token = 0;
    int errores = 0;
    int i = 0;

    total = file_read("FUENTE.KPP", fuente);

    if (total < 0)
    {
        print_int(total);
        return 1;
    }

    print("TOKENS");

    while (pos < total)
    {
        c = fuente[pos];
        hay_token = 0;
        tipo = 0;
        inicio = pos;
        largo = 1;

        if (c == 32 || c == 9 || c == 10 || c == 13)
        {
            pos = pos + 1;
        }
        else if (c == 47)
        {
            d = 0;
            if (pos + 1 < total)
            {
                d = fuente[pos + 1];
            }
            if (d == 47)
            {
                pos = pos + 2;
                sigue = 1;
                while (sigue == 1)
                {
                    if (pos >= total)
                    {
                        sigue = 0;
                    }
                    else
                    {
                        c = fuente[pos];
                        if (c == 10)
                        {
                            sigue = 0;
                        }
                        else
                        {
                            pos = pos + 1;
                        }
                    }
                }
            }
            else
            {
                tipo = 17;
                hay_token = 1;
                pos = pos + 1;
            }
        }
        else if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95)
        {
            sigue = 1;
            while (sigue == 1)
            {
                if (pos >= total)
                {
                    sigue = 0;
                }
                else
                {
                    c = fuente[pos];
                    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95)
                    {
                        pos = pos + 1;
                    }
                    else
                    {
                        sigue = 0;
                    }
                }
            }
            largo = pos - inicio;
            tipo = 1;
            if (largo == 2)
            {
                if (fuente[inicio] == 105)
                {
                    if (fuente[inicio + 1] == 102)
                    {
                        tipo = 10;
                    }
                }
            }
            if (largo == 3)
            {
                if (fuente[inicio] == 105)
                {
                    if (fuente[inicio + 1] == 110)
                    {
                        if (fuente[inicio + 2] == 116)
                        {
                            tipo = 4;
                        }
                    }
                }
            }
            if (largo == 4)
            {
                if (fuente[inicio] == 101)
                {
                    if (fuente[inicio + 1] == 110)
                    {
                        if (fuente[inicio + 2] == 117)
                        {
                            if (fuente[inicio + 3] == 109)
                            {
                                tipo = 7;
                            }
                        }
                    }
                    if (fuente[inicio + 1] == 108)
                    {
                        if (fuente[inicio + 2] == 115)
                        {
                            if (fuente[inicio + 3] == 101)
                            {
                                tipo = 11;
                            }
                        }
                    }
                }
            }
            if (largo == 5)
            {
                if (fuente[inicio] == 112)
                {
                    if (fuente[inicio + 1] == 114)
                    {
                        if (fuente[inicio + 2] == 105)
                        {
                            if (fuente[inicio + 3] == 110)
                            {
                                if (fuente[inicio + 4] == 116)
                                {
                                    tipo = 9;
                                }
                            }
                        }
                    }
                }
                if (fuente[inicio] == 119)
                {
                    if (fuente[inicio + 1] == 104)
                    {
                        if (fuente[inicio + 2] == 105)
                        {
                            if (fuente[inicio + 3] == 108)
                            {
                                if (fuente[inicio + 4] == 101)
                                {
                                    tipo = 12;
                                }
                            }
                        }
                    }
                }
            }
            if (largo == 6)
            {
                if (fuente[inicio] == 115)
                {
                    if (fuente[inicio + 1] == 116)
                    {
                        if (fuente[inicio + 2] == 114)
                        {
                            if (fuente[inicio + 3] == 105)
                            {
                                if (fuente[inicio + 4] == 110)
                                {
                                    if (fuente[inicio + 5] == 103)
                                    {
                                        tipo = 5;
                                    }
                                }
                            }
                        }
                        if (fuente[inicio + 2] == 114)
                        {
                            if (fuente[inicio + 3] == 117)
                            {
                                if (fuente[inicio + 4] == 99)
                                {
                                    if (fuente[inicio + 5] == 116)
                                    {
                                        tipo = 6;
                                    }
                                }
                            }
                        }
                    }
                }
                if (fuente[inicio] == 114)
                {
                    if (fuente[inicio + 1] == 101)
                    {
                        if (fuente[inicio + 2] == 116)
                        {
                            if (fuente[inicio + 3] == 117)
                            {
                                if (fuente[inicio + 4] == 114)
                                {
                                    if (fuente[inicio + 5] == 110)
                                    {
                                        tipo = 8;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            hay_token = 1;
        }
        else if (c >= 48 && c <= 57)
        {
            sigue = 1;
            while (sigue == 1)
            {
                if (pos >= total)
                {
                    sigue = 0;
                }
                else
                {
                    c = fuente[pos];
                    if (c >= 48 && c <= 57)
                    {
                        pos = pos + 1;
                    }
                    else
                    {
                        sigue = 0;
                    }
                }
            }
            largo = pos - inicio;
            tipo = 2;
            hay_token = 1;
        }
        else if (c == 34)
        {
            pos = pos + 1;
            sigue = 1;
            while (sigue == 1)
            {
                if (pos >= total)
                {
                    sigue = 0;
                }
                else
                {
                    c = fuente[pos];
                    if (c == 34)
                    {
                        pos = pos + 1;
                        sigue = 0;
                    }
                    else
                    {
                        pos = pos + 1;
                    }
                }
            }
            largo = pos - inicio;
            tipo = 3;
            hay_token = 1;
        }
        else
        {
            d = 0;
            if (pos + 1 < total)
            {
                d = fuente[pos + 1];
            }
            if (c == 43)
            {
                tipo = 14;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 45)
            {
                tipo = 15;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 42)
            {
                tipo = 16;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 37)
            {
                tipo = 18;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 94)
            {
                tipo = 19;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 40)
            {
                tipo = 29;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 41)
            {
                tipo = 30;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 91)
            {
                tipo = 31;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 93)
            {
                tipo = 32;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 123)
            {
                tipo = 33;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 125)
            {
                tipo = 34;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 44)
            {
                tipo = 35;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 59)
            {
                tipo = 36;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 46)
            {
                tipo = 38;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 61)
            {
                if (d == 61)
                {
                    tipo = 20;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 13;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 33)
            {
                if (d == 61)
                {
                    tipo = 21;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 28;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 60)
            {
                if (d == 61)
                {
                    tipo = 23;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 22;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 62)
            {
                if (d == 61)
                {
                    tipo = 25;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 24;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 38)
            {
                if (d == 38)
                {
                    tipo = 26;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    errores = errores + 1;
                    pos = pos + 1;
                }
            }
            else if (c == 124)
            {
                if (d == 124)
                {
                    tipo = 27;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    errores = errores + 1;
                    pos = pos + 1;
                }
            }
            else if (c == 58)
            {
                if (d == 58)
                {
                    tipo = 37;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    errores = errores + 1;
                    pos = pos + 1;
                }
            }
            else
            {
                errores = errores + 1;
                pos = pos + 1;
            }
        }

        if (hay_token == 1)
        {
            if (ntok < 256)
            {
                tok_tipo[ntok] = tipo;
                tok_inicio[ntok] = inicio;
                tok_largo[ntok] = largo;
                ntok = ntok + 1;
            }
            else
            {
                errores = errores + 1;
            }
        }
    }

    i = 0;
    while (i < ntok)
    {
        print_int(tok_tipo[i]);
        print_int(tok_inicio[i]);
        print_int(tok_largo[i]);
        i = i + 1;
    }
    print_int(ntok);
    print_int(errores);

    return 0;
}
