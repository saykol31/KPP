///////////////////////////////////////////////////////////////////////////////////////////////////
// Lexer.kpp — Stage 1, pieza 1.
// Lee FUENTE.KPP una sola vez y vuelca (tipo, inicio, largo, valor) por token.
// Codigos de token: orden de TokenType en include/kpp/Token.hpp (Stage 0).
// Reglas que este borrador respeta, todas verificadas contra Stage 0:
//   - El escaneo vive en la subrutina escanea() (rebanada
//     del acople): los arreglos son compartidos por nombre
//     y ninguna subrutina necesita recibirlos; escanea()
//     es void desde la reescritura del Stage 1: registra
//     la tabla y el conteo queda en tok_count, el escalar
//     compartido que el Parser lee. main() queda como
//     la sonda de la pieza: lee el archivo y la imprime.
//   - && NO cortocircuita en K++: baja a una sola AND con los dos lados
//     evaluados (IRGenerator.cpp / X86Backend.cpp). Ningun fuente[pos]
//     va a la derecha de un &&: los guardas de fin de fuente van en
//     if separados. Los escaneos internos salen con break
//     desde la reescritura del Stage 1 (antes usaban un flag
//     sigue: la bandera existia solo para salir del ciclo, y
//     break lo dice sin variable).
//   - Sin literales de caracter en K++: se comparan codigos numericos.
//   - // salta hasta fin de linea; / solo sigue siendo Divide (b35d47c).
//   - String sin escapes, igual que el Lexer.cpp de Stage 0.
//   - & y | sueltos SON tokens desde la Ampliacion 4
//     (BitwiseAnd = 42 y BitwiseOr = 43); la : suelta
//     no es token: se cuenta en errores (Stage 0 la
//     rechaza con error; la fuente de prueba no la usa).
//   - La clasificacion de palabras clave usa ifs anidados guardados
//     por largo, nunca && con indices: asi ningun indice sale del
//     identificador escaneado.
// Salida: por token, tipo, inicio, largo y valor (4 print_int
// por token), y al final tok_count y errores. Aceptacion:
// 27 tokens, 0 errores con FUENTE.KPP, tok_valor 42 en los
// tokens 8 y 14, y los mismos numeros en tu KolibriOS.

// ============================================================
// ESTADO COMPARTIDO (DATA) — el contrato de arrays:
// pos es el cursor (del escaneo sobre fuente[], del
// Parser sobre la tabla), total los bytes de la
// fuente, tok_count los tokens registrados y errores
// el contador unico de la corrida.
// ============================================================

int pos;
int total;
int tok_count;
int errores;

// ============================================================
// ESCANEA — EL LEXER COMO SUBRUTINA (el contrato
// compartido, rebanada 14).
//
// Lee fuente[0..total) y registra cada token en la
// tabla compartida: tok_tipo, tok_inicio, tok_largo
// y tok_valor — el valor numerico ya calculado para
// los Number, acumulado digito a digito al escanear.
// Los errores lexicos se suman al errores compartido
// (escanea no lo pone a cero: en el programa acoplado
// cada corrida lo reinicia antes).
//
// Es void desde la reescritura del Stage 1: ningun
// llamador leia el valor que devolvia (main lo
// capturaba en una variable muerta y el Parser en
// quince). El conteo queda en tok_count, el escalar
// compartido. Al salir deja pos = 0, listo para que
// el Parser consuma la tabla sin copiar un solo token.
// ============================================================
void escanea()
{
    int fuente[1024];
    int tok_tipo[256];
    int tok_inicio[256];
    int tok_largo[256];
    int tok_valor[256];
    int inicio = 0;
    int largo = 0;
    int tipo = 0;
    int valor = 0;
    int c = 0;
    int d = 0;
    int hay_token = 0;
    pos = 0;
    tok_count = 0;
    while (pos < total)
    {
        c = fuente[pos];
        hay_token = 0;
        tipo = 0;
        inicio = pos;
        largo = 1;
        valor = 0;

        if (c == 32 || c == 9 || c == 10 || c == 13)
        {
            pos = pos + 1;
        }
        else if (c == 47)
        {
            d = 0;
            if (pos + 1 < total)
            {
                d = fuente[pos + 1];
            }
            if (d == 47)
            {
                pos = pos + 2;
                while (pos < total)
                {
                    c = fuente[pos];
                    if (c == 10)
                    {
                        break;
                    }
                    pos = pos + 1;
                }
            }
            else
            {
                tipo = 17;
                hay_token = 1;
                pos = pos + 1;
            }
        }
        else if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95)
        {
            while (pos < total)
            {
                c = fuente[pos];
                if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95)
                {
                    pos = pos + 1;
                }
                else
                {
                    break;
                }
            }
            largo = pos - inicio;
            tipo = 1;
            if (largo == 2)
            {
                if (fuente[inicio] == 105)
                {
                    if (fuente[inicio + 1] == 102)
                    {
                        tipo = 10;
                    }
                }
            }
            if (largo == 3)
            {
                if (fuente[inicio] == 105)
                {
                    if (fuente[inicio + 1] == 110)
                    {
                        if (fuente[inicio + 2] == 116)
                        {
                            tipo = 4;
                        }
                    }
                }
                if (fuente[inicio] == 102)
                {
                    if (fuente[inicio + 1] == 111)
                    {
                        if (fuente[inicio + 2] == 114)
                        {
                            tipo = 41;
                        }
                    }
                }
            }
            if (largo == 4)
            {
                if (fuente[inicio] == 101)
                {
                    if (fuente[inicio + 1] == 110)
                    {
                        if (fuente[inicio + 2] == 117)
                        {
                            if (fuente[inicio + 3] == 109)
                            {
                                tipo = 7;
                            }
                        }
                    }
                    if (fuente[inicio + 1] == 108)
                    {
                        if (fuente[inicio + 2] == 115)
                        {
                            if (fuente[inicio + 3] == 101)
                            {
                                tipo = 11;
                            }
                        }
                    }
                }
                if (fuente[inicio] == 118)
                {
                    if (fuente[inicio + 1] == 111)
                    {
                        if (fuente[inicio + 2] == 105)
                        {
                            if (fuente[inicio + 3] == 100)
                            {
                                tipo = 39;
                            }
                        }
                    }
                }
            }
            if (largo == 5)
            {
                if (fuente[inicio] == 112)
                {
                    if (fuente[inicio + 1] == 114)
                    {
                        if (fuente[inicio + 2] == 105)
                        {
                            if (fuente[inicio + 3] == 110)
                            {
                                if (fuente[inicio + 4] == 116)
                                {
                                    tipo = 9;
                                }
                            }
                        }
                    }
                }
                if (fuente[inicio] == 119)
                {
                    if (fuente[inicio + 1] == 104)
                    {
                        if (fuente[inicio + 2] == 105)
                        {
                            if (fuente[inicio + 3] == 108)
                            {
                                if (fuente[inicio + 4] == 101)
                                {
                                    tipo = 12;
                                }
                            }
                        }
                    }
                }
                if (fuente[inicio] == 98)
                {
                    if (fuente[inicio + 1] == 114)
                    {
                        if (fuente[inicio + 2] == 101)
                        {
                            if (fuente[inicio + 3] == 97)
                            {
                                if (fuente[inicio + 4] == 107)
                                {
                                    tipo = 40;
                                }
                            }
                        }
                    }
                }
            }
            if (largo == 6)
            {
                if (fuente[inicio] == 115)
                {
                    if (fuente[inicio + 1] == 116)
                    {
                        if (fuente[inicio + 2] == 114)
                        {
                            if (fuente[inicio + 3] == 105)
                            {
                                if (fuente[inicio + 4] == 110)
                                {
                                    if (fuente[inicio + 5] == 103)
                                    {
                                        tipo = 5;
                                    }
                                }
                            }
                        }
                        if (fuente[inicio + 2] == 114)
                        {
                            if (fuente[inicio + 3] == 117)
                            {
                                if (fuente[inicio + 4] == 99)
                                {
                                    if (fuente[inicio + 5] == 116)
                                    {
                                        tipo = 6;
                                    }
                                }
                            }
                        }
                    }
                }
                if (fuente[inicio] == 114)
                {
                    if (fuente[inicio + 1] == 101)
                    {
                        if (fuente[inicio + 2] == 116)
                        {
                            if (fuente[inicio + 3] == 117)
                            {
                                if (fuente[inicio + 4] == 114)
                                {
                                    if (fuente[inicio + 5] == 110)
                                    {
                                        tipo = 8;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            hay_token = 1;
        }
        else if (c >= 48 && c <= 57)
        {
            // El prefijo 0x (Ampliacion 4): el literal
            // hexadecimal nace como un Number mas, con
            // su valor calculado en el lexing. La guarda
            // de fin de fuente va en un if aparte, como
            // en el resto de la pieza, y la base viaja
            // en d: 10 decimal, 16 hexadecimal.
            d = 10;
            if (c == 48)
            {
                if (pos + 1 < total)
                {
                    if (fuente[pos + 1] == 120 || fuente[pos + 1] == 88)
                    {
                        d = 16;
                        pos = pos + 2;
                    }
                }
            }
            while (pos < total)
            {
                c = fuente[pos];
                if (c >= 48 && c <= 57)
                {
                    valor = valor * d + (c - 48);
                    pos = pos + 1;
                }
                else if (d == 16 && c >= 97 && c <= 102)
                {
                    valor = valor * 16 + (c - 87);
                    pos = pos + 1;
                }
                else if (d == 16 && c >= 65 && c <= 70)
                {
                    valor = valor * 16 + (c - 55);
                    pos = pos + 1;
                }
                else
                {
                    break;
                }
            }
            largo = pos - inicio;
            tipo = 2;
            hay_token = 1;
            if (d == 16)
            {
                if (largo == 2)
                {
                    // Un 0x sin un solo digito detras:
                    // error, como en Stage 0, y el
                    // token no nace.
                    errores = errores + 1;
                    hay_token = 0;
                }
            }
        }
        else if (c == 34)
        {
            pos = pos + 1;
            inicio = pos;
            while (pos < total)
            {
                c = fuente[pos];
                if (c == 34)
                {
                    break;
                }
                pos = pos + 1;
            }
            largo = pos - inicio;
            if (pos < total)
            {
                pos = pos + 1;
            }
            tipo = 3;
            hay_token = 1;
        }
        else
        {
            d = 0;
            if (pos + 1 < total)
            {
                d = fuente[pos + 1];
            }
            if (c == 43)
            {
                tipo = 14;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 45)
            {
                tipo = 15;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 42)
            {
                tipo = 16;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 37)
            {
                tipo = 18;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 94)
            {
                tipo = 19;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 40)
            {
                tipo = 29;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 41)
            {
                tipo = 30;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 91)
            {
                tipo = 31;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 93)
            {
                tipo = 32;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 123)
            {
                tipo = 33;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 125)
            {
                tipo = 34;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 44)
            {
                tipo = 35;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 59)
            {
                tipo = 36;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 46)
            {
                tipo = 38;
                hay_token = 1;
                pos = pos + 1;
            }
            else if (c == 61)
            {
                if (d == 61)
                {
                    tipo = 20;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 13;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 33)
            {
                if (d == 61)
                {
                    tipo = 21;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 28;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 60)
            {
                if (d == 60)
                {
                    tipo = 44;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else if (d == 61)
                {
                    tipo = 23;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 22;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 62)
            {
                if (d == 62)
                {
                    tipo = 45;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else if (d == 61)
                {
                    tipo = 25;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 24;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 38)
            {
                if (d == 38)
                {
                    tipo = 26;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 42;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 124)
            {
                if (d == 124)
                {
                    tipo = 27;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    tipo = 43;
                    hay_token = 1;
                    pos = pos + 1;
                }
            }
            else if (c == 58)
            {
                if (d == 58)
                {
                    tipo = 37;
                    largo = 2;
                    hay_token = 1;
                    pos = pos + 2;
                }
                else
                {
                    errores = errores + 1;
                    pos = pos + 1;
                }
            }
            else
            {
                errores = errores + 1;
                pos = pos + 1;
            }
        }

        if (hay_token == 1)
        {
            if (tok_count < 256)
            {
                tok_tipo[tok_count] = tipo;
                tok_inicio[tok_count] = inicio;
                tok_largo[tok_count] = largo;
                tok_valor[tok_count] = valor;
                tok_count = tok_count + 1;
            }
            else
            {
                errores = errores + 1;
            }
        }
    }
    pos = 0;
}

int main()
{
    int fuente[1024];
    int tok_tipo[256];
    int tok_inicio[256];
    int tok_largo[256];
    int tok_valor[256];
    int i = 0;

    total = file_read("FUENTE.KPP", fuente);

    if (total < 0)
    {
        print_int(total);
        return 1;
    }

    print("TOKENS");

    escanea();

    for (i = 0; i < tok_count; i = i + 1)
    {
        print_int(tok_tipo[i]);
        print_int(tok_inicio[i]);
        print_int(tok_largo[i]);
        print_int(tok_valor[i]);
    }
    print_int(tok_count);
    print_int(errores);

    return 0;
}
