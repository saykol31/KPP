// ============================================================
// REGISTRO DE PARCHES INTERNOS.
//
// Cada salto o llamada entre regiones se anota al
// emitirse con su posicion, su clase de destino y
// su rebanada duena. destino_de traduce la clase a
// la direccion que emite_grafico fijo para esa
// region (una clase invalida acusa en errores_rt y
// devuelve el centinela -1). rellena_registro cierra
// de una pasada todos los parches de una duena con
// el rel32 del oraculo: destino - (posicion + 4).
// En R-1 se cierra la duena 1, en R-2 la duena
// 2, en R-3 la duena 3 y en R-4 la duena 4; las
// demas pasadas nacen con sus rebanadas.
// ============================================================

void registra_parche(int pos, int clase, int dueno)
{
    int r;
    r = da_add(dreg_pos, pos);
    if (r < 0)
    {
        errores_rt = errores_rt + 1;
        return;
    }
    r = da_add(dreg_clase, clase);
    r = da_add(dreg_dueno, dueno);
    nreg = nreg + 1;
}

int destino_de(int clase)
{
    if (clase == 0)
    {
        return dir_ventana;
    }
    if (clase == 1)
    {
        return dir_bucle;
    }
    if (clase == 2)
    {
        return dir_redraw;
    }
    if (clase == 3)
    {
        return dir_tecla;
    }
    if (clase == 4)
    {
        return dir_boton;
    }
    if (clase == 5)
    {
        return dir_raton;
    }
    if (clase == 6)
    {
        return dir_refresco;
    }
    if (clase == 7)
    {
        return dir_lineas;
    }
    if (clase == 8)
    {
        return dir_barra;
    }
    if (clase == 9)
    {
        return dir_edit;
    }
    if (clase == 10)
    {
        return dir_file;
    }
    if (clase == 11)
    {
        return dir_copiar;
    }
    if (clase == 12)
    {
        return dir_pegar;
    }
    if (clase == 13)
    {
        return dir_vaciar;
    }
    if (clase == 14)
    {
        return dir_iedit;
    }
    if (clase == 15)
    {
        return dir_icortar;
    }
    if (clase == 16)
    {
        return dir_icopiar;
    }
    if (clase == 17)
    {
        return dir_isel;
    }
    if (clase == 18)
    {
        return dir_ipegar;
    }
    if (clase == 19)
    {
        return dir_ieliminar;
    }
    if (clase == 20)
    {
        return dir_ifile;
    }
    if (clase == 21)
    {
        return dir_iopen;
    }
    if (clase == 22)
    {
        return dir_isave;
    }
    if (clase == 23)
    {
        return dir_iclose;
    }
    errores_rt = errores_rt + 1;
    return -1;
}

void rellena_registro(int dueno)
{
    int i;
    int pos;
    int destino;
    i = 0;
    while (i < nreg)
    {
        if (da_get(dreg_dueno, i) == dueno)
        {
            pos = da_get(dreg_pos, i);
            destino = destino_de(da_get(dreg_clase, i));
            if (destino >= 0)
            {
                parche32(pos, destino - (pos + 4));
            }
        }
        i = i + 1;
    }
}

// ============================================================
// EMISION DEL PREFIJO GRAFICO.
//
// La transcripcion de emitGraphicsRuntime del
// oraculo en su orden de emision, con las regiones
// aun no portadas como huecos de su tamano final.
// Las direcciones dir_ se fijan al pasar y el Result
// queda en los res_. Las pasadas internas cierran
// los parches de las duenas 1 y 2 (la cabecera y la
// ventana entre si, incluido el CALL de START a
// DRAW_WINDOW del Result, y las dos llamadas a
// DIBUJA_LINEAS); el JMP al cuerpo principal no se
// registra: es la costura con el backend y su hueco
// queda a cero.
// ============================================================

void emite_salida()
{
    em_mov_eax_imm(-1);
    em_int(64);
}

void emite_refresco()
{
    int p;
    // begin redraw (funcion 12.1).
    em_mov_eax_imm(12);
    em_mov_reg_imm(187, 1);
    em_int(64);
    // La limpieza del area de texto (funcion 13):
    // X = 30 con ancho 440 (hasta 470; la barra
    // vive en 478 y no se toca), Y = 38 con alto
    // 414, y el color negro de la funcion 0.
    em_mov_eax_imm(13);
    em_mov_reg_imm(187, 1966520);
    em_mov_reg_imm(185, 2490782);
    em_mov_reg_imm(186, 0);
    em_int(64);
    // call DIBUJA_LINEAS: se registra con duena 2 y
    // la cierra la pasada de esta rebanada, como el
    // oraculo devuelve ese parche de
    // emitRefreshOutput a la pasada interna de
    // emitGraphicsRuntime.
    p = em_call_hueco();
    registra_parche(p, 7, 2);
    // call DIBUJA_EDIT y call DIBUJA_FILE: se
    // registran con duenas 4 y 5; en el oraculo van
    // a las listas editCall y fileCall, que la
    // misma pasada rellena contra las rutinas de
    // los menus.
    p = em_call_hueco();
    registra_parche(p, 9, 4);
    p = em_call_hueco();
    registra_parche(p, 10, 5);
    // end redraw (funcion 12.2).
    em_mov_eax_imm(12);
    em_mov_reg_imm(187, 2);
    em_int(64);
    em_ret();
}

void emite_lineas()
{
    int p_sin_lineas;
    int p_cabe;
    int p_sin_sel;
    int p_tinte;
    int bucle;
    int p_fin_bucle;
    int p_otra;
    int p;
    // Preserva EBX, ESI y EDI.
    em_byte(83);
    em_byte(86);
    em_byte(87);
    // filas = lineCount - firstVisible.
    em_mov_eax_mem(1);
    em_sub_eax_mem(3);
    // jle fin (no hay lineas visibles).
    p_sin_lineas = em_jle_hueco();
    // filas = min(filas, 41).
    em_cmp_eax_imm(41);
    p_cabe = em_jbe_hueco();
    em_mov_eax_imm(41);
    parche32(p_cabe, bytebuffer_get_size(dcod) - (p_cabe + 4));
    // mov edi, eax (EDI = filas por dibujar).
    em_byte(137);
    em_byte(199);
    // El tinte de la seleccion: con la seleccion
    // activa, el area de las filas visibles se tine
    // (funcion 13, X = 30, ancho 440, Y = 40, alto
    // = filas * 10) antes de dibujar los textos.
    // EAX aun guarda las filas.
    em_mov_eax_mem(10);
    em_cmp_eax_imm(0);
    // je sinSeleccion.
    p_sin_sel = em_je_hueco();
    // mov edx, eax (EDX = filas, la copia del *10).
    em_byte(137);
    em_byte(194);
    // shl eax, 3.
    em_byte(193);
    em_byte(224);
    em_byte(3);
    // add eax, edx (dos veces: *8 + *1 + *1 = *10).
    em_byte(1);
    em_byte(208);
    em_byte(1);
    em_byte(208);
    // mov ecx, eax; add ecx, 40 << 16.
    em_byte(137);
    em_byte(193);
    em_byte(129);
    em_byte(193);
    p_tinte = em_hueco();
    parche32(p_tinte, 2621440);
    em_mov_eax_imm(13);
    em_mov_reg_imm(187, 1966520);
    em_mov_reg_imm(186, 1589344);
    em_int(64);
    parche32(p_sin_sel, bytebuffer_get_size(dcod) - (p_sin_sel + 4));
    // ranura inicial = (lineHead - lineCount +
    // firstVisible) & 511.
    em_mov_eax_mem(2);
    em_sub_eax_mem(1);
    em_add_eax_mem(3);
    em_and_eax_imm(511);
    // mov esi, eax (ESI = ranura actual).
    em_byte(137);
    em_byte(198);
    // El estado del bucle pasa a la pila:
    // [ESP] = filas restantes, [ESP + 4] = ranura.
    // push esi (la ranura) / push edi (las filas).
    em_byte(86);
    em_byte(87);
    // cursor de repintado = (35, 40).
    em_mov_eax_imm(2293800);
    em_mov_mem_eax(4);
    bucle = bytebuffer_get_size(dcod);
    // ¿filas restantes == 0? -> fin del bucle.
    // mov eax, [esp].
    em_byte(139);
    em_byte(68);
    em_byte(36);
    em_byte(0);
    em_cmp_eax_imm(0);
    p_fin_bucle = em_je_hueco();
    // EAX = ranura * 64 + base del buffer:
    // mov eax, [esp + 4]; shl eax, 6; add eax,
    // imm32 (la base, anotada en lineBuffer).
    em_byte(139);
    em_byte(68);
    em_byte(36);
    em_byte(4);
    em_byte(193);
    em_byte(224);
    em_byte(6);
    em_byte(5);
    p = em_hueco();
    anota_lista(0, p);
    // mov edx, eax (EDX = la ranura en bytes).
    em_byte(137);
    em_byte(194);
    // mov esi, [eax] (ESI = longitud de dibujo).
    em_byte(139);
    em_byte(48);
    // add edx, 4 (EDX = el texto).
    em_byte(131);
    em_byte(194);
    em_byte(4);
    // EBX = cursor de repintado; ECX = el color.
    em_mov_ebx_mem(4);
    em_mov_reg_imm(185, -2130706433);
    // Dibujar la linea (funcion 4).
    em_mov_eax_imm(4);
    em_int(64);
    // El cursor de repintado solo baja: Y += 10.
    em_mov_eax_mem(4);
    em_add_eax_imm(10);
    em_mov_mem_eax(4);
    // ranura = (ranura + 1) & 511 (circular):
    // mov eax, [esp + 4].
    em_byte(139);
    em_byte(68);
    em_byte(36);
    em_byte(4);
    em_add_eax_imm(1);
    em_and_eax_imm(511);
    // mov [esp + 4], eax.
    em_byte(137);
    em_byte(68);
    em_byte(36);
    em_byte(4);
    // filas--: mov eax, [esp]; dec eax;
    // mov [esp], eax.
    em_byte(139);
    em_byte(68);
    em_byte(36);
    em_byte(0);
    em_byte(72);
    em_byte(137);
    em_byte(68);
    em_byte(36);
    em_byte(0);
    p_otra = em_jmp_hueco();
    parche32(p_otra, bucle - (p_otra + 4));
    parche32(p_fin_bucle, bytebuffer_get_size(dcod) - (p_fin_bucle + 4));
    // add esp, 8 (soltar el estado del bucle).
    em_byte(131);
    em_byte(196);
    em_byte(8);
    parche32(p_sin_lineas, bytebuffer_get_size(dcod) - (p_sin_lineas + 4));
    // La barra de desplazamiento cierra el dibujo:
    // call BARRA, registrada con duena R-3.
    p = em_call_hueco();
    registra_parche(p, 8, 3);
    // pop edi / pop esi / pop ebx.
    em_byte(95);
    em_byte(94);
    em_byte(91);
    em_ret();
}

void emite_edit()
{
    // emitDibujaEdit del oraculo: el boton EDIT
    // (funcion 8, id 2) y su rotulo (funcion 4,
    // menuTexto + 0, longitud 4); si el menu
    // esta abierto (menuAbierto = 1), el panel
    // (funcion 13) y los cinco renglones como
    // botones 3 a 7 con sus rotulos: los
    // desplazamientos y longitudes de
    // menuTexto son constantes que el oraculo
    // parchea en el sitio.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 5570625);
    em_mov_reg_imm(185, 1310737);
    em_mov_reg_imm(186, 2);
    em_mov_reg_imm(190, 3166320);
    em_int(64);
    em_mov_eax_imm(4);
    em_mov_reg_imm(187, 6881304);
    em_mov_reg_imm(185, -2130706433);
    em_mov_edx_dir(13);
    em_byte(190);
    em_dword(4);
    em_int(64);
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int cerrado = em_jne_hueco();
    em_mov_eax_imm(13);
    em_mov_reg_imm(187, 5570698);
    em_mov_reg_imm(185, 2424906);
    em_mov_reg_imm(186, 1579032);
    em_int(64);
    // Renglon 1: y 37, boton 3, texto +5, largo 6.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 5570698);
    em_mov_reg_imm(185, 2424846);
    em_mov_reg_imm(186, 3);
    em_mov_reg_imm(190, 2631720);
    em_int(64);
    em_mov_eax_imm(4);
    em_mov_reg_imm(187, 5963816);
    em_mov_reg_imm(185, -2130706433);
    em_mov_edx_dir(13);
    em_byte(131);
    em_byte(194);
    em_byte(5);
    em_byte(190);
    em_dword(6);
    em_int(64);
    // Renglon 2: y 51, boton 4, texto +12, largo 6.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 5570698);
    em_mov_reg_imm(185, 3342350);
    em_mov_reg_imm(186, 4);
    em_mov_reg_imm(190, 2631720);
    em_int(64);
    em_mov_eax_imm(4);
    em_mov_reg_imm(187, 5963830);
    em_mov_reg_imm(185, -2130706433);
    em_mov_edx_dir(13);
    em_byte(131);
    em_byte(194);
    em_byte(12);
    em_byte(190);
    em_dword(6);
    em_int(64);
    // Renglon 3: y 65, boton 5, texto +19, largo 16.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 5570698);
    em_mov_reg_imm(185, 4259854);
    em_mov_reg_imm(186, 5);
    em_mov_reg_imm(190, 2631720);
    em_int(64);
    em_mov_eax_imm(4);
    em_mov_reg_imm(187, 5963844);
    em_mov_reg_imm(185, -2130706433);
    em_mov_edx_dir(13);
    em_byte(131);
    em_byte(194);
    em_byte(19);
    em_byte(190);
    em_dword(16);
    em_int(64);
    // Renglon 4: y 79, boton 6, texto +36, largo 5.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 5570698);
    em_mov_reg_imm(185, 5177358);
    em_mov_reg_imm(186, 6);
    em_mov_reg_imm(190, 2631720);
    em_int(64);
    em_mov_eax_imm(4);
    em_mov_reg_imm(187, 5963858);
    em_mov_reg_imm(185, -2130706433);
    em_mov_edx_dir(13);
    em_byte(131);
    em_byte(194);
    em_byte(36);
    em_byte(190);
    em_dword(5);
    em_int(64);
    // Renglon 5: y 93, boton 7, texto +42, largo 8.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 5570698);
    em_mov_reg_imm(185, 6094862);
    em_mov_reg_imm(186, 7);
    em_mov_reg_imm(190, 2631720);
    em_int(64);
    em_mov_eax_imm(4);
    em_mov_reg_imm(187, 5963872);
    em_mov_reg_imm(185, -2130706433);
    em_mov_edx_dir(13);
    em_byte(131);
    em_byte(194);
    em_byte(42);
    em_byte(190);
    em_dword(8);
    em_int(64);
    parche32(cerrado,
             bytebuffer_get_size(dcod) - (cerrado + 4));
    em_ret();
}

void emite_barra()
{
    int p_lleno;
    int p_dibuja;
    // El carril (funcion 13): X = 478, ancho 12,
    // Y = 40, alto 410, color 0x303030.
    em_mov_eax_imm(13);
    em_mov_reg_imm(187, 31326220);
    em_mov_reg_imm(185, 2621850);
    em_mov_reg_imm(186, 3158064);
    em_int(64);
    // Si lineCount <= 41, el pulgar llena el
    // carril (jbe lleno).
    em_mov_eax_mem(1);
    em_cmp_eax_imm(41);
    p_lleno = em_jbe_hueco();
    // alto = 410 * 41 / lineCount.
    em_mov_eax_imm(16810);
    em_byte(49);
    em_byte(210);
    em_div_mem(1);
    em_mov_mem_eax(6);
    // posicion = 40 + (410 - alto) * firstVisible
    // / (lineCount - 41).
    em_mov_eax_imm(410);
    em_sub_eax_mem(6);
    em_mul_mem(3);
    em_mov_ecx_mem(1);
    em_byte(131);
    em_byte(233);
    em_byte(41);
    em_byte(247);
    em_byte(241);
    em_add_eax_imm(40);
    em_mov_mem_eax(5);
    // jmp dibuja.
    p_dibuja = em_jmp_hueco();
    // lleno: alto = 410, posicion = 40.
    parche32(p_lleno,
        bytebuffer_get_size(dcod) - (p_lleno + 4));
    em_mov_eax_imm(410);
    em_mov_mem_eax(6);
    em_mov_eax_imm(40);
    em_mov_mem_eax(5);
    // dibuja: el pulgar, con la geometria
    // guardada en thumbTop y thumbHeight.
    parche32(p_dibuja,
        bytebuffer_get_size(dcod) - (p_dibuja + 4));
    em_mov_eax_imm(13);
    em_mov_reg_imm(187, 31326220);
    em_mov_ecx_mem(5);
    em_byte(193);
    em_byte(225);
    em_byte(16);
    em_add_ecx_mem(6);
    em_mov_reg_imm(186, 9474192);
    em_int(64);
    em_ret();
}

void emite_raton()
{
    int p_pulsado;
    int p_arrastra;
    int p_arriba;
    int p_abajo;
    int p_techo;
    int p_top;
    int p_rango;
    int f_soltado;
    int f_banda1;
    int f_banda2;
    int f_agarre;
    int f_rango1;
    int f_rango2;
    int f_cambio;
    int a_1;
    int a_2;
    int a_3;
    int a_4;
    int a_5;
    int p;
    int destino;
    // BOTONES (funcion 37.2): test eax, 1 (boton
    // izquierdo); si no esta pulsado, el arrastre
    // se cancela y se vuelve al bucle.
    em_mov_eax_imm(37);
    em_mov_reg_imm(187, 2);
    em_int(64);
    em_byte(169);
    em_dword(1);
    p_pulsado = em_jne_hueco();
    em_mov_eax_imm(0);
    em_mov_mem_eax(7);
    f_soltado = em_jmp_hueco();
    parche32(p_pulsado,
        bytebuffer_get_size(dcod) - (p_pulsado + 4));
    // COORDENADAS (funcion 37.1): EDX = y,
    // ECX = x.
    em_mov_eax_imm(37);
    em_mov_reg_imm(187, 1);
    em_int(64);
    em_byte(137);
    em_byte(194);
    em_byte(137);
    em_byte(209);
    em_byte(193);
    em_byte(233);
    em_byte(16);
    em_byte(129);
    em_byte(226);
    em_dword(65535);
    // Arrastrando? El agarre manda sobre la banda.
    em_mov_eax_mem(7);
    em_cmp_eax_imm(0);
    p_arrastra = em_jne_hueco();
    // La banda X de la barra: 478..490.
    em_byte(129);
    em_byte(249);
    em_dword(478);
    f_banda1 = em_jb_hueco();
    em_byte(129);
    em_byte(249);
    em_dword(490);
    f_banda2 = em_ja_hueco();
    // Encima del pulgar: pagina arriba. Debajo:
    // pagina abajo. Sobre el pulgar: agarre
    // (dragGrab = y - thumbTop, dragState = 1).
    em_mov_eax_mem(5);
    em_byte(59);
    em_byte(208);
    p_arriba = em_jb_hueco();
    em_mov_eax_mem(5);
    em_add_eax_mem(6);
    em_byte(59);
    em_byte(208);
    p_abajo = em_jae_hueco();
    em_byte(137);
    em_byte(208);
    em_sub_eax_mem(5);
    em_mov_mem_eax(8);
    em_mov_eax_imm(1);
    em_mov_mem_eax(7);
    f_agarre = em_jmp_hueco();
    // PAGINA ARRIBA: firstVisible - 41, suelo 0.
    parche32(p_arriba,
        bytebuffer_get_size(dcod) - (p_arriba + 4));
    em_mov_eax_mem(3);
    em_byte(131);
    em_byte(232);
    em_byte(41);
    a_1 = em_jge_hueco();
    em_mov_eax_imm(0);
    a_2 = em_jmp_hueco();
    // PAGINA ABAJO: firstVisible + 41, techo en
    // lineCount - 41 (suelo 0 si no hay pagina).
    parche32(p_abajo,
        bytebuffer_get_size(dcod) - (p_abajo + 4));
    em_mov_eax_mem(3);
    em_add_eax_imm(41);
    em_mov_ecx_mem(1);
    em_byte(131);
    em_byte(233);
    em_byte(41);
    p_techo = em_jns_hueco();
    em_mov_reg_imm(185, 0);
    parche32(p_techo,
        bytebuffer_get_size(dcod) - (p_techo + 4));
    em_byte(59);
    em_byte(193);
    a_3 = em_jbe_hueco();
    em_byte(137);
    em_byte(200);
    a_4 = em_jmp_hueco();
    // ARRASTRE: nuevoTop = y - dragGrab, sujeto a
    // [40, 40 + 410 - thumbHeight]; firstVisible =
    // (nuevoTop - 40) * (lineCount - 41) /
    // (410 - thumbHeight).
    parche32(p_arrastra,
        bytebuffer_get_size(dcod) - (p_arrastra + 4));
    em_mov_reg_imm(187, 410);
    em_sub_ebx_mem(6);
    em_mov_ecx_mem(1);
    em_byte(131);
    em_byte(233);
    em_byte(41);
    em_byte(131);
    em_byte(251);
    em_byte(0);
    f_rango1 = em_jle_hueco();
    em_byte(131);
    em_byte(249);
    em_byte(0);
    f_rango2 = em_jle_hueco();
    em_byte(137);
    em_byte(208);
    em_sub_eax_mem(8);
    em_cmp_eax_imm(40);
    p_top = em_jae_hueco();
    em_mov_eax_imm(40);
    parche32(p_top,
        bytebuffer_get_size(dcod) - (p_top + 4));
    em_byte(137);
    em_byte(218);
    em_byte(131);
    em_byte(194);
    em_byte(40);
    em_byte(59);
    em_byte(194);
    p_rango = em_jbe_hueco();
    em_byte(137);
    em_byte(208);
    parche32(p_rango,
        bytebuffer_get_size(dcod) - (p_rango + 4));
    em_byte(131);
    em_byte(232);
    em_byte(40);
    em_byte(247);
    em_byte(225);
    em_byte(247);
    em_byte(243);
    em_byte(59);
    em_byte(193);
    a_5 = em_jbe_hueco();
    em_byte(137);
    em_byte(200);
    // APLICAR: solo si el valor cambia se guarda
    // y se llama al REFRESCO (registrada con
    // duena 3, como la parchea el oraculo).
    destino = bytebuffer_get_size(dcod);
    parche32(a_1, destino - (a_1 + 4));
    parche32(a_2, destino - (a_2 + 4));
    parche32(a_3, destino - (a_3 + 4));
    parche32(a_4, destino - (a_4 + 4));
    parche32(a_5, destino - (a_5 + 4));
    em_cmp_eax_mem(3);
    f_cambio = em_je_hueco();
    em_mov_mem_eax(3);
    p = em_call_hueco();
    registra_parche(p, 6, 3);
    // SALIDA: los saltos a fuera se cierran aqui
    // y el salto al bucle se registra con duena 3.
    destino = bytebuffer_get_size(dcod);
    parche32(f_soltado, destino - (f_soltado + 4));
    parche32(f_banda1, destino - (f_banda1 + 4));
    parche32(f_banda2, destino - (f_banda2 + 4));
    parche32(f_agarre, destino - (f_agarre + 4));
    parche32(f_rango1, destino - (f_rango1 + 4));
    parche32(f_rango2, destino - (f_rango2 + 4));
    parche32(f_cambio, destino - (f_cambio + 4));
    p = em_jmp_hueco();
    registra_parche(p, 1, 3);
}

void emite_isla_edit()
{
    // La isla del boton EDIT: si su menu esta
    // abierto lo cierra; si no, lo abre. En
    // ambos casos redibuja y vuelve al bucle
    // (las llamadas y el salto se registran
    // con duena 4).
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int cerrar = em_je_hueco();
    em_mov_eax_imm(1);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    registra_parche(em_jmp_hueco(), 1, 4);
    parche32(cerrar,
             bytebuffer_get_size(dcod) - (cerrar + 4));
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    registra_parche(em_jmp_hueco(), 1, 4);
}

void emite_isla_cortar()
{
    // CORTAR: con el menu EDIT abierto y la
    // seleccion activa, copia y vacia, cierra
    // el menu y redibuja; si la guarda falla,
    // vuelve al bucle sin actuar.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int g1 = em_jne_hueco();
    em_mov_eax_mem(10);
    em_cmp_eax_imm(0);
    int g2 = em_je_hueco();
    registra_parche(em_call_hueco(), 11, 4);
    registra_parche(em_call_hueco(), 13, 4);
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    parche32(g2, salir - (g2 + 4));
    registra_parche(em_jmp_hueco(), 1, 4);
}

void emite_isla_copiar()
{
    // COPIAR: la misma guarda; copia, cierra
    // el menu y redibuja.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int g1 = em_jne_hueco();
    em_mov_eax_mem(10);
    em_cmp_eax_imm(0);
    int g2 = em_je_hueco();
    registra_parche(em_call_hueco(), 11, 4);
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    parche32(g2, salir - (g2 + 4));
    registra_parche(em_jmp_hueco(), 1, 4);
}

void emite_isla_sel()
{
    // SELECCIONAR TODO: con el menu abierto,
