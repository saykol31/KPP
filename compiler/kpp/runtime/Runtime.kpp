int filas_visibles(int lc, int fv)
{
    int f;
    f = lc - fv;
    if (f <= 0)
    {
        return 0;
    }
    if (f > 41)
    {
        f = 41;
    }
    return f;
}

int ranura_inicial(int lh, int lc, int fv)
{
    return (lh - lc + fv) & 511;
}

void sonda_escenario(int lc, int fv, int lh, int sel)
{
    int filas;
    int alto;
    int inicial;
    int k;
    filas = filas_visibles(lc, fv);
    alto = 0;
    if (sel != 0)
    {
        alto = filas * 10;
    }
    inicial = ranura_inicial(lh, lc, fv);
    print_int(lc);
    print_int(fv);
    print_int(lh);
    print_int(sel);
    print_int(filas);
    print_int(alto);
    k = 0;
    while (k < filas)
    {
        print_int((inicial + k) & 511);
        print_int(40 + 10 * k);
        k = k + 1;
    }
}

void sonda_visibles()
{
    print_int(5);
    sonda_escenario(0, 0, 0, 0);
    sonda_escenario(5, 0, 5, 0);
    sonda_escenario(41, 0, 41, 1);
    sonda_escenario(100, 59, 100, 0);
    sonda_escenario(512, 480, 10, 0);
}

int segmento_sonda()
{
    int datos[4];
    int n;
    n = file_read("SONDA.TXT", datos);
    if (n < 1)
    {
        return 1;
    }
    if (datos[0] == 50)
    {
        return 2;
    }
    if (datos[0] == 51)
    {
        return 3;
    }
    if (datos[0] == 52)
    {
        return 4;
    }
    if (datos[0] == 53)
    {
        return 5;
    }
    if (datos[0] == 54)
    {
        return 6;
    }
    if (datos[0] == 55)
    {
        return 7;
    }
    if (datos[0] == 56)
    {
        return 8;
    }
    if (datos[0] == 57)
    {
        return 9;
    }
    if (datos[0] == 48)
    {
        return 10;
    }
    return 1;
}

int main()
{
    int rs;
    int rf;
    int rc;
    int rb;
    int seg;
    inicia_arena();
    rs = arena_create(256);
    region_source = rs;
    rf = arena_create(256);
    region_frontend = rf;
    rc = arena_create(256);
    region_compiler = rc;
    arena_destroy(rf);
    rb = arena_create(32768);
    region_backend = rb;
    reinicia_rt();
    emite_grafico();
    seg = segmento_sonda();
    if (seg == 2)
    {
        sonda_parches();
        sonda_huecos();
        sonda_refresco();
    }
    if (seg == 3)
    {
        sonda_lineas();
        sonda_visibles();
    }
    if (seg == 4)
    {
        sonda_barra();
    }
    if (seg == 5)
    {
        sonda_raton();
    }
    if (seg == 6)
    {
        sonda_edit();
    }
    if (seg == 7)
    {
        sonda_copiar();
        sonda_pegar();
        sonda_vaciar();
    }
    if (seg == 8)
    {
        sonda_isla_edit();
        sonda_isla_cortar();
        sonda_isla_copiar();
        sonda_isla_sel();
        sonda_isla_pegar();
        sonda_isla_eliminar();
    }
    if (seg == 9)
    {
        sonda_file();
        sonda_isla_file();
    }
    if (seg == 10)
    {
        sonda_isla_open();
        sonda_isla_save();
        sonda_isla_close();
    }
    if (seg == 1)
    {
        sonda_hasta_start();
        sonda_bucle_despacho();
        sonda_ventana();
    }
    return 0;
}
