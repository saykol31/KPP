// Runtime.kpp — Stage 1, runtime, rebanada R-5.
// El runtime propio de K++ (KolibriRuntime de Stage 0): rutinas x86 que
// el backend EMITE dentro de cada programa — no es una biblioteca
// externa ni un interprete. La pieza emite el PREFIJO GRAFICO entero
// en su orden final (2587 bytes: mascara de eventos, START, bucle y
// despacho, la salida, DRAW_WINDOW, los cuerpos de las rutinas de la
// Konsole y las islas de los menus), y devuelve el Result y las
// listas de parches que quien ensambla rellena con DATA.
// Fidelidad (fallo de Esequiel del 2026-11-22): byte a byte, como el
// Backend. Los tamanos y las direcciones de esta rebanada estan
// medidos por el puerto emitiendo el oraculo entero, y la
// transcripcion quedo probada byte a byte contra el BIN que Stage 0
// produce para el programa minimo (57.086 bytes: 36 de cabecera,
// 2622 de codigo — 2587 del prefijo y 35 del cuerpo de main — y
// 54.428 de DATA).
// El RESULT copia campo a campo el KolibriRuntimeResult del oraculo,
// seis campos: drawWindowCallPatch (el CALL de START a DRAW_WINDOW,
// lo cierra la pasada interna de la pieza), mainEntryPatch (el JMP
// de START al cuerpo principal: lo rellena quien ensambla, es la
// costura con el backend), eventLoopAddress, titleAddressPatch y
// titleCaptionPatch (las dos referencias al titulo: las rellena
// quien ensambla con su direccion en DATA) y refreshOutputAddress
// (la direccion de la region del refresco: final desde R-1, y con
// ella el backend de B-9 tiene destino para los huecos de Print).
// HUECOS: cada region aun no portada se emite como ceros de su
// tamano final — medido del oraculo, nunca puesto a mano — y su
// rebanada duena la sustituye sin mover un solo offset. R-1 porto
// la mascara, START, el bucle y el despacho, la salida y
// DRAW_WINDOW. R-2 porta el REFRESCO (62 bytes: begin redraw, la
// limpieza del area de texto con la funcion 13, las llamadas a
// DIBUJA_LINEAS, DIBUJA_EDIT y DIBUJA_FILE, y end redraw) y el
// DIBUJO DE LINEAS (239 bytes: las filas visibles — lineCount
// menos firstVisible, con tope de 41 —, el tinte de la seleccion,
// la ranura inicial circular y el bucle que dibuja cada fila
// bajando el cursor de repintado de 10 en 10). R-3 porta el
// RATON (358 bytes: botones y coordenadas con la funcion 37 —
// sin boton izquierdo el arrastre se cancela; con arrastre
// activo manda la posicion del puntero con desplazamiento
// proporcional; sin arrastre, el clic sobre el carril pagina
// arriba o abajo y sobre el pulgar agarra — y solo repinta,
// llamando al REFRESCO, si firstVisible cambia) y la BARRA
// (157 bytes: el carril con la funcion 13, el pulgar que lo
// llena si lineCount <= 41 y, si no, su alto 410*41/lineCount
// y su posicion proporcional a firstVisible, dibujado con la
// geometria guardada). R-4 porta DIBUJA_EDIT (378 bytes: el
// boton EDIT con su rotulo y, si el menu esta abierto, el
// panel con los cinco renglones como botones), COPIAR (189:
// el historial al bloque del portapapeles con CR LF entre
// lineas y la puesta al sistema con la funcion 54.2), PEGAR
// (94: el bloque de la funcion 70 en la pila y la escritura
// del texto en KONSOLE.TXT) y VACIAR (30: los tres contadores
// a cero y la seleccion apagada), y las seis islas de EDIT
// (58, 63, 58, 48, 42, 58: abrir o cerrar el menu y, tras la
// guarda del menu abierto y la seleccion activa, copiar,
// cortar, seleccionar todo, pegar y eliminar). R-5 porta
// DIBUJA_FILE (267: el boton FILE con su rotulo y, si el
// menu esta abierto con estado 2, el panel con los tres
// renglones OPEN, SAVE y CLOSE como botones 9 a 11) y las
// cuatro islas de FILE (58, 42, 42, 42: abrir o cerrar el
// menu y las tres acciones, que en el oraculo solo
// cierran el menu y redibujan). Con R-5 el prefijo
// grafico queda portado entero: no queda ningun hueco.
// El runtime de archivos (emitFileIoRuntime) es R-6.
// PARCHES INTERNOS: cada salto o llamada entre regiones se
// registra al emitirse — posicion, clase de destino y rebanada
// duena (la ultima de las dos orillas) — y lo cierra la pasada de
// su duena: rellena_registro(1) cierra los de la cabecera y la
// ventana entre si, y rellena_registro(2) cierra las dos
// llamadas a DIBUJA_LINEAS (la de DRAW_WINDOW, registrada en
// R-1, y la del propio refresco, que el oraculo devuelve de
// emitRefreshOutput a su pasada). rellena_registro(3) cierra en
// esta rebanada el salto del despacho al RATON (registrado en
// R-1), la llamada del dibujo a la BARRA (registrada en R-2) y
// los dos registros del propio raton: su llamada al REFRESCO —
// el oraculo la parchea contra refreshOutputAddress, no contra
// DRAW_WINDOW, contra lo que dice el comentario de su cuerpo —
// y su salto de salida al bucle. rellena_registro(4) cierra en
// esta rebanada la llamada del refresco a DIBUJA_EDIT
// (registrada en R-2: en el oraculo va a la lista editCall, que
// la pasada interna de emitGraphicsRuntime rellena contra la
// rutina del menu), los seis saltos del despacho a las islas
// de EDIT (registrados en R-1) y los diecinueve registros de
// las propias islas: sus llamadas a la ventana, al bucle, a
// COPIAR, a PEGAR y a VACIAR. rellena_registro(5) cierra
// en esta rebanada la llamada del refresco a DIBUJA_FILE
// (registrada en R-2: la lista fileCall del oraculo), la
// de DRAW_WINDOW a la misma rutina (registrada en R-1),
// los cuatro saltos del despacho a las islas de FILE
// (registrados en R-1) y los trece registros de las
// propias islas: sus llamadas a la ventana y sus saltos
// al bucle. Con la duena 5 no queda ningun parche
// interno abierto. Las catorce listas de direcciones DATA
// del oraculo quedan declaradas como listas de la pieza: el
// dibujo anota en seis de ellas (lineBuffer una vez, lineCount
// dos, lineHead una, firstVisible dos, repaintCursor cuatro y
// seleccion una), la barra en cuatro (lineCount tres,
// thumbHeight tres, thumbTop tres y firstVisible una) y el
// raton en seis (dragState tres, firstVisible cuatro, thumbTop
// tres, dragGrab dos, thumbHeight dos y lineCount dos), el
// menu EDIT en dos (menuTexto seis y menuAbierto una), COPIAR
// en cinco (clipBuffer tres, lineCount tres, lineHead una,
// lineBuffer una y clipLen dos), PEGAR en tres (clipLen dos,
// clipBuffer una y menuTexto una), VACIAR en cuatro (una en
// cada contador y en la seleccion) y las islas en dos
// (menuAbierto trece entre las seis y seleccion tres),
// DIBUJA_FILE en dos (menuTexto cuatro y menuAbierto una)
// y las islas de FILE en una (menuAbierto nueve entre las
// cuatro); las llamadas al refresco nacen en las emisiones de Print del
// backend (la costura de B-9), no en esta pieza.
// CORRECCION de R-4: la constante del
// color de texto de DIBUJA_LINEAS quedo mal
// copiada del hex del oraculo en R-2 (-2130771969
// es 0x80FEFFFF: el byte blanco perdido de las
// salvedades de R-2 y R-3); su decimal correcto es
// -2130706433 (0x80FFFFFF) y aqui se restaura, asi
// que la corriente de R-4 vuelve a ser exacta sin
// salvedad.
// NOTA de R-5: las funciones de sonda de esta
// rebanada leen el buffer con bytebuffer_get, como
// todas las de la pieza; celda_get es el accesor de
// celdas de la arena y sobre dcod barre las celdas
// vecinas (la leccion del cotejo de campo de R-4,
// cuya sonda nueva lo usaba por error).
// ABI interna de las rutinas de archivo:
//   WRITE: EAX = ruta, EBX = arreglo, ECX = cantidad, EDX = capacidad
//   READ:  EAX = ruta, EBX = arreglo, ECX = capacidad
//   Retorno en EAX (0 exito, -1 error; en lectura, >= 0 bytes leidos).
//   Se preservan EBX, ESI, EDI, EBP y ESP. Scratch compartido de
//   65536 bytes; transferencia en bloques de hasta MaxBytes.
//   Protocolo de escritura: subfuncion 2 con cero bytes crea/trunca,
//   y cada bloque de datos va con la subfuncion 3 y su offset.
//   EOF (6) en lectura es exito corto: se devuelve el conteo real.
// Una celda int32 de K++ produce o recibe exactamente un byte.

// Constantes de la E/S de archivos (los constexpr de KolibriRuntime.hpp;
// SubWriteBlock no tiene constante nombrada en Stage 0: sale del texto
// del contrato).
enum KolibriFileIo
{
    Function = 70,
    SubRead = 0,
    SubWrite = 2,
    SubWriteBlock = 3,
    Eof = 6,
    MaxBytes = 65536,
    EncodingRaw = 0
};

// Bloque de parametros de la funcion 70: 25 bytes EMPAQUETADOS.
// pathAddress va en +21, pegado al flag de 1 byte: sin relleno.
// (En Stage 0 lo blindan static_asserts; aqui los offsets se escriben
// a mano en el arreglo de bytes, y esta tabla es la referencia.)
enum FileIoParams
{
    Size = 25,
    OffSubfunction = 0,
    OffOffsetLow = 4,
    OffOffsetHigh = 8,
    OffByteCount = 12,
    OffBufferAddress = 16,
    OffEncodingFlag = 20,
    OffPathAddress = 21
};

// ============================================================
// LA BIBLIOTECA DE LA ARENA.
//
// La biblioteca que sigue es la de Arena.kpp (M-0,
// sellada en campo) sin su sonda ni su main, con los
// ajustes de dimension ya declarados en X86Backend.kpp
// y heredados tal cual: el bloque B se declara a 32768
// celdas, el bucle de cero de inicia_arena se parte en
// dos y el comentario de tamanos de inicia_arena dice
// los de la pieza. El texto se copia mecanicamente de
// X86Backend.kpp (lineas 417 a 1302) al construir esta
// rebanada: ni una firma ni una mecanica cambian.
// ============================================================

// ============================================================
// ESTADO COMPARTIDO.
//
// Los contadores de la biblioteca y los handles de las
// cinco regiones, compartidos por nombre como en las
// demas piezas. El driver guarda en region_source ..
// region_output el handle de cada region al crearla.
// errores_arena es la guarda comun: suma 1 por cada
// operacion que la biblioteca no pudo cumplir, y ninguna
// operacion fallida escribe fuera ni a medias.
// ============================================================

int errores_arena;
int nest;
int prov_nacq;
int region_source;
int region_frontend;
int region_compiler;
int region_backend;
int region_output;

// ============================================================
// INICIA LA BIBLIOTECA.
//
// Pone a cero la contabilidad y los tres bloques, y
// escribe el plan de solape: la region 1 (Source) vive
// en el bloque 0 (A), la 2 (Frontend) en el 1 (B), la 3
// (Compiler) en el 2 (C), la 4 (Backend) en el 1 (B, su
// segunda vida) y la 5 (Output) en el 0 (A, su segunda
// vida). Los tamanos de bloque de esta pieza: A con
// 1024 celdas, B con 32768, C con 512.
// ============================================================

void inicia_arena()
{
    int bloque_a[1024];
    int bloque_b[32768];
    int bloque_c[512];
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int i;
    i = 0;
    while (i < 1024)
    {
        bloque_a[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 32768)
    {
        bloque_b[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 512)
    {
        bloque_c[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 6)
    {
        reg_bloque[i] = 0;
        reg_reserva[i] = 0;
        reg_usado[i] = 0;
        reg_viva[i] = 0;
        plan_bloque[i] = 0;
        i = i + 1;
    }
    plan_bloque[1] = 0;
    plan_bloque[2] = 1;
    plan_bloque[3] = 2;
    plan_bloque[4] = 1;
    plan_bloque[5] = 0;
    tam_bloque[0] = 1024;
    tam_bloque[1] = 32768;
    tam_bloque[2] = 512;
    i = 0;
    while (i < 3)
    {
        bloque_dueno[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 129)
    {
        est_region[i] = 0;
        est_base[i] = 0;
        est_cuenta[i] = 0;
        est_cap[i] = 0;
        est_tipo[i] = 0;
        est_viva[i] = 0;
        i = i + 1;
    }
    errores_arena = 0;
    nest = 0;
    prov_nacq = 0;
    region_source = 0;
    region_frontend = 0;
    region_compiler = 0;
    region_backend = 0;
    region_output = 0;
}

// ============================================================
// MEMORY PROVIDER.
//
// La puerta entre la biblioteca y la memoria fisica.
// En V2 son subrutinas ordinarias: memory_acquire entrega
// el bloque fisico que el plan de solape asigna a la
// siguiente region por nacer (las regiones nacen en
// orden: Source, Frontend, Compiler, Backend, Output) y
// devuelve bloque + 1, o 0 si el bloque no alcanza o
// sigue ocupado por su vida anterior. Nunca un bloque
// invalido, nunca un valor a medias. memory_release
// devuelve el bloque; memory_available da el tamano del
// bloque libre mayor, en celdas.
// ============================================================

int memory_available()
{
    int tam_bloque[3];
    int bloque_dueno[3];
    int m;
    int b;
    m = 0;
    b = 0;
    while (b < 3)
    {
        if (bloque_dueno[b] == 0)
        {
            if (tam_bloque[b] > m)
            {
                m = tam_bloque[b];
            }
        }
        b = b + 1;
    }
    return m;
}

int memory_acquire(int size)
{
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int n;
    int blk;
    n = prov_nacq + 1;
    if (n > 5)
    {
        return 0;
    }
    blk = plan_bloque[n];
    if (size > tam_bloque[blk])
    {
        return 0;
    }
    if (bloque_dueno[blk] != 0)
    {
        return 0;
    }
    bloque_dueno[blk] = n;
    prov_nacq = n;
    return blk + 1;
}

void memory_release(int block)
{
    int bloque_dueno[3];
    bloque_dueno[block - 1] = 0;
}

// ============================================================
// MEMORY MANAGER.
//
// arena_create reserva el bloque inicial de la region y
// devuelve su handle (0 = fallo, acusado en
// errores_arena). El handle de la region es su numero de
// nacimiento: 1 Source, 2 Frontend, 3 Compiler,
// 4 Backend, 5 Output.
// arena_alloc entrega un offset dentro de la region: el
// espacio se entrega por avance (bump) con la alineacion
// pedida en celdas; si no cabe en lo reservado, acusa y
// devuelve -1 sin tocar nada. Ningun offset ya entregado
// cambia jamas de significado.
// arena_reset devuelve la region a vacia sin liberarla:
// es la liberacion por fase, y de paso invalida las
// estructuras que vivian en ella. arena_destroy la
// libera del todo: el bloque vuelve al Provider y la
// region muerta acusa si la llaman (la disciplina del
// mapa contra handles de regiones muertas).
// ============================================================

int region_activa(int arena)
{
    int reg_viva[6];
    int r;
    r = 0;
    if (arena >= 1)
    {
        if (arena <= 5)
        {
            if (reg_viva[arena] == 1)
            {
                r = 1;
            }
        }
    }
    return r;
}

int arena_create(int initial_size)
{
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int b;
    int r;
    if (initial_size < 1)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    b = memory_acquire(initial_size);
    if (b == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    r = prov_nacq;
    reg_bloque[r] = b - 1;
    reg_reserva[r] = initial_size;
    reg_usado[r] = 0;
    reg_viva[r] = 1;
    return r;
}

int arena_alloc(int arena, int size, int alignment)
{
    int reg_reserva[6];
    int reg_usado[6];
    int off;
    int resto;
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (size < 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (alignment < 1)
    {
        alignment = 1;
    }
    off = reg_usado[arena];
    resto = off - (off / alignment) * alignment;
    if (resto != 0)
    {
        off = off + (alignment - resto);
    }
    if (off + size > reg_reserva[arena])
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    reg_usado[arena] = off + size;
    return off;
}

void invalida_estructuras(int arena)
{
    int est_region[129];
    int est_viva[129];
    int e;
    e = 1;
    while (e <= nest)
    {
        if (est_region[e] == arena)
        {
            est_viva[e] = 0;
        }
        e = e + 1;
    }
}

void arena_reset(int arena)
{
    int reg_usado[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
}

void arena_destroy(int arena)
{
    int reg_bloque[6];
    int reg_usado[6];
    int reg_viva[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
    reg_viva[arena] = 0;
    memory_release(reg_bloque[arena] + 1);
}

int arena_get_used(int arena)
{
    int reg_usado[6];
    if (region_activa(arena) == 0)
    {
        return -1;
    }
    return reg_usado[arena];
}

int arena_get_reserved(int arena)
{
    int reg_reserva[6];
    if (region_activa(arena) == 0)
    {
        return -1;
    }
    return reg_reserva[arena];
}

// ============================================================
// ACCESO A CELDAS.
//
// La capa de acceso interna de la via V2: cada bloque es
// un arreglo declarado y estas dos subrutinas son las
// unicas que lo indexan por numero de bloque. Si un dia
// se migra a la via V1, este es el interior que se
// reescribe por peek/poke; la API publica no se entera.
// ============================================================

int celda_get(int bloque, int off)
{
    int bloque_a[1024];
    int bloque_b[32768];
    int bloque_c[512];
    int r;
    r = 0;
    if (bloque == 0)
    {
        r = bloque_a[off];
    }
    else
    {
        if (bloque == 1)
        {
            r = bloque_b[off];
        }
        else
        {
            r = bloque_c[off];
        }
    }
    return r;
}

void celda_set(int bloque, int off, int v)
{
    int bloque_a[1024];
    int bloque_b[32768];
    int bloque_c[512];
    if (bloque == 0)
    {
        bloque_a[off] = v;
    }
    else
    {
        if (bloque == 1)
        {
            bloque_b[off] = v;
        }
        else
        {
            bloque_c[off] = v;
        }
    }
}

// ============================================================
// LA CONTABILIDAD DE ESTRUCTURAS.
//
// DynamicArray, StringPool y ByteBuffer comparten la
// misma contabilidad: por estructura, su region, la base
// (offset de su bloque actual en la region), la cuenta,
// la capacidad, el tipo (1 DynamicArray, 2 StringPool,
// 3 ByteBuffer) y si vive. Los arreglos van indexados por
// el handle de la estructura (1..128); el 0 es el fallo.
// est_crece es el crecimiento geometrico x2, el mismo
// para las tres clases: extension en el sitio si el
// bloque de la estructura es el ultimo asignado de su
// arena; si no, bloque nuevo al doble y copia, y el
// bloque viejo queda como hueco hasta el reset de la
// fase. La base puede cambiar al crecer con copia; los
// handles de los datos no, porque un dato se referencia
// por su indice dentro de la estructura, no por su
// offset en la arena.
// est_agrega es la unica puerta de registro: agrega al
// final y devuelve el indice del elemento, o -1 si la
// arena no pudo crecer (error ya acusado, una sola vez
// por operacion fallida).
// ============================================================

int est_crea(int arena, int tipo, int capini)
{
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int off;
    int e;
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (capini < 1)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (nest >= 128)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    off = arena_alloc(arena, capini, 1);
    if (off < 0)
    {
        return 0;
    }
    nest = nest + 1;
    e = nest;
    est_region[e] = arena;
    est_base[e] = off;
    est_cuenta[e] = 0;
    est_cap[e] = capini;
    est_tipo[e] = tipo;
    est_viva[e] = 1;
    return e;
}

int est_valida(int e, int tipo)
{
    int est_tipo[129];
    int est_viva[129];
    int r;
    r = 0;
    if (e >= 1)
    {
        if (e <= nest)
        {
            if (est_viva[e] == 1)
            {
                if (tipo == 0)
                {
                    r = 1;
                }
                else
                {
                    if (est_tipo[e] == tipo)
                    {
                        r = 1;
                    }
                }
            }
        }
    }
    return r;
}

int est_crece(int e)
{
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int region;
    int base;
    int cap;
    int nuevacap;
    int off;
    int blk;
    int i;
    region = est_region[e];
    base = est_base[e];
    cap = est_cap[e];
    nuevacap = cap * 2;
    if (base + cap == reg_usado[region])
    {
        if (reg_usado[region] + (nuevacap - cap) <= reg_reserva[region])
        {
            reg_usado[region] = reg_usado[region] + (nuevacap - cap);
            est_cap[e] = nuevacap;
            return 1;
        }
        errores_arena = errores_arena + 1;
        return 0;
    }
    off = arena_alloc(region, nuevacap, 1);
    if (off < 0)
    {
        return 0;
    }
    blk = reg_bloque[region];
    i = 0;
    while (i < est_cuenta[e])
    {
        celda_set(blk, off + i, celda_get(blk, base + i));
        i = i + 1;
    }
    est_base[e] = off;
    est_cap[e] = nuevacap;
    return 1;
}

int est_agrega(int e, int v)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int idx;
    if (est_valida(e, 0) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (est_cuenta[e] == est_cap[e])
    {
        if (est_crece(e) == 0)
        {
            return -1;
        }
    }
    idx = est_cuenta[e];
    celda_set(reg_bloque[est_region[e]], est_base[e] + idx, v);
    est_cuenta[e] = idx + 1;
    return idx;
}

// ============================================================
// DYNAMICARRAY.
//
// da_create nace con la capacidad inicial pedida (en
// elementos) y devuelve el handle del arreglo (0 = fallo
// acusado). da_add agrega al final creciendo como manda
// est_crece y devuelve el indice del elemento o -1.
// da_get / da_set leen y escriben por indice, con el
// intervalo validado antes de tocar memoria: fuera de la
// cuenta, acusan y no tocan nada. da_count, da_capacity
// y da_base consultan la contabilidad (valen para las
// tres clases de estructura); handle invalido da -1.
// ============================================================

int da_create(int arena, int initial_capacity)
{
    return est_crea(arena, 1, initial_capacity);
}

int da_add(int arr, int value)
{
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(arr, value);
}

int da_get(int arr, int index)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (index < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (index >= est_cuenta[arr])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[arr]], est_base[arr] + index);
}

void da_set(int arr, int index, int value)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (index < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (index >= est_cuenta[arr])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[arr]], est_base[arr] + index, value);
}

int da_count(int arr)
{
    int est_cuenta[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[arr];
}

int da_capacity(int arr)
{
    int est_cap[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_cap[arr];
}

int da_base(int arr)
{
    int est_base[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_base[arr];
}

// ============================================================
// STRINGPOOL.
//
// La piscina dinamica: un buffer de caracteres que crece
// en la region pedida. string_pool_add_char agrega un
// caracter (guardado como byte, 0..255) y devuelve su
// offset dentro de la piscina: ese offset es el ini de
// las referencias. El formato de la referencia no
// cambia: ini * 128 + largo, el de la piscina de hoy;
// string_pool_len desempaqueta el largo y
// string_pool_get_char lee el caracter ini + i. Los
// handles son offsets: estables hasta la muerte de la
// region, crezca lo que crezca la piscina.
// ============================================================

int string_pool_create(int arena)
{
    return est_crea(arena, 2, 4);
}

int string_pool_add_char(int pool, int ch)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(pool, ch & 255);
}

int string_pool_get_char(int pool, int ini, int i)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int idx;
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    idx = ini + i;
    if (idx < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (idx >= est_cuenta[pool])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[pool]], est_base[pool] + idx);
}

int string_pool_len(int pool, int ref)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return ref - (ref / 128) * 128;
}

// ============================================================
// BYTEBUFFER.
//
// El buffer de bytes que crece: el codigo del Emitter y
// la imagen de los Writers. Una celda por byte, como
// hoy, y cada byte guardado en 0..255.
// bytebuffer_append agrega un byte al final y devuelve
// su offset — la semantica de los placeholders del
// Emitter, que ya devuelven el offset de su hueco.
// bytebuffer_patch escribe en un offset ya entregado y
// dentro de la cuenta: es el patch32 / patchRel32 de hoy
// sin guarda de 256. bytebuffer_write copia count bytes
// desde otro ByteBuffer (desde su src_offset) y los
// agrega al final de este: lo que los Writers hacen al
// ensamblar cabecera + codigo + datos; el intervalo de
// origen se valida entero antes de copiar, asi que una
// copia invalida acusa y no escribe nada.
// bytebuffer_get lee un byte por offset, validado.
// ============================================================

int bytebuffer_create(int arena)
{
    return est_crea(arena, 3, 8);
}

int bytebuffer_append(int bb, int byte)
{
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(bb, byte & 255);
}

void bytebuffer_patch(int bb, int offset, int byte)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[bb]], est_base[bb] + offset, byte & 255);
}

void bytebuffer_write(int bb, int src, int src_offset, int count)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int blk;
    int i;
    int v;
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (est_valida(src, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (src_offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (count < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (src_offset + count > est_cuenta[src])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    blk = reg_bloque[est_region[src]];
    i = 0;
    while (i < count)
    {
        v = celda_get(blk, est_base[src] + src_offset + i);
        if (est_agrega(bb, v) < 0)
        {
            return;
        }
        i = i + 1;
    }
}

int bytebuffer_get(int bb, int offset)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[bb]], est_base[bb] + offset);
}

int bytebuffer_get_size(int bb)
{
    int est_cuenta[129];
    if (est_valida(bb, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[bb];
}
// ============================================================
// ESTADO COMPARTIDO.
//
// Los escalares de la pieza: el contador de errores
// (errores_rt: suma 1 por cada registro que la arena
// no pudo cumplir o cada clase de destino invalida),
// el ByteBuffer dcod con el prefijo modelado, el
// registro de parches internos (tres arreglos
// paralelos: posicion, clase de destino y rebanada
// duena, con su contador nreg), las catorce listas de
// direcciones DATA del oraculo (un DynamicArray y un
// contador por lista, con el prefijo dpl_/npl_), los
// tamanos finales de las diecinueve regiones en hueco
// (tam_: medidos por el puerto emitiendo el oraculo
// entero, probados byte a byte; la rebanada que porte
// una region debe emitir exactamente su tam_ o la
// conservacion lo acusa), las direcciones de las
// veinticuatro regiones (dir_: las fija emite_grafico
// al pasar) y los seis campos del Result (res_).
// Las clases de destino del registro: 0 ventana,
// 1 bucle, 2 redraw, 3 tecla, 4 boton, 5 raton,
// 6 refresco, 7 lineas, 8 barra, 9 DIBUJA_EDIT,
// 10 DIBUJA_FILE, 11 COPIAR, 12 PEGAR, 13 VACIAR,
// 14 isla EDIT, 15 isla CORTAR, 16 isla COPIAR,
// 17 isla SELECCIONAR, 18 isla PEGAR, 19 isla
// ELIMINAR, 20 isla FILE, 21 isla OPEN, 22 isla SAVE
// y 23 isla CLOSE.
// ============================================================

int errores_rt;
int dcod;
int nreg;
int dreg_pos;
int dreg_clase;
int dreg_dueno;
int dpl_buf;
int dpl_cnt;
int dpl_cab;
int dpl_vis;
int dpl_cur;
int dpl_top;
int dpl_alt;
int dpl_est;
int dpl_agr;
int dpl_men;
int dpl_sel;
int dpl_len;
int dpl_clip;
int dpl_txt;
int npl_buf;
int npl_cnt;
int npl_cab;
int npl_vis;
int npl_cur;
int npl_top;
int npl_alt;
int npl_est;
int npl_agr;
int npl_men;
int npl_sel;
int npl_len;
int npl_clip;
int npl_txt;
int tam_raton;
int tam_refresco;
int tam_lineas;
int tam_barra;
int tam_edit;
int tam_file;
int tam_copiar;
int tam_pegar;
int tam_vaciar;
int tam_iedit;
int tam_icortar;
int tam_icopiar;
int tam_isel;
int tam_ipegar;
int tam_ieliminar;
int tam_ifile;
int tam_iopen;
int tam_isave;
int tam_iclose;
int dir_bucle;
int dir_redraw;
int dir_tecla;
int dir_boton;
int dir_raton;
int dir_ventana;
int dir_refresco;
int dir_lineas;
int dir_barra;
int dir_edit;
int dir_file;
int dir_copiar;
int dir_pegar;
int dir_vaciar;
int dir_iedit;
int dir_icortar;
int dir_icopiar;
int dir_isel;
int dir_ipegar;
int dir_ieliminar;
int dir_ifile;
int dir_iopen;
int dir_isave;
int dir_iclose;
int res_draw;
int res_main;
int res_bucle;
int res_titulo;
int res_cap;
int res_refresco;

// ============================================================
// REINICIA EL RUNTIME.
//
// Pone a cero el estado, fija los tamanos medidos de
// las regiones en hueco y crea las estructuras en
// BackendArena: el ByteBuffer del prefijo, los tres
// arreglos del registro de parches y las catorce
// listas DATA, nacidos a 256 como manda la norma de
// la casa. El llamador crea BackendArena antes
// (region_backend), como en las demas piezas.
// ============================================================

void reinicia_rt()
{
    errores_rt = 0;
    nreg = 0;
    npl_buf = 0;
    npl_cnt = 0;
    npl_cab = 0;
    npl_vis = 0;
    npl_cur = 0;
    npl_top = 0;
    npl_alt = 0;
    npl_est = 0;
    npl_agr = 0;
    npl_men = 0;
    npl_sel = 0;
    npl_len = 0;
    npl_clip = 0;
    npl_txt = 0;
    tam_raton = 358;
    tam_refresco = 62;
    tam_lineas = 239;
    tam_barra = 157;
    tam_edit = 378;
    tam_file = 267;
    tam_copiar = 189;
    tam_pegar = 94;
    tam_vaciar = 30;
    tam_iedit = 58;
    tam_icortar = 63;
    tam_icopiar = 58;
    tam_isel = 48;
    tam_ipegar = 42;
    tam_ieliminar = 58;
    tam_ifile = 58;
    tam_iopen = 42;
    tam_isave = 42;
    tam_iclose = 42;
    dir_bucle = 0;
    dir_redraw = 0;
    dir_tecla = 0;
    dir_boton = 0;
    dir_raton = 0;
    dir_ventana = 0;
    dir_refresco = 0;
    dir_lineas = 0;
    dir_barra = 0;
    dir_edit = 0;
    dir_file = 0;
    dir_copiar = 0;
    dir_pegar = 0;
    dir_vaciar = 0;
    dir_iedit = 0;
    dir_icortar = 0;
    dir_icopiar = 0;
    dir_isel = 0;
    dir_ipegar = 0;
    dir_ieliminar = 0;
    dir_ifile = 0;
    dir_iopen = 0;
    dir_isave = 0;
    dir_iclose = 0;
    res_draw = 0;
    res_main = 0;
    res_bucle = 0;
    res_titulo = 0;
    res_cap = 0;
    res_refresco = 0;
    dcod = bytebuffer_create(region_backend);
    dreg_pos = da_create(region_backend, 256);
    dreg_clase = da_create(region_backend, 256);
    dreg_dueno = da_create(region_backend, 256);
    dpl_buf = da_create(region_backend, 256);
    dpl_cnt = da_create(region_backend, 256);
    dpl_cab = da_create(region_backend, 256);
    dpl_vis = da_create(region_backend, 256);
    dpl_cur = da_create(region_backend, 256);
    dpl_top = da_create(region_backend, 256);
    dpl_alt = da_create(region_backend, 256);
    dpl_est = da_create(region_backend, 256);
    dpl_agr = da_create(region_backend, 256);
    dpl_men = da_create(region_backend, 256);
    dpl_sel = da_create(region_backend, 256);
    dpl_len = da_create(region_backend, 256);
    dpl_clip = da_create(region_backend, 256);
    dpl_txt = da_create(region_backend, 256);
}

// ============================================================
// EMISORES.
//
// La base de emision de la casa sobre el ByteBuffer
// dcod: em_byte anota un byte, em_dword un dword
// little-endian, em_hueco reserva el dword de un
// parche y devuelve su posicion (la semantica de los
// placeholders del Emitter) y parche32 escribe un
// dword en un offset ya entregado. Encima, las
// primitivas del prefijo: las mismas codificaciones
// de X86Emitter.cpp de Stage 0, en decimal como en
// las demas piezas. Los huecos con retorno devuelven
// la posicion del rel32 o del imm32. em_hueco_cero
// emite la region en hueco: n bytes a cero.
// anota_lista anota la posicion de un imm32 en una
// de las catorce listas DATA de la pieza — el indice
// sigue el orden del estado: 0 lineBuffer, 1
// lineCount, 2 lineHead, 3 firstVisible, 4
// repaintCursor, 5 thumbTop, 6 thumbHeight, 7
// dragState, 8 dragGrab, 9 menuAbierto, 10
// seleccion, 11 clipLen, 12 clipBuffer y 13
// menuTexto — e incrementa su contador; los
// emisores de operando de memoria (em_mov_eax_mem,
// em_mov_ebx_mem, em_mov_mem_eax, em_sub_eax_mem y
// em_add_eax_mem) emiten su imm32 a cero y lo
// anotan. em_jle_hueco y em_jbe_hueco son los
// saltos con signo y sin signo del dibujo, y
// em_and_eax_imm y em_add_eax_imm sus inmediatos.
// R-3 suma los saltos que piden la barra y el
// raton (em_jb_hueco, em_ja_hueco, em_jae_hueco,
// em_jge_hueco y em_jns_hueco) y los operandos de
// memoria de sus cuentas (em_mov_ecx_mem,
// em_sub_ebx_mem, em_cmp_eax_mem, em_add_ecx_mem,
// em_div_mem y em_mul_mem). R-4 suma los
// operandos con la direccion DATA como
// inmediato (em_mov_edi_dir, em_mov_edx_dir,
// em_mov_esi_dir, em_mov_eax_dir, em_add_eax_dir
// y em_sub_eax_dir: el opcode y un imm32
// anotado en su lista) y em_cmp_ebx_mem
// (cmp ebx, [dir]).
// ============================================================

void em_byte(int b)
{
    bytebuffer_append(dcod, b & 255);
}

void em_dword(int v)
{
    em_byte(v & 255);
    em_byte((v >> 8) & 255);
    em_byte((v >> 16) & 255);
    em_byte((v >> 24) & 255);
}

int em_hueco()
{
    int pos;
    pos = bytebuffer_get_size(dcod);
    em_dword(0);
    return pos;
}

void parche32(int pos, int v)
{
    bytebuffer_patch(dcod, pos, v & 255);
    bytebuffer_patch(dcod, pos + 1, (v >> 8) & 255);
    bytebuffer_patch(dcod, pos + 2, (v >> 16) & 255);
    bytebuffer_patch(dcod, pos + 3, (v >> 24) & 255);
}

void anota_lista(int cual, int pos)
{
    int r;
    if (cual < 0)
    {
        errores_rt = errores_rt + 1;
        return;
    }
    if (cual > 13)
    {
        errores_rt = errores_rt + 1;
        return;
    }
    r = 0;
    if (cual == 0)
    {
        r = da_add(dpl_buf, pos);
        if (r >= 0)
        {
            npl_buf = npl_buf + 1;
        }
    }
    if (cual == 1)
    {
        r = da_add(dpl_cnt, pos);
        if (r >= 0)
        {
            npl_cnt = npl_cnt + 1;
        }
    }
    if (cual == 2)
    {
        r = da_add(dpl_cab, pos);
        if (r >= 0)
        {
            npl_cab = npl_cab + 1;
        }
    }
    if (cual == 3)
    {
        r = da_add(dpl_vis, pos);
        if (r >= 0)
        {
            npl_vis = npl_vis + 1;
        }
    }
    if (cual == 4)
    {
        r = da_add(dpl_cur, pos);
        if (r >= 0)
        {
            npl_cur = npl_cur + 1;
        }
    }
    if (cual == 5)
    {
        r = da_add(dpl_top, pos);
        if (r >= 0)
        {
            npl_top = npl_top + 1;
        }
    }
    if (cual == 6)
    {
        r = da_add(dpl_alt, pos);
        if (r >= 0)
        {
            npl_alt = npl_alt + 1;
        }
    }
    if (cual == 7)
    {
        r = da_add(dpl_est, pos);
        if (r >= 0)
        {
            npl_est = npl_est + 1;
        }
    }
    if (cual == 8)
    {
        r = da_add(dpl_agr, pos);
        if (r >= 0)
        {
            npl_agr = npl_agr + 1;
        }
    }
    if (cual == 9)
    {
        r = da_add(dpl_men, pos);
        if (r >= 0)
        {
            npl_men = npl_men + 1;
        }
    }
    if (cual == 10)
    {
        r = da_add(dpl_sel, pos);
        if (r >= 0)
        {
            npl_sel = npl_sel + 1;
        }
    }
    if (cual == 11)
    {
        r = da_add(dpl_len, pos);
        if (r >= 0)
        {
            npl_len = npl_len + 1;
        }
    }
    if (cual == 12)
    {
        r = da_add(dpl_clip, pos);
        if (r >= 0)
        {
            npl_clip = npl_clip + 1;
        }
    }
    if (cual == 13)
    {
        r = da_add(dpl_txt, pos);
        if (r >= 0)
        {
            npl_txt = npl_txt + 1;
        }
    }
    if (r < 0)
    {
        errores_rt = errores_rt + 1;
    }
}

void em_mov_eax_imm(int v)
{
    em_byte(184);
    em_dword(v);
}

void em_mov_reg_imm(int op, int v)
{
    em_byte(op);
    em_dword(v);
}

void em_int(int n)
{
    em_byte(205);
    em_byte(n);
}

void em_cmp_eax_imm(int v)
{
    em_byte(61);
    em_dword(v);
}

void em_cmp_ah_imm8(int v)
