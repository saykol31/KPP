    registra_parche(em_jmp_hueco(), 1, 5);
}

void emite_isla_open()
{
    // OPEN: con el menu FILE abierto
    // (estado 2), lo cierra y redibuja; si la
    // guarda falla, vuelve al bucle sin
    // actuar. En el oraculo la accion solo
    // cierra el menu: los dialogos reales
    // quedan fuera de esta pieza.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(2);
    int g1 = em_jne_hueco();
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 5);
    registra_parche(em_jmp_hueco(), 1, 5);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    registra_parche(em_jmp_hueco(), 1, 5);
}

void emite_isla_save()
{
    // SAVE: con el menu FILE abierto
    // (estado 2), lo cierra y redibuja; si la
    // guarda falla, vuelve al bucle sin
    // actuar. En el oraculo la accion solo
    // cierra el menu: los dialogos reales
    // quedan fuera de esta pieza.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(2);
    int g1 = em_jne_hueco();
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 5);
    registra_parche(em_jmp_hueco(), 1, 5);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    registra_parche(em_jmp_hueco(), 1, 5);
}

void emite_isla_close()
{
    // CLOSE: con el menu FILE abierto
    // (estado 2), lo cierra y redibuja; si la
    // guarda falla, vuelve al bucle sin
    // actuar. En el oraculo la accion solo
    // cierra el menu: los dialogos reales
    // quedan fuera de esta pieza.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(2);
    int g1 = em_jne_hueco();
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 5);
    registra_parche(em_jmp_hueco(), 1, 5);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    registra_parche(em_jmp_hueco(), 1, 5);
}

void emite_grafico()
{
    int p;
    // MASCARA DE EVENTOS (funcion 40, 0x27).
    em_mov_eax_imm(40);
    em_mov_reg_imm(187, 39);
    em_int(64);
    // START: call DRAW_WINDOW, jmp al cuerpo.
    res_draw = em_call_hueco();
    registra_parche(res_draw, 0, 1);
    res_main = em_jmp_hueco();
    // BUCLE DE EVENTOS (funcion 10).
    dir_bucle = bytebuffer_get_size(dcod);
    res_bucle = dir_bucle;
    em_mov_eax_imm(10);
    em_int(64);
    // DESPACHO: 1 redraw, 2 tecla, 3 boton, 6 raton.
    em_cmp_eax_imm(1);
    p = em_je_hueco();
    registra_parche(p, 2, 1);
    em_cmp_eax_imm(2);
    p = em_je_hueco();
    registra_parche(p, 3, 1);
    em_cmp_eax_imm(3);
    p = em_je_hueco();
    registra_parche(p, 4, 1);
    em_cmp_eax_imm(6);
    p = em_je_hueco();
    registra_parche(p, 5, 3);
    // Evento desconocido: volver al bucle.
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // REDRAW: call DRAW_WINDOW y volver al bucle.
    dir_redraw = bytebuffer_get_size(dcod);
    p = em_call_hueco();
    registra_parche(p, 0, 1);
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // TECLA: funcion 2 y volver al bucle.
    dir_tecla = bytebuffer_get_size(dcod);
    em_mov_eax_imm(2);
    em_int(64);
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // BOTON: funcion 17; el id llega en AH. Las
    // islas del menu se registran con su duena: los
    // renglones de EDIT en R-4 y los de FILE en R-5.
    dir_boton = bytebuffer_get_size(dcod);
    em_mov_eax_imm(17);
    em_int(64);
    em_cmp_ah_imm8(2);
    p = em_je_hueco();
    registra_parche(p, 14, 4);
    em_cmp_ah_imm8(8);
    p = em_je_hueco();
    registra_parche(p, 20, 5);
    em_cmp_ah_imm8(9);
    p = em_je_hueco();
    registra_parche(p, 21, 5);
    em_cmp_ah_imm8(10);
    p = em_je_hueco();
    registra_parche(p, 22, 5);
    em_cmp_ah_imm8(11);
    p = em_je_hueco();
    registra_parche(p, 23, 5);
    em_cmp_ah_imm8(3);
    p = em_je_hueco();
    registra_parche(p, 15, 4);
    em_cmp_ah_imm8(4);
    p = em_je_hueco();
    registra_parche(p, 16, 4);
    em_cmp_ah_imm8(5);
    p = em_je_hueco();
    registra_parche(p, 17, 4);
    em_cmp_ah_imm8(6);
    p = em_je_hueco();
    registra_parche(p, 18, 4);
    em_cmp_ah_imm8(7);
    p = em_je_hueco();
    registra_parche(p, 19, 4);
    // Boton 1 = cerrar (cae a la salida); otro
    // cualquiera vuelve al bucle.
    em_cmp_ah_imm8(1);
    p = em_jne_hueco();
    registra_parche(p, 1, 1);
    // SALIDA.
    emite_salida();
    // RATON: portado en R-3.
    dir_raton = bytebuffer_get_size(dcod);
    emite_raton();
    // DRAW WINDOW: begin redraw, la ventana de
    // 500 x 220 en (100, 100) con su titulo, las
    // llamadas a las rutinas de dibujo registradas
    // con sus duenas, el titulo reafirmado con la
    // funcion 71.1 y end redraw.
    dir_ventana = bytebuffer_get_size(dcod);
    em_mov_eax_imm(12);
    em_mov_reg_imm(187, 1);
    em_int(64);
    em_mov_eax_imm(0);
    em_mov_reg_imm(187, 6554100);
    em_mov_reg_imm(185, 6554100);
    em_mov_reg_imm(186, 335544320);
    em_mov_reg_imm(190, -2138531329);
    em_byte(191);
    res_titulo = em_hueco();
    em_int(64);
    p = em_call_hueco();
    registra_parche(p, 7, 2);
    p = em_call_hueco();
    registra_parche(p, 9, 4);
    p = em_call_hueco();
    registra_parche(p, 10, 5);
    em_mov_eax_imm(71);
    em_mov_reg_imm(187, 1);
    em_byte(185);
    res_cap = em_hueco();
    em_int(64);
    em_mov_eax_imm(12);
    em_mov_reg_imm(187, 2);
    em_int(64);
    em_ret();
    // REFRESCO: portado en R-2. Su direccion es
    // el refreshOutputAddress del Result.
    dir_refresco = bytebuffer_get_size(dcod);
    res_refresco = dir_refresco;
    emite_refresco();
    // DIBUJO DE LINEAS: portado en R-2.
    dir_lineas = bytebuffer_get_size(dcod);
    emite_lineas();
    // BARRA: portada en R-3.
    dir_barra = bytebuffer_get_size(dcod);
    emite_barra();
    // DIBUJA_EDIT: portado en R-4.
    dir_edit = bytebuffer_get_size(dcod);
    emite_edit();
    // DIBUJA_FILE: portado en R-5.
    dir_file = bytebuffer_get_size(dcod);
    emite_file();
    // COPIAR, PEGAR y VACIAR: portados en R-4.
    dir_copiar = bytebuffer_get_size(dcod);
    emite_copiar();
    dir_pegar = bytebuffer_get_size(dcod);
    emite_pegar();
    dir_vaciar = bytebuffer_get_size(dcod);
    emite_vaciar();
    // ISLAS DE EDIT: portadas en R-4.
    dir_iedit = bytebuffer_get_size(dcod);
    emite_isla_edit();
    dir_icortar = bytebuffer_get_size(dcod);
    emite_isla_cortar();
    dir_icopiar = bytebuffer_get_size(dcod);
    emite_isla_copiar();
    dir_isel = bytebuffer_get_size(dcod);
    emite_isla_sel();
    dir_ipegar = bytebuffer_get_size(dcod);
    emite_isla_pegar();
    dir_ieliminar = bytebuffer_get_size(dcod);
    emite_isla_eliminar();
    // ISLAS DE FILE: portadas en R-5.
    dir_ifile = bytebuffer_get_size(dcod);
    emite_isla_file();
    dir_iopen = bytebuffer_get_size(dcod);
    emite_isla_open();
    dir_isave = bytebuffer_get_size(dcod);
    emite_isla_save();
    dir_iclose = bytebuffer_get_size(dcod);
    emite_isla_close();
    // PASADAS INTERNAS: la de R-1, la de R-2, la
    // de R-3, la de R-4 y la de R-5.
    rellena_registro(1);
    rellena_registro(2);
    rellena_registro(3);
    rellena_registro(4);
    rellena_registro(5);
}

// ============================================================
// SONDA DE LA REBANADA.
//
// Veinticinco bloques cerrados, en el orden de la
// corriente: (a) la emision hasta START — la cuenta
// de bytes, los bytes y los dos campos del Result
// que alli nacen; (b) el bucle y el despacho — la
// cuenta y los bytes hasta la region del raton;
// (c) DRAW_WINDOW — la cuenta y sus bytes; (d) el
// registro de parches entero (cuenta y filas de
// posicion, clase y duena), los seis campos del
// Result, los contadores de las catorce listas DATA
// y los dos contadores de errores; (e) el registro
// de huecos: la cuenta de regiones y, por region,
// su direccion y su tamano, y el tamano total del
// prefijo; (f) el cuerpo del REFRESCO — la cuenta y
// sus bytes; (g) el cuerpo del DIBUJO DE LINEAS —
// la cuenta y sus bytes; (h) la logica de visibles
// en el modelo: cinco escenarios cerrados (el
// historial vacio, menos de 41 lineas, 41 exactas
// con la seleccion activa, mas de 41 con
// firstVisible desplazado y el historial lleno con
// la cabeza envuelta), cada uno con sus datos, las
// filas que se dibujan, el alto del tinte y, por
// fila, su ranura circular y su Y; (i) el cuerpo de
// la BARRA — la cuenta y sus bytes; (j) el cuerpo
// del RATON — la cuenta y sus bytes; (k) el cuerpo
// de DIBUJA_EDIT — la cuenta y sus bytes; (l) el
// cuerpo de COPIAR; (m) el de PEGAR; (n) el de
// VACIAR; (o) a (t) los cuerpos de las seis islas
// de EDIT, en su orden — cada uno la cuenta y sus
// bytes; (u) el cuerpo de DIBUJA_FILE — la cuenta y
// sus bytes; (v) a (y) los cuerpos de las cuatro
// islas de FILE, en su orden. En esta rebanada el
// bloque (e) queda en dos valores: cero huecos y
// el tamano total del prefijo. Ningun bloque
// pasa de 512 valores: el empaquetado en segmentos
// lo fija el plan de la rebanada — diez
// segmentos: el primero con los bloques (a) a (c),
// 307 valores; el segundo con (d), (e) y (f), 271;
// el tercero con (g) y (h), 509; el cuarto con
// (i), 158; el quinto con (j), 359; el sexto con
// (k), 379; el septimo con (l), (m) y (n), 316;
// el octavo con (o) a (t), 333; el noveno con (u)
// y (v), 327; y el decimo con (w), (x) e (y), 129.
// Como el historial circular de la Konsole
// retiene 512 registros, cada corrida de la sonda
// imprime UN segmento y se copia antes de correr el
// siguiente: segmento_sonda lee el archivo
// SONDA.TXT de la raiz de la imagen — si no esta,
// la corrida imprime el segmento 1; si su primer
// byte es el digito 2, 3, 4, 5, 6, 7, 8 o 9,
// imprime ese segmento; si es el digito 0,
// imprime el segmento 10.
// ============================================================

void sonda_hasta_start()
{
    int i;
    print_int(dir_bucle);
    i = 0;
    while (i < dir_bucle)
    {
        print_int(bytebuffer_get(dcod, i));
        i = i + 1;
    }
    print_int(res_draw);
    print_int(res_main);
}

