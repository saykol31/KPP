// ============================================================
// SONDA DEL BACKEND B-1: LA MAQUINARIA.
//
//
// Cinco movimientos. El primero conserva la sonda de
// M-1 en sus dos primeros tramos (arranque, basico y
// crecimiento de la lista de llamadas hasta 3.000) con
// los unicos numeros re-apuntados que los nacimientos
// de la maquinaria mueven: las bases de la lista crecida
// (17936 y 22032) y el usado de la region (26128); la
// corriente de registros, cuentas, capacidades e
// integridad es la de M-1, intacta. El segundo corre el
// guion de la maquinaria: el asignador liga 101 a EAX y
// 102 a EBX, el tercer temporal derrama el de EAX a la
// ranura -4, el cuarto derrama el nuevo de EAX a -8 y
// pedir el que esta en memoria derrama el de EAX a -12
// y lo liga a EAX sin recargarlo (la politica del
// oraculo); liberado EBX entra 105, liberado EAX la
// recarga de 103 emite su reten y lo liga a EAX; la
// constante de 106 nace, se lee y muere con su liberacion
// tras derramar a 103 a -16; el reinicio de temporales
// vacia el mapa sin tocar las listas; los retenes de EBX
// y ECX cierran el codigo en 42 bytes. Despues, los
// globales 201 y 202 se reservan en datos (offsets 0 y
// 4), el contexto de la funcion 301 se siembra con
// ellos, suma una variable de datos (offset 16) y una
// de pila (ranura -20, tras las cuatro de los derrames),
// se guarda, y el de 302 nace sembrado y solo con la
// suya (offset 20): el directorio los encuentra a los
// dos y no al 303. El cierre acusa dos veces: la ranura
// sin marco y el registro de un temporal inexistente.
// El tercero crece las tablas nuevas: 300 variables
// (capacidad 512), su contexto guardado (512) y 300
// temporales (512). El cuarto y el quinto acusan contra
// una BackendArena de 11024 celdas (caben los
// nacimientos, no el primer crecimiento): la guarda de
// variables ante la declaracion 257 y la lista de
// llamadas de M-1 ante el registro 257, ambas con las
// cuentas clavadas en 256 y la ultima ranura intacta.
// ============================================================

void sonda_backend_b1()
{
    int rs;
    int rf;
    int rc;
    int rb;
    int i;
    int r;
    int o;
    int s;
    inicia_arena();
    rs = arena_create(256);
    region_source = rs;
    rf = arena_create(256);
    region_frontend = rf;
    rc = arena_create(256);
    region_compiler = rc;
    arena_destroy(rf);
    rb = arena_create(32768);
    region_backend = rb;
    print_int(rb);
    print_int(arena_get_reserved(rb));
    print_int(errores_arena);
    reinicia_back();
    registra_vl(11, 21, 101);
    registra_vl(12, 22, 102);
    registra_vl(13, 23, 103);
    registra_vs(31, 41, 201);
    registra_vs(32, 42, 202);
    registra_spill(51, 301, -4);
    registra_spill(52, 302, -8);
    registra_reload(61, 401, -12);
    registra_reload(62, 402, -16);
    registra_reload(63, 403, -20);
    registra_sc(501, 71);
    registra_sc(502, 72);
    registra_cf(81, 601);
    registra_cf(82, 602);
    registra_fc(91, 701);
    registra_fc(92, 702);
    imprime_listas();
    i = nfc;
    while (i < 257)
    {
        registra_fc(i, 1000 + i);
        i = i + 1;
    }
    print_int(da_capacity(dfc_fun));
    while (i < 3000)
    {
        registra_fc(i, 1000 + i);
        i = i + 1;
    }
    print_int(nfc);
