// ============================================================
// SONDA B-2: EL ESQUELETO DE GENERATE().
//
// Tras la sonda B-1 entera (la conservacion), cinco
// movimientos del paseo, cada uno en su mundo con su
// programa registrado por registra_ir: el minimo que
// devuelve un entero (Return inmediato en main), el
// programa con global, funcion con parametros y
// locales, Store y Load de pila y de DATA, StringConst
// con derrame y Return desde EBX; el retorno implicito
// de una funcion sin Return y sin main; los dos
// errores de FunctionBegin (sin nombre y duplicada); y
// el crecimiento con 300 constantes. Los textos se
// agregan a dpool caracter a caracter con tx1..tx4,
// que devuelven la referencia ini * 128 + largo.
// ============================================================

int tx1(int c0)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    return ini * 128 + 1;
}

int tx2(int c0, int c1)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    string_pool_add_char(dpool, c1);
    return ini * 128 + 2;
}

int tx3(int c0, int c1, int c2)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    string_pool_add_char(dpool, c1);
    string_pool_add_char(dpool, c2);
    return ini * 128 + 3;
}

int tx4(int c0, int c1, int c2, int c3)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    string_pool_add_char(dpool, c1);
    string_pool_add_char(dpool, c2);
    string_pool_add_char(dpool, c3);
    return ini * 128 + 4;
}

