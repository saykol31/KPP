// ============================================================
// SONDA B-5: COMPARACIONES Y LOGICA.
//
// Tras las sondas B-1 a B-4 enteras (la conservacion
// de 5.445 valores), catorce movimientos de
// comparaciones y logica, cada uno en su mundo con
// su programa en main: Equal caso 1, Less con la
// lanzadera, LessEqual caso 3 con derrame protector,
// GreaterEqual caso 3 con EBX libre, Greater en sus
// casos 1, 2 y 4, NotEqual en la pareja (memoria,
// EBX) — el error de la rama A sin caso 4 —,
// LogicalAnd en registros, LogicalOr con el derecho
// en EAX, LogicalAnd con ambos operandos en
// memoria, LogicalNot en EAX, LogicalNot en memoria
// con derrame protector y los tres errores de
// temporal inexistente (Equal, LogicalAnd,
// LogicalNot). Cada movimiento vuelca el codigo, el
// estado de genera, las listas de parches, la
// maquinaria y los errores.
// ============================================================

void sonda_cmp_eq()
{
    int r_main;
    int r_ope;
    int ini_ope;
    int r_t0;
    int r_t1;
