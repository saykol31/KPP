    em_byte(26);
}

int fuente_de(int nom)
{
    int k;
    k = 0;
    while (k < texto_len(nom))
    {
        if (texto_char(nom, k) == 64)
        {
            return texto_ini(nom) * 128 + k;
        }
        k = k + 1;
    }
    return nom;
}

int busca_shr(int src)
{
    int i;
    i = 0;
    while (i < nshr)
    {
        if (da_get(dshr_nom, i) == src)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

void registra_shr(int src, int tam)
{
    if (nshr < da_count(dshr_nom))
    {
        da_set(dshr_nom, nshr, src);
        da_set(dshr_tam, nshr, tam);
        da_set(dshr_off, nshr, -1);
    }
    else
    {
        da_add(dshr_nom, src);
        da_add(dshr_tam, tam);
        da_add(dshr_off, -1);
    }
    nshr = nshr + 1;
}

int busca_funarr(int src)
{
    int i;
    i = 0;
    while (i < nfunarr)
    {
        if (da_get(dfun_nom, i) == src)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

void registra_funarr(int src)
{
    if (nfunarr < da_count(dfun_nom))
    {
        da_set(dfun_nom, nfunarr, src);
    }
    else
    {
        da_add(dfun_nom, src);
    }
    nfunarr = nfunarr + 1;
}

int busca_dcl(int src)
{
    int i;
    i = 0;
    while (i < ndcl)
    {
        if (da_get(ddcl_nom, i) == src)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

void registra_dcl(int src)
{
    if (ndcl < da_count(ddcl_nom))
    {
        da_set(ddcl_nom, ndcl, src);
    }
    else
    {
        da_add(ddcl_nom, src);
    }
    ndcl = ndcl + 1;
}

