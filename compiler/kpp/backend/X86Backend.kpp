//
// Cinco movimientos (59 a 63): Print de una
// constante de cadena, de un temporal en EBX y
// PrintInteger de una constante; Print y
// PrintInteger de variables; el viaje de ida y
// vuelta del archivo; el programa completo con
// todas las listas conviviendo; y los errores de
// las ramas nuevas en seis submundos.
// ============================================================

// Movimiento 59: Print de una constante de cadena
// (la piscina y el relleno de la cadena, de punta
// a punta), PrintInteger de una constante y Print
// de un temporal en EBX.
void sonda_print()
{
    int r_main;
    int r_hola;
    int r_t0;
    int r_t1;
    int r_t2;
    int r_t3;
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    r_hola = tx4(72, 111, 108, 97);
    r_t0 = tx2(37, 48);
    r_t1 = tx2(37, 49);
    r_t2 = tx2(37, 50);
    r_t3 = tx2(37, 51);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(3, r_hola, 0, r_t0, 0);
    registra_ir(41, 0, r_t0, 0, 0);
    registra_ir(2, 0, 0, r_t1, 30);
    registra_ir(42, 0, r_t1, 0, 0);
    registra_ir(2, 0, 0, r_t2, 7);
    registra_ir(2, 0, 0, r_t3, 9);
    registra_ir(41, 0, r_t3, 0, 0);
    registra_ir(40, 0, r_t2, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
}

// Movimiento 60: Print y PrintInteger de variables
// (carga de una global y de una local de marco,
// con derrame y recarga entre medias).
void sonda_print_variable()
{
    int r_g;
    int r_main;
    int r_y;
    int r_t0;
    int r_t1;
    int r_t2;
    int r_t3;
    mundo2();
    r_g = tx1(103);
    r_main = tx4(109, 97, 105, 110);
    r_y = tx1(121);
    r_t0 = tx2(37, 48);
    r_t1 = tx2(37, 49);
    r_t2 = tx2(37, 50);
    r_t3 = tx2(37, 51);
    registra_ir(4, r_g, 0, 0, 0);
    dir_nglob = 1;
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(4, r_y, 0, 0, 0);
    registra_ir(2, 0, 0, r_t0, 5);
    registra_ir(5, r_g, r_t0, 0, 0);
    registra_ir(6, r_g, 0, r_t1, 0);
    registra_ir(42, 0, r_t1, 0, 0);
    registra_ir(2, 0, 0, r_t2, 8);
    registra_ir(5, r_y, r_t2, 0, 0);
    registra_ir(6, r_y, 0, r_t3, 0);
    registra_ir(41, 0, r_t3, 0, 0);
    registra_ir(40, 0, r_t1, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
}

// Movimiento 61: el viaje de ida y vuelta del
// archivo: FileWrite con su temporal de conteo y
// FileRead sobre la misma ruta y el mismo arreglo.
void sonda_archivo()
{
    int r_main;
    int r_v;
    int r_ruta;
    int r_t0;
    int r_t1;
    int r_t2;
    int r_t3;
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    r_v = tx3(118, 64, 48);
    r_ruta = tx9(68, 65, 84, 79, 83, 46, 84, 88, 84);
    r_t0 = tx2(37, 48);
    r_t1 = tx2(37, 49);
    r_t2 = tx2(37, 50);
    r_t3 = tx2(37, 51);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(4, r_v, 0, 0, 4);
    registra_ir(2, 0, 0, r_t0, 3);
    registra_ir(10, r_ruta, r_v, r_t1, 4);
    registra_aux(r_t0);
    registra_ir(9, r_ruta, r_v, r_t2, 4);
    registra_ir(2, 0, 0, r_t3, 0);
    registra_ir(7, r_v, r_t3, r_t1, 0);
    registra_ir(40, 0, r_t1, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
}

// Movimiento 62: el programa completo: global,
// arreglo compartido con alias, cadena, llamada,
// carga, almacen, carga y almacen de arreglo,
// Print y PrintInteger: el cierre resuelve todas
// las listas en un solo programa.
void sonda_completo()
{
    int r_g;
    int r_ayud;
    int r_main;
    int r_v0;
    int r_v1;
    int r_hola;
    int r_t0;
    int r_t1;
    int r_t2;
    int r_t3;
    int r_t4;
    int r_t5;
    int r_t6;
    mundo2();
    r_g = tx1(103);
    r_ayud = tx4(97, 121, 117, 100);
    r_main = tx4(109, 97, 105, 110);
    r_v0 = tx3(118, 64, 48);
    r_v1 = tx3(118, 64, 49);
    r_hola = tx4(72, 111, 108, 97);
    r_t0 = tx2(37, 48);
    r_t1 = tx2(37, 49);
    r_t2 = tx2(37, 50);
    r_t3 = tx2(37, 51);
    r_t4 = tx2(37, 52);
    r_t5 = tx2(37, 53);
    r_t6 = tx2(37, 54);
    registra_ir(4, r_g, 0, 0, 0);
    dir_nglob = 1;
    registra_ir(0, r_ayud, 0, 0, 0);
    registra_ir(4, r_v0, 0, 0, 3);
    registra_ir(2, 0, 0, r_t0, 2);
    registra_ir(2, 0, 0, r_t1, 40);
    registra_ir(8, r_v0, r_t0, r_t1, 0);
    registra_ir(2, 0, 0, r_t0, 40);
    registra_ir(40, 0, r_t0, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(4, r_v1, 0, 0, 3);
    registra_ir(39, r_ayud, 0, r_t2, 0);
    registra_ir(2, 0, 0, r_t3, 11);
    registra_ir(5, r_g, r_t3, 0, 0);
    registra_ir(6, r_g, 0, r_t4, 0);
    registra_ir(42, 0, r_t4, 0, 0);
    registra_ir(3, r_hola, 0, r_t5, 0);
    registra_ir(41, 0, r_t5, 0, 0);
    registra_ir(2, 0, 0, r_t6, 2);
    registra_ir(7, r_v1, r_t6, r_t4, 0);
    registra_ir(40, 0, r_t4, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
}

// Movimiento 63: los errores de las ramas nuevas,
// en seis submundos.
void sonda_errores_nativas()
{
    int r_main;
    int r_mues;
    int r_v;
    int r_ruta;
    int r_t0;
    int r_t1;
    int r_t2;
    int r_t3;
    int r_t9;
    // (a) Print de un temporal inexistente.
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    r_t9 = tx2(37, 57);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(41, 0, r_t9, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
    // (b) PrintInteger de un temporal en memoria.
    mundo2();
    r_mues = tx4(109, 117, 101, 115);
    r_main = tx4(109, 97, 105, 110);
    r_t0 = tx2(37, 48);
    r_t1 = tx2(37, 49);
    r_t2 = tx2(37, 50);
    r_t3 = tx2(37, 51);
    registra_ir(0, r_mues, 0, 0, 0);
    registra_ir(40, 0, 0, 0, 1);
    registra_ir(1, 0, 0, 0, 0);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(2, 0, 0, r_t0, 1);
    registra_ir(2, 0, 0, r_t1, 2);
    registra_ir(2, 0, 0, r_t2, 3);
    registra_ir(39, r_mues, 0, r_t3, 0);
    registra_ir(42, 0, r_t0, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
    // (c) FileRead de un arreglo no declarado.
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    r_v = tx3(118, 64, 48);
    r_ruta = tx9(68, 65, 84, 79, 83, 46, 84, 88, 84);
    r_t0 = tx2(37, 48);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(9, r_ruta, r_v, r_t0, 4);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
    // (d) FileRead con la capacidad en desacuerdo.
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    r_v = tx3(118, 64, 48);
    r_ruta = tx9(68, 65, 84, 79, 83, 46, 84, 88, 84);
    r_t0 = tx2(37, 48);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(4, r_v, 0, 0, 4);
    registra_ir(9, r_ruta, r_v, r_t0, 3);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
    // (e) FileWrite sin el temporal de conteo.
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    r_v = tx3(118, 64, 48);
    r_ruta = tx9(68, 65, 84, 79, 83, 46, 84, 88, 84);
    r_t0 = tx2(37, 48);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(4, r_v, 0, 0, 4);
    registra_ir(10, r_ruta, r_v, r_t0, 4);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
    // (f) FileRead fuera de todo marco.
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    r_v = tx3(118, 64, 48);
    r_ruta = tx9(68, 65, 84, 79, 83, 46, 84, 88, 84);
    r_t0 = tx2(37, 48);
    registra_ir(9, r_ruta, r_v, r_t0, 4);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_mov();
    imprime_cierre();
}


// ============================================================
// SONDAS DE LA REPARACION (B-10).
//
// Los IR reales de dos programas, volcados por el
// frente de Stage 0 y registrados con la disciplina
// de la piscina de la casa (el operando combinado
// de cada binaria como un tramo, las partes por
// subcadena): L00, el minimo, y L18 bloques, el
// caso de estres (un arreglo de 70000 y E/S de
// archivos). Cada sonda mide primero la capacidad
// en un mundo de sondeo y luego corre genera() en
// el mundo de trabajo, creado con esa capacidad;
// el cierre imprime la DATA construida y la sonda
// anade la capacidad calculada, la reserva y el
// uso de la region y los dos contadores de error.
// ============================================================

void carga_ir_l00()
{
    int refs[1];
    int ini;
    ini = string_pool_add_char(dpool, 109);
    string_pool_add_char(dpool, 97);
    string_pool_add_char(dpool, 105);
    string_pool_add_char(dpool, 110);
    refs[0] = ini * 128 + 4;
    registra_ir(0, refs[0], 0, 0, 0);
    registra_ir(40, 0, 0, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
}

void sonda_b10_l00()
{
    int cap;
    mundo2();
    carga_ir_l00();
    cap = capacidad_region();
    mundo_trabajo(cap);
    carga_ir_l00();
    genera();
    imprime_cierre();
    print_int(cap);
    print_int(arena_get_reserved(region_backend));
    print_int(arena_get_used(region_backend));
    print_int(errores_back);
    print_int(errores_arena);
}

