// X86Backend.kpp — Stage 1, backend, arranque.
// El corazon: traduce el IR a bytes x86. Su .hpp incluye IR.hpp, asi
// que su tabla de entrada es IROpcode (vive en IRGenerator.kpp; esta
// pieza llevara su copia identica cuando empiece a traducir, como
// emisor y consumidor de NodeKind se reparten la suya). De los 57
// codigos atiende 31 por nombre; el resto quedo nombrado sin ejecutar
// en Stage 0, por decision de su autor.
// Lo que define a este modulo no es un enum: es su maquinaria de
// PARCHES. Emite con huecos y los rellena en una pasada final, cuando
// todas las posiciones se conocen. Stage 0 lleva SIETE listas:
//   VariableLoadPatch    cargas de variable
//   VariableStorePatch   guardados de variable
//   TemporarySpillPatch  temporales derramados
//   TemporaryReloadPatch temporales recargados
//   StringConstPatch     constantes de cadena
//   ControlFlowPatch     saltos a etiquetas (aqui vivio el trabajo
//                        del JE de JumpIfZero: desplazamiento que se
//                        parchea al final)
//   FunctionCallPatch    CALL rel32 a funciones aun no generadas
// Temporales: viven en registro (EAX = 0, EBX = 3) o derramados a
// memoria (slots del marco EBP: -4, -8, -12...). Variables: offset
// absoluto en DATA o locales de pila (EBP-relativas), con capacidad
// si son arreglos; los arreglos se comparten por nombre entre
// funciones y cada funcion guarda su propio contexto de variables,
// para resolver incluso llamadas hacia adelante.
// Su unico enum propio en Stage 0 es el Kind de TemporaryLocation:
// Rebanada M-1 (2026-11-20): B-0 renace sobre arenas.
// El enum IROpcode queda identico (los 61 codigos) y las
// siete listas dejan de ser arreglos fijos de 256: son
// 18 DynamicArray de la biblioteca Arena (M-0) en
// BackendArena, creados por reinicia_back y operados
// por los registra_* de siempre, que conservan firma y
// papel — su cuerpo pasa de la guarda que acusa al
// llegar a 256 al crecimiento que acusa solo si la
// arena no puede crecer. La biblioteca viaja
// incorporada en esta misma pieza, mas abajo. La sonda
// se re-apunta como manda el mapa: ya no llena una
// lista hasta 256 para probar la guarda; crece la de
// llamadas hasta 3.000 y acusa contra una BackendArena
// de reserva diminuta. Sin generate() todavia: la
// maquinaria es B-1 y el paseo es B-2, que naceran
// sobre arenas.
// Rebanada B-1 (2026-11-21): la maquinaria, sin generate().
// Entran los temporales con su asignador (EAX primero,
// EBX despues, derrama el de EAX: la politica exacta de
// allocateRegisterForTemporary), el derrame y la recarga
// con sus emisiones al ByteBuffer de codigo y sus
// registros en las listas de M-1, el marco EBP con sus
// ranuras compartidas (allocateFrameSlot sirve a los
// derrames y a las locales de pila) y los tres retenes
// (emitMovEax/Ebx/EcxFramePlaceholder: 8B 85 / 8B 9D /
// 8B 8D con el desplazamiento a cero y su offset de
// parche en size + 2), y las variables con sus contextos
// por funcion (el mapa de trabajo sembrado de globales
// en cada reinicia_variables, los contextos guardados
// por guarda_contexto para las pasadas de resolucion).
// Todo vive en 24 DynamicArray mas de BackendArena y en
// dos ByteBuffer (codigo y datos), nacidos en
// reinicia_back tras las 18 listas. Las diferencias de
// forma con el oraculo quedan declaradas en el modulo
// ESTADO DE LA MAQUINARIA. Lo que no entra: el prologo y
// el cierre emitidos del marco (son del paseo, B-2), el
// paseo mismo, y el alias de arreglos por nombre con su
// limpieza de nombres por funcion (sharedArrayOffsets,
// sharedArraySizes, functionArrayNames: son de Declare
// de arreglos, B-8).
// Rebanada B-2 (2026-11-21): el esqueleto de generate()
// — las pasadas previas (los Declare globales a DATA y
// la coleccion de textos de StringConst), el paseo con
// FunctionBegin y su cierre de marco, Const,
// StringConst, Declare escalar, Store, Load y Return,
// y el retorno implicito tras el paseo. El programa
// minimo que devuelve un entero ya sale entero. Lo que
// no entra: el runtime de KolibriRuntime con sus
// parches del principal y del event loop (B-9), las
// resoluciones contra dataBase (B-9), el alias de
// arreglos y el Declare de arreglo (B-8) y las ramas
// de los demas opcodes (B-3 a B-9): en el paseo caen
// sin emitir, como en la cadena de if del oraculo
// cuando ninguna rama casa.

enum TemporaryLocationKind
{
    Register,
    Memory
};

// ============================================================
// EL ENUM IROpcode.
//
// La copia identica de la tabla del generador: los 61
// codigos de include/kpp/IR.hpp en su orden exacto (una
// operacion nueva va AL FINAL, nunca en el medio). Es el
// contrato de entrada de esta pieza, como el de salida
// es el de IRGenerator.kpp.
// ============================================================

enum IROpcode
{
    // ESTRUCTURA DEL PROGRAMA
    FunctionBegin,
    FunctionEnd,

    // CONSTANTES
    Const,
    StringConst,

    // VARIABLES Y MEMORIA
    Declare,
    Store,
    Load,
    ArrayLoad,
    ArrayStore,

    // FILE I/O
    FileRead,
    FileWrite,

    // ARITMETICA BASICA
    Add,
    Sub,
    Mul,
    Div,
    Mod,

    // POTENCIAS Y RAICES
    Pow,
    Sqrt,

    // LOGARITMOS Y EXPONENCIALES
    Log,
    Log10,
    Exp,

    // TRIGONOMETRIA
    Sin,
    Cos,
    Tan,
    Cot,
    Sec,
    Csc,

    // TRIGONOMETRIA INVERSA
    Asin,
    Acos,
    Atan,

    // FUNCIONES MATEMATICAS
    Abs,
    Floor,
    Ceil,
    Round,
    Min,
    Max,

    // MATEMATICA AVANZADA
    Factorial,
    Sum,
    Integral,

    // FUNCIONES
    Call,
    Return,

    // SALIDA
    Print,
    PrintInteger,
    PrintFloat,

    // COMPARACIONES
    CompareEqual,
    CompareNotEqual,
    CompareLess,
    CompareLessEqual,
    CompareGreater,
    CompareGreaterEqual,

    // LOGICA
    LogicalAnd,
    LogicalOr,
    LogicalNot,

    // CONTROL DE FLUJO
    Label,
    Jump,
    JumpIfZero,
    JumpIfNotZero,

    // BITS (Ampliacion 4, al final)
    BitwiseAnd,
    BitwiseOr,
    ShiftLeft,
    ShiftRight
};

// ============================================================
// LA BIBLIOTECA ARENA, INCORPORADA.
//
// K++ no tiene includes: un archivo es un programa, y
// las piezas se componen por copia identica, como los
// enum que emisor y consumidor se reparten. Lo que
// sigue es la biblioteca de M-0 (compiler/kpp/runtime/
// Arena.kpp, sellada en campo 108/108) sin su sonda ni
// su main, con tres ajustes de dimension para esta
// pieza, declarados: el bloque B se declara a 32768
// celdas (la reserva de BackendArena que la sonda de
// esta pieza pide; en la biblioteca de M-0 era de
// 1024, dimension de su sonda), el bucle de cero de
// inicia_arena se parte en dos al dejar A y B de medir
// lo mismo, y el comentario de tamanos de inicia_arena
// dice los de esta pieza. Nada mas cambia: ni una
// firma, ni una mecanica.
// ============================================================

// ============================================================
// ESTADO COMPARTIDO.
//
// Los contadores de la biblioteca y los handles de las
// cinco regiones, compartidos por nombre como en las
// demas piezas. El driver guarda en region_source ..
// region_output el handle de cada region al crearla.
// errores_arena es la guarda comun: suma 1 por cada
// operacion que la biblioteca no pudo cumplir, y ninguna
// operacion fallida escribe fuera ni a medias.
// ============================================================

int errores_arena;
int nest;
int prov_nacq;
int region_source;
int region_frontend;
int region_compiler;
int region_backend;
int region_output;

// ============================================================
// INICIA LA BIBLIOTECA.
//
// Pone a cero la contabilidad y los tres bloques, y
// escribe el plan de solape: la region 1 (Source) vive
// en el bloque 0 (A), la 2 (Frontend) en el 1 (B), la 3
// (Compiler) en el 2 (C), la 4 (Backend) en el 1 (B, su
// segunda vida) y la 5 (Output) en el 0 (A, su segunda
// vida). Los tamanos de bloque de esta pieza: A con
// 1024 celdas, B con 32768, C con 512.
// ============================================================

void inicia_arena()
{
    int bloque_a[1024];
    int bloque_b[32768];
    int bloque_c[512];
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int i;
    i = 0;
    while (i < 1024)
    {
        bloque_a[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 32768)
    {
        bloque_b[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 512)
    {
        bloque_c[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 6)
    {
        reg_bloque[i] = 0;
        reg_reserva[i] = 0;
        reg_usado[i] = 0;
        reg_viva[i] = 0;
        plan_bloque[i] = 0;
        i = i + 1;
    }
    plan_bloque[1] = 0;
    plan_bloque[2] = 1;
    plan_bloque[3] = 2;
    plan_bloque[4] = 1;
    plan_bloque[5] = 0;
    tam_bloque[0] = 1024;
    tam_bloque[1] = 32768;
    tam_bloque[2] = 512;
    i = 0;
    while (i < 3)
    {
        bloque_dueno[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 129)
    {
        est_region[i] = 0;
        est_base[i] = 0;
        est_cuenta[i] = 0;
        est_cap[i] = 0;
        est_tipo[i] = 0;
        est_viva[i] = 0;
        i = i + 1;
    }
    errores_arena = 0;
    nest = 0;
    prov_nacq = 0;
    region_source = 0;
    region_frontend = 0;
    region_compiler = 0;
    region_backend = 0;
    region_output = 0;
}

// ============================================================
// MEMORY PROVIDER.
//
// La puerta entre la biblioteca y la memoria fisica.
// En V2 son subrutinas ordinarias: memory_acquire entrega
// el bloque fisico que el plan de solape asigna a la
// siguiente region por nacer (las regiones nacen en
// orden: Source, Frontend, Compiler, Backend, Output) y
// devuelve bloque + 1, o 0 si el bloque no alcanza o
// sigue ocupado por su vida anterior. Nunca un bloque
// invalido, nunca un valor a medias. memory_release
// devuelve el bloque; memory_available da el tamano del
// bloque libre mayor, en celdas.
// ============================================================

int memory_available()
{
    int tam_bloque[3];
    int bloque_dueno[3];
    int m;
    int b;
    m = 0;
    b = 0;
    while (b < 3)
    {
        if (bloque_dueno[b] == 0)
        {
            if (tam_bloque[b] > m)
            {
                m = tam_bloque[b];
            }
        }
        b = b + 1;
    }
    return m;
}

int memory_acquire(int size)
{
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int n;
    int blk;
    n = prov_nacq + 1;
    if (n > 5)
    {
        return 0;
    }
    blk = plan_bloque[n];
    if (size > tam_bloque[blk])
    {
        return 0;
    }
    if (bloque_dueno[blk] != 0)
    {
        return 0;
    }
    bloque_dueno[blk] = n;
    prov_nacq = n;
    return blk + 1;
}

void memory_release(int block)
{
    int bloque_dueno[3];
    bloque_dueno[block - 1] = 0;
}

// ============================================================
// MEMORY MANAGER.
//
// arena_create reserva el bloque inicial de la region y
// devuelve su handle (0 = fallo, acusado en
// errores_arena). El handle de la region es su numero de
// nacimiento: 1 Source, 2 Frontend, 3 Compiler,
// 4 Backend, 5 Output.
// arena_alloc entrega un offset dentro de la region: el
// espacio se entrega por avance (bump) con la alineacion
// pedida en celdas; si no cabe en lo reservado, acusa y
// devuelve -1 sin tocar nada. Ningun offset ya entregado
// cambia jamas de significado.
// arena_reset devuelve la region a vacia sin liberarla:
// es la liberacion por fase, y de paso invalida las
// estructuras que vivian en ella. arena_destroy la
// libera del todo: el bloque vuelve al Provider y la
// region muerta acusa si la llaman (la disciplina del
// mapa contra handles de regiones muertas).
// ============================================================

int region_activa(int arena)
{
    int reg_viva[6];
    int r;
    r = 0;
    if (arena >= 1)
    {
        if (arena <= 5)
        {
            if (reg_viva[arena] == 1)
            {
                r = 1;
            }
        }
    }
    return r;
}

int arena_create(int initial_size)
{
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int b;
    int r;
    if (initial_size < 1)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    b = memory_acquire(initial_size);
    if (b == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    r = prov_nacq;
    reg_bloque[r] = b - 1;
    reg_reserva[r] = initial_size;
    reg_usado[r] = 0;
    reg_viva[r] = 1;
    return r;
}

int arena_alloc(int arena, int size, int alignment)
{
    int reg_reserva[6];
    int reg_usado[6];
    int off;
    int resto;
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (size < 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (alignment < 1)
    {
        alignment = 1;
    }
    off = reg_usado[arena];
    resto = off - (off / alignment) * alignment;
    if (resto != 0)
    {
        off = off + (alignment - resto);
    }
    if (off + size > reg_reserva[arena])
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    reg_usado[arena] = off + size;
    return off;
}

void invalida_estructuras(int arena)
{
    int est_region[129];
    int est_viva[129];
    int e;
    e = 1;
    while (e <= nest)
    {
        if (est_region[e] == arena)
        {
            est_viva[e] = 0;
        }
        e = e + 1;
    }
}

void arena_reset(int arena)
{
    int reg_usado[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
}

void arena_destroy(int arena)
{
    int reg_bloque[6];
    int reg_usado[6];
    int reg_viva[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
    reg_viva[arena] = 0;
    memory_release(reg_bloque[arena] + 1);
}

int arena_get_used(int arena)
{
    int reg_usado[6];
    if (region_activa(arena) == 0)
    {
        return -1;
    }
    return reg_usado[arena];
}

int arena_get_reserved(int arena)
{
    int reg_reserva[6];
    if (region_activa(arena) == 0)
    {
        return -1;
    }
    return reg_reserva[arena];
}

// ============================================================
// ACCESO A CELDAS.
//
// La capa de acceso interna de la via V2: cada bloque es
// un arreglo declarado y estas dos subrutinas son las
// unicas que lo indexan por numero de bloque. Si un dia
// se migra a la via V1, este es el interior que se
// reescribe por peek/poke; la API publica no se entera.
// ============================================================

int celda_get(int bloque, int off)
{
    int bloque_a[1024];
    int bloque_b[32768];
    int bloque_c[512];
    int r;
    r = 0;
    if (bloque == 0)
    {
        r = bloque_a[off];
    }
    else
    {
        if (bloque == 1)
        {
            r = bloque_b[off];
        }
        else
        {
            r = bloque_c[off];
        }
    }
    return r;
}

void celda_set(int bloque, int off, int v)
{
    int bloque_a[1024];
    int bloque_b[32768];
    int bloque_c[512];
    if (bloque == 0)
    {
        bloque_a[off] = v;
    }
    else
    {
        if (bloque == 1)
        {
            bloque_b[off] = v;
        }
        else
        {
            bloque_c[off] = v;
        }
    }
}

// ============================================================
// LA CONTABILIDAD DE ESTRUCTURAS.
//
// DynamicArray, StringPool y ByteBuffer comparten la
// misma contabilidad: por estructura, su region, la base
// (offset de su bloque actual en la region), la cuenta,
// la capacidad, el tipo (1 DynamicArray, 2 StringPool,
// 3 ByteBuffer) y si vive. Los arreglos van indexados por
// el handle de la estructura (1..128); el 0 es el fallo.
// est_crece es el crecimiento geometrico x2, el mismo
// para las tres clases: extension en el sitio si el
// bloque de la estructura es el ultimo asignado de su
// arena; si no, bloque nuevo al doble y copia, y el
// bloque viejo queda como hueco hasta el reset de la
// fase. La base puede cambiar al crecer con copia; los
// handles de los datos no, porque un dato se referencia
// por su indice dentro de la estructura, no por su
// offset en la arena.
// est_agrega es la unica puerta de registro: agrega al
// final y devuelve el indice del elemento, o -1 si la
// arena no pudo crecer (error ya acusado, una sola vez
// por operacion fallida).
// ============================================================

int est_crea(int arena, int tipo, int capini)
{
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int off;
    int e;
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (capini < 1)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (nest >= 128)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    off = arena_alloc(arena, capini, 1);
    if (off < 0)
    {
        return 0;
    }
    nest = nest + 1;
    e = nest;
    est_region[e] = arena;
    est_base[e] = off;
    est_cuenta[e] = 0;
    est_cap[e] = capini;
    est_tipo[e] = tipo;
    est_viva[e] = 1;
    return e;
}

int est_valida(int e, int tipo)
{
    int est_tipo[129];
    int est_viva[129];
    int r;
    r = 0;
    if (e >= 1)
    {
        if (e <= nest)
        {
            if (est_viva[e] == 1)
            {
                if (tipo == 0)
                {
                    r = 1;
                }
                else
                {
                    if (est_tipo[e] == tipo)
                    {
                        r = 1;
                    }
                }
            }
        }
    }
    return r;
}

int est_crece(int e)
{
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int region;
    int base;
    int cap;
    int nuevacap;
    int off;
    int blk;
    int i;
    region = est_region[e];
    base = est_base[e];
    cap = est_cap[e];
    nuevacap = cap * 2;
    if (base + cap == reg_usado[region])
    {
        if (reg_usado[region] + (nuevacap - cap) <= reg_reserva[region])
        {
            reg_usado[region] = reg_usado[region] + (nuevacap - cap);
            est_cap[e] = nuevacap;
            return 1;
        }
        errores_arena = errores_arena + 1;
        return 0;
    }
    off = arena_alloc(region, nuevacap, 1);
    if (off < 0)
    {
        return 0;
    }
    blk = reg_bloque[region];
    i = 0;
    while (i < est_cuenta[e])
    {
        celda_set(blk, off + i, celda_get(blk, base + i));
        i = i + 1;
    }
    est_base[e] = off;
    est_cap[e] = nuevacap;
    return 1;
}

int est_agrega(int e, int v)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int idx;
    if (est_valida(e, 0) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (est_cuenta[e] == est_cap[e])
    {
        if (est_crece(e) == 0)
        {
            return -1;
        }
    }
    idx = est_cuenta[e];
    celda_set(reg_bloque[est_region[e]], est_base[e] + idx, v);
    est_cuenta[e] = idx + 1;
    return idx;
}

// ============================================================
// DYNAMICARRAY.
//
// da_create nace con la capacidad inicial pedida (en
// elementos) y devuelve el handle del arreglo (0 = fallo
// acusado). da_add agrega al final creciendo como manda
// est_crece y devuelve el indice del elemento o -1.
// da_get / da_set leen y escriben por indice, con el
// intervalo validado antes de tocar memoria: fuera de la
// cuenta, acusan y no tocan nada. da_count, da_capacity
// y da_base consultan la contabilidad (valen para las
// tres clases de estructura); handle invalido da -1.
// ============================================================

int da_create(int arena, int initial_capacity)
{
    return est_crea(arena, 1, initial_capacity);
}

int da_add(int arr, int value)
{
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(arr, value);
}

int da_get(int arr, int index)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (index < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (index >= est_cuenta[arr])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[arr]], est_base[arr] + index);
}

void da_set(int arr, int index, int value)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (index < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (index >= est_cuenta[arr])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[arr]], est_base[arr] + index, value);
}

int da_count(int arr)
{
    int est_cuenta[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[arr];
}

int da_capacity(int arr)
{
    int est_cap[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_cap[arr];
}

int da_base(int arr)
{
    int est_base[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_base[arr];
}

// ============================================================
// STRINGPOOL.
//
// La piscina dinamica: un buffer de caracteres que crece
// en la region pedida. string_pool_add_char agrega un
// caracter (guardado como byte, 0..255) y devuelve su
// offset dentro de la piscina: ese offset es el ini de
// las referencias. El formato de la referencia no
// cambia: ini * 128 + largo, el de la piscina de hoy;
// string_pool_len desempaqueta el largo y
// string_pool_get_char lee el caracter ini + i. Los
// handles son offsets: estables hasta la muerte de la
// region, crezca lo que crezca la piscina.
// ============================================================

int string_pool_create(int arena)
{
    return est_crea(arena, 2, 4);
}

int string_pool_add_char(int pool, int ch)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(pool, ch & 255);
}

int string_pool_get_char(int pool, int ini, int i)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int idx;
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    idx = ini + i;
    if (idx < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (idx >= est_cuenta[pool])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[pool]], est_base[pool] + idx);
}

int string_pool_len(int pool, int ref)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return ref - (ref / 128) * 128;
}

// ============================================================
// BYTEBUFFER.
//
// El buffer de bytes que crece: el codigo del Emitter y
// la imagen de los Writers. Una celda por byte, como
// hoy, y cada byte guardado en 0..255.
// bytebuffer_append agrega un byte al final y devuelve
// su offset — la semantica de los placeholders del
// Emitter, que ya devuelven el offset de su hueco.
// bytebuffer_patch escribe en un offset ya entregado y
// dentro de la cuenta: es el patch32 / patchRel32 de hoy
// sin guarda de 256. bytebuffer_write copia count bytes
// desde otro ByteBuffer (desde su src_offset) y los
// agrega al final de este: lo que los Writers hacen al
// ensamblar cabecera + codigo + datos; el intervalo de
// origen se valida entero antes de copiar, asi que una
// copia invalida acusa y no escribe nada.
// bytebuffer_get lee un byte por offset, validado.
// ============================================================

int bytebuffer_create(int arena)
{
    return est_crea(arena, 3, 8);
}

int bytebuffer_append(int bb, int byte)
{
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(bb, byte & 255);
}

void bytebuffer_patch(int bb, int offset, int byte)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[bb]], est_base[bb] + offset, byte & 255);
}

void bytebuffer_write(int bb, int src, int src_offset, int count)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int blk;
    int i;
    int v;
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (est_valida(src, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (src_offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (count < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (src_offset + count > est_cuenta[src])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    blk = reg_bloque[est_region[src]];
    i = 0;
    while (i < count)
    {
        v = celda_get(blk, est_base[src] + src_offset + i);
        if (est_agrega(bb, v) < 0)
        {
            return;
        }
        i = i + 1;
    }
}

int bytebuffer_get(int bb, int offset)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[bb]], est_base[bb] + offset);
}

int bytebuffer_get_size(int bb)
{
    int est_cuenta[129];
    if (est_valida(bb, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[bb];
}


// ============================================================
// ESTADO COMPARTIDO.
//
// Los escalares compartidos de la pieza: los contadores
// de las tablas de entrada (nir instrucciones, pool_len
// caracteres en la piscina), la cuenta del codigo (ncod),
// el contador de errores de la pieza (errores_back: suma
// 1 por cada registro que la arena no pudo cumplir) y el
// contador de cada una de las siete listas (nvl, nvs,
// nsp, nrl, nsc, ncf, nfc). Debajo, los handles de los
// 18 DynamicArray de las listas (d + lista + campo): los
// crea reinicia_back dentro de BackendArena y los
// registra_* agregan por ellos. Son 18 y no 21 porque
// tres listas (StringConst, ControlFlow, FunctionCall)
// tienen dos campos en los structs de X86Backend.hpp,
// no tres. Las tablas de entrada y el codigo se declaran
// dentro de reinicia_back, como en B-0: son el andamiaje
// que las rebanadas siguientes consumiran por handle.
// ============================================================

int nir;
int pool_len;
int ncod;
int errores_back;
int nvl;
int nvs;
int nsp;
int nrl;
int nsc;
int ncf;
int nfc;
int dvl_fun;
int dvl_nom;
int dvl_pos;
int dvs_fun;
int dvs_nom;
int dvs_pos;
int dsp_tmp;
int dsp_pos;
int dsp_dat;
int drl_tmp;
int drl_pos;
int drl_dat;
int dsc_pos;
int dsc_idx;
int dcf_etiq;
int dcf_pos;
int dfc_fun;
int dfc_pos;

// ============================================================
// ESTADO DE LA MAQUINARIA.
//
//
// Los contadores y handles de la rebanada B-1. Las
// tablas de temporales (nombre, clase, registro,
// desplazamiento), de constantes de temporales (nombre,
// valor), de variables del contexto vivo y de globales
// (nombre, offset en DATA, si es de pila, offset de
// pila, capacidad), el directorio de contextos
// guardados (funcion, fila inicial, filas) y las filas
// guardadas: 24 DynamicArray de BackendArena nacidos a
// 256 en reinicia_back, tras las listas. El codigo que
// la maquinaria emite (guardados de derrame y retenes
// de recarga) va al ByteBuffer dcod y la reserva de
// datos de allocateVariableData al ByteBuffer ddat;
// ambos nacen a 8, como manda bytebuffer_create.
// La clase del temporal es el enum de la cabecera:
// 0 = Register, 1 = Memory; el registro es el codigo
// fisico (EAX = 0, EBX = 3) y el desplazamiento de
// memoria es la ranura del marco (-4, -8, ...).
// El estado del marco: frame_activo y frame_slots, los
// miembros frameActive y frameSlots del oraculo.
// Convenciones de la pieza frente al oraculo, declaradas:
// - Donde Stage 0 lanza (throw), la pieza acusa en
//   errores_back y devuelve un centinela (-1 o 0, que
//   nunca son valores validos en esos puestos), sin
//   escribir nada mas; la ranura quemada por un derrame
//   de registro no soportado si se consume, como alli.
// - Borrar un temporal o una constante es el erase del
//   mapa: la ultima fila ocupa el hueco (swap), porque
//   el oraculo guarda mapas sin orden y la pieza filas
//   con orden; el unico lector sensible al orden,
//   temporaryInRegister, pregunta por un registro que
//   por construccion tiene un solo dueno.
// - Un contexto guardado dos veces vale por el ultimo:
//   contexto_de busca desde el final del directorio,
//   como la asignacion del mapa del oraculo.
// - abre_marco y cierra_marco transcriben solo la mitad
//   de estado de FunctionBegin y de
//   finishCurrentFunctionFrame (marco activo, ranuras a
//   cero); la mitad emitida (prologo, SUB ESP con su
//   reten, parche del tamano) es del paseo, B-2.
// - anota_const transcribe la escritura en linea de
//   generate() sobre temporaryConstants; declara_var_
//   pila transcribe su escritura en linea de la local de
//   pila (isStackLocal) en Declare.
// ============================================================

int ntmp;
int ncon;
int nvar;
int nglo;
int nctx;
int nsv;
int frame_activo;
int frame_slots;
int dtmp_nom;
int dtmp_kind;
int dtmp_reg;
int dtmp_off;
int dcon_nom;
int dcon_val;
int dvar_nom;
int dvar_dat;
int dvar_stack;
int dvar_soff;
int dvar_cap;
int dglo_nom;
int dglo_dat;
int dglo_stack;
int dglo_soff;
int dglo_cap;
int dctx_fun;
int dctx_ini;
int dctx_n;
int dsv_nom;
int dsv_dat;
int dsv_stack;
int dsv_soff;
int dsv_cap;
int dcod;
int ddat;
int dir_op;
int dir_nom;
int dir_ope;
int dir_res;
int dir_val;
int dpool;
int ndir;
int dir_nglob;
int dent_fun;
int dent_pos;
int dret_pos;
int dtextos_nom;
int ndent;
int nret;
int ntextos;
int fun_actual;
int pos_marco;
int pos_main;
int idx_sc;

// ============================================================
// REINICIA EL BACKEND.
//
// Pone a cero el andamiaje (el codigo y las tablas de
// entrada del generador: seis arreglos paralelos — iop,
// inombre, ioperando, iresultado, iaux, ivalor — y la
// piscina de texto pool, donde el nombre, el operando,
// el resultado y el auxiliary de cada instruccion son
// referencias ini * 128 + largo) y crea las estructuras
// de las siete listas: 18 DynamicArray en BackendArena,
// nacidos a 256 elementos — el 256 de la norma vieja
// como capacidad inicial, ya no como techo: crecen por
// la geometria de la biblioteca. El llamador crea
// BackendArena antes (region_backend) y los handles
// quedan en los escalares compartidos. La rebanada B-1
// agrega al final los nacimientos de la maquinaria:
// las 24 tablas del modulo ESTADO DE LA MAQUINARIA y
// los dos ByteBuffer, codigo y datos.
// ============================================================

void reinicia_back()
{
    int codigo[256];
    int iop[256];
    int inombre[256];
    int ioperando[256];
    int iresultado[256];
    int iaux[256];
    int ivalor[256];
    int pool[256];
    int i;
    i = 0;
    while (i < 256)
    {
        codigo[i] = 0;
        iop[i] = 0;
        inombre[i] = 0;
        ioperando[i] = 0;
        iresultado[i] = 0;
        iaux[i] = 0;
        ivalor[i] = 0;
        pool[i] = 0;
        i = i + 1;
    }
    nir = 0;
    pool_len = 0;
    ncod = 0;
    errores_back = 0;
    nvl = 0;
    nvs = 0;
    nsp = 0;
    nrl = 0;
    nsc = 0;
    ncf = 0;
    nfc = 0;
    ntmp = 0;
    ncon = 0;
    nvar = 0;
    nglo = 0;
    nctx = 0;
    nsv = 0;
    frame_activo = 0;
    frame_slots = 0;
    dvl_fun = da_create(region_backend, 256);
    dvl_nom = da_create(region_backend, 256);
    dvl_pos = da_create(region_backend, 256);
    dvs_fun = da_create(region_backend, 256);
    dvs_nom = da_create(region_backend, 256);
    dvs_pos = da_create(region_backend, 256);
    dsp_tmp = da_create(region_backend, 256);
    dsp_pos = da_create(region_backend, 256);
    dsp_dat = da_create(region_backend, 256);
    drl_tmp = da_create(region_backend, 256);
    drl_pos = da_create(region_backend, 256);
    drl_dat = da_create(region_backend, 256);
    dsc_pos = da_create(region_backend, 256);
    dsc_idx = da_create(region_backend, 256);
    dcf_etiq = da_create(region_backend, 256);
    dcf_pos = da_create(region_backend, 256);
    dfc_fun = da_create(region_backend, 256);
    dfc_pos = da_create(region_backend, 256);
    dtmp_nom = da_create(region_backend, 256);
    dtmp_kind = da_create(region_backend, 256);
    dtmp_reg = da_create(region_backend, 256);
    dtmp_off = da_create(region_backend, 256);
    dcon_nom = da_create(region_backend, 256);
    dcon_val = da_create(region_backend, 256);
    dvar_nom = da_create(region_backend, 256);
    dvar_dat = da_create(region_backend, 256);
    dvar_stack = da_create(region_backend, 256);
    dvar_soff = da_create(region_backend, 256);
    dvar_cap = da_create(region_backend, 256);
    dglo_nom = da_create(region_backend, 256);
    dglo_dat = da_create(region_backend, 256);
    dglo_stack = da_create(region_backend, 256);
    dglo_soff = da_create(region_backend, 256);
    dglo_cap = da_create(region_backend, 256);
    dctx_fun = da_create(region_backend, 256);
    dctx_ini = da_create(region_backend, 256);
    dctx_n = da_create(region_backend, 256);
    dsv_nom = da_create(region_backend, 256);
    dsv_dat = da_create(region_backend, 256);
    dsv_stack = da_create(region_backend, 256);
    dsv_soff = da_create(region_backend, 256);
    dsv_cap = da_create(region_backend, 256);
    dcod = bytebuffer_create(region_backend);
    ddat = bytebuffer_create(region_backend);
}

// ============================================================
// REGISTRO DE LAS SIETE LISTAS.
//
// Una funcion por lista, con la misma disciplina: el
// primer campo hace de guarda — si su da_add devuelve
// -1, la arena no pudo crecer: la funcion acusa en
// errores_back (la biblioteca ya acuso en
// errores_arena) y no escribe nada mas. Los campos
// paralelos comparten la cuenta del primero porque
// nacen con la misma capacidad y crecen a la par. Los
// campos de texto de Stage 0 (functionName, name,
// temporary, label) viajan como referencias a la
// piscina: un entero por campo. El orden de los campos
// es el de los structs de X86Backend.hpp.
// ============================================================

// VariableLoadPatch: funcion, nombre, offset del hueco.
void registra_vl(int fun, int nom, int pos)
{
    int r;
    r = da_add(dvl_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dvl_nom, nom);
    r = da_add(dvl_pos, pos);
    nvl = nvl + 1;
}

// VariableStorePatch: funcion, nombre, offset del hueco.
void registra_vs(int fun, int nom, int pos)
{
    int r;
    r = da_add(dvs_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dvs_nom, nom);
    r = da_add(dvs_pos, pos);
    nvs = nvs + 1;
}

// TemporarySpillPatch: temporal, offset del hueco,
// offset de datos (el slot, firmado).
void registra_spill(int tmp, int pos, int dat)
{
    int r;
    r = da_add(dsp_tmp, tmp);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dsp_pos, pos);
    r = da_add(dsp_dat, dat);
    nsp = nsp + 1;
}

// TemporaryReloadPatch: temporal, offset del hueco,
// offset de datos (el slot, firmado).
void registra_reload(int tmp, int pos, int dat)
{
    int r;
    r = da_add(drl_tmp, tmp);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(drl_pos, pos);
    r = da_add(drl_dat, dat);
    nrl = nrl + 1;
}

// StringConstPatch: offset del hueco, indice de la
// cadena en la piscina.
void registra_sc(int pos, int idx)
{
    int r;
    r = da_add(dsc_pos, pos);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dsc_idx, idx);
    nsc = nsc + 1;
}

// ControlFlowPatch: etiqueta, offset del hueco.
void registra_cf(int etiq, int pos)
{
    int r;
    r = da_add(dcf_etiq, etiq);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dcf_pos, pos);
    ncf = ncf + 1;
}

// FunctionCallPatch: funcion, offset del hueco.
void registra_fc(int fun, int pos)
{
    int r;
    r = da_add(dfc_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dfc_pos, pos);
    nfc = nfc + 1;
}

// ============================================================
// IMPRIME LAS LISTAS.
//
// Por lista, el contador y despues los campos de cada
// entrada en orden, leidos con da_get; al final, el
// contador de errores de la pieza. La lectura de campo
// se coteja numero a numero contra el puerto
// independiente.
// ============================================================

void imprime_listas()
{
    int i;
    print_int(nvl);
    i = 0;
    while (i < nvl)
    {
        print_int(da_get(dvl_fun, i));
        print_int(da_get(dvl_nom, i));
        print_int(da_get(dvl_pos, i));
        i = i + 1;
    }
    print_int(nvs);
    i = 0;
    while (i < nvs)
    {
        print_int(da_get(dvs_fun, i));
        print_int(da_get(dvs_nom, i));
        print_int(da_get(dvs_pos, i));
        i = i + 1;
    }
    print_int(nsp);
    i = 0;
    while (i < nsp)
    {
        print_int(da_get(dsp_tmp, i));
        print_int(da_get(dsp_pos, i));
        print_int(da_get(dsp_dat, i));
        i = i + 1;
    }
    print_int(nrl);
    i = 0;
    while (i < nrl)
    {
        print_int(da_get(drl_tmp, i));
        print_int(da_get(drl_pos, i));
        print_int(da_get(drl_dat, i));
        i = i + 1;
    }
    print_int(nsc);
    i = 0;
    while (i < nsc)
    {
        print_int(da_get(dsc_pos, i));
        print_int(da_get(dsc_idx, i));
        i = i + 1;
    }
    print_int(ncf);
    i = 0;
    while (i < ncf)
    {
        print_int(da_get(dcf_etiq, i));
        print_int(da_get(dcf_pos, i));
        i = i + 1;
    }
    print_int(nfc);
    i = 0;
    while (i < nfc)
    {
        print_int(da_get(dfc_fun, i));
        print_int(da_get(dfc_pos, i));
        i = i + 1;
    }
    print_int(errores_back);
}

// ============================================================
// TEMPORALES.
//
//
// El mapa de temporales y su asignador, transcritos de
// X86Backend.cpp. busca_tmp da la fila por nombre o -1.
// inserta_tmp escribe una fila con la disciplina de la
// casa: si la fila ya existe fisicamente la reescribe
// con da_set; si es nueva entra por da_add con el nombre
// de guarda. liga_tmp liga o actualiza (la actualizacion
// a registro pone el desplazamiento a cero y la de
// memoria el registro a cero, como la inicializacion
// por agregado del oraculo). libera_tmp es el erase:
// la ultima fila ocupa el hueco, y la constante del
// temporal se borra con el, como en freeTemporary.
// tmp_en_registro devuelve el nombre del dueno de un
// registro o -1. reinicia_temporales pone las cuentas
// a cero: las filas quedan para reuso.
// ============================================================

int busca_tmp(int nom)
{
    int i;
    i = 0;
    while (i < ntmp)
    {
        if (da_get(dtmp_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int inserta_tmp(int fila, int nom, int kind, int reg, int off)
{
    int r;
    if (fila < da_count(dtmp_nom))
    {
        da_set(dtmp_nom, fila, nom);
        da_set(dtmp_kind, fila, kind);
        da_set(dtmp_reg, fila, reg);
        da_set(dtmp_off, fila, off);
        return 1;
    }
    r = da_add(dtmp_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dtmp_kind, kind);
    r = da_add(dtmp_reg, reg);
    r = da_add(dtmp_off, off);
    return 1;
}

void liga_tmp(int nom, int kind, int reg, int off)
{
    int f;
    int nueva;
    f = busca_tmp(nom);
    nueva = 0;
    if (f < 0)
    {
        f = ntmp;
        nueva = 1;
    }
    if (inserta_tmp(f, nom, kind, reg, off) == 1)
    {
        if (nueva == 1)
        {
            ntmp = ntmp + 1;
        }
    }
}

void liga_tmp_eax(int nom)
{
    liga_tmp(nom, 0, 0, 0);
}

void liga_tmp_ebx(int nom)
{
    liga_tmp(nom, 0, 3, 0);
}

void liga_tmp_mem(int nom, int off)
{
    liga_tmp(nom, 1, 0, off);
}

int busca_const_fila(int nom)
{
    int i;
    i = 0;
    while (i < ncon)
    {
        if (da_get(dcon_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int busca_const(int nom)
{
    int f;
    f = busca_const_fila(nom);
    if (f < 0)
    {
        return -1;
    }
    return da_get(dcon_val, f);
}

int inserta_con(int fila, int nom, int val)
{
    int r;
    if (fila < da_count(dcon_nom))
    {
        da_set(dcon_nom, fila, nom);
        da_set(dcon_val, fila, val);
        return 1;
    }
    r = da_add(dcon_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dcon_val, val);
    return 1;
}

void anota_const(int nom, int val)
{
    int f;
    int nueva;
    f = busca_const_fila(nom);
    nueva = 0;
    if (f < 0)
    {
        f = ncon;
        nueva = 1;
    }
    if (inserta_con(f, nom, val) == 1)
    {
        if (nueva == 1)
        {
            ncon = ncon + 1;
        }
    }
}

void libera_tmp(int nom)
{
    int f;
    int u;
    int c;
    f = busca_tmp(nom);
    if (f >= 0)
    {
        u = ntmp - 1;
        if (f != u)
        {
            da_set(dtmp_nom, f, da_get(dtmp_nom, u));
            da_set(dtmp_kind, f, da_get(dtmp_kind, u));
            da_set(dtmp_reg, f, da_get(dtmp_reg, u));
            da_set(dtmp_off, f, da_get(dtmp_off, u));
        }
        ntmp = ntmp - 1;
    }
    c = busca_const_fila(nom);
    if (c >= 0)
    {
        u = ncon - 1;
        if (c != u)
        {
            da_set(dcon_nom, c, da_get(dcon_nom, u));
            da_set(dcon_val, c, da_get(dcon_val, u));
        }
        ncon = ncon - 1;
    }
}

int tmp_en_registro(int cod)
{
    int i;
    i = 0;
    while (i < ntmp)
    {
        if (da_get(dtmp_kind, i) == 0)
        {
            if (da_get(dtmp_reg, i) == cod)
            {
                return da_get(dtmp_nom, i);
            }
        }
        i = i + 1;
    }
    return -1;
}

int eax_ocupado()
{
    if (tmp_en_registro(0) >= 0)
    {
        return 1;
    }
    return 0;
}

int ebx_ocupado()
{
    if (tmp_en_registro(3) >= 0)
    {
        return 1;
    }
    return 0;
}

void reinicia_temporales()
{
    ntmp = 0;
    ncon = 0;
}

// ============================================================
// MARCO Y RETENES.
//
//
// El marco EBP de la funcion en curso. abre_marco y
// cierra_marco fijan solo el estado (la emision del
// prologo y del cierre es de B-2). ranura_marco es
// allocateFrameSlot: sin marco activo acusa y devuelve
// 0; con marco, entrega -4, -8, -12... en orden, y la
// misma ranura sirve a los derrames y a las locales de
// pila. Los tres retenes son los emitMov*FramePlace-
// holder del oraculo: sin marco acusan y devuelven -1;
// con marco emiten MOV registro, [EBP + 0] (8B 85 para
// EAX, 8B 9D para EBX, 8B 8D para ECX, con el desplaza-
// miento de 32 bits a cero) en el ByteBuffer de codigo
// y devuelven el offset del hueco, size + 2.
// ============================================================

void abre_marco()
{
    frame_activo = 1;
    frame_slots = 0;
}

void cierra_marco()
{
    frame_activo = 0;
}

int ranura_marco()
{
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    frame_slots = frame_slots + 1;
    return 0 - (4 * frame_slots);
}

int emite_reten_eax()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x85);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}

int emite_reten_ebx()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x9D);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}

int emite_reten_ecx()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x8D);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}

// ============================================================
// DERRAME Y RECARGA.
//
//
// derrama_tmp es spillTemporary: el temporal debe
// existir y vivir en registro; pide su ranura al marco,
// emite MOV [EBP + 0], registro (89 85 si es EAX,
// 89 9D si es EBX) en el ByteBuffer de codigo, registra
// el parche en la lista de derrames de M-1 con el offset
// del hueco (size + 2 antes de emitir) y liga el
// temporal a memoria. Un registro que no sea EAX ni EBX
// acusa despues de consumir la ranura, como el throw
// del oraculo. asigna_registro es allocateRegisterFor-
// Temporary con su politica exacta: si el temporal ya
// vive en registro devuelve el suyo; si EAX esta libre
// lo liga a EAX; si EBX esta libre, a EBX; si no,
// derrama el dueno de EAX y liga a EAX (la rama de
// derramar EBX del oraculo es inalcanzable: si ambos
// estan ocupados, el de EAX siempre existe).
// registro_de es getTemporaryRegister y recarga_tmp es
// reloadTemporary: emite el reten de EAX, registra el
// parche en la lista de recargas y liga el temporal a
// EAX sin desalojar a nadie, como el oraculo.
// ============================================================

void derrama_tmp(int nom)
{
    int f;
    int reg;
    int off;
    int pos;
    f = busca_tmp(nom);
    if (f < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    if (da_get(dtmp_kind, f) != 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    reg = da_get(dtmp_reg, f);
    off = ranura_marco();
    if (off == 0)
    {
        return;
    }
    pos = 0;
    if (reg == 0)
    {
        pos = bytebuffer_get_size(dcod) + 2;
        bytebuffer_append(dcod, 0x89);
        bytebuffer_append(dcod, 0x85);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
    }
    else
    {
        if (reg == 3)
        {
            pos = bytebuffer_get_size(dcod) + 2;
            bytebuffer_append(dcod, 0x89);
            bytebuffer_append(dcod, 0x9D);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
        }
        else
        {
            errores_back = errores_back + 1;
            return;
        }
    }
    registra_spill(nom, pos, off);
    liga_tmp_mem(nom, off);
}

int asigna_registro(int nom)
{
    int f;
    int ocupante;
    f = busca_tmp(nom);
    if (f >= 0)
    {
        if (da_get(dtmp_kind, f) == 0)
        {
            return da_get(dtmp_reg, f);
        }
    }
    if (eax_ocupado() == 0)
    {
        liga_tmp_eax(nom);
        return 0;
    }
    if (ebx_ocupado() == 0)
    {
        liga_tmp_ebx(nom);
        return 3;
    }
    ocupante = tmp_en_registro(0);
    derrama_tmp(ocupante);
    liga_tmp_eax(nom);
    return 0;
}

int registro_de(int nom)
{
    int f;
    f = busca_tmp(nom);
    if (f < 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    if (da_get(dtmp_kind, f) != 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    return da_get(dtmp_reg, f);
}

void recarga_tmp(int nom)
{
    int f;
    int off;
    int pos;
    f = busca_tmp(nom);
    if (f < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    if (da_get(dtmp_kind, f) != 1)
    {
        errores_back = errores_back + 1;
        return;
    }
    off = da_get(dtmp_off, f);
    pos = emite_reten_eax();
    if (pos < 0)
    {
        return;
    }
    registra_reload(nom, pos, off);
    liga_tmp_eax(nom);
}

// ============================================================
// VARIABLES Y CONTEXTOS.
//
//
// El mapa de variables del contexto vivo, el de
// globales y los contextos guardados por funcion.
// declara_var es declareVariable (residencia en DATA,
// con capacidad si es arreglo); declara_var_pila
// transcribe la escritura de la local de pila;
// declara_global registra en el mapa de globales.
// reinicia_variables es resetVariables: vacia el
// contexto vivo y lo siembra con los globales, que se
// ven en todas las funciones. reserva_datos es
// allocateVariableData: devuelve el offset actual del
// ByteBuffer de datos y lo crece en 4 * n ceros.
// guarda_contexto copia las filas del contexto vivo a
// las filas guardadas y anota el directorio (funcion,
// fila inicial, filas); contexto_de devuelve la entrada
// mas reciente de una funcion o -1. Los contextos los
// leeran las pasadas de resolucion de B-2 en adelante.
// ============================================================

int busca_var(int nom)
{
    int i;
    i = 0;
    while (i < nvar)
    {
        if (da_get(dvar_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int inserta_var(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dvar_nom))
    {
        da_set(dvar_nom, fila, nom);
        da_set(dvar_dat, fila, dat);
        da_set(dvar_stack, fila, stack);
        da_set(dvar_soff, fila, soff);
        da_set(dvar_cap, fila, cap);
        return 1;
    }
    r = da_add(dvar_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dvar_dat, dat);
    r = da_add(dvar_stack, stack);
    r = da_add(dvar_soff, soff);
    r = da_add(dvar_cap, cap);
    return 1;
}

void declara_var(int nom, int dat, int cap)
{
    int f;
    int nueva;
    f = busca_var(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nvar;
        nueva = 1;
    }
    if (inserta_var(f, nom, dat, 0, 0, cap) == 1)
    {
        if (nueva == 1)
        {
            nvar = nvar + 1;
        }
    }
}

void declara_var_pila(int nom, int soff, int cap)
{
    int f;
    int nueva;
    f = busca_var(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nvar;
        nueva = 1;
    }
    if (inserta_var(f, nom, 0, 1, soff, cap) == 1)
    {
        if (nueva == 1)
        {
            nvar = nvar + 1;
        }
    }
}

int busca_glo(int nom)
{
    int i;
    i = 0;
    while (i < nglo)
    {
        if (da_get(dglo_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int inserta_glo(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dglo_nom))
    {
        da_set(dglo_nom, fila, nom);
        da_set(dglo_dat, fila, dat);
        da_set(dglo_stack, fila, stack);
        da_set(dglo_soff, fila, soff);
        da_set(dglo_cap, fila, cap);
        return 1;
    }
    r = da_add(dglo_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dglo_dat, dat);
    r = da_add(dglo_stack, stack);
    r = da_add(dglo_soff, soff);
    r = da_add(dglo_cap, cap);
    return 1;
}

void declara_global(int nom, int dat, int cap)
{
    int f;
    int nueva;
    f = busca_glo(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nglo;
        nueva = 1;
    }
    if (inserta_glo(f, nom, dat, 0, 0, cap) == 1)
    {
        if (nueva == 1)
        {
            nglo = nglo + 1;
        }
    }
}

void reinicia_variables()
{
    int i;
    nvar = 0;
    i = 0;
    while (i < nglo)
    {
        if (inserta_var(i, da_get(dglo_nom, i), da_get(dglo_dat, i), da_get(dglo_stack, i), da_get(dglo_soff, i), da_get(dglo_cap, i)) == 1)
        {
            nvar = nvar + 1;
        }
        i = i + 1;
    }
}

int reserva_datos(int n)
{
    int off;
    int i;
    off = bytebuffer_get_size(ddat);
    i = 0;
    while (i < 4 * n)
    {
        bytebuffer_append(ddat, 0);
        i = i + 1;
    }
    return off;
}

int inserta_sv(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dsv_nom))
    {
        da_set(dsv_nom, fila, nom);
        da_set(dsv_dat, fila, dat);
        da_set(dsv_stack, fila, stack);
        da_set(dsv_soff, fila, soff);
        da_set(dsv_cap, fila, cap);
        return 1;
    }
    r = da_add(dsv_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dsv_dat, dat);
    r = da_add(dsv_stack, stack);
    r = da_add(dsv_soff, soff);
    r = da_add(dsv_cap, cap);
    return 1;
}

int inserta_ctx(int fila, int fun, int ini, int n)
{
    int r;
    if (fila < da_count(dctx_fun))
    {
        da_set(dctx_fun, fila, fun);
        da_set(dctx_ini, fila, ini);
        da_set(dctx_n, fila, n);
        return 1;
    }
    r = da_add(dctx_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dctx_ini, ini);
    r = da_add(dctx_n, n);
    return 1;
}

void guarda_contexto(int fun)
{
    int i;
    int ini;
    ini = nsv;
    i = 0;
    while (i < nvar)
    {
        if (inserta_sv(nsv, da_get(dvar_nom, i), da_get(dvar_dat, i), da_get(dvar_stack, i), da_get(dvar_soff, i), da_get(dvar_cap, i)) == 0)
        {
            return;
        }
        nsv = nsv + 1;
        i = i + 1;
    }
    if (inserta_ctx(nctx, fun, ini, nvar) == 1)
    {
        nctx = nctx + 1;
    }
}

int contexto_de(int fun)
{
    int i;
    i = nctx - 1;
    while (i >= 0)
    {
        if (da_get(dctx_fun, i) == fun)
        {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

// ============================================================
// IMPRIME LA MAQUINARIA.
//
//
// El volcado de la sonda B-1: el estado del marco, las
// filas de temporales y de constantes, las del contexto
// vivo y las de globales, el directorio de contextos y
// las filas guardadas, el ByteBuffer de codigo entero
// (su cuenta y cada byte) y la cuenta del de datos, y
// al final el contador de errores de la pieza. volcado
// junta las listas de M-1 y la maquinaria.
// ============================================================

void imprime_maquinaria()
{
    int i;
    print_int(frame_activo);
    print_int(frame_slots);
    print_int(ntmp);
    i = 0;
    while (i < ntmp)
    {
        print_int(da_get(dtmp_nom, i));
        print_int(da_get(dtmp_kind, i));
        print_int(da_get(dtmp_reg, i));
        print_int(da_get(dtmp_off, i));
        i = i + 1;
    }
    print_int(ncon);
    i = 0;
    while (i < ncon)
    {
        print_int(da_get(dcon_nom, i));
        print_int(da_get(dcon_val, i));
        i = i + 1;
    }
    print_int(nvar);
    i = 0;
    while (i < nvar)
    {
        print_int(da_get(dvar_nom, i));
        print_int(da_get(dvar_dat, i));
        print_int(da_get(dvar_stack, i));
        print_int(da_get(dvar_soff, i));
        print_int(da_get(dvar_cap, i));
        i = i + 1;
    }
    print_int(nglo);
    i = 0;
    while (i < nglo)
    {
        print_int(da_get(dglo_nom, i));
        print_int(da_get(dglo_dat, i));
        print_int(da_get(dglo_stack, i));
        print_int(da_get(dglo_soff, i));
        print_int(da_get(dglo_cap, i));
        i = i + 1;
    }
    print_int(nctx);
    i = 0;
    while (i < nctx)
    {
        print_int(da_get(dctx_fun, i));
        print_int(da_get(dctx_ini, i));
        print_int(da_get(dctx_n, i));
        i = i + 1;
    }
    print_int(nsv);
    i = 0;
    while (i < nsv)
    {
        print_int(da_get(dsv_nom, i));
        print_int(da_get(dsv_dat, i));
        print_int(da_get(dsv_stack, i));
        print_int(da_get(dsv_soff, i));
        print_int(da_get(dsv_cap, i));
        i = i + 1;
    }
    print_int(bytebuffer_get_size(dcod));
    i = 0;
    while (i < bytebuffer_get_size(dcod))
    {
        print_int(bytebuffer_get(dcod, i));
        i = i + 1;
    }
    print_int(bytebuffer_get_size(ddat));
    print_int(errores_back);
}

void volcado()
{
    imprime_listas();
    imprime_maquinaria();
}


// ============================================================
// ENTRADA IR.
//
// El programa que consume generate(): una lista plana
// de instrucciones (opcode, nombre, operando,
// resultado, valor) con los Declare globales al frente
// — dir_nglob marca cuantos son. registra_ir es la
// unica puerta de entrada, con la disciplina de
// insercion y reuso de la casa. Los textos viven en
// dpool y se referencian ini * 128 + largo, el formato
// de la piscina de la biblioteca; quien produce el IR
// interna los nombres (una sola referencia por texto),
// y el operando de parametros de un FunctionBegin se
// construye de modo que la referencia de cada
// parametro es la de su subcadena dentro del operando,
// que es la que el parseo de genera() devuelve. Este
// es el arnes de entrada de la pieza sola: en el
// compilador ensamblado el IR llega por el mango del
// generador (M-6).
// ============================================================

void reinicia_ir()
{
    dir_op = da_create(region_backend, 256);
    dir_nom = da_create(region_backend, 256);
    dir_ope = da_create(region_backend, 256);
    dir_res = da_create(region_backend, 256);
    dir_val = da_create(region_backend, 256);
    dpool = string_pool_create(region_backend);
    ndir = 0;
    dir_nglob = 0;
}

void registra_ir(int op, int nom, int ope, int res, int val)
{
    if (ndir < da_count(dir_op))
    {
        da_set(dir_op, ndir, op);
        da_set(dir_nom, ndir, nom);
        da_set(dir_ope, ndir, ope);
        da_set(dir_res, ndir, res);
        da_set(dir_val, ndir, val);
    }
    else
    {
        da_add(dir_op, op);
        da_add(dir_nom, nom);
        da_add(dir_ope, ope);
        da_add(dir_res, res);
        da_add(dir_val, val);
    }
    ndir = ndir + 1;
}

int texto_len(int ref)
{
    return string_pool_len(dpool, ref);
}

int texto_ini(int ref)
{
    return ref / 128;
}

int texto_char(int ref, int i)
{
    return string_pool_get_char(dpool, texto_ini(ref), i);
}

int texto_es_main(int ref)
{
    if (texto_len(ref) != 4)
    {
        return 0;
    }
    if (texto_char(ref, 0) != 109)
    {
        return 0;
    }
    if (texto_char(ref, 1) != 97)
    {
        return 0;
    }
    if (texto_char(ref, 2) != 105)
    {
        return 0;
    }
    if (texto_char(ref, 3) != 110)
    {
        return 0;
    }
    return 1;
}

// ============================================================
// EMISOR DEL PASEO.
//
// Las emisiones de generate() sobre el ByteBuffer de
// codigo, con las codificaciones de X86Emitter de
// Stage 0. El hueco es un imm32 en cero cuyo offset se
// devuelve (la semantica de los placeholders del
// Emitter), y parche32 escribe un dword little-endian
// en un offset ya entregado: es el patch32 del
// oraculo, con el que el cierre de marco rellena el
// tamano del marco. Los accesos EBP-relativos con
// desplazamiento ya conocido son los retenes de B-1
// sin hueco: 89 85 / 89 9D guardan, 8B 85 / 8B 9D
// cargan.
// ============================================================

void em_byte(int b)
{
    bytebuffer_append(dcod, b & 255);
}

void em_dword(int v)
{
    em_byte(v & 255);
    em_byte((v >> 8) & 255);
    em_byte((v >> 16) & 255);
    em_byte((v >> 24) & 255);
}

int em_hueco()
{
    int pos;
    pos = bytebuffer_get_size(dcod);
    em_dword(0);
    return pos;
}

void parche32(int pos, int v)
{
    bytebuffer_patch(dcod, pos, v & 255);
    bytebuffer_patch(dcod, pos + 1, (v >> 8) & 255);
    bytebuffer_patch(dcod, pos + 2, (v >> 16) & 255);
    bytebuffer_patch(dcod, pos + 3, (v >> 24) & 255);
}

void em_push_ebp()
{
    em_byte(85);
}

void em_mov_ebp_esp()
{
    em_byte(137);
    em_byte(229);
}

void em_mov_esp_ebp()
{
    em_byte(137);
    em_byte(236);
}

void em_pop_ebp()
{
    em_byte(93);
}

void em_ret()
{
    em_byte(195);
}

void em_mov_eax_imm(int v)
{
    em_byte(184);
    em_dword(v);
}

void em_mov_ebx_imm(int v)
{
    em_byte(187);
    em_dword(v);
}

void em_mov_eax_ebx()
{
    em_byte(137);
    em_byte(216);
}

int em_sub_esp_hueco()
{
    em_byte(129);
    em_byte(236);
    return em_hueco();
}

void em_store_eax_ebp(int off)
{
    em_byte(137);
    em_byte(133);
    em_dword(off);
}

void em_store_ebx_ebp(int off)
{
    em_byte(137);
    em_byte(157);
    em_dword(off);
}

void em_load_eax_ebp(int off)
{
    em_byte(139);
    em_byte(133);
    em_dword(off);
}

void em_load_ebx_ebp(int off)
{
    em_byte(139);
    em_byte(157);
    em_dword(off);
}

int em_store_eax_mem()
{
    em_byte(137);
    em_byte(5);
    return em_hueco();
}

int em_store_ebx_mem()
{
    em_byte(137);
    em_byte(29);
    return em_hueco();
}

int em_load_eax_mem()
{
    em_byte(161);
    return em_hueco();
}

int em_load_ebx_mem()
{
    em_byte(139);
    em_byte(29);
    return em_hueco();
}

// ============================================================
// GENERA: EL ESQUELETO DE GENERATE().
//
// La transcripcion del generate() de Stage 0 en su
// esqueleto: las dos pasadas previas, el paseo por la
// lista plana y el cierre. En el oraculo el paseo
// recorre las IRFunction una a una y llama a
// finishCurrentFunctionFrame al final de cada una;
// en la lista plana ese cierre es el FunctionEnd
// (opcode 1), que en la cadena del oraculo no tiene
// rama. El FunctionBegin tambien llama al cierre
// antes de abrir su marco, como en el oraculo.
//
// Las listas dent_*, dret_pos y dtextos_nom son las
// locales de generate() en el oraculo (functionEntries,
// returnEventLoopPatches y los textos recogidos):
// nacen en cada llamada a genera(). Los parches que
// el paseo registra (vl, vs, sc, spill, reload y los
// del event loop en dret_pos) quedan pendientes: su
// resolucion contra dataBase es la pasada final de
// B-9, y los del runtime (la entrada del principal y
// el destino del event loop) son del runtime, tambien
// B-9. El parche del tamano del marco si se resuelve
// en el paseo, en cierra_funcion, como en el oraculo.
//
// La rama de parametros de FunctionBegin: en el
// oraculo la rama de DATA es inalcanzable (el marco
// acaba de abrirse y frameActive ya vale), asi que
// solo se transcribe la viva, la de la pila. La
// diagnostica del asignador que el oraculo escribe en
// cerr no es parte del binario y no se transcribe.
// ============================================================

void registra_entrada(int fun, int pos)
{
    if (ndent < da_count(dent_fun))
    {
        da_set(dent_fun, ndent, fun);
        da_set(dent_pos, ndent, pos);
    }
    else
    {
        da_add(dent_fun, fun);
        da_add(dent_pos, pos);
    }
    ndent = ndent + 1;
}

void registra_ret(int pos)
{
    if (nret < da_count(dret_pos))
    {
        da_set(dret_pos, nret, pos);
    }
    else
    {
        da_add(dret_pos, pos);
    }
    nret = nret + 1;
}

void registra_texto(int nom)
{
    if (ntextos < da_count(dtextos_nom))
    {
        da_set(dtextos_nom, ntextos, nom);
    }
    else
    {
        da_add(dtextos_nom, nom);
    }
    ntextos = ntextos + 1;
}

void cierra_funcion()
{
    if (frame_activo == 0)
    {
        return;
    }
    em_mov_eax_imm(0);
    em_mov_esp_ebp();
    em_pop_ebp();
    if (texto_es_main(fun_actual) == 1)
    {
        em_byte(233);
        registra_ret(em_hueco());
    }
    else
    {
        em_ret();
    }
    parche32(pos_marco, frame_slots * 4);
    cierra_marco();
}

void genera()
{
    int i;
    int op;
    int nom;
    int ope;
    int res;
    int val;
    int fila;
    int reg;
    int off;
    int pos;
    int j;
    int dup;
    int ppos;
    int indice;
    int largo;
    int coma;
    int fin;
    int a;
    int z;
    int refpar;
    dent_fun = da_create(region_backend, 256);
    dent_pos = da_create(region_backend, 256);
    dret_pos = da_create(region_backend, 256);
    dtextos_nom = da_create(region_backend, 256);
    ndent = 0;
    nret = 0;
    ntextos = 0;
    fun_actual = 0;
    pos_main = 0;
    idx_sc = 0;
    i = dir_nglob;
    while (i < ndir)
    {
        if (da_get(dir_op, i) == 3)
        {
            registra_texto(da_get(dir_nom, i));
        }
        i = i + 1;
    }
    i = 0;
    while (i < dir_nglob)
    {
        if (da_get(dir_op, i) == 4)
        {
            off = reserva_datos(1);
            declara_global(da_get(dir_nom, i), off, 0);
        }
        i = i + 1;
    }
    i = dir_nglob;
    while (i < ndir)
    {
        op = da_get(dir_op, i);
        nom = da_get(dir_nom, i);
        ope = da_get(dir_ope, i);
        res = da_get(dir_res, i);
        val = da_get(dir_val, i);
        if (op == 1)
        {
            cierra_funcion();
        }
        if (op == 0)
        {
            cierra_funcion();
            if (texto_len(nom) == 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            dup = 0;
            j = 0;
            while (j < ndent)
            {
                if (da_get(dent_fun, j) == nom)
                {
                    dup = 1;
                }
                j = j + 1;
            }
            if (dup == 1)
            {
                errores_back = errores_back + 1;
                return;
            }
            registra_entrada(nom, bytebuffer_get_size(dcod));
            if (texto_len(fun_actual) > 0)
            {
                guarda_contexto(fun_actual);
            }
            fun_actual = nom;
            if (texto_es_main(nom) == 1)
            {
                pos_main = bytebuffer_get_size(dcod);
            }
            em_push_ebp();
            em_mov_ebp_esp();
            abre_marco();
            pos_marco = em_sub_esp_hueco();
            reinicia_temporales();
            reinicia_variables();
            if (texto_len(ope) > 0)
            {
                ppos = 0;
                indice = 0;
                largo = texto_len(ope);
                while (ppos < largo)
                {
                    coma = -1;
                    j = ppos;
                    while (j < largo)
                    {
                        if (texto_char(ope, j) == 44)
                        {
                            coma = j;
                            j = largo;
                        }
                        else
                        {
                            j = j + 1;
                        }
                    }
                    fin = largo;
                    if (coma >= 0)
                    {
                        fin = coma;
                    }
                    a = ppos;
                    z = fin;
                    while (a < z && texto_char(ope, a) == 32)
                    {
                        a = a + 1;
                    }
                    while (z > a && texto_char(ope, z - 1) == 32)
                    {
                        z = z - 1;
                    }
                    if (a >= z)
                    {
                        errores_back = errores_back + 1;
                        return;
                    }
                    refpar = (texto_ini(ope) + a) * 128 + (z - a);
                    off = ranura_marco();
                    if (off == 0)
                    {
                        return;
                    }
                    declara_var_pila(refpar, off, 0);
                    if (indice == 0)
                    {
                        em_store_eax_ebp(off);
                    }
                    else if (indice == 1)
                    {
                        em_store_ebx_ebp(off);
                    }
                    else
                    {
                        em_load_eax_ebp(8 + (indice - 2) * 4);
                        em_store_eax_ebp(off);
                    }
                    indice = indice + 1;
                    if (coma < 0)
                    {
                        ppos = largo;
                    }
                    else
                    {
                        ppos = coma + 1;
                    }
                }
            }
        }
        if (op == 2)
        {
            reg = asigna_registro(res);
            anota_const(res, val);
            if (reg == 0)
            {
                em_mov_eax_imm(val);
            }
            else if (reg == 3)
            {
                em_mov_ebx_imm(val);
            }
            else
            {
                errores_back = errores_back + 1;
                return;
            }
        }
        else if (op == 3)
        {
            reg = asigna_registro(res);
            if (reg == 0)
            {
                pos = bytebuffer_get_size(dcod) + 1;
                em_mov_eax_imm(0);
            }
            else if (reg == 3)
            {
                pos = bytebuffer_get_size(dcod) + 1;
                em_mov_ebx_imm(0);
            }
            else
            {
                errores_back = errores_back + 1;
                return;
            }
            registra_sc(pos, idx_sc);
            idx_sc = idx_sc + 1;
        }
        else if (op == 4)
        {
            if (frame_activo == 1 && val <= 0)
            {
                off = ranura_marco();
                if (off == 0)
                {
                    return;
                }
                declara_var_pila(nom, off, 0);
            }
            else
            {
                if (val <= 0)
                {
                    off = reserva_datos(1);
                    declara_var(nom, off, 0);
                }
            }
        }
        else if (op == 5)
        {
            fila = busca_var(nom);
            if (fila < 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            if (texto_len(ope) == 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            reg = registro_de(ope);
            if (da_get(dvar_stack, fila) == 1)
            {
                off = da_get(dvar_soff, fila);
                if (reg == 0)
                {
                    em_store_eax_ebp(off);
                }
                else if (reg == 3)
                {
                    em_store_ebx_ebp(off);
                }
                else
                {
                    errores_back = errores_back + 1;
                    return;
                }
            }
            else
            {
                if (reg == 0)
                {
                    pos = em_store_eax_mem();
                }
                else if (reg == 3)
                {
                    pos = em_store_ebx_mem();
                }
                else
                {
                    errores_back = errores_back + 1;
                    return;
                }
                registra_vs(fun_actual, nom, pos);
            }
            libera_tmp(ope);
        }
        else if (op == 6)
        {
            fila = busca_var(nom);
            if (fila < 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            reg = asigna_registro(res);
            if (da_get(dvar_stack, fila) == 1)
            {
                off = da_get(dvar_soff, fila);
                if (reg == 0)
                {
                    em_load_eax_ebp(off);
                }
                else if (reg == 3)
                {
                    em_load_ebx_ebp(off);
                }
                else
                {
                    errores_back = errores_back + 1;
                    return;
                }
            }
            else
            {
                if (reg == 0)
                {
                    pos = em_load_eax_mem();
                }
                else if (reg == 3)
                {
                    pos = em_load_ebx_mem();
                }
                else
                {
                    errores_back = errores_back + 1;
                    return;
                }
                registra_vl(fun_actual, nom, pos);
            }
        }
        else if (op == 40)
        {
            if (texto_len(ope) > 0)
            {
                fila = busca_tmp(ope);
                if (fila < 0)
                {
                    errores_back = errores_back + 1;
                    return;
                }
                if (da_get(dtmp_kind, fila) != 0)
                {
                    errores_back = errores_back + 1;
                    return;
                }
                reg = da_get(dtmp_reg, fila);
                if (reg == 3)
                {
                    em_mov_eax_ebx();
                }
                else if (reg != 0)
                {
                    errores_back = errores_back + 1;
                    return;
                }
            }
            else
            {
                em_mov_eax_imm(val);
            }
            if (texto_es_main(fun_actual) == 0)
            {
                if (frame_activo == 1)
                {
                    em_mov_esp_ebp();
                    em_pop_ebp();
                    em_ret();
                }
                else
                {
                    em_ret();
                }
            }
            else
            {
                if (frame_activo == 1)
                {
                    em_mov_esp_ebp();
                    em_pop_ebp();
                }
                em_byte(233);
                registra_ret(em_hueco());
            }
        }
        i = i + 1;
    }
    if (nret == 0)
    {
        em_mov_eax_imm(0);
        em_byte(233);
        registra_ret(em_hueco());
    }
    if (texto_len(fun_actual) > 0)
    {
        guarda_contexto(fun_actual);
    }
}

// ============================================================
// SONDA DEL BACKEND B-1: LA MAQUINARIA.
//
//
// Cinco movimientos. El primero conserva la sonda de
// M-1 en sus dos primeros tramos (arranque, basico y
// crecimiento de la lista de llamadas hasta 3.000) con
// los unicos numeros re-apuntados que los nacimientos
// de la maquinaria mueven: las bases de la lista crecida
// (17936 y 22032) y el usado de la region (26128); la
// corriente de registros, cuentas, capacidades e
// integridad es la de M-1, intacta. El segundo corre el
// guion de la maquinaria: el asignador liga 101 a EAX y
// 102 a EBX, el tercer temporal derrama el de EAX a la
// ranura -4, el cuarto derrama el nuevo de EAX a -8 y
// pedir el que esta en memoria derrama el de EAX a -12
// y lo liga a EAX sin recargarlo (la politica del
// oraculo); liberado EBX entra 105, liberado EAX la
// recarga de 103 emite su reten y lo liga a EAX; la
// constante de 106 nace, se lee y muere con su liberacion
// tras derramar a 103 a -16; el reinicio de temporales
// vacia el mapa sin tocar las listas; los retenes de EBX
// y ECX cierran el codigo en 42 bytes. Despues, los
// globales 201 y 202 se reservan en datos (offsets 0 y
// 4), el contexto de la funcion 301 se siembra con
// ellos, suma una variable de datos (offset 16) y una
// de pila (ranura -20, tras las cuatro de los derrames),
// se guarda, y el de 302 nace sembrado y solo con la
// suya (offset 20): el directorio los encuentra a los
// dos y no al 303. El cierre acusa dos veces: la ranura
// sin marco y el registro de un temporal inexistente.
// El tercero crece las tablas nuevas: 300 variables
// (capacidad 512), su contexto guardado (512) y 300
// temporales (512). El cuarto y el quinto acusan contra
// una BackendArena de 11024 celdas (caben los
// nacimientos, no el primer crecimiento): la guarda de
// variables ante la declaracion 257 y la lista de
// llamadas de M-1 ante el registro 257, ambas con las
// cuentas clavadas en 256 y la ultima ranura intacta.
// ============================================================

void sonda_backend_b1()
{
    int rs;
    int rf;
    int rc;
    int rb;
    int i;
    int r;
    int o;
    int s;
    inicia_arena();
    rs = arena_create(256);
    region_source = rs;
    rf = arena_create(256);
    region_frontend = rf;
    rc = arena_create(256);
    region_compiler = rc;
    arena_destroy(rf);
    rb = arena_create(32768);
    region_backend = rb;
    print_int(rb);
    print_int(arena_get_reserved(rb));
    print_int(errores_arena);
    reinicia_back();
    registra_vl(11, 21, 101);
    registra_vl(12, 22, 102);
    registra_vl(13, 23, 103);
    registra_vs(31, 41, 201);
    registra_vs(32, 42, 202);
    registra_spill(51, 301, -4);
    registra_spill(52, 302, -8);
    registra_reload(61, 401, -12);
    registra_reload(62, 402, -16);
    registra_reload(63, 403, -20);
    registra_sc(501, 71);
    registra_sc(502, 72);
    registra_cf(81, 601);
    registra_cf(82, 602);
    registra_fc(91, 701);
    registra_fc(92, 702);
    imprime_listas();
    i = nfc;
    while (i < 257)
    {
        registra_fc(i, 1000 + i);
        i = i + 1;
    }
    print_int(da_capacity(dfc_fun));
    while (i < 3000)
    {
        registra_fc(i, 1000 + i);
        i = i + 1;
    }
    print_int(nfc);
    print_int(da_count(dfc_fun));
    print_int(da_count(dfc_pos));
    print_int(da_capacity(dfc_fun));
    print_int(da_base(dfc_fun));
    print_int(da_base(dfc_pos));
    print_int(arena_get_used(rb));
    print_int(da_get(dfc_fun, 0));
    print_int(da_get(dfc_pos, 0));
    print_int(da_get(dfc_fun, 255));
    print_int(da_get(dfc_pos, 255));
    print_int(da_get(dfc_fun, 256));
    print_int(da_get(dfc_pos, 256));
    print_int(da_get(dfc_fun, 2999));
    print_int(da_get(dfc_pos, 2999));
    print_int(errores_back);
    print_int(errores_arena);
    inicia_arena();
    rs = arena_create(256);
    region_source = rs;
    rf = arena_create(256);
    region_frontend = rf;
    rc = arena_create(256);
    region_compiler = rc;
    arena_destroy(rf);
    rb = arena_create(32768);
    region_backend = rb;
    print_int(rb);
    print_int(arena_get_reserved(rb));
    print_int(errores_arena);
    reinicia_back();
    abre_marco();
    print_int(frame_activo);
    print_int(frame_slots);
    r = asigna_registro(101);
    print_int(r);
    r = asigna_registro(102);
    print_int(r);
    r = asigna_registro(103);
    print_int(r);
    volcado();
    r = asigna_registro(104);
    print_int(r);
    r = asigna_registro(101);
    print_int(r);
    volcado();
    libera_tmp(102);
    r = asigna_registro(105);
    print_int(r);
    libera_tmp(101);
    recarga_tmp(103);
    print_int(registro_de(103));
    print_int(tmp_en_registro(0));
    print_int(tmp_en_registro(3));
    volcado();
    anota_const(106, 42);
    print_int(busca_const(106));
