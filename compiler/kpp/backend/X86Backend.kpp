void imprime_contexto(int fun)
{
    int ci;
    int ini;
    int n;
    int k;
    ci = contexto_de(fun);
    print_int(ci);
    if (ci >= 0)
    {
        ini = da_get(dctx_ini, ci);
        n = da_get(dctx_n, ci);
        k = 0;
        while (k < n)
        {
            print_int(da_get(dsv_nom, ini + k));
            print_int(da_get(dsv_dat, ini + k));
            print_int(da_get(dsv_stack, ini + k));
            print_int(da_get(dsv_soff, ini + k));
            print_int(da_get(dsv_cap, ini + k));
            k = k + 1;
        }
    }
}

