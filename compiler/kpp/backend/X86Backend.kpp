void sonda_crecimiento_gen()
{
    int r_main;
    int r_ult;
    int r;
    int i;
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    registra_ir(0, r_main, 0, 0, 0);
    r_ult = 0;
    i = 0;
    while (i < 300)
    {
        if (i < 10)
        {
            r = tx2(37, 48 + i);
        }
        else if (i < 100)
        {
            r = tx3(37, 48 + i / 10, 48 + (i - (i / 10) * 10));
        }
        else
        {
            r = tx4(37, 48 + i / 100, 48 + ((i / 10) - (i / 100) * 10), 48 + (i - (i / 10) * 10));
        }
        registra_ir(2, 0, 0, r, i);
        r_ult = r;
        i = i + 1;
    }
    registra_ir(40, 0, r_ult, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    print_int(bytebuffer_get_size(dcod));
    print_int(da_count(dtmp_nom));
    print_int(da_capacity(dtmp_nom));
    print_int(nsp);
    print_int(bytebuffer_get(dcod, 5) + bytebuffer_get(dcod, 6) * 256 + bytebuffer_get(dcod, 7) * 65536 + bytebuffer_get(dcod, 8) * 16777216);
    print_int(errores_back);
    print_int(errores_arena);
}


// ============================================================
// SONDA B-3: LA ARITMETICA.
//
// Tras las sondas B-1 y B-2 enteras (la conservacion
// de 1.465 valores), once movimientos del paseo
// aritmetico, cada uno en su mundo con su programa en
// main (salvo el Sub sin marco, en f): Add en sus
// tres casos y en su caso 2 con EBX libre, Sub base y
// Sub con el orden de la tabla, Mul base y Mul con el
// orden de registro, Div, Mod y los tres errores
// (temporal inexistente, combinacion no soportada y
// Sub sin marco). Cada movimiento vuelca el codigo,
// el estado de genera, las listas de parches, la
// maquinaria y los errores. Los operandos "izq, der"
// se internan con tx6 y las referencias de los
// temporales operandos son las de sus subcadenas,
// como los parametros de B-2.
// ============================================================

int tx6(int c0, int c1, int c2, int c3, int c4, int c5)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    string_pool_add_char(dpool, c1);
    string_pool_add_char(dpool, c2);
    string_pool_add_char(dpool, c3);
    string_pool_add_char(dpool, c4);
    string_pool_add_char(dpool, c5);
    return ini * 128 + 6;
}

int tx9(int c0, int c1, int c2, int c3, int c4, int c5, int c6, int c7, int c8)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    string_pool_add_char(dpool, c1);
    string_pool_add_char(dpool, c2);
    string_pool_add_char(dpool, c3);
    string_pool_add_char(dpool, c4);
    string_pool_add_char(dpool, c5);
    string_pool_add_char(dpool, c6);
    string_pool_add_char(dpool, c7);
    string_pool_add_char(dpool, c8);
    return ini * 128 + 9;
}

