// ============================================================
// SONDA B-2: EL ESQUELETO DE GENERATE().
//
// Tras la sonda B-1 entera (la conservacion), cinco
// movimientos del paseo, cada uno en su mundo con su
// programa registrado por registra_ir: el minimo que
// devuelve un entero (Return inmediato en main), el
// programa con global, funcion con parametros y
// locales, Store y Load de pila y de DATA, StringConst
// con derrame y Return desde EBX; el retorno implicito
// de una funcion sin Return y sin main; los dos
// errores de FunctionBegin (sin nombre y duplicada); y
// el crecimiento con 300 constantes. Los textos se
// agregan a dpool caracter a caracter con tx1..tx4,
// que devuelven la referencia ini * 128 + largo.
// ============================================================

int tx1(int c0)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    return ini * 128 + 1;
}

int tx2(int c0, int c1)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    string_pool_add_char(dpool, c1);
    return ini * 128 + 2;
}

int tx3(int c0, int c1, int c2)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    string_pool_add_char(dpool, c1);
    string_pool_add_char(dpool, c2);
    return ini * 128 + 3;
}

int tx4(int c0, int c1, int c2, int c3)
{
    int ini;
    ini = string_pool_add_char(dpool, c0);
    string_pool_add_char(dpool, c1);
    string_pool_add_char(dpool, c2);
    string_pool_add_char(dpool, c3);
    return ini * 128 + 4;
}

void mundo2()
{
    int rf;
    int rb;
    inicia_arena();
    arena_create(256);
    rf = arena_create(256);
    arena_create(256);
    arena_destroy(rf);
    rb = arena_create(32768);
    region_backend = rb;
    reinicia_back();
    reinicia_ir();
}

void imprime_codigo()
{
    int n;
    int i;
    n = bytebuffer_get_size(dcod);
    print_int(n);
    i = 0;
    while (i < n)
    {
        print_int(bytebuffer_get(dcod, i));
        i = i + 1;
    }
}

void imprime_genera()
{
    int i;
    print_int(pos_main);
    print_int(ndent);
    i = 0;
    while (i < ndent)
    {
        print_int(da_get(dent_fun, i));
        print_int(da_get(dent_pos, i));
        i = i + 1;
    }
    print_int(nret);
    i = 0;
    while (i < nret)
    {
        print_int(da_get(dret_pos, i));
        i = i + 1;
    }
    print_int(ntextos);
    i = 0;
    while (i < ntextos)
    {
        print_int(da_get(dtextos_nom, i));
        i = i + 1;
    }
}

void imprime_contexto(int fun)
{
    int ci;
    int ini;
    int n;
    int k;
    ci = contexto_de(fun);
    print_int(ci);
    if (ci >= 0)
    {
        ini = da_get(dctx_ini, ci);
        n = da_get(dctx_n, ci);
        k = 0;
        while (k < n)
        {
            print_int(da_get(dsv_nom, ini + k));
            print_int(da_get(dsv_dat, ini + k));
            print_int(da_get(dsv_stack, ini + k));
            print_int(da_get(dsv_soff, ini + k));
            print_int(da_get(dsv_cap, ini + k));
            k = k + 1;
        }
    }
}

void sonda_minimo()
{
    int r_main;
    int r_t0;
    mundo2();
    r_main = tx4(109, 97, 105, 110);
    r_t0 = tx2(37, 48);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(40, 0, 0, 0, 42);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_codigo();
    imprime_genera();
    print_int(errores_back);
    print_int(errores_arena);
}

void sonda_programa()
{
    int r_g;
    int r_suma;
    int r_ope;
    int ini_ope;
    int r_a;
    int r_b;
    int r_x;
    int r_main;
    int r_y;
    int r_hola;
    int r_t0;
    int r_t1;
    int r_t2;
    int r_t3;
    int r_t4;
    int i;
    mundo2();
    r_g = tx1(103);
    r_suma = tx4(115, 117, 109, 97);
    r_ope = tx4(97, 44, 32, 98);
    ini_ope = r_ope / 128;
    r_a = ini_ope * 128 + 1;
    r_b = (ini_ope + 3) * 128 + 1;
    r_x = tx1(120);
    r_main = tx4(109, 97, 105, 110);
    r_y = tx1(121);
    r_hola = tx4(104, 111, 108, 97);
    r_t0 = tx2(37, 48);
    r_t1 = tx2(37, 49);
    r_t2 = tx2(37, 50);
    r_t3 = tx2(37, 51);
    r_t4 = tx2(37, 52);
    registra_ir(4, r_g, 0, 0, 0);
    dir_nglob = 1;
    registra_ir(0, r_suma, r_ope, 0, 0);
    registra_ir(4, r_x, 0, 0, 0);
    registra_ir(6, r_a, 0, r_t0, 0);
    registra_ir(40, 0, r_t0, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    registra_ir(0, r_main, 0, 0, 0);
    registra_ir(4, r_y, 0, 0, 0);
    registra_ir(2, 0, 0, r_t0, 7);
    registra_ir(5, r_y, r_t0, 0, 0);
    registra_ir(2, 0, 0, r_t1, 9);
    registra_ir(5, r_g, r_t1, 0, 0);
    registra_ir(6, r_y, 0, r_t2, 0);
    registra_ir(6, r_g, 0, r_t3, 0);
    registra_ir(3, r_hola, 0, r_t4, 0);
    registra_ir(40, 0, r_t3, 0, 0);
    registra_ir(1, 0, 0, 0, 0);
    genera();
    imprime_codigo();
    print_int(bytebuffer_get_size(ddat));
    i = 0;
    while (i < bytebuffer_get_size(ddat))
    {
        print_int(bytebuffer_get(ddat, i));
        i = i + 1;
    }
    imprime_genera();
    imprime_listas();
    imprime_maquinaria();
    imprime_contexto(r_suma);
    imprime_contexto(r_main);
    print_int(errores_back);
    print_int(errores_arena);
}

