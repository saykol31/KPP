// ============================================================
// REINICIA EL BACKEND.
//
// Pone a cero el andamiaje (el codigo y las tablas de
// entrada del generador: seis arreglos paralelos — iop,
// inombre, ioperando, iresultado, iaux, ivalor — y la
// piscina de texto pool, donde el nombre, el operando,
// el resultado y el auxiliary de cada instruccion son
// referencias ini * 128 + largo) y crea las estructuras
// de las siete listas: 18 DynamicArray en BackendArena,
// nacidos a 256 elementos — el 256 de la norma vieja
// como capacidad inicial, ya no como techo: crecen por
// la geometria de la biblioteca. El llamador crea
// BackendArena antes (region_backend) y los handles
// quedan en los escalares compartidos. La rebanada B-1
// agrega al final los nacimientos de la maquinaria:
// las 24 tablas del modulo ESTADO DE LA MAQUINARIA y
// los dos ByteBuffer, codigo y datos.
// ============================================================

void reinicia_back()
{
    int codigo[256];
    int iop[256];
    int inombre[256];
    int ioperando[256];
    int iresultado[256];
    int iaux[256];
    int ivalor[256];
    int pool[256];
    int i;
    i = 0;
    while (i < 256)
    {
        codigo[i] = 0;
        iop[i] = 0;
        inombre[i] = 0;
        ioperando[i] = 0;
        iresultado[i] = 0;
        iaux[i] = 0;
        ivalor[i] = 0;
        pool[i] = 0;
        i = i + 1;
    }
    nir = 0;
    pool_len = 0;
    ncod = 0;
    errores_back = 0;
    nvl = 0;
    nvs = 0;
    nsp = 0;
    nrl = 0;
    nsc = 0;
    ncf = 0;
    nfc = 0;
    ntmp = 0;
    ncon = 0;
    nvar = 0;
    nglo = 0;
    nctx = 0;
    nsv = 0;
    frame_activo = 0;
    frame_slots = 0;
    dvl_fun = da_create(region_backend, 256);
    dvl_nom = da_create(region_backend, 256);
    dvl_pos = da_create(region_backend, 256);
    dvs_fun = da_create(region_backend, 256);
    dvs_nom = da_create(region_backend, 256);
    dvs_pos = da_create(region_backend, 256);
    dsp_tmp = da_create(region_backend, 256);
    dsp_pos = da_create(region_backend, 256);
    dsp_dat = da_create(region_backend, 256);
    drl_tmp = da_create(region_backend, 256);
    drl_pos = da_create(region_backend, 256);
    drl_dat = da_create(region_backend, 256);
    dsc_pos = da_create(region_backend, 256);
    dsc_idx = da_create(region_backend, 256);
    dcf_etiq = da_create(region_backend, 256);
    dcf_pos = da_create(region_backend, 256);
    dfc_fun = da_create(region_backend, 256);
    dfc_pos = da_create(region_backend, 256);
    dtmp_nom = da_create(region_backend, 256);
    dtmp_kind = da_create(region_backend, 256);
    dtmp_reg = da_create(region_backend, 256);
    dtmp_off = da_create(region_backend, 256);
    dcon_nom = da_create(region_backend, 256);
    dcon_val = da_create(region_backend, 256);
    dvar_nom = da_create(region_backend, 256);
    dvar_dat = da_create(region_backend, 256);
    dvar_stack = da_create(region_backend, 256);
    dvar_soff = da_create(region_backend, 256);
    dvar_cap = da_create(region_backend, 256);
    dglo_nom = da_create(region_backend, 256);
    dglo_dat = da_create(region_backend, 256);
    dglo_stack = da_create(region_backend, 256);
    dglo_soff = da_create(region_backend, 256);
    dglo_cap = da_create(region_backend, 256);
    dctx_fun = da_create(region_backend, 256);
    dctx_ini = da_create(region_backend, 256);
    dctx_n = da_create(region_backend, 256);
    dsv_nom = da_create(region_backend, 256);
    dsv_dat = da_create(region_backend, 256);
    dsv_stack = da_create(region_backend, 256);
    dsv_soff = da_create(region_backend, 256);
    dsv_cap = da_create(region_backend, 256);
    dcod = bytebuffer_create(region_backend);
    ddat = bytebuffer_create(region_backend);
}

// ============================================================
// REGISTRO DE LAS SIETE LISTAS.
//
// Una funcion por lista, con la misma disciplina: el
// primer campo hace de guarda — si su da_add devuelve
// -1, la arena no pudo crecer: la funcion acusa en
// errores_back (la biblioteca ya acuso en
// errores_arena) y no escribe nada mas. Los campos
// paralelos comparten la cuenta del primero porque
// nacen con la misma capacidad y crecen a la par. Los
// campos de texto de Stage 0 (functionName, name,
// temporary, label) viajan como referencias a la
// piscina: un entero por campo. El orden de los campos
// es el de los structs de X86Backend.hpp.
// ============================================================

// VariableLoadPatch: funcion, nombre, offset del hueco.
void registra_vl(int fun, int nom, int pos)
{
    int r;
    r = da_add(dvl_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dvl_nom, nom);
    r = da_add(dvl_pos, pos);
    nvl = nvl + 1;
}

// VariableStorePatch: funcion, nombre, offset del hueco.
void registra_vs(int fun, int nom, int pos)
{
    int r;
    r = da_add(dvs_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dvs_nom, nom);
    r = da_add(dvs_pos, pos);
    nvs = nvs + 1;
}

// TemporarySpillPatch: temporal, offset del hueco,
// offset de datos (el slot, firmado).
void registra_spill(int tmp, int pos, int dat)
{
    int r;
    r = da_add(dsp_tmp, tmp);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dsp_pos, pos);
    r = da_add(dsp_dat, dat);
    nsp = nsp + 1;
}

// TemporaryReloadPatch: temporal, offset del hueco,
// offset de datos (el slot, firmado).
void registra_reload(int tmp, int pos, int dat)
{
    int r;
    r = da_add(drl_tmp, tmp);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(drl_pos, pos);
    r = da_add(drl_dat, dat);
    nrl = nrl + 1;
}

// StringConstPatch: offset del hueco, indice de la
// cadena en la piscina.
void registra_sc(int pos, int idx)
{
    int r;
    r = da_add(dsc_pos, pos);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dsc_idx, idx);
    nsc = nsc + 1;
}

// ControlFlowPatch: etiqueta, offset del hueco.
void registra_cf(int etiq, int pos)
{
    int r;
    r = da_add(dcf_etiq, etiq);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dcf_pos, pos);
    ncf = ncf + 1;
}

// FunctionCallPatch: funcion, offset del hueco.
void registra_fc(int fun, int pos)
{
    int r;
    r = da_add(dfc_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    r = da_add(dfc_pos, pos);
    nfc = nfc + 1;
}

// ============================================================
// IMPRIME LAS LISTAS.
//
// Por lista, el contador y despues los campos de cada
// entrada en orden, leidos con da_get; al final, el
// contador de errores de la pieza. La lectura de campo
// se coteja numero a numero contra el puerto
// independiente.
// ============================================================

void imprime_listas()
{
    int i;
    print_int(nvl);
    i = 0;
    while (i < nvl)
    {
        print_int(da_get(dvl_fun, i));
        print_int(da_get(dvl_nom, i));
        print_int(da_get(dvl_pos, i));
        i = i + 1;
    }
    print_int(nvs);
    i = 0;
    while (i < nvs)
    {
        print_int(da_get(dvs_fun, i));
        print_int(da_get(dvs_nom, i));
        print_int(da_get(dvs_pos, i));
        i = i + 1;
    }
    print_int(nsp);
    i = 0;
    while (i < nsp)
    {
        print_int(da_get(dsp_tmp, i));
        print_int(da_get(dsp_pos, i));
        print_int(da_get(dsp_dat, i));
        i = i + 1;
    }
    print_int(nrl);
    i = 0;
    while (i < nrl)
    {
        print_int(da_get(drl_tmp, i));
        print_int(da_get(drl_pos, i));
        print_int(da_get(drl_dat, i));
        i = i + 1;
    }
    print_int(nsc);
    i = 0;
    while (i < nsc)
    {
        print_int(da_get(dsc_pos, i));
        print_int(da_get(dsc_idx, i));
        i = i + 1;
    }
    print_int(ncf);
    i = 0;
    while (i < ncf)
    {
        print_int(da_get(dcf_etiq, i));
        print_int(da_get(dcf_pos, i));
        i = i + 1;
    }
    print_int(nfc);
    i = 0;
    while (i < nfc)
    {
        print_int(da_get(dfc_fun, i));
        print_int(da_get(dfc_pos, i));
        i = i + 1;
    }
    print_int(errores_back);
}

// ============================================================
// TEMPORALES.
//
//
// El mapa de temporales y su asignador, transcritos de
// X86Backend.cpp. busca_tmp da la fila por nombre o -1.
// inserta_tmp escribe una fila con la disciplina de la
// casa: si la fila ya existe fisicamente la reescribe
// con da_set; si es nueva entra por da_add con el nombre
// de guarda. liga_tmp liga o actualiza (la actualizacion
// a registro pone el desplazamiento a cero y la de
// memoria el registro a cero, como la inicializacion
// por agregado del oraculo). libera_tmp es el erase:
// la ultima fila ocupa el hueco, y la constante del
// temporal se borra con el, como en freeTemporary.
// tmp_en_registro devuelve el nombre del dueno de un
// registro o -1. reinicia_temporales pone las cuentas
// a cero: las filas quedan para reuso.
// ============================================================

int busca_tmp(int nom)
{
    int i;
    i = 0;
    while (i < ntmp)
    {
        if (da_get(dtmp_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int inserta_tmp(int fila, int nom, int kind, int reg, int off)
{
    int r;
    if (fila < da_count(dtmp_nom))
    {
        da_set(dtmp_nom, fila, nom);
        da_set(dtmp_kind, fila, kind);
        da_set(dtmp_reg, fila, reg);
        da_set(dtmp_off, fila, off);
        return 1;
    }
    r = da_add(dtmp_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dtmp_kind, kind);
    r = da_add(dtmp_reg, reg);
    r = da_add(dtmp_off, off);
    return 1;
}

void liga_tmp(int nom, int kind, int reg, int off)
{
    int f;
    int nueva;
    f = busca_tmp(nom);
    nueva = 0;
    if (f < 0)
    {
        f = ntmp;
        nueva = 1;
    }
    if (inserta_tmp(f, nom, kind, reg, off) == 1)
    {
        if (nueva == 1)
        {
            ntmp = ntmp + 1;
        }
    }
}

void liga_tmp_eax(int nom)
{
    liga_tmp(nom, 0, 0, 0);
}

void liga_tmp_ebx(int nom)
{
    liga_tmp(nom, 0, 3, 0);
}

void liga_tmp_mem(int nom, int off)
{
    liga_tmp(nom, 1, 0, off);
}

int busca_const_fila(int nom)
{
    int i;
    i = 0;
    while (i < ncon)
    {
        if (da_get(dcon_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int busca_const(int nom)
{
    int f;
    f = busca_const_fila(nom);
    if (f < 0)
    {
        return -1;
    }
    return da_get(dcon_val, f);
}

int inserta_con(int fila, int nom, int val)
{
    int r;
    if (fila < da_count(dcon_nom))
    {
        da_set(dcon_nom, fila, nom);
        da_set(dcon_val, fila, val);
        return 1;
    }
    r = da_add(dcon_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dcon_val, val);
    return 1;
}

void anota_const(int nom, int val)
{
    int f;
    int nueva;
    f = busca_const_fila(nom);
    nueva = 0;
    if (f < 0)
    {
        f = ncon;
        nueva = 1;
    }
    if (inserta_con(f, nom, val) == 1)
    {
        if (nueva == 1)
        {
            ncon = ncon + 1;
        }
    }
}

void libera_tmp(int nom)
{
    int f;
    int u;
    int c;
    f = busca_tmp(nom);
    if (f >= 0)
    {
        u = ntmp - 1;
        if (f != u)
        {
            da_set(dtmp_nom, f, da_get(dtmp_nom, u));
            da_set(dtmp_kind, f, da_get(dtmp_kind, u));
            da_set(dtmp_reg, f, da_get(dtmp_reg, u));
            da_set(dtmp_off, f, da_get(dtmp_off, u));
        }
        ntmp = ntmp - 1;
    }
    c = busca_const_fila(nom);
    if (c >= 0)
    {
        u = ncon - 1;
        if (c != u)
        {
            da_set(dcon_nom, c, da_get(dcon_nom, u));
            da_set(dcon_val, c, da_get(dcon_val, u));
        }
        ncon = ncon - 1;
    }
}

int tmp_en_registro(int cod)
{
    int i;
    i = 0;
    while (i < ntmp)
    {
        if (da_get(dtmp_kind, i) == 0)
        {
            if (da_get(dtmp_reg, i) == cod)
            {
                return da_get(dtmp_nom, i);
            }
        }
        i = i + 1;
    }
    return -1;
}

int eax_ocupado()
{
    if (tmp_en_registro(0) >= 0)
    {
        return 1;
    }
    return 0;
}

int ebx_ocupado()
{
    if (tmp_en_registro(3) >= 0)
    {
        return 1;
    }
    return 0;
}

void reinicia_temporales()
{
    ntmp = 0;
    ncon = 0;
}

// ============================================================
// MARCO Y RETENES.
//
//
// El marco EBP de la funcion en curso. abre_marco y
// cierra_marco fijan solo el estado (la emision del
// prologo y del cierre es de B-2). ranura_marco es
// allocateFrameSlot: sin marco activo acusa y devuelve
// 0; con marco, entrega -4, -8, -12... en orden, y la
// misma ranura sirve a los derrames y a las locales de
// pila. Los tres retenes son los emitMov*FramePlace-
// holder del oraculo: sin marco acusan y devuelven -1;
// con marco emiten MOV registro, [EBP + 0] (8B 85 para
// EAX, 8B 9D para EBX, 8B 8D para ECX, con el desplaza-
// miento de 32 bits a cero) en el ByteBuffer de codigo
// y devuelven el offset del hueco, size + 2.
// ============================================================

void abre_marco()
{
    frame_activo = 1;
    frame_slots = 0;
}

void cierra_marco()
{
    frame_activo = 0;
}

int ranura_marco()
{
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    frame_slots = frame_slots + 1;
    return 0 - (4 * frame_slots);
}

int emite_reten_eax()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x85);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}

int emite_reten_ebx()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x9D);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}

int emite_reten_ecx()
{
    int pos;
    if (frame_activo == 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    pos = bytebuffer_get_size(dcod) + 2;
    bytebuffer_append(dcod, 0x8B);
    bytebuffer_append(dcod, 0x8D);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    bytebuffer_append(dcod, 0);
    return pos;
}

// ============================================================
// DERRAME Y RECARGA.
//
//
// derrama_tmp es spillTemporary: el temporal debe
// existir y vivir en registro; pide su ranura al marco,
// emite MOV [EBP + 0], registro (89 85 si es EAX,
// 89 9D si es EBX) en el ByteBuffer de codigo, registra
// el parche en la lista de derrames de M-1 con el offset
// del hueco (size + 2 antes de emitir) y liga el
// temporal a memoria. Un registro que no sea EAX ni EBX
// acusa despues de consumir la ranura, como el throw
// del oraculo. asigna_registro es allocateRegisterFor-
// Temporary con su politica exacta: si el temporal ya
// vive en registro devuelve el suyo; si EAX esta libre
// lo liga a EAX; si EBX esta libre, a EBX; si no,
// derrama el dueno de EAX y liga a EAX (la rama de
// derramar EBX del oraculo es inalcanzable: si ambos
// estan ocupados, el de EAX siempre existe).
// registro_de es getTemporaryRegister y recarga_tmp es
// reloadTemporary: emite el reten de EAX, registra el
// parche en la lista de recargas y liga el temporal a
// EAX sin desalojar a nadie, como el oraculo.
// ============================================================

void derrama_tmp(int nom)
{
    int f;
    int reg;
    int off;
    int pos;
    f = busca_tmp(nom);
    if (f < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    if (da_get(dtmp_kind, f) != 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    reg = da_get(dtmp_reg, f);
    off = ranura_marco();
    if (off == 0)
    {
        return;
    }
    pos = 0;
    if (reg == 0)
    {
        pos = bytebuffer_get_size(dcod) + 2;
        bytebuffer_append(dcod, 0x89);
        bytebuffer_append(dcod, 0x85);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
        bytebuffer_append(dcod, 0);
    }
    else
    {
        if (reg == 3)
        {
            pos = bytebuffer_get_size(dcod) + 2;
            bytebuffer_append(dcod, 0x89);
            bytebuffer_append(dcod, 0x9D);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
            bytebuffer_append(dcod, 0);
        }
        else
        {
            errores_back = errores_back + 1;
            return;
        }
    }
    registra_spill(nom, pos, off);
    liga_tmp_mem(nom, off);
}

int asigna_registro(int nom)
{
    int f;
    int ocupante;
    f = busca_tmp(nom);
    if (f >= 0)
    {
        if (da_get(dtmp_kind, f) == 0)
        {
            return da_get(dtmp_reg, f);
        }
    }
    if (eax_ocupado() == 0)
    {
        liga_tmp_eax(nom);
        return 0;
    }
    if (ebx_ocupado() == 0)
    {
        liga_tmp_ebx(nom);
        return 3;
    }
    ocupante = tmp_en_registro(0);
    derrama_tmp(ocupante);
    liga_tmp_eax(nom);
    return 0;
}

int registro_de(int nom)
{
    int f;
    f = busca_tmp(nom);
    if (f < 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    if (da_get(dtmp_kind, f) != 0)
    {
        errores_back = errores_back + 1;
        return -1;
    }
    return da_get(dtmp_reg, f);
}

void recarga_tmp(int nom)
{
    int f;
    int off;
    int pos;
    f = busca_tmp(nom);
    if (f < 0)
    {
        errores_back = errores_back + 1;
        return;
    }
    if (da_get(dtmp_kind, f) != 1)
    {
        errores_back = errores_back + 1;
        return;
    }
    off = da_get(dtmp_off, f);
    pos = emite_reten_eax();
    if (pos < 0)
    {
        return;
    }
    registra_reload(nom, pos, off);
    liga_tmp_eax(nom);
}

// ============================================================
// VARIABLES Y CONTEXTOS.
//
//
// El mapa de variables del contexto vivo, el de
// globales y los contextos guardados por funcion.
// declara_var es declareVariable (residencia en DATA,
// con capacidad si es arreglo); declara_var_pila
// transcribe la escritura de la local de pila;
// declara_global registra en el mapa de globales.
// reinicia_variables es resetVariables: vacia el
// contexto vivo y lo siembra con los globales, que se
// ven en todas las funciones. reserva_datos es
// allocateVariableData: devuelve el offset actual del
// ByteBuffer de datos y lo crece en 4 * n ceros.
// guarda_contexto copia las filas del contexto vivo a
// las filas guardadas y anota el directorio (funcion,
// fila inicial, filas); contexto_de devuelve la entrada
// mas reciente de una funcion o -1. Los contextos los
// leeran las pasadas de resolucion de B-2 en adelante.
// ============================================================

int busca_var(int nom)
{
    int i;
    i = 0;
    while (i < nvar)
    {
        if (da_get(dvar_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int inserta_var(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dvar_nom))
    {
        da_set(dvar_nom, fila, nom);
        da_set(dvar_dat, fila, dat);
        da_set(dvar_stack, fila, stack);
        da_set(dvar_soff, fila, soff);
        da_set(dvar_cap, fila, cap);
        return 1;
    }
    r = da_add(dvar_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dvar_dat, dat);
    r = da_add(dvar_stack, stack);
    r = da_add(dvar_soff, soff);
    r = da_add(dvar_cap, cap);
    return 1;
}

void declara_var(int nom, int dat, int cap)
{
    int f;
    int nueva;
    f = busca_var(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nvar;
        nueva = 1;
    }
    if (inserta_var(f, nom, dat, 0, 0, cap) == 1)
    {
        if (nueva == 1)
        {
            nvar = nvar + 1;
        }
    }
}

void declara_var_pila(int nom, int soff, int cap)
{
    int f;
    int nueva;
    f = busca_var(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nvar;
        nueva = 1;
    }
    if (inserta_var(f, nom, 0, 1, soff, cap) == 1)
    {
        if (nueva == 1)
        {
            nvar = nvar + 1;
        }
    }
}

int busca_glo(int nom)
{
    int i;
    i = 0;
    while (i < nglo)
    {
        if (da_get(dglo_nom, i) == nom)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

int inserta_glo(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dglo_nom))
    {
        da_set(dglo_nom, fila, nom);
        da_set(dglo_dat, fila, dat);
        da_set(dglo_stack, fila, stack);
        da_set(dglo_soff, fila, soff);
        da_set(dglo_cap, fila, cap);
        return 1;
    }
    r = da_add(dglo_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dglo_dat, dat);
    r = da_add(dglo_stack, stack);
    r = da_add(dglo_soff, soff);
    r = da_add(dglo_cap, cap);
    return 1;
}

void declara_global(int nom, int dat, int cap)
{
    int f;
    int nueva;
    f = busca_glo(nom);
    nueva = 0;
    if (f < 0)
    {
        f = nglo;
        nueva = 1;
    }
    if (inserta_glo(f, nom, dat, 0, 0, cap) == 1)
    {
        if (nueva == 1)
        {
            nglo = nglo + 1;
        }
    }
}

void reinicia_variables()
{
    int i;
    nvar = 0;
    i = 0;
    while (i < nglo)
    {
        if (inserta_var(i, da_get(dglo_nom, i), da_get(dglo_dat, i), da_get(dglo_stack, i), da_get(dglo_soff, i), da_get(dglo_cap, i)) == 1)
        {
            nvar = nvar + 1;
        }
        i = i + 1;
    }
}

int reserva_datos(int n)
{
    int off;
    int i;
    off = bytebuffer_get_size(ddat);
    i = 0;
    while (i < 4 * n)
    {
        bytebuffer_append(ddat, 0);
        i = i + 1;
    }
    return off;
}

int inserta_sv(int fila, int nom, int dat, int stack, int soff, int cap)
{
    int r;
    if (fila < da_count(dsv_nom))
    {
        da_set(dsv_nom, fila, nom);
        da_set(dsv_dat, fila, dat);
        da_set(dsv_stack, fila, stack);
        da_set(dsv_soff, fila, soff);
        da_set(dsv_cap, fila, cap);
        return 1;
    }
    r = da_add(dsv_nom, nom);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dsv_dat, dat);
    r = da_add(dsv_stack, stack);
    r = da_add(dsv_soff, soff);
    r = da_add(dsv_cap, cap);
    return 1;
}

int inserta_ctx(int fila, int fun, int ini, int n)
{
    int r;
    if (fila < da_count(dctx_fun))
    {
        da_set(dctx_fun, fila, fun);
        da_set(dctx_ini, fila, ini);
        da_set(dctx_n, fila, n);
        return 1;
    }
    r = da_add(dctx_fun, fun);
    if (r < 0)
    {
        errores_back = errores_back + 1;
        return 0;
    }
    r = da_add(dctx_ini, ini);
    r = da_add(dctx_n, n);
    return 1;
}

void guarda_contexto(int fun)
{
    int i;
    int ini;
    ini = nsv;
    i = 0;
    while (i < nvar)
    {
        if (inserta_sv(nsv, da_get(dvar_nom, i), da_get(dvar_dat, i), da_get(dvar_stack, i), da_get(dvar_soff, i), da_get(dvar_cap, i)) == 0)
        {
            return;
        }
        nsv = nsv + 1;
        i = i + 1;
    }
    if (inserta_ctx(nctx, fun, ini, nvar) == 1)
    {
        nctx = nctx + 1;
    }
}

int contexto_de(int fun)
{
    int i;
    i = nctx - 1;
    while (i >= 0)
    {
        if (da_get(dctx_fun, i) == fun)
        {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

// ============================================================
// IMPRIME LA MAQUINARIA.
//
//
// El volcado de la sonda B-1: el estado del marco, las
// filas de temporales y de constantes, las del contexto
// vivo y las de globales, el directorio de contextos y
// las filas guardadas, el ByteBuffer de codigo entero
// (su cuenta y cada byte) y la cuenta del de datos, y
// al final el contador de errores de la pieza. volcado
// junta las listas de M-1 y la maquinaria.
// ============================================================

void imprime_maquinaria()
{
    int i;
    print_int(frame_activo);
    print_int(frame_slots);
    print_int(ntmp);
    i = 0;
    while (i < ntmp)
    {
        print_int(da_get(dtmp_nom, i));
        print_int(da_get(dtmp_kind, i));
        print_int(da_get(dtmp_reg, i));
        print_int(da_get(dtmp_off, i));
        i = i + 1;
    }
    print_int(ncon);
    i = 0;
    while (i < ncon)
    {
        print_int(da_get(dcon_nom, i));
        print_int(da_get(dcon_val, i));
        i = i + 1;
    }
    print_int(nvar);
    i = 0;
    while (i < nvar)
    {
        print_int(da_get(dvar_nom, i));
        print_int(da_get(dvar_dat, i));
        print_int(da_get(dvar_stack, i));
        print_int(da_get(dvar_soff, i));
        print_int(da_get(dvar_cap, i));
        i = i + 1;
    }
    print_int(nglo);
    i = 0;
    while (i < nglo)
    {
        print_int(da_get(dglo_nom, i));
        print_int(da_get(dglo_dat, i));
        print_int(da_get(dglo_stack, i));
        print_int(da_get(dglo_soff, i));
        print_int(da_get(dglo_cap, i));
        i = i + 1;
    }
    print_int(nctx);
    i = 0;
    while (i < nctx)
    {
        print_int(da_get(dctx_fun, i));
        print_int(da_get(dctx_ini, i));
        print_int(da_get(dctx_n, i));
        i = i + 1;
    }
    print_int(nsv);
    i = 0;
    while (i < nsv)
    {
        print_int(da_get(dsv_nom, i));
        print_int(da_get(dsv_dat, i));
        print_int(da_get(dsv_stack, i));
        print_int(da_get(dsv_soff, i));
        print_int(da_get(dsv_cap, i));
        i = i + 1;
    }
    print_int(bytebuffer_get_size(dcod));
    i = 0;
    while (i < bytebuffer_get_size(dcod))
    {
        print_int(bytebuffer_get(dcod, i));
        i = i + 1;
    }
    print_int(bytebuffer_get_size(ddat));
    print_int(errores_back);
}

void volcado()
{
    imprime_listas();
    imprime_maquinaria();
}


// ============================================================
// ENTRADA IR.
//
// El programa que consume generate(): una lista plana
// de instrucciones (opcode, nombre, operando,
// resultado, valor) con los Declare globales al frente
// — dir_nglob marca cuantos son. registra_ir es la
// unica puerta de entrada, con la disciplina de
// insercion y reuso de la casa. Los textos viven en
// dpool y se referencian ini * 128 + largo, el formato
// de la piscina de la biblioteca; quien produce el IR
// interna los nombres (una sola referencia por texto),
// y el operando de parametros de un FunctionBegin se
// construye de modo que la referencia de cada
// parametro es la de su subcadena dentro del operando,
// que es la que el parseo de genera() devuelve. Este
// es el arnes de entrada de la pieza sola: en el
// compilador ensamblado el IR llega por el mango del
// generador (M-6).
// ============================================================

void reinicia_ir()
{
    dir_op = da_create(region_backend, 256);
    dir_nom = da_create(region_backend, 256);
    dir_ope = da_create(region_backend, 256);
    dir_res = da_create(region_backend, 256);
    dir_val = da_create(region_backend, 256);
    dir_aux = da_create(region_backend, 256);
    dpool = string_pool_create(region_backend);
    ndir = 0;
    dir_nglob = 0;
}

void registra_ir(int op, int nom, int ope, int res, int val)
{
    if (ndir < da_count(dir_op))
    {
        da_set(dir_op, ndir, op);
        da_set(dir_nom, ndir, nom);
        da_set(dir_ope, ndir, ope);
        da_set(dir_res, ndir, res);
        da_set(dir_val, ndir, val);
        da_set(dir_aux, ndir, 0);
    }
    else
    {
        da_add(dir_op, op);
        da_add(dir_nom, nom);
        da_add(dir_ope, ope);
        da_add(dir_res, res);
        da_add(dir_val, val);
        da_add(dir_aux, 0);
    }
    ndir = ndir + 1;
}

// El auxiliar de la ultima instruccion registrada
// (el temporal de conteo de FileWrite).
void registra_aux(int ref)
{
    da_set(dir_aux, ndir - 1, ref);
}

int texto_len(int ref)
{
    return string_pool_len(dpool, ref);
}

int texto_ini(int ref)
{
    return ref / 128;
}

int texto_char(int ref, int i)
{
    return string_pool_get_char(dpool, texto_ini(ref), i);
}

int texto_es_main(int ref)
{
    if (texto_len(ref) != 4)
    {
        return 0;
    }
    if (texto_char(ref, 0) != 109)
    {
        return 0;
    }
    if (texto_char(ref, 1) != 97)
    {
        return 0;
    }
    if (texto_char(ref, 2) != 105)
    {
        return 0;
    }
    if (texto_char(ref, 3) != 110)
    {
        return 0;
    }
    return 1;
}

// ============================================================
// EMISOR DEL PASEO.
//
// Las emisiones de generate() sobre el ByteBuffer de
// codigo, con las codificaciones de X86Emitter de
// Stage 0. El hueco es un imm32 en cero cuyo offset se
// devuelve (la semantica de los placeholders del
// Emitter), y parche32 escribe un dword little-endian
// en un offset ya entregado: es el patch32 del
// oraculo, con el que el cierre de marco rellena el
// tamano del marco. Los accesos EBP-relativos con
// desplazamiento ya conocido son los retenes de B-1
// sin hueco: 89 85 / 89 9D guardan, 8B 85 / 8B 9D
// cargan.
// ============================================================

void em_byte(int b)
{
    bytebuffer_append(dcod, b & 255);
}

void em_dword(int v)
{
    em_byte(v & 255);
    em_byte((v >> 8) & 255);
    em_byte((v >> 16) & 255);
    em_byte((v >> 24) & 255);
}

int em_hueco()
{
    int pos;
    pos = bytebuffer_get_size(dcod);
    em_dword(0);
    return pos;
}

void parche32(int pos, int v)
{
    bytebuffer_patch(dcod, pos, v & 255);
    bytebuffer_patch(dcod, pos + 1, (v >> 8) & 255);
    bytebuffer_patch(dcod, pos + 2, (v >> 16) & 255);
    bytebuffer_patch(dcod, pos + 3, (v >> 24) & 255);
}

void em_push_ebp()
{
    em_byte(85);
}

void em_mov_ebp_esp()
{
    em_byte(137);
    em_byte(229);
}

void em_mov_esp_ebp()
{
    em_byte(137);
    em_byte(236);
}

