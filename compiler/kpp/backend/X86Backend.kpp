int carga_mem_eax(int tmp, int off)
{
    int pos;
    pos = emite_reten_eax();
    if (pos < 0)
    {
        return -1;
    }
    registra_reload(tmp, pos, off);
    return 0;
}

void registra_arg(int ref)
{
    if (ndarg < da_count(darg))
    {
        da_set(darg, ndarg, ref);
    }
    else
    {
        da_add(darg, ref);
    }
    ndarg = ndarg + 1;
}

int lee_arg(int i)
{
    return da_get(darg, i);
}

int busca_entrada(int fun)
{
    int i;
    i = 0;
    while (i < ndent)
    {
        if (da_get(dent_fun, i) == fun)
        {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

void rellena_fc()
{
    int i;
    int fila;
    i = 0;
    while (i < nfc)
    {
        fila = busca_entrada(da_get(dfc_fun, i));
        if (fila < 0)
        {
            errores_back = errores_back + 1;
            return;
        }
        parche32(da_get(dfc_pos, i), da_get(dent_pos, fila) - (da_get(dfc_pos, i) + 4));
        i = i + 1;
    }
}

