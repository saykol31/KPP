}

int emitJneRel32Placeholder()
{
    emitByte(0x0F);
    emitByte(0x85);
    return emitRel32Placeholder();
}

// ============================================================
// PARCHES: RELLENAR LOS HUECOS.
//
// patch32 escribe el valor carril bajo primero sobre
// el hueco, con bytebuffer_patch carril a carril. Su
// guarda es la de la casa: Stage 0 lanza out_of_range
// si offset + 4 pasa del codigo emitido; aqui el
// intervalo se valida entero contra la cuenta del
// ByteBuffer antes de tocar un byte — si no cabe, la
// guarda acusa una sola vez en errores_emit y no
// escribe nada, como siempre. patchRel32 calcula el
// desplazamiento desde la instruccion que sigue al
// rel32, destino - (offset + 4), y lo escribe con
// patch32: la misma guarda lo cubre, una sola acusacion.
// ============================================================

void patch32(int pos, int v)
{
    int bien;
    bien = 0;
    if (pos >= 0)
    {
        if (pos + 4 <= bytebuffer_get_size(bcod))
        {
            bien = 1;
        }
    }
    if (bien == 1)
    {
        bytebuffer_patch(bcod, pos, v);
        bytebuffer_patch(bcod, pos + 1, v >> 8);
        bytebuffer_patch(bcod, pos + 2, v >> 16);
        bytebuffer_patch(bcod, pos + 3, v >> 24);
    }
    else
    {
        errores_emit = errores_emit + 1;
    }
}

void patchRel32(int pos, int destino)
{
    int desp;
    desp = destino - (pos + 4);
    patch32(pos, desp);
}

// ============================================================
// IMPRIME EL CODIGO EMITIDO.
//
// La cuenta del ByteBuffer, cada byte en decimal leido
// con bytebuffer_get y la cuenta de la guarda: la
// lectura de campo se coteja byte a byte contra el
// oraculo de Stage 0 (216 bytes, guarda en cero).
// ============================================================

void imprime_emit()
{
    int n;
    int i;
    n = bytebuffer_get_size(bcod);
    print_int(n);
    i = 0;
    while (i < n)
    {
        print_int(bytebuffer_get(bcod, i));
        i = i + 1;
    }
    print_int(errores_emit);
}

// ============================================================
// SONDA DEL EMITTER 1: LA EMISION DIRECTA COMPLETA.
//
// Ejercita los 68 metodos con la misma secuencia y los
// mismos argumentos que el oraculo C++ de Stage 0; la
// salida esperada son los 216 bytes de ese oraculo.
// ============================================================

void sonda_emitter1()
{
    reinicia_emit();
    emitByte(170);
    emitPushEbp();
    emitMovEbpEsp();
    emitMovEspEbp();
    emitPopEbp();
    emitMovEaxEbpRelative(-4);
    emitMovEbxEbpRelative(8);
    emitMovEcxEbpRelative(-12);
    emitMovEbpRelativeEax(16);
    emitMovEbpRelativeEbx(-8);
    emitCmpEaxEbx();
    emitSeteAl();
    emitSetneAl();
    emitSetlAl();
    emitSetleAl();
    emitSetgAl();
    emitSetgeAl();
    emitMovzxEaxAl();
    emitMovEaxImm32(305419896);
    emitMovMemImm32(4096, -1);
    emitMovMemEax32(8192);
    emitMovMemEbx32(8196);
    emitMovEaxEdxMem32();
    emitMovEbxEdxMem32();
    emitMovMemEdxEax32();
    emitMovMemEdxEbx32();
    emitMovRegImm32(187, 195948557);
    emitAddEaxEbx();
    emitAndEaxEbx();
    emitOrEaxEbx();
    emitShlEaxCl();
    emitSarEaxCl();
    emitShlEaxImm8(3);
    emitSarEaxImm8(5);
    emitSubEaxEbx();
    emitMulEaxEbx();
    emitCdq();
    emitIdivEbx();
    emitMovEaxEdx();
    emitMovEaxEbx();
    emitMovEbxEax();
    emitMovEbxEbp();
    emitMovEdxEax();
    emitMovEdxEbx();
    emitAddEbpImm32(256);
    emitAddEaxImm32(-16);
    emitXorEdxEdx();
    emitMovEcxImm32(1000000000);
    emitDivEcx();
    emitAddDlImm8(48);
    emitDecEdi();
    emitMovEdiMem8Dl();
    emitMovEdiImm32(12288);
    emitPushEax();
    emitPushEbx();
    emitAddEspImm32(-32);
    emitPopEax();
    emitPopEbx();
    emitMovEdxEdi();
    emitMovEdiMem8Imm8(65);
    emitInt(64);
    emitRet();
    emitJmpRel32(-5);
    emitJeRel32(4660);
    emitJneRel32(-256);
    emitCmpEaxImm32(2147483647);
    emitAndEaxImm32(-16711936);
    emitCmpAhImm8(63);
    imprime_emit();
}

// ============================================================
// SONDA DEL EMITTER 2: PLACEHOLDERS Y PARCHES.
//
// Emite los 14 placeholders capturando cada offset, mete un
// byte intermedio de la familia directa y cierra con un
// ret; despues parchea cada hueco: patch32 con valores
// positivos y negativos y patchRel32 hacia adelante (al
// final y al ret) y hacia atras (al principio y al jmp).
// La salida esperada son los 86 bytes del oraculo extendido
// de Stage 0, con la guarda en cero. La sonda reinicia el
// emitter, asi que la corriente de la sonda 1 queda intacta
// byte a byte.
// ============================================================

void sonda_emitter2()
{
    int p_sub;
    int p_eax;
    int p_ebx;
    int p_sto;
    int p_msa;
    int p_msb;
    int p_lea;
    int p_leb;
    int p_jmp;
    int p_je;
    int p_jbe;
    int p_jne;
    int p_imm;
    int p_rel;
    reinicia_emit();
    p_sub = emitSubEspImm32Placeholder();
    p_eax = emitMovEaxMem32Placeholder();
    p_ebx = emitMovEbxMem32Placeholder();
    p_sto = emitMovMemImm32Placeholder(-1);
    p_msa = emitMovMemEax32Placeholder();
    p_msb = emitMovMemEbx32Placeholder();
    p_lea = emitLeaEdxEaxScaled4Placeholder();
    p_leb = emitLeaEdxEbxScaled4Placeholder();
    emitPushEbp();
    p_jmp = emitJmpRel32Placeholder();
    p_je = emitJeRel32Placeholder();
    p_jbe = emitJbeRel32Placeholder();
    p_jne = emitJneRel32Placeholder();
    p_imm = emitImm32Placeholder();
    p_rel = emitRel32Placeholder();
    emitRet();
    patch32(p_sub, 48);
    patch32(p_eax, 8192);
    patch32(p_ebx, 305419896);
    patch32(p_sto, 12288);
    patch32(p_msa, 8196);
    patch32(p_msb, -16);
    patch32(p_lea, 4096);
    patch32(p_leb, -4);
    patch32(p_imm, -1000000);
    patchRel32(p_jmp, 86);
    patchRel32(p_je, 0);
    patchRel32(p_jbe, 85);
    patchRel32(p_jne, 54);
    patchRel32(p_rel, 0);
    imprime_emit();
}

int main()
{
    inicia_emit();
    sonda_emitter1();
    sonda_emitter2();
    return 0;
}
