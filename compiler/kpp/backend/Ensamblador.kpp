void emite_file()
{
    // emitDibujaFile del oraculo: el boton FILE
    // (funcion 8, id 8) y su rotulo (funcion 4,
    // menuTexto + 63, longitud 4); si el menu
    // esta abierto con estado 2, el panel
    // (funcion 13) y los tres renglones como
    // botones 9 a 11 con sus rotulos: los
    // desplazamientos y longitudes de
    // menuTexto son constantes que el oraculo
    // parchea en el sitio.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 983105);
    em_mov_reg_imm(185, 1310737);
    em_mov_reg_imm(186, 8);
    em_mov_reg_imm(190, 3166320);
    em_int(64);
    em_mov_eax_imm(4);
    em_mov_reg_imm(187, 1966104);
    em_mov_reg_imm(185, -2130706433);
    em_mov_edx_dir(13);
    em_byte(131);
    em_byte(194);
    em_byte(63);
    em_byte(190);
    em_dword(4);
    em_int(64);
    em_mov_eax_mem(9);
    em_cmp_eax_imm(2);
    int no_file = em_jne_hueco();
    em_mov_eax_imm(13);
    em_mov_reg_imm(187, 983150);
    em_mov_reg_imm(185, 2424876);
    em_mov_reg_imm(186, 1579032);
    em_int(64);
    // Renglon 1: y 37, boton 9, texto +68, largo 4.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 983150);
    em_mov_reg_imm(185, 2424846);
    em_mov_reg_imm(186, 9);
    em_mov_reg_imm(190, 2631720);
    em_int(64);
