            }
            n2 = ntmp;
            i2 = 0;
            while (i2 < n2)
            {
                if (da_get(dtmp_kind, i2) == 0)
                {
                    derrama_tmp(da_get(dtmp_nom, i2));
                }
                i2 = i2 + 1;
            }
            fila = busca_tmp(aux);
