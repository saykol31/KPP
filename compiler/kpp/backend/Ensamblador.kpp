            dereax = 0;
            if (kd == 0 && rd == 0)
            {
                dereax = 1;
            }
            em_push_ebx();
            if (dereax == 1)
            {
                em_push_eax();
            }
            if (ki == 1)
            {
                pos = emite_reten_eax();
                if (pos < 0)
                {
                    return;
                }
                registra_reload(izq, pos, da_get(dtmp_off, fila));
            }
            else if (ri == 3)
            {
                em_mov_eax_ebx();
            }
            em_normaliza();
            if (dereax == 1)
            {
                em_mov_ebx_eax();
                em_pop_eax();
                em_normaliza();
            }
            else
            {
                em_push_eax();
                if (kd == 1)
                {
                    pos = emite_reten_eax();
                    if (pos < 0)
                    {
                        return;
                    }
                    registra_reload(der, pos, da_get(dtmp_off, fila2));
                }
                else if (rd == 3)
                {
                    em_mov_eax_ebx();
                }
                em_normaliza();
                em_pop_ebx();
            }
            if (op == 50)
            {
                em_and_eax_ebx();
            }
            else
            {
                em_or_eax_ebx();
            }
            em_pop_ebx();
            libera_tmp(izq);
            libera_tmp(der);
            liga_tmp_eax(res);
        }
        else if (op == 52)
        {
            if (busca_tmp(ope) < 0)
