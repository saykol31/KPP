    registra_parche(em_jmp_hueco(), 1, 4);
}


void emite_isla_eliminar()
{
    // ELIMINAR: la guarda de CORTAR; vacia sin
    // copiar, cierra el menu y redibuja.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int g1 = em_jne_hueco();
    em_mov_eax_mem(10);
    em_cmp_eax_imm(0);
    int g2 = em_je_hueco();
    registra_parche(em_call_hueco(), 13, 4);
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    parche32(g2, salir - (g2 + 4));
    registra_parche(em_jmp_hueco(), 1, 4);
}


