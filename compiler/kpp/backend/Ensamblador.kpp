void emite_isla_file()
{
    // La isla del boton FILE: si su menu esta
    // abierto (estado 2) lo cierra; si no, lo
    // abre con estado 2. En ambos casos
    // redibuja y vuelve al bucle (las llamadas
    // y el salto se registran con duena 5).
    em_mov_eax_mem(9);
    em_cmp_eax_imm(2);
    int cerrar = em_je_hueco();
    em_mov_eax_imm(2);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 5);
    registra_parche(em_jmp_hueco(), 1, 5);
    parche32(cerrar,
             bytebuffer_get_size(dcod) - (cerrar + 4));
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 5);
    registra_parche(em_jmp_hueco(), 1, 5);
}


void emite_isla_open()
{
    // OPEN: con el menu FILE abierto
    // (estado 2), lo cierra y redibuja; si la
    // guarda falla, vuelve al bucle sin
    // actuar. En el oraculo la accion solo
    // cierra el menu: los dialogos reales
    // quedan fuera de esta pieza.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(2);
    int g1 = em_jne_hueco();
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 5);
    registra_parche(em_jmp_hueco(), 1, 5);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    registra_parche(em_jmp_hueco(), 1, 5);
}


void emite_isla_save()
{
    // SAVE: con el menu FILE abierto
    // (estado 2), lo cierra y redibuja; si la
    // guarda falla, vuelve al bucle sin
    // actuar. En el oraculo la accion solo
    // cierra el menu: los dialogos reales
    // quedan fuera de esta pieza.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(2);
    int g1 = em_jne_hueco();
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 5);
    registra_parche(em_jmp_hueco(), 1, 5);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    registra_parche(em_jmp_hueco(), 1, 5);
}


void emite_isla_close()
{
    // CLOSE: con el menu FILE abierto
    // (estado 2), lo cierra y redibuja; si la
    // guarda falla, vuelve al bucle sin
    // actuar. En el oraculo la accion solo
    // cierra el menu: los dialogos reales
    // quedan fuera de esta pieza.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(2);
    int g1 = em_jne_hueco();
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 5);
    registra_parche(em_jmp_hueco(), 1, 5);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    registra_parche(em_jmp_hueco(), 1, 5);
}


void emite_escritura()
{
    int f1;
    int f2;
    int f3;
    int f4;
    int f5;
    int f6;
    int f7;
    int s1;
    int bucle;
    int terminado;
    int usa_resto;
    int conv;
    int conv_vuelta;
    int vuelta;
    int exito;
    int fracaso;
    int epilogo;
    // FILE_WRITE de emitFileIoRuntime: valida
    // (ruta y arreglo no nulos, cantidad y
    // capacidad no negativas, cantidad <=
    // capacidad), carga las bases ESI =
    // parametros y EDI = scratch (anotadas en
    // los res_ de archivos: las rellena quien
    // ensambla con DATA), crea/reescribe una
    // sola vez con la subfuncion 2 y escribe en
    // bloques de 65536 con la 3, convirtiendo
    // cada celda int32 en un byte del scratch.
    // Devuelve 0 o -1. Los saltos se parchean
    // en el sitio, como en el oraculo.
    em_prologo_io();
    em_carga_eax_esp(32);
    em_cmp_eax_imm(0);
    f1 = em_je_hueco();
    em_carga_eax_esp(44);
    em_cmp_eax_imm(0);
    f2 = em_je_hueco();
    em_carga_ecx_esp(28);
    em_cmp_reg_imm(249, 0);
    f3 = em_jl_hueco();
    em_carga_edx_esp(24);
    em_cmp_reg_imm(250, 0);
    f4 = em_jl_hueco();
    em_carga_ecx_esp(28);
    em_carga_edx_esp(24);
    em_byte(57);
    em_byte(209);
    f5 = em_ja_hueco();
    em_guarda_imm_esp(0, 0);
    em_carga_eax_esp(28);
    em_guarda_eax_esp(4);
    em_carga_eax_esp(44);
    em_guarda_eax_esp(12);
    res_esc_params = em_mov_esi_hueco();
    res_esc_scratch = em_mov_edi_hueco();
    em_mov_esi_dword(0, 2);
    em_mov_esi_dword(4, 0);
    em_mov_esi_dword(8, 0);
    em_mov_esi_dword(12, 0);
    em_mov_esi_dword(16, 0);
    em_byte(198);
    em_byte(70);
    em_byte(20);
    em_byte(0);
    em_carga_eax_esp(32);
    em_byte(137);
    em_byte(70);
    em_byte(21);
    em_byte(137);
    em_byte(243);
    em_mov_eax_imm(70);
    em_int(64);
    em_cmp_eax_imm(0);
    f6 = em_jne_hueco();
    bucle = bytebuffer_get_size(dcod);
    em_carga_eax_esp(4);
    em_byte(133);
    em_byte(192);
    terminado = em_jle_hueco();
    em_carga_eax_esp(4);
    em_cmp_reg_imm(248, 65536);
    usa_resto = em_jbe_hueco();
    em_mov_eax_imm(65536);
    parche32(usa_resto,
             bytebuffer_get_size(dcod) - (usa_resto + 4));
    em_guarda_eax_esp(8);
    em_carga_ebx_esp(12);
    em_byte(137);
    em_byte(250);
    em_carga_ecx_esp(8);
    conv = bytebuffer_get_size(dcod);
    em_byte(139);
    em_byte(3);
    em_byte(136);
    em_byte(2);
    em_byte(131);
    em_byte(195);
    em_byte(4);
    em_byte(66);
    em_byte(73);
    conv_vuelta = em_jne_hueco();
    parche32(conv_vuelta, conv - (conv_vuelta + 4));
    em_guarda_ebx_esp(12);
    em_mov_esi_dword(0, 3);
    em_carga_eax_esp(0);
    em_byte(137);
    em_byte(70);
    em_byte(4);
    em_mov_esi_dword(8, 0);
    em_carga_eax_esp(8);
    em_byte(137);
    em_byte(70);
    em_byte(12);
    em_byte(137);
    em_byte(126);
    em_byte(16);
    em_byte(137);
    em_byte(243);
    em_mov_eax_imm(70);
    em_int(64);
    em_cmp_eax_imm(0);
    f7 = em_jne_hueco();
    em_carga_eax_esp(0);
    em_byte(3);
    em_byte(68);
    em_byte(36);
    em_byte(8);
    em_guarda_eax_esp(0);
    em_carga_eax_esp(4);
    em_byte(43);
    em_byte(68);
    em_byte(36);
    em_byte(8);
    em_guarda_eax_esp(4);
    vuelta = em_jmp_hueco();
    parche32(vuelta, bucle - (vuelta + 4));
    exito = bytebuffer_get_size(dcod);
    em_byte(49);
    em_byte(192);
    s1 = em_jmp_hueco();
    fracaso = bytebuffer_get_size(dcod);
    em_mov_eax_imm(-1);
    epilogo = bytebuffer_get_size(dcod);
    em_epilogo_io();
    parche32(terminado, exito - (terminado + 4));
    parche32(f1, fracaso - (f1 + 4));
    parche32(f2, fracaso - (f2 + 4));
    parche32(f3, fracaso - (f3 + 4));
    parche32(f4, fracaso - (f4 + 4));
    parche32(f5, fracaso - (f5 + 4));
    parche32(f6, fracaso - (f6 + 4));
    parche32(f7, fracaso - (f7 + 4));
    parche32(s1, epilogo - (s1 + 4));
}


void emite_lectura()
{
    int f1;
    int f2;
    int f3;
    int s1;
    int bucle;
    int terminado;
    int usa_resto;
    int conv;
    int conv_vuelta;
    int vuelta;
    int estado_eof;
    int estado_error;
    int estado_normal;
    int eof;
    int continua_eof;
    int error;
    int parcial;
    int sin_datos;
    int proceso;
    int invalido;
    int cero;
    int eof_tras_copia;
    int bloque_corto;
    int exito;
    int fracaso;
    int epilogo;
    // FILE_READ de emitFileIoRuntime: valida
    // (ruta y arreglo no nulos, capacidad
    // positiva), carga las bases como la
    // escritura y lee con la subfuncion 0 en
    // bloques de 65536, convirtiendo cada byte
    // del scratch en una celda int32. El EOF
    // (6) es exito corto y un error con datos
    // devuelve el total parcial; sin datos,
    // -1. Los saltos se parchean en el sitio,
    // como en el oraculo.
    em_prologo_io();
    em_carga_eax_esp(32);
    em_cmp_eax_imm(0);
    f1 = em_je_hueco();
    em_carga_eax_esp(44);
    em_cmp_eax_imm(0);
    f2 = em_je_hueco();
    em_carga_ecx_esp(28);
    em_cmp_reg_imm(249, 0);
    f3 = em_jle_hueco();
    em_guarda_imm_esp(0, 0);
    em_carga_eax_esp(28);
    em_guarda_eax_esp(4);
    em_carga_eax_esp(44);
    em_guarda_eax_esp(12);
    em_guarda_imm_esp(16, 0);
    res_lec_params = em_mov_esi_hueco();
    res_lec_scratch = em_mov_edi_hueco();
    em_mov_esi_dword(0, 0);
    em_mov_esi_dword(4, 0);
    em_mov_esi_dword(8, 0);
    em_mov_esi_dword(12, 0);
    em_byte(137);
    em_byte(126);
    em_byte(16);
    em_byte(198);
    em_byte(70);
    em_byte(20);
    em_byte(0);
    em_carga_eax_esp(32);
    em_byte(137);
    em_byte(70);
    em_byte(21);
    bucle = bytebuffer_get_size(dcod);
    em_carga_eax_esp(4);
    em_byte(133);
    em_byte(192);
    terminado = em_jle_hueco();
    em_carga_eax_esp(4);
    em_cmp_reg_imm(248, 65536);
    usa_resto = em_jbe_hueco();
    em_mov_eax_imm(65536);
    parche32(usa_resto,
             bytebuffer_get_size(dcod) - (usa_resto + 4));
    em_guarda_eax_esp(8);
    em_guarda_eax_esp(20);
    em_carga_eax_esp(0);
    em_byte(137);
    em_byte(70);
    em_byte(4);
    em_mov_esi_dword(8, 0);
    em_carga_eax_esp(8);
    em_byte(137);
    em_byte(70);
    em_byte(12);
    em_guarda_imm_esp(16, 0);
    em_byte(137);
    em_byte(243);
    em_mov_eax_imm(70);
    em_int(64);
    em_cmp_eax_imm(6);
    estado_eof = em_je_hueco();
    em_cmp_eax_imm(0);
    estado_error = em_jne_hueco();
    estado_normal = em_jmp_hueco();
    eof = bytebuffer_get_size(dcod);
    em_guarda_imm_esp(16, 1);
    continua_eof = em_jmp_hueco();
    error = bytebuffer_get_size(dcod);
    em_carga_eax_esp(0);
    em_byte(133);
    em_byte(192);
    parcial = em_jne_hueco();
    sin_datos = em_jmp_hueco();
    proceso = bytebuffer_get_size(dcod);
    em_carga_eax_esp(8);
    em_byte(57);
    em_byte(195);
    invalido = em_ja_hueco();
    em_guarda_ebx_esp(8);
    em_byte(133);
    em_byte(219);
    cero = em_je_hueco();
    em_byte(137);
    em_byte(250);
    em_carga_ebx_esp(12);
    em_carga_ecx_esp(8);
    conv = bytebuffer_get_size(dcod);
    em_byte(15);
    em_byte(182);
    em_byte(2);
    em_byte(137);
    em_byte(3);
    em_byte(66);
    em_byte(131);
    em_byte(195);
    em_byte(4);
    em_byte(73);
    conv_vuelta = em_jne_hueco();
    parche32(conv_vuelta, conv - (conv_vuelta + 4));
    em_guarda_ebx_esp(12);
    em_carga_eax_esp(0);
    em_byte(3);
    em_byte(68);
    em_byte(36);
    em_byte(8);
    em_guarda_eax_esp(0);
    em_carga_eax_esp(4);
    em_byte(43);
    em_byte(68);
    em_byte(36);
    em_byte(8);
    em_guarda_eax_esp(4);
    em_carga_eax_esp(16);
    em_byte(133);
    em_byte(192);
    eof_tras_copia = em_jne_hueco();
    em_carga_eax_esp(8);
    em_byte(59);
    em_byte(68);
    em_byte(36);
    em_byte(20);
    bloque_corto = em_jb_hueco();
    vuelta = em_jmp_hueco();
    parche32(vuelta, bucle - (vuelta + 4));
    exito = bytebuffer_get_size(dcod);
    em_carga_eax_esp(0);
    s1 = em_jmp_hueco();
    fracaso = bytebuffer_get_size(dcod);
    em_mov_eax_imm(-1);
    epilogo = bytebuffer_get_size(dcod);
    em_epilogo_io();
    parche32(terminado, exito - (terminado + 4));
    parche32(estado_eof, eof - (estado_eof + 4));
    parche32(continua_eof, proceso - (continua_eof + 4));
    parche32(estado_normal, proceso - (estado_normal + 4));
    parche32(estado_error, error - (estado_error + 4));
    parche32(parcial, exito - (parcial + 4));
    parche32(sin_datos, fracaso - (sin_datos + 4));
    parche32(invalido, error - (invalido + 4));
    parche32(cero, exito - (cero + 4));
    parche32(eof_tras_copia, exito - (eof_tras_copia + 4));
    parche32(bloque_corto, exito - (bloque_corto + 4));
    parche32(f1, fracaso - (f1 + 4));
    parche32(f2, fracaso - (f2 + 4));
    parche32(f3, fracaso - (f3 + 4));
    parche32(s1, epilogo - (s1 + 4));
}


void emite_grafico()
{
    int p;
    // MASCARA DE EVENTOS (funcion 40, 0x27).
    em_mov_eax_imm(40);
    em_mov_reg_imm(187, 39);
    em_int(64);
    // START: call DRAW_WINDOW, jmp al cuerpo.
    res_draw = em_call_hueco();
    registra_parche(res_draw, 0, 1);
    res_main = em_jmp_hueco();
    // BUCLE DE EVENTOS (funcion 10).
    dir_bucle = bytebuffer_get_size(dcod);
    res_bucle = dir_bucle;
    em_mov_eax_imm(10);
    em_int(64);
    // DESPACHO: 1 redraw, 2 tecla, 3 boton, 6 raton.
    em_cmp_eax_imm(1);
    p = em_je_hueco();
    registra_parche(p, 2, 1);
    em_cmp_eax_imm(2);
    p = em_je_hueco();
    registra_parche(p, 3, 1);
    em_cmp_eax_imm(3);
    p = em_je_hueco();
    registra_parche(p, 4, 1);
    em_cmp_eax_imm(6);
    p = em_je_hueco();
    registra_parche(p, 5, 3);
    // Evento desconocido: volver al bucle.
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // REDRAW: call DRAW_WINDOW y volver al bucle.
    dir_redraw = bytebuffer_get_size(dcod);
    p = em_call_hueco();
    registra_parche(p, 0, 1);
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // TECLA: funcion 2 y volver al bucle.
    dir_tecla = bytebuffer_get_size(dcod);
    em_mov_eax_imm(2);
    em_int(64);
    p = em_jmp_hueco();
    registra_parche(p, 1, 1);
    // BOTON: funcion 17; el id llega en AH. Las
    // islas del menu se registran con su duena: los
    // renglones de EDIT en R-4 y los de FILE en R-5.
    dir_boton = bytebuffer_get_size(dcod);
    em_mov_eax_imm(17);
    em_int(64);
    em_cmp_ah_imm8(2);
    p = em_je_hueco();
    registra_parche(p, 14, 4);
    em_cmp_ah_imm8(8);
    p = em_je_hueco();
    registra_parche(p, 20, 5);
    em_cmp_ah_imm8(9);
    p = em_je_hueco();
    registra_parche(p, 21, 5);
    em_cmp_ah_imm8(10);
    p = em_je_hueco();
    registra_parche(p, 22, 5);
    em_cmp_ah_imm8(11);
    p = em_je_hueco();
    registra_parche(p, 23, 5);
    em_cmp_ah_imm8(3);
    p = em_je_hueco();
    registra_parche(p, 15, 4);
    em_cmp_ah_imm8(4);
    p = em_je_hueco();
    registra_parche(p, 16, 4);
    em_cmp_ah_imm8(5);
    p = em_je_hueco();
    registra_parche(p, 17, 4);
    em_cmp_ah_imm8(6);
    p = em_je_hueco();
    registra_parche(p, 18, 4);
    em_cmp_ah_imm8(7);
    p = em_je_hueco();
    registra_parche(p, 19, 4);
    // Boton 1 = cerrar (cae a la salida); otro
    // cualquiera vuelve al bucle.
    em_cmp_ah_imm8(1);
    p = em_jne_hueco();
    registra_parche(p, 1, 1);
    // SALIDA.
    emite_salida();
    // RATON: portado en R-3.
    dir_raton = bytebuffer_get_size(dcod);
    emite_raton();
    // DRAW WINDOW: begin redraw, la ventana de
    // 500 x 220 en (100, 100) con su titulo, las
    // llamadas a las rutinas de dibujo registradas
    // con sus duenas, el titulo reafirmado con la
    // funcion 71.1 y end redraw.
    dir_ventana = bytebuffer_get_size(dcod);
    em_mov_eax_imm(12);
    em_mov_reg_imm(187, 1);
    em_int(64);
    em_mov_eax_imm(0);
    em_mov_reg_imm(187, 6554100);
    em_mov_reg_imm(185, 6554100);
    em_mov_reg_imm(186, 335544320);
    em_mov_reg_imm(190, -2138531329);
    em_byte(191);
    res_titulo = em_hueco();
    em_int(64);
    p = em_call_hueco();
    registra_parche(p, 7, 2);
    p = em_call_hueco();
    registra_parche(p, 9, 4);
    p = em_call_hueco();
    registra_parche(p, 10, 5);
    em_mov_eax_imm(71);
    em_mov_reg_imm(187, 1);
    em_byte(185);
    res_cap = em_hueco();
    em_int(64);
    em_mov_eax_imm(12);
    em_mov_reg_imm(187, 2);
    em_int(64);
    em_ret();
    // REFRESCO: portado en R-2. Su direccion es
    // el refreshOutputAddress del Result.
    dir_refresco = bytebuffer_get_size(dcod);
    res_refresco = dir_refresco;
    emite_refresco();
    // DIBUJO DE LINEAS: portado en R-2.
    dir_lineas = bytebuffer_get_size(dcod);
    emite_lineas();
    // BARRA: portada en R-3.
    dir_barra = bytebuffer_get_size(dcod);
    emite_barra();
    // DIBUJA_EDIT: portado en R-4.
    dir_edit = bytebuffer_get_size(dcod);
    emite_edit();
    // DIBUJA_FILE: portado en R-5.
    dir_file = bytebuffer_get_size(dcod);
    emite_file();
    // COPIAR, PEGAR y VACIAR: portados en R-4.
    dir_copiar = bytebuffer_get_size(dcod);
    emite_copiar();
    dir_pegar = bytebuffer_get_size(dcod);
    emite_pegar();
    dir_vaciar = bytebuffer_get_size(dcod);
    emite_vaciar();
    // ISLAS DE EDIT: portadas en R-4.
    dir_iedit = bytebuffer_get_size(dcod);
    emite_isla_edit();
    dir_icortar = bytebuffer_get_size(dcod);
    emite_isla_cortar();
    dir_icopiar = bytebuffer_get_size(dcod);
    emite_isla_copiar();
    dir_isel = bytebuffer_get_size(dcod);
    emite_isla_sel();
    dir_ipegar = bytebuffer_get_size(dcod);
    emite_isla_pegar();
    dir_ieliminar = bytebuffer_get_size(dcod);
    emite_isla_eliminar();
    // ISLAS DE FILE: portadas en R-5.
    dir_ifile = bytebuffer_get_size(dcod);
    emite_isla_file();
    dir_iopen = bytebuffer_get_size(dcod);
    emite_isla_open();
    dir_isave = bytebuffer_get_size(dcod);
    emite_isla_save();
    dir_iclose = bytebuffer_get_size(dcod);
    emite_isla_close();
    // PASADAS INTERNAS del prefijo: la de R-1,
    // la de R-2, la de R-3, la de R-4 y la de R-5.
    rellena_registro(1);
    rellena_registro(2);
    rellena_registro(3);
    rellena_registro(4);
    rellena_registro(5);
}

// ============================================================
// RUTINAS DE ARCHIVO (en la pieza Runtime son la
// cola de emite_grafico; en el Ensamblador van
// aparte, diferencia D4): se emiten tras el
// prefijo grafico SOLO cuando el programa usa
// archivos, como en generate() de Stage 0, que
// llama a emitFileIoRuntime bajo
// needsFileIoRuntime. La pasada de la duena 6
// las cierra (sin filas: no registran parches).
// ============================================================

void emite_archivos()
{
    dir_escritura = bytebuffer_get_size(dcod);
    emite_escritura();
    dir_lectura = bytebuffer_get_size(dcod);
    emite_lectura();
    rellena_registro(6);
}


