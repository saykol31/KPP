int tam_isave;

int tam_iclose;

int tam_escritura;

int tam_lectura;

int dir_bucle;

int dir_redraw;

int dir_tecla;

int dir_boton;

int dir_raton;

int dir_ventana;

int dir_refresco;

int dir_lineas;

int dir_barra;

int dir_edit;

int dir_file;

int dir_copiar;

int dir_pegar;

int dir_vaciar;

int dir_iedit;

int dir_icortar;

int dir_icopiar;

int dir_isel;

int dir_ipegar;

int dir_ieliminar;

int dir_ifile;

int dir_iopen;

int dir_isave;

int dir_iclose;

int dir_escritura;

int dir_lectura;

int res_draw;

int res_main;

int res_bucle;

int res_titulo;

