void em_setcc_a(int op)
{
    if (op == 46)
    {
        em_setl_al();
    }
    else if (op == 47)
    {
        em_setle_al();
    }
    else if (op == 44)
    {
        em_sete_al();
    }
    else if (op == 45)
    {
        em_setne_al();
    }
    else
    {
        em_setge_al();
    }
    em_movzx_eax_al();
}


