        else if (op == 10)
        {
            if (frame_activo == 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            if (texto_len(nom) == 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            nula = 0;
            j = 0;
            while (j < texto_len(nom))
            {
