            if (texto_es_main(fun_actual) == 0)
            {
                if (frame_activo == 1)
                {
                    em_mov_esp_ebp();
                    em_pop_ebp();
                    em_ret();
                }
                else
                {
                    em_ret();
                }
            }
            else
            {
                if (frame_activo == 1)
                {
                    em_mov_esp_ebp();
                    em_pop_ebp();
                }
                em_byte(233);
                registra_ret(em_hueco());
            }
        }
        i = i + 1;
    }
    if (nret == 0)
    {
        em_mov_eax_imm(0);
        em_byte(233);
        registra_ret(em_hueco());
    }
    if (texto_len(fun_actual) > 0)
    {
        guarda_contexto(fun_actual);
    }
    rellena_cf();
    rellena_fc();
    cierra_genera();
}

// ============================================================
// ESTADO PROPIO DEL ENSAMBLADOR (D6).
//
// El cursor del cargador sobre los bytes de IR.TXT,
// su cuenta de errores, y si el programa leido usa
// archivos (el escaneo propio; genera() hace el suyo
// para su Result, este decide emite_archivos()).
// ============================================================

int ir_pos;
int ir_total;
int ir_errores;
int ens_necesita_io;

// ============================================================
// TABLA DE NOMBRES DE OPERACION (generada).
//
// Los 37 nombres que imprime_op de la pieza
// IRGenerator puede escribir; los otros 24
// codigos del enum no tienen nombre en la
// serializacion y nunca llegan a un archivo IR.
// La clave de una linea es largo * 100000 mas
// la suma ponderada de sus caracteres,
// caracter i (desde 1) por su codigo; el
// constructor verifico que las 37 claves son
// todas distintas. Sin pareja, devuelve -1.
// ============================================================

int op_desde_clave(int clave)
{
    if (clave == 1407944) { return 0; } // FUNCTION_BEGIN
    if (clave == 1205996) { return 1; } // FUNCTION_END
    if (clave == 501211) { return 2; } // CONST
    if (clave == 1206218) { return 3; } // STRING_CONST
    if (clave == 702011) { return 4; } // DECLARE
    if (clave == 501161) { return 5; } // STORE
    if (clave == 400701) { return 6; } // LOAD
    if (clave == 1004179) { return 7; } // ARRAY_LOAD
    if (clave == 1105293) { return 8; } // ARRAY_STORE
    if (clave == 903302) { return 9; } // FILE_READ
    if (clave == 1004321) { return 10; } // FILE_WRITE
    if (clave == 300405) { return 11; } // ADD
    if (clave == 300451) { return 12; } // SUB
    if (clave == 300475) { return 13; } // MUL
    if (clave == 300472) { return 14; } // DIV
    if (clave == 300439) { return 15; } // MOD
    if (clave == 300499) { return 16; } // POW
    if (clave == 400729) { return 39; } // CALL
    if (clave == 601690) { return 40; } // RETURN
    if (clave == 501195) { return 41; } // PRINT
    if (clave == 1307021) { return 42; } // PRINT_INTEGER
    if (clave == 1306970) { return 44; } // COMPARE_EQUAL
    if (clave == 1712030) { return 45; } // COMPARE_NOT_EQUAL
    if (clave == 1206119) { return 46; } // COMPARE_LESS
    if (clave == 1813368) { return 47; } // COMPARE_LESS_EQUAL
    if (clave == 1509122) { return 48; } // COMPARE_GREATER
    if (clave == 2117784) { return 49; } // COMPARE_GREATER_EQUAL
    if (clave == 1104869) { return 50; } // LOGICAL_AND
    if (clave == 1004287) { return 51; } // LOGICAL_OR
    if (clave == 1105172) { return 52; } // LOGICAL_NOT
    if (clave == 501060) { return 53; } // LABEL
    if (clave == 400795) { return 54; } // JUMP
    if (clave == 1206308) { return 55; } // JUMP_IF_ZERO
    if (clave == 1105031) { return 57; } // BITWISE_AND
    if (clave == 1004449) { return 58; } // BITWISE_OR
    if (clave == 1004270) { return 59; } // SHIFT_LEFT
    if (clave == 1105157) { return 60; } // SHIFT_RIGHT
    return -1;
}

// ============================================================
// EL CARGADOR DEL IR (D6).
//
// Lee IR.TXT byte a byte. El formato es el de
// imprime_ir() de la pieza IRGenerator, linea a
// linea: por instruccion, el nombre de la operacion
// en una linea de texto y despues nueve enteros, uno
// por linea — ini y largo de nombre, operando,
// resultado y aux (una referencia es ini * 128 +
// largo) y el valor entero —; al final, el largo de
// la piscina y un entero por caracter. No hay cuenta
// de instrucciones: la primera linea numerica donde
// se espera un nombre ES el largo de la piscina.
// Los numeros pueden llevar signo; se tolera el CR
// de los fines de linea de Windows.
// ============================================================

int ir_linea_es_numero()
{
    int datos_ir[8192];
    int c;
    if (ir_pos >= ir_total)
    {
        return 0;
    }
    c = datos_ir[ir_pos];
    if (c == 45)
    {
        return 1;
    }
    if (c >= 48)
    {
        if (c <= 57)
        {
            return 1;
        }
    }
    return 0;
}

int ir_lee_numero()
{
    int datos_ir[8192];
    int v;
    int signo;
    int c;
    v = 0;
    signo = 1;
    if (ir_pos < ir_total)
    {
        c = datos_ir[ir_pos];
        if (c == 45)
        {
            signo = -1;
            ir_pos = ir_pos + 1;
        }
    }
    while (ir_pos < ir_total)
    {
        c = datos_ir[ir_pos];
        if (c < 48)
        {
            break;
        }
        if (c > 57)
        {
            break;
        }
        v = v * 10 + (c - 48);
        ir_pos = ir_pos + 1;
    }
    while (ir_pos < ir_total)
    {
        c = datos_ir[ir_pos];
        ir_pos = ir_pos + 1;
        if (c == 10)
        {
            break;
        }
    }
    return v * signo;
}

int ir_lee_op()
{
    int datos_ir[8192];
    int largo;
    int suma;
    int c;
    int clave;
    largo = 0;
    suma = 0;
    while (ir_pos < ir_total)
    {
        c = datos_ir[ir_pos];
        if (c == 10)
        {
            break;
        }
        if (c == 13)
        {
            break;
        }
        largo = largo + 1;
        suma = suma + largo * c;
        ir_pos = ir_pos + 1;
    }
    while (ir_pos < ir_total)
    {
        c = datos_ir[ir_pos];
        ir_pos = ir_pos + 1;
        if (c == 10)
        {
            break;
        }
    }
    clave = largo * 100000 + suma;
    return op_desde_clave(clave);
}

void carga_ir()
{
    int datos_ir[8192];
    int op;
    int a;
    int b;
    int c;
    int d;
    int e;
    int f;
    int g;
    int h;
    int v;
    int x;
    int plen;
    int i;
    int r;
    ir_pos = 0;
    ir_errores = 0;
    ir_total = file_read("IR.TXT", datos_ir);
    if (ir_total < 0)
    {
        ir_errores = 1;
        return;
    }
    while (ir_pos < ir_total)
    {
        if (ir_linea_es_numero() == 1)
        {
            break;
        }
        op = ir_lee_op();
        if (op < 0)
        {
            ir_errores = ir_errores + 1;
            return;
        }
        a = ir_lee_numero();
        b = ir_lee_numero();
        c = ir_lee_numero();
        d = ir_lee_numero();
        e = ir_lee_numero();
        f = ir_lee_numero();
        g = ir_lee_numero();
        h = ir_lee_numero();
        v = ir_lee_numero();
        registra_ir(op, a * 128 + b, c * 128 + d, e * 128 + f, v);
        registra_aux(g * 128 + h);
    }
    plen = ir_lee_numero();
    i = 0;
    while (i < plen)
    {
        x = ir_lee_numero();
        r = string_pool_add_char(dpool, x);
        i = i + 1;
    }
    pool_len = plen;
    dir_nglob = ndir;
    i = 0;
    while (i < ndir)
    {
        if (da_get(dir_op, i) == 0)
        {
            dir_nglob = i;
            i = ndir;
        }
        else
        {
            i = i + 1;
        }
    }
    ens_necesita_io = 0;
    i = 0;
    while (i < ndir)
    {
        op = da_get(dir_op, i);
        if (op == 9)
        {
            ens_necesita_io = 1;
        }
        if (op == 10)
        {
            ens_necesita_io = 1;
        }
        i = i + 1;
    }
}

// ============================================================
// LA COSTURA (D6): rellena_costura().
//
// Aplica, sobre el codigo ya cerrado por genera(),
// los parches que generate() de Stage 0 resuelve
// contra el Result del Runtime y que el genera() de
// la pieza no puede ver, porque su mundo termina en
// el prefijo. Los parches tocan posiciones ajenas
// entre si, asi que el orden entre pasadas no cambia
// el resultado; se sigue el de generate().
//
// - PATCH MAIN: el salto E9 de la cabecera del
//   prefijo (res_main, medido por el Runtime) al
//   cuerpo de main (pos_main, medido por el Backend
//   en su paseo). Relativo, con parche_rel.
// - PATCH RETURN: cada salto de retorno de main
//   registrado por el Backend en dret_pos, al bucle
//   de eventos del prefijo (res_bucle).
// - LAS CATORCE LISTAS: cada posicion registrada por
//   los emisores del prefijo contra direcciones
//   moffs, rellenada con base_datos mas el offset de
//   su lista en la DATA que construye_datos() acaba
//   de construir — el mismo emparejamiento, lista a
//   offset, que el Result de Stage 0 declara.
// - PATCH TITULO: el puntero y la caption de la
//   ventana (res_titulo, res_cap) a la direccion del
//   titulo en la DATA (base_datos + o_titulo).
// - PATCH DIRECCIONES DE ARCHIVO, solo si el
//   programa usa archivos: las cuatro direcciones
//   del Result de archivo (las params y el scratch
//   de escritura y de lectura) a base_datos +
//   o_params y base_datos + o_scratch, la DATA que
//   el Backend aparto al final para las rutinas.
// ============================================================

void parche_lista(int lista, int cuenta, int destino)
{
    int i;
    int pos;
    i = 0;
    while (i < cuenta)
    {
        pos = da_get(lista, i);
        parche32(pos, destino);
        i = i + 1;
    }
}

void rellena_costura()
{
    int i;
    int pos;
    parche_rel(res_main, pos_main);
    i = 0;
    while (i < nret)
    {
        pos = da_get(dret_pos, i);
        parche_rel(pos, res_bucle);
        i = i + 1;
    }
    parche_lista(dpl_buf, npl_buf, base_datos + o_lineas);
    parche_lista(dpl_cnt, npl_cnt, base_datos + o_cuenta);
    parche_lista(dpl_cab, npl_cab, base_datos + o_cabeza);
    parche_lista(dpl_vis, npl_vis, base_datos + o_primera);
    parche_lista(dpl_cur, npl_cur, base_datos + o_cursor);
    parche_lista(dpl_top, npl_top, base_datos + o_pulgar);
    parche_lista(dpl_alt, npl_alt, base_datos + o_altura);
    parche_lista(dpl_est, npl_est, base_datos + o_arrastre);
    parche_lista(dpl_agr, npl_agr, base_datos + o_agarre);
    parche_lista(dpl_men, npl_men, base_datos + o_menu);
    parche_lista(dpl_sel, npl_sel, base_datos + o_selec);
    parche_lista(dpl_len, npl_len, base_datos + o_cliplen);
    parche_lista(dpl_clip, npl_clip, base_datos + o_clip);
    parche_lista(dpl_txt, npl_txt, base_datos + o_texto);
    parche32(res_titulo, base_datos + o_titulo);
    parche32(res_cap, base_datos + o_titulo);
    if (ens_necesita_io == 1)
    {
        parche32(res_esc_scratch, base_datos + o_scratch);
        parche32(res_esc_params, base_datos + o_params);
        parche32(res_lec_scratch, base_datos + o_scratch);
        parche32(res_lec_params, base_datos + o_params);
    }
}

// ============================================================
// LA ESCRITURA DEL EJECUTABLE (D6).
//
// pon32_imagen escribe un entero de 32 bits en
// little-endian dentro de imagen, el arreglo que
// escribe_bin y el comparten por nombre (el
// mecanismo de arreglos compartidos de la casa), y
// devuelve la posicion siguiente. Los valores que
// escribe son tamanos, nunca negativos.
//
// escribe_bin compone el archivo final como el
// Writer de Stage 0: la cabecera de 36 bytes del
// enum Menuet01 — la firma MENUET01, la version, el
// inicio en 36, el fin de la imagen y, con la pila
// de 4096, el fin de memoria y el tope de pila; los
// campos de parametros y ruta a cero —, despues el
// codigo (el prefijo, el bloque de archivos si lo
// hay y el cuerpo, ya un solo dcod) y la DATA. Lo
// escribe a SALIDA.BIN con file_write, la forma que
// la pieza BinaryWriter declara suya.
// ============================================================

int pon32_imagen(int pos, int v)
{
    int imagen[60000];
    int r;
    r = v;
    imagen[pos] = r - (r / 256) * 256;
    r = r / 256;
    imagen[pos + 1] = r - (r / 256) * 256;
    r = r / 256;
    imagen[pos + 2] = r - (r / 256) * 256;
    r = r / 256;
    imagen[pos + 3] = r - (r / 256) * 256;
    return pos + 4;
}

void escribe_bin()
{
    int imagen[60000];
    int total;
    int i;
    int tam_cod;
    int tam_dat;
    int fin;
    int r;
    tam_cod = bytebuffer_get_size(dcod);
    tam_dat = bytebuffer_get_size(ddat);
    fin = 36 + tam_cod + tam_dat;
    imagen[0] = 77;
    imagen[1] = 69;
    imagen[2] = 78;
    imagen[3] = 85;
    imagen[4] = 69;
    imagen[5] = 84;
    imagen[6] = 48;
    imagen[7] = 49;
    total = 8;
    total = pon32_imagen(total, 1);
    total = pon32_imagen(total, 36);
    total = pon32_imagen(total, fin);
    total = pon32_imagen(total, fin + 4096);
    total = pon32_imagen(total, fin + 4096);
    total = pon32_imagen(total, 0);
    total = pon32_imagen(total, 0);
    i = 0;
    while (i < tam_cod)
    {
        imagen[total] = bytebuffer_get(dcod, i);
        total = total + 1;
        i = i + 1;
    }
    i = 0;
    while (i < tam_dat)
    {
        imagen[total] = bytebuffer_get(ddat, i);
        total = total + 1;
        i = i + 1;
    }
    r = file_write("SALIDA.BIN", imagen, total);
}

int main()
{
    int rs;
    int rf;
    int rc;
    int rb;
    int ro;
    inicia_arena();
    rs = arena_create(256);
    rf = arena_create(256);
    rc = arena_create(256);
    arena_destroy(rf);
    rb = arena_create(262144);
    ro = arena_create(256);
    region_source = rs;
    region_frontend = rf;
    region_compiler = rc;
    region_backend = rb;
    region_output = ro;
    reinicia_rt();
    reinicia_back();
    reinicia_ir();
    carga_ir();
    if (ir_errores == 0)
    {
        emite_grafico();
        if (ens_necesita_io == 1)
        {
            emite_archivos();
        }
        genera();
        rellena_costura();
        escribe_bin();
    }
    print("ENSAMBLADOR E-1");
    print_int(ir_errores);
    print_int(errores_arena);
    print_int(errores_back);
    print_int(errores_rt);
    return 0;
}
