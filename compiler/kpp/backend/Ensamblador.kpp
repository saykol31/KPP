// ============================================================
// ENSAMBLADOR — PIEZA DE STAGE 1 (REBANADA E-1).
// ============================================================
//
// El nacimiento del Ensamblador, por decision de
// Esequiel (2026-11-23): antes que el CompilerDriver
// completo, nace la pieza que cierra la costura que
// R-7 dejo medida — en Stage 0 todo el ensamblaje
// vive dentro de X86Backend::generate() y en Stage 1
// nadie consumia los Results de las piezas.
//
// La pieza es UN programa: unifica la mitad trasera
// del compilador con la biblioteca de apoyo una sola
// vez — los emisores de la pieza Runtime (el prefijo
// grafico y las rutinas de archivo), genera() de la
// pieza X86Backend y la produccion del archivo final
// de los Writers (la cabecera Menuet01 de la pieza
// ExecutableWriter; la escritura con file_write, la
// forma que la pieza BinaryWriter declara suya).
// Recibe un IR y produce un ejecutable, como el
// generate() de Stage 0.
//
// EL FLUJO, en el orden de generate() de Stage 0:
//
// 1. El mundo: inicia_arena y las regiones, con la
//    region de trabajo a 262144 celdas (D5).
// 2. reinicia_rt() y luego reinicia_back(): los dos
//    crean dcod; el que queda vivo es el del Backend,
//    y los registros y listas del Runtime quedan en
//    pie apuntando a sus propias estructuras.
// 3. carga_ir(): lee IR.TXT en el formato exacto de
//    imprime_ir() de la pieza IRGenerator y lo deja
//    en las listas del Backend por registra_ir, la
//    unica puerta; dir_nglob queda en la primera
//    FunctionBegin, como en el paseo de genera().
// 4. emite_grafico(): siembra el prefijo grafico en
//    dcod (2587 bytes) y cierra sus registros.
// 5. emite_archivos(), SOLO si el IR usa archivos:
//    el bloque de 763 bytes tras el prefijo (D4).
// 6. genera(): el cuerpo del usuario tras el bloque
//    presente, y la DATA tras el codigo. Como el
//    prefijo ya vive en dcod, base_datos y cada
//    posicion registrada nacen en el marco del
//    ensamblaje sin tocar una linea de genera().
//    genera() resuelve por dentro lo suyo: las
//    llamadas Print y de archivo del cuerpo, las
//    direcciones de sus rutinas internas y, si hay
//    archivos, las direcciones phue/ahue del cuerpo.
// 7. rellena_costura(): lo que generate() de Stage 0
//    resuelve contra el Result del Runtime y este
//    genera() no puede ver: el salto de la cabecera
//    al cuerpo de main (res_main contra pos_main),
//    los retornos de main al bucle de eventos
//    (dret_pos contra res_bucle), las catorce listas
//    DATA contra los offsets de la DATA construida,
//    el titulo (res_titulo y res_cap contra
//    o_titulo) y, si hay archivos, las cuatro
//    direcciones del Result de archivo contra
//    o_scratch y o_params.
// 8. escribe_bin(): la cabecera de 36 bytes, el
//    codigo y la DATA, a SALIDA.BIN con file_write.
//
// PRUEBA DE NACIMIENTO (E-1): con el IR del programa
// minimo L00 (un main con return 0), el BIN producido
// es byte a byte el de Stage 0: 57086 bytes, MD5
// 7822747da0b8ec68e8151cf5445e63b5. Los huecos que la
// pieza Backend deja sin registrar (las lineas de
// Print y los huecos de refresco y de llamada de
// archivo de su costura abierta de B-2) no aparecen
// en L00; su plomeria es materia de E-2 y E-3.
//
// DIFERENCIAS DECLARADAS frente a las piezas
// selladas (los modulos trasplantados van byte a
// byte; esto es todo lo que cambia):
//
// D1 La biblioteca arena va una sola vez: las dos
//    copias selladas son identicas modulo a modulo
//    (verificado por el constructor) y se toma la
//    del Backend. Los 11 ayudantes em_* y parche32,
//    tambien identicos en ambas piezas, van en la
//    copia del Runtime.
// D2 En la biblioteca, el bloque B pasa de 32768 a
//    262144 celdas: la DATA de un programa entero
//    (54428 celdas; 120000 con el scratch de E/S) no
//    cabe en el bloque sellado — con B en 32768 la
//    construccion de la DATA se detiene a mitad y lo
//    acusa errores_arena. Precedente de la casa: la
//    pieza Backend ya ajusto B de 1024 a 32768 al
//    incorporar la biblioteca, y la regla de
//    Esequiel (2026-11-20) es capacidades crecibles
//    cambiando numeros y recompilando.
// D3 Los main sonda y las funciones de sonda de
//    ambas piezas quedan fuera; entra el main del
//    Ensamblador y su codigo nuevo.
// D4 emite_grafico se parte en dos: en la pieza
//    Runtime emite el bloque de archivos siempre;
//    Stage 0 lo emite solo cuando el programa usa
//    archivos, y un L00 con el bloque no seria el
//    BIN del oraculo. El prefijo cierra con las
//    pasadas 1..5 y el bloque pasa a emite_archivos().
// D5 La reserva de la region de trabajo es 262144
//    (consecuencia de D2, pedida por el main nuevo).
// D6 Codigo nuevo: el estado propio, el cargador del
//    IR, la tabla de nombres de operacion,
//    rellena_costura(), pon32_imagen(), escribe_bin()
//    y main().
//
// CAPACIDADES DE LA REBANADA: el archivo IR cabe en
// 8192 bytes y la imagen en 60000 bytes (L00 pide
// 57086); son numeros de la pieza, crecibles como
// todos los de la casa.
// ============================================================

enum Menuet01
{
    HeaderSize = 36,
    StackSize = 4096,
    Version = 1,
    OffSignature = 0,
    OffVersion = 8,
    OffStart = 12,
    OffImageEnd = 16,
    OffMemoryEnd = 20,
    OffStackTop = 24,
    OffParameters = 28,
    OffPath = 32
};

// Constantes de la E/S de archivos (los constexpr de KolibriRuntime.hpp;
// SubWriteBlock no tiene constante nombrada en Stage 0: sale del texto
// del contrato).
enum KolibriFileIo
{
    Function = 70,
    SubRead = 0,
    SubWrite = 2,
    SubWriteBlock = 3,
    Eof = 6,
    MaxBytes = 65536,
    EncodingRaw = 0
};

// Bloque de parametros de la funcion 70: 25 bytes EMPAQUETADOS.
// pathAddress va en +21, pegado al flag de 1 byte: sin relleno.
// (En Stage 0 lo blindan static_asserts; aqui los offsets se escriben
// a mano en el arreglo de bytes, y esta tabla es la referencia.)
enum FileIoParams
{
    Size = 25,
    OffSubfunction = 0,
    OffOffsetLow = 4,
    OffOffsetHigh = 8,
    OffByteCount = 12,
    OffBufferAddress = 16,
    OffEncodingFlag = 20,
    OffPathAddress = 21
};

enum TemporaryLocationKind
{
    Register,
    Memory
};

enum IROpcode
{
    // ESTRUCTURA DEL PROGRAMA
    FunctionBegin,
    FunctionEnd,

    // CONSTANTES
    Const,
    StringConst,

    // VARIABLES Y MEMORIA
    Declare,
    Store,
    Load,
    ArrayLoad,
    ArrayStore,

    // FILE I/O
    FileRead,
    FileWrite,

    // ARITMETICA BASICA
    Add,
    Sub,
    Mul,
    Div,
    Mod,

    // POTENCIAS Y RAICES
    Pow,
    Sqrt,

    // LOGARITMOS Y EXPONENCIALES
    Log,
    Log10,
    Exp,

    // TRIGONOMETRIA
    Sin,
    Cos,
    Tan,
    Cot,
    Sec,
    Csc,

    // TRIGONOMETRIA INVERSA
    Asin,
    Acos,
    Atan,

    // FUNCIONES MATEMATICAS
    Abs,
    Floor,
    Ceil,
    Round,
    Min,
    Max,

    // MATEMATICA AVANZADA
    Factorial,
    Sum,
    Integral,

    // FUNCIONES
    Call,
    Return,

    // SALIDA
    Print,
    PrintInteger,
    PrintFloat,

    // COMPARACIONES
    CompareEqual,
    CompareNotEqual,
    CompareLess,
    CompareLessEqual,
    CompareGreater,
    CompareGreaterEqual,

    // LOGICA
    LogicalAnd,
    LogicalOr,
    LogicalNot,

    // CONTROL DE FLUJO
    Label,
    Jump,
    JumpIfZero,
    JumpIfNotZero,

    // BITS (Ampliacion 4, al final)
    BitwiseAnd,
    BitwiseOr,
    ShiftLeft,
    ShiftRight
};

// ============================================================
// LA BIBLIOTECA ARENA, INCORPORADA.
//
// K++ no tiene includes: un archivo es un programa, y
// las piezas se componen por copia identica, como los
// enum que emisor y consumidor se reparten. Lo que
// sigue es la biblioteca de M-0 (compiler/kpp/runtime/
// Arena.kpp, sellada en campo 108/108) sin su sonda ni
// su main, con los ajustes de dimension declarados
// en la cabecera de esta pieza (D2): el bloque B se
// declara a 262144 celdas, porque la region de
// trabajo del Ensamblador guarda la DATA entera de
// un programa (54428 celdas; 120000 con el scratch
// de E/S) ademas de las tablas de las dos mitades;
// en las piezas selladas B media 32768 y la DATA no
// cabia (en la biblioteca de M-0 era de 1024,
// dimension de su sonda). El bucle de cero de
// inicia_arena se parte en dos al dejar A y B de medir
// lo mismo, y el comentario de tamanos de inicia_arena
// dice los de esta pieza. Nada mas cambia: ni una
// firma, ni una mecanica.
// ============================================================

// ============================================================
// ESTADO COMPARTIDO.
//
// Los contadores de la biblioteca y los handles de las
// cinco regiones, compartidos por nombre como en las
// demas piezas. El driver guarda en region_source ..
// region_output el handle de cada region al crearla.
// errores_arena es la guarda comun: suma 1 por cada
// operacion que la biblioteca no pudo cumplir, y ninguna
// operacion fallida escribe fuera ni a medias.
// ============================================================

int errores_arena;

int nest;

int prov_nacq;

int region_source;

int region_frontend;

int region_compiler;

int region_backend;

int region_output;


// ============================================================
// INICIA LA BIBLIOTECA.
//
// Pone a cero la contabilidad y los tres bloques, y
// escribe el plan de solape: la region 1 (Source) vive
// en el bloque 0 (A), la 2 (Frontend) en el 1 (B), la 3
// (Compiler) en el 2 (C), la 4 (Backend) en el 1 (B, su
// segunda vida) y la 5 (Output) en el 0 (A, su segunda
// vida). Los tamanos de bloque de esta pieza: A con
// 1024 celdas, B con 262144, C con 512.
// ============================================================

void inicia_arena()
{
    int bloque_a[1024];
    int bloque_b[262144];
    int bloque_c[512];
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int i;
    i = 0;
    while (i < 1024)
    {
        bloque_a[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 262144)
    {
        bloque_b[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 512)
    {
        bloque_c[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 6)
    {
        reg_bloque[i] = 0;
        reg_reserva[i] = 0;
        reg_usado[i] = 0;
        reg_viva[i] = 0;
        plan_bloque[i] = 0;
        i = i + 1;
    }
    plan_bloque[1] = 0;
    plan_bloque[2] = 1;
    plan_bloque[3] = 2;
    plan_bloque[4] = 1;
    plan_bloque[5] = 0;
    tam_bloque[0] = 1024;
    tam_bloque[1] = 262144;
    tam_bloque[2] = 512;
    i = 0;
    while (i < 3)
    {
        bloque_dueno[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 129)
    {
        est_region[i] = 0;
        est_base[i] = 0;
        est_cuenta[i] = 0;
        est_cap[i] = 0;
        est_tipo[i] = 0;
        est_viva[i] = 0;
        i = i + 1;
    }
    errores_arena = 0;
    nest = 0;
    prov_nacq = 0;
    region_source = 0;
    region_frontend = 0;
    region_compiler = 0;
    region_backend = 0;
    region_output = 0;
}


// ============================================================
// MEMORY PROVIDER.
//
// La puerta entre la biblioteca y la memoria fisica.
// En V2 son subrutinas ordinarias: memory_acquire entrega
// el bloque fisico que el plan de solape asigna a la
// siguiente region por nacer (las regiones nacen en
// orden: Source, Frontend, Compiler, Backend, Output) y
// devuelve bloque + 1, o 0 si el bloque no alcanza o
// sigue ocupado por su vida anterior. Nunca un bloque
// invalido, nunca un valor a medias. memory_release
// devuelve el bloque; memory_available da el tamano del
// bloque libre mayor, en celdas.
// ============================================================

int memory_available()
{
    int tam_bloque[3];
    int bloque_dueno[3];
    int m;
    int b;
    m = 0;
    b = 0;
    while (b < 3)
    {
        if (bloque_dueno[b] == 0)
        {
            if (tam_bloque[b] > m)
            {
                m = tam_bloque[b];
            }
        }
        b = b + 1;
    }
    return m;
}


int memory_acquire(int size)
{
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int n;
    int blk;
    n = prov_nacq + 1;
    if (n > 5)
    {
        return 0;
    }
    blk = plan_bloque[n];
    if (size > tam_bloque[blk])
    {
        return 0;
    }
    if (bloque_dueno[blk] != 0)
    {
        return 0;
    }
    bloque_dueno[blk] = n;
    prov_nacq = n;
    return blk + 1;
}


void memory_release(int block)
{
    int bloque_dueno[3];
    bloque_dueno[block - 1] = 0;
}


// ============================================================
// MEMORY MANAGER.
//
// arena_create reserva el bloque inicial de la region y
// devuelve su handle (0 = fallo, acusado en
// errores_arena). El handle de la region es su numero de
// nacimiento: 1 Source, 2 Frontend, 3 Compiler,
// 4 Backend, 5 Output.
// arena_alloc entrega un offset dentro de la region: el
// espacio se entrega por avance (bump) con la alineacion
// pedida en celdas; si no cabe en lo reservado, acusa y
// devuelve -1 sin tocar nada. Ningun offset ya entregado
// cambia jamas de significado.
// arena_reset devuelve la region a vacia sin liberarla:
// es la liberacion por fase, y de paso invalida las
// estructuras que vivian en ella. arena_destroy la
// libera del todo: el bloque vuelve al Provider y la
// region muerta acusa si la llaman (la disciplina del
// mapa contra handles de regiones muertas).
// ============================================================

int region_activa(int arena)
{
    int reg_viva[6];
    int r;
    r = 0;
    if (arena >= 1)
    {
        if (arena <= 5)
        {
            if (reg_viva[arena] == 1)
            {
                r = 1;
            }
        }
    }
    return r;
}


int arena_create(int initial_size)
{
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int b;
    int r;
    if (initial_size < 1)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    b = memory_acquire(initial_size);
    if (b == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    r = prov_nacq;
    reg_bloque[r] = b - 1;
    reg_reserva[r] = initial_size;
    reg_usado[r] = 0;
    reg_viva[r] = 1;
    return r;
}


int arena_alloc(int arena, int size, int alignment)
{
    int reg_reserva[6];
    int reg_usado[6];
    int off;
    int resto;
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (size < 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (alignment < 1)
    {
        alignment = 1;
    }
    off = reg_usado[arena];
    resto = off - (off / alignment) * alignment;
    if (resto != 0)
    {
        off = off + (alignment - resto);
    }
    if (off + size > reg_reserva[arena])
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    reg_usado[arena] = off + size;
    return off;
}


void invalida_estructuras(int arena)
{
    int est_region[129];
    int est_viva[129];
    int e;
    e = 1;
    while (e <= nest)
    {
        if (est_region[e] == arena)
        {
            est_viva[e] = 0;
        }
        e = e + 1;
    }
}


void arena_reset(int arena)
{
    int reg_usado[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
}


void arena_destroy(int arena)
{
    int reg_bloque[6];
    int reg_usado[6];
    int reg_viva[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
    reg_viva[arena] = 0;
    memory_release(reg_bloque[arena] + 1);
}


int arena_get_used(int arena)
{
    int reg_usado[6];
    if (region_activa(arena) == 0)
    {
        return -1;
    }
    return reg_usado[arena];
}


int arena_get_reserved(int arena)
{
    int reg_reserva[6];
    if (region_activa(arena) == 0)
    {
        return -1;
    }
    return reg_reserva[arena];
}


// ============================================================
// ACCESO A CELDAS.
//
// La capa de acceso interna de la via V2: cada bloque es
// un arreglo declarado y estas dos subrutinas son las
// unicas que lo indexan por numero de bloque. Si un dia
// se migra a la via V1, este es el interior que se
// reescribe por peek/poke; la API publica no se entera.
// ============================================================

int celda_get(int bloque, int off)
{
    int bloque_a[1024];
    int bloque_b[262144];
    int bloque_c[512];
    int r;
    r = 0;
    if (bloque == 0)
    {
        r = bloque_a[off];
    }
    else
    {
        if (bloque == 1)
        {
            r = bloque_b[off];
        }
        else
        {
            r = bloque_c[off];
        }
    }
    return r;
}


void celda_set(int bloque, int off, int v)
{
    int bloque_a[1024];
    int bloque_b[262144];
    int bloque_c[512];
    if (bloque == 0)
    {
        bloque_a[off] = v;
    }
    else
    {
        if (bloque == 1)
        {
            bloque_b[off] = v;
        }
        else
        {
            bloque_c[off] = v;
        }
    }
}


// ============================================================
// LA CONTABILIDAD DE ESTRUCTURAS.
//
// DynamicArray, StringPool y ByteBuffer comparten la
// misma contabilidad: por estructura, su region, la base
// (offset de su bloque actual en la region), la cuenta,
// la capacidad, el tipo (1 DynamicArray, 2 StringPool,
// 3 ByteBuffer) y si vive. Los arreglos van indexados por
// el handle de la estructura (1..128); el 0 es el fallo.
// est_crece es el crecimiento geometrico x2, el mismo
// para las tres clases: extension en el sitio si el
// bloque de la estructura es el ultimo asignado de su
// arena; si no, bloque nuevo al doble y copia, y el
// bloque viejo queda como hueco hasta el reset de la
// fase. La base puede cambiar al crecer con copia; los
// handles de los datos no, porque un dato se referencia
// por su indice dentro de la estructura, no por su
// offset en la arena.
// est_agrega es la unica puerta de registro: agrega al
// final y devuelve el indice del elemento, o -1 si la
// arena no pudo crecer (error ya acusado, una sola vez
// por operacion fallida).
// ============================================================

int est_crea(int arena, int tipo, int capini)
{
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int off;
    int e;
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (capini < 1)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (nest >= 128)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    off = arena_alloc(arena, capini, 1);
    if (off < 0)
    {
        return 0;
    }
    nest = nest + 1;
    e = nest;
    est_region[e] = arena;
    est_base[e] = off;
    est_cuenta[e] = 0;
    est_cap[e] = capini;
    est_tipo[e] = tipo;
    est_viva[e] = 1;
    return e;
}


int est_valida(int e, int tipo)
{
    int est_tipo[129];
    int est_viva[129];
    int r;
    r = 0;
    if (e >= 1)
    {
        if (e <= nest)
        {
            if (est_viva[e] == 1)
            {
                if (tipo == 0)
                {
                    r = 1;
                }
                else
                {
                    if (est_tipo[e] == tipo)
                    {
                        r = 1;
                    }
                }
            }
        }
    }
    return r;
}


int est_crece(int e)
{
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int region;
    int base;
    int cap;
    int nuevacap;
    int off;
    int blk;
    int i;
    region = est_region[e];
    base = est_base[e];
    cap = est_cap[e];
    nuevacap = cap * 2;
    if (base + cap == reg_usado[region])
    {
        if (reg_usado[region] + (nuevacap - cap) <= reg_reserva[region])
        {
            reg_usado[region] = reg_usado[region] + (nuevacap - cap);
            est_cap[e] = nuevacap;
            return 1;
        }
        errores_arena = errores_arena + 1;
        return 0;
    }
    off = arena_alloc(region, nuevacap, 1);
    if (off < 0)
    {
        return 0;
    }
    blk = reg_bloque[region];
    i = 0;
    while (i < est_cuenta[e])
    {
        celda_set(blk, off + i, celda_get(blk, base + i));
        i = i + 1;
    }
    est_base[e] = off;
    est_cap[e] = nuevacap;
    return 1;
}


int est_agrega(int e, int v)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int idx;
    if (est_valida(e, 0) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (est_cuenta[e] == est_cap[e])
    {
        if (est_crece(e) == 0)
        {
            return -1;
        }
    }
    idx = est_cuenta[e];
    celda_set(reg_bloque[est_region[e]], est_base[e] + idx, v);
    est_cuenta[e] = idx + 1;
    return idx;
}


// ============================================================
// DYNAMICARRAY.
//
// da_create nace con la capacidad inicial pedida (en
// elementos) y devuelve el handle del arreglo (0 = fallo
// acusado). da_add agrega al final creciendo como manda
// est_crece y devuelve el indice del elemento o -1.
// da_get / da_set leen y escriben por indice, con el
// intervalo validado antes de tocar memoria: fuera de la
// cuenta, acusan y no tocan nada. da_count, da_capacity
// y da_base consultan la contabilidad (valen para las
// tres clases de estructura); handle invalido da -1.
// ============================================================

int da_create(int arena, int initial_capacity)
{
    return est_crea(arena, 1, initial_capacity);
}


int da_add(int arr, int value)
{
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(arr, value);
}


int da_get(int arr, int index)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (index < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (index >= est_cuenta[arr])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[arr]], est_base[arr] + index);
}


void da_set(int arr, int index, int value)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (index < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (index >= est_cuenta[arr])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[arr]], est_base[arr] + index, value);
}


int da_count(int arr)
{
    int est_cuenta[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[arr];
}


int da_capacity(int arr)
{
    int est_cap[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_cap[arr];
}


int da_base(int arr)
{
    int est_base[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_base[arr];
}


// ============================================================
// STRINGPOOL.
//
// La piscina dinamica: un buffer de caracteres que crece
// en la region pedida. string_pool_add_char agrega un
// caracter (guardado como byte, 0..255) y devuelve su
// offset dentro de la piscina: ese offset es el ini de
// las referencias. El formato de la referencia no
// cambia: ini * 128 + largo, el de la piscina de hoy;
// string_pool_len desempaqueta el largo y
// string_pool_get_char lee el caracter ini + i. Los
// handles son offsets: estables hasta la muerte de la
// region, crezca lo que crezca la piscina.
// ============================================================

int string_pool_create(int arena)
{
    return est_crea(arena, 2, 4);
}


int string_pool_add_char(int pool, int ch)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(pool, ch & 255);
}


int string_pool_get_char(int pool, int ini, int i)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int idx;
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    idx = ini + i;
    if (idx < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (idx >= est_cuenta[pool])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[pool]], est_base[pool] + idx);
}


int string_pool_len(int pool, int ref)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return ref - (ref / 128) * 128;
}


// ============================================================
// BYTEBUFFER.
//
// El buffer de bytes que crece: el codigo del Emitter y
// la imagen de los Writers. Una celda por byte, como
// hoy, y cada byte guardado en 0..255.
// bytebuffer_append agrega un byte al final y devuelve
// su offset — la semantica de los placeholders del
// Emitter, que ya devuelven el offset de su hueco.
// bytebuffer_patch escribe en un offset ya entregado y
// dentro de la cuenta: es el patch32 / patchRel32 de hoy
// sin guarda de 256. bytebuffer_write copia count bytes
// desde otro ByteBuffer (desde su src_offset) y los
// agrega al final de este: lo que los Writers hacen al
// ensamblar cabecera + codigo + datos; el intervalo de
// origen se valida entero antes de copiar, asi que una
// copia invalida acusa y no escribe nada.
// bytebuffer_get lee un byte por offset, validado.
// ============================================================

int bytebuffer_create(int arena)
{
    return est_crea(arena, 3, 8);
}


int bytebuffer_append(int bb, int byte)
{
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(bb, byte & 255);
}


void bytebuffer_patch(int bb, int offset, int byte)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[bb]], est_base[bb] + offset, byte & 255);
}


void bytebuffer_write(int bb, int src, int src_offset, int count)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int blk;
    int i;
    int v;
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (est_valida(src, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (src_offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (count < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (src_offset + count > est_cuenta[src])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    blk = reg_bloque[est_region[src]];
    i = 0;
    while (i < count)
    {
        v = celda_get(blk, est_base[src] + src_offset + i);
        if (est_agrega(bb, v) < 0)
        {
            return;
        }
        i = i + 1;
    }
}


int bytebuffer_get(int bb, int offset)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[bb]], est_base[bb] + offset);
}


int bytebuffer_get_size(int bb)
{
    int est_cuenta[129];
    if (est_valida(bb, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[bb];
}

// ============================================================
// PARTE RUNTIME: el estado, los emisores del prefijo
// grafico y de las rutinas de archivo de la pieza
// Runtime (R-1 a R-6), trasplantados modulo a modulo
// sin tocar una linea; solo emite_grafico se parte
// en dos (diferencia D4, declarada en la cabecera).
// ============================================================

// ============================================================
// ESTADO COMPARTIDO.
//
// Los escalares de la pieza: el contador de errores
// (errores_rt: suma 1 por cada registro que la arena
// no pudo cumplir o cada clase de destino invalida),
// el ByteBuffer dcod con el prefijo modelado, el
// registro de parches internos (tres arreglos
// paralelos: posicion, clase de destino y rebanada
// duena, con su contador nreg), las catorce listas de
// direcciones DATA del oraculo (un DynamicArray y un
// contador por lista, con el prefijo dpl_/npl_), los
// tamanos finales de las diecinueve regiones en hueco
// (tam_: medidos por el puerto emitiendo el oraculo
// entero, probados byte a byte; la rebanada que porte
// una region debe emitir exactamente su tam_ o la
// conservacion lo acusa), las direcciones de las
// veinticuatro regiones (dir_: las fija emite_grafico
// al pasar) y los seis campos del Result (res_).
// Las clases de destino del registro: 0 ventana,
// 1 bucle, 2 redraw, 3 tecla, 4 boton, 5 raton,
// 6 refresco, 7 lineas, 8 barra, 9 DIBUJA_EDIT,
// 10 DIBUJA_FILE, 11 COPIAR, 12 PEGAR, 13 VACIAR,
// 14 isla EDIT, 15 isla CORTAR, 16 isla COPIAR,
// 17 isla SELECCIONAR, 18 isla PEGAR, 19 isla
// ELIMINAR, 20 isla FILE, 21 isla OPEN, 22 isla SAVE
// y 23 isla CLOSE.
// ============================================================

int errores_rt;

int nreg;

int dreg_pos;

int dreg_clase;

int dreg_dueno;

int dpl_buf;

int dpl_cnt;

int dpl_cab;

int dpl_vis;

int dpl_cur;

int dpl_top;

int dpl_alt;

int dpl_est;

int dpl_agr;

int dpl_men;

int dpl_sel;

int dpl_len;

int dpl_clip;

int dpl_txt;

int npl_buf;

int npl_cnt;

int npl_cab;

int npl_vis;

int npl_cur;

int npl_top;

int npl_alt;

int npl_est;

int npl_agr;

int npl_men;

int npl_sel;

int npl_len;

int npl_clip;

int npl_txt;

int tam_raton;

int tam_refresco;

int tam_lineas;

int tam_barra;

int tam_edit;

int tam_file;

int tam_copiar;

int tam_pegar;

int tam_vaciar;

