            }
            if (texto_len(ope) == 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            if (texto_len(res) == 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            if (texto_len(aux) == 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            if (val <= 0)
            {
                errores_back = errores_back + 1;
                return;
            }
            fila = busca_var(ope);
            if (fila < 0)
            {
                errores_back = errores_back + 1;
