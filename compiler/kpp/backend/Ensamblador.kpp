int res_lec_params;


// ============================================================
// REINICIA EL RUNTIME.
//
// Pone a cero el estado, fija los tamanos medidos de
// las regiones en hueco y crea las estructuras en
// BackendArena: el ByteBuffer del prefijo, los tres
// arreglos del registro de parches y las catorce
// listas DATA, nacidos a 256 como manda la norma de
// la casa. El llamador crea BackendArena antes
// (region_backend), como en las demas piezas.
// ============================================================

void reinicia_rt()
{
    errores_rt = 0;
    nreg = 0;
    npl_buf = 0;
    npl_cnt = 0;
    npl_cab = 0;
    npl_vis = 0;
    npl_cur = 0;
    npl_top = 0;
    npl_alt = 0;
    npl_est = 0;
    npl_agr = 0;
    npl_men = 0;
    npl_sel = 0;
    npl_len = 0;
    npl_clip = 0;
    npl_txt = 0;
    tam_raton = 358;
    tam_refresco = 62;
    tam_lineas = 239;
    tam_barra = 157;
    tam_edit = 378;
    tam_file = 267;
    tam_copiar = 189;
    tam_pegar = 94;
    tam_vaciar = 30;
    tam_iedit = 58;
    tam_icortar = 63;
    tam_icopiar = 58;
    tam_isel = 48;
    tam_ipegar = 42;
    tam_ieliminar = 58;
    tam_ifile = 58;
    tam_iopen = 42;
    tam_isave = 42;
    tam_iclose = 42;
    tam_escritura = 355;
    tam_lectura = 408;
    dir_bucle = 0;
    dir_redraw = 0;
    dir_tecla = 0;
    dir_boton = 0;
    dir_raton = 0;
    dir_ventana = 0;
    dir_refresco = 0;
    dir_lineas = 0;
    dir_barra = 0;
    dir_edit = 0;
    dir_file = 0;
    dir_copiar = 0;
    dir_pegar = 0;
    dir_vaciar = 0;
    dir_iedit = 0;
    dir_icortar = 0;
    dir_icopiar = 0;
    dir_isel = 0;
    dir_ipegar = 0;
    dir_ieliminar = 0;
    dir_ifile = 0;
    dir_iopen = 0;
    dir_isave = 0;
    dir_iclose = 0;
    res_draw = 0;
    res_main = 0;
    res_bucle = 0;
    res_titulo = 0;
    res_cap = 0;
    res_refresco = 0;
    dir_escritura = 0;
    dir_lectura = 0;
    res_esc_scratch = 0;
    res_esc_params = 0;
    res_lec_scratch = 0;
    res_lec_params = 0;
    dcod = bytebuffer_create(region_backend);
    dreg_pos = da_create(region_backend, 256);
    dreg_clase = da_create(region_backend, 256);
    dreg_dueno = da_create(region_backend, 256);
    dpl_buf = da_create(region_backend, 256);
    dpl_cnt = da_create(region_backend, 256);
    dpl_cab = da_create(region_backend, 256);
    dpl_vis = da_create(region_backend, 256);
    dpl_cur = da_create(region_backend, 256);
    dpl_top = da_create(region_backend, 256);
    dpl_alt = da_create(region_backend, 256);
    dpl_est = da_create(region_backend, 256);
    dpl_agr = da_create(region_backend, 256);
    dpl_men = da_create(region_backend, 256);
    dpl_sel = da_create(region_backend, 256);
    dpl_len = da_create(region_backend, 256);
    dpl_clip = da_create(region_backend, 256);
    dpl_txt = da_create(region_backend, 256);
}


// ============================================================
// EMISORES.
//
// La base de emision de la casa sobre el ByteBuffer
// dcod: em_byte anota un byte, em_dword un dword
// little-endian, em_hueco reserva el dword de un
// parche y devuelve su posicion (la semantica de los
// placeholders del Emitter) y parche32 escribe un
// dword en un offset ya entregado. Encima, las
// primitivas del prefijo: las mismas codificaciones
// de X86Emitter.cpp de Stage 0, en decimal como en
// las demas piezas. Los huecos con retorno devuelven
// la posicion del rel32 o del imm32. em_hueco_cero
// emite la region en hueco: n bytes a cero.
// anota_lista anota la posicion de un imm32 en una
// de las catorce listas DATA de la pieza — el indice
// sigue el orden del estado: 0 lineBuffer, 1
// lineCount, 2 lineHead, 3 firstVisible, 4
// repaintCursor, 5 thumbTop, 6 thumbHeight, 7
// dragState, 8 dragGrab, 9 menuAbierto, 10
// seleccion, 11 clipLen, 12 clipBuffer y 13
// menuTexto — e incrementa su contador; los
// emisores de operando de memoria (em_mov_eax_mem,
// em_mov_ebx_mem, em_mov_mem_eax, em_sub_eax_mem y
// em_add_eax_mem) emiten su imm32 a cero y lo
// anotan. em_jle_hueco y em_jbe_hueco son los
// saltos con signo y sin signo del dibujo, y
// em_and_eax_imm y em_add_eax_imm sus inmediatos.
// R-3 suma los saltos que piden la barra y el
// raton (em_jb_hueco, em_ja_hueco, em_jae_hueco,
// em_jge_hueco y em_jns_hueco) y los operandos de
// memoria de sus cuentas (em_mov_ecx_mem,
// em_sub_ebx_mem, em_cmp_eax_mem, em_add_ecx_mem,
// em_div_mem y em_mul_mem). R-4 suma los
// operandos con la direccion DATA como
// inmediato (em_mov_edi_dir, em_mov_edx_dir,
// em_mov_esi_dir, em_mov_eax_dir, em_add_eax_dir
// y em_sub_eax_dir: el opcode y un imm32
// anotado en su lista) y em_cmp_ebx_mem
// (cmp ebx, [dir]).
// ============================================================

void em_byte(int b)
{
    bytebuffer_append(dcod, b & 255);
}


void em_dword(int v)
{
    em_byte(v & 255);
    em_byte((v >> 8) & 255);
    em_byte((v >> 16) & 255);
    em_byte((v >> 24) & 255);
}


int em_hueco()
{
    int pos;
    pos = bytebuffer_get_size(dcod);
    em_dword(0);
    return pos;
}


void parche32(int pos, int v)
{
    bytebuffer_patch(dcod, pos, v & 255);
    bytebuffer_patch(dcod, pos + 1, (v >> 8) & 255);
    bytebuffer_patch(dcod, pos + 2, (v >> 16) & 255);
    bytebuffer_patch(dcod, pos + 3, (v >> 24) & 255);
}


void anota_lista(int cual, int pos)
{
    int r;
    if (cual < 0)
    {
        errores_rt = errores_rt + 1;
        return;
    }
    if (cual > 13)
    {
        errores_rt = errores_rt + 1;
        return;
    }
    r = 0;
    if (cual == 0)
    {
        r = da_add(dpl_buf, pos);
        if (r >= 0)
        {
            npl_buf = npl_buf + 1;
        }
    }
    if (cual == 1)
    {
        r = da_add(dpl_cnt, pos);
        if (r >= 0)
        {
            npl_cnt = npl_cnt + 1;
        }
    }
    if (cual == 2)
    {
        r = da_add(dpl_cab, pos);
        if (r >= 0)
        {
            npl_cab = npl_cab + 1;
        }
    }
    if (cual == 3)
    {
        r = da_add(dpl_vis, pos);
        if (r >= 0)
        {
            npl_vis = npl_vis + 1;
        }
    }
    if (cual == 4)
    {
        r = da_add(dpl_cur, pos);
        if (r >= 0)
        {
            npl_cur = npl_cur + 1;
        }
    }
    if (cual == 5)
    {
        r = da_add(dpl_top, pos);
        if (r >= 0)
        {
            npl_top = npl_top + 1;
        }
    }
    if (cual == 6)
    {
        r = da_add(dpl_alt, pos);
        if (r >= 0)
        {
            npl_alt = npl_alt + 1;
        }
    }
    if (cual == 7)
    {
        r = da_add(dpl_est, pos);
        if (r >= 0)
        {
            npl_est = npl_est + 1;
        }
    }
    if (cual == 8)
    {
        r = da_add(dpl_agr, pos);
        if (r >= 0)
        {
            npl_agr = npl_agr + 1;
        }
    }
    if (cual == 9)
    {
        r = da_add(dpl_men, pos);
        if (r >= 0)
        {
            npl_men = npl_men + 1;
        }
    }
    if (cual == 10)
    {
        r = da_add(dpl_sel, pos);
        if (r >= 0)
        {
            npl_sel = npl_sel + 1;
        }
    }
    if (cual == 11)
    {
        r = da_add(dpl_len, pos);
        if (r >= 0)
        {
            npl_len = npl_len + 1;
        }
    }
    if (cual == 12)
    {
        r = da_add(dpl_clip, pos);
        if (r >= 0)
        {
            npl_clip = npl_clip + 1;
        }
    }
    if (cual == 13)
    {
        r = da_add(dpl_txt, pos);
        if (r >= 0)
        {
            npl_txt = npl_txt + 1;
        }
    }
    if (r < 0)
    {
        errores_rt = errores_rt + 1;
    }
}


void em_mov_eax_imm(int v)
{
    em_byte(184);
    em_dword(v);
}


void em_mov_reg_imm(int op, int v)
{
    em_byte(op);
    em_dword(v);
}


void em_int(int n)
{
