void emite_barra()
{
    int p_lleno;
    int p_dibuja;
    // El carril (funcion 13): X = 478, ancho 12,
    // Y = 40, alto 410, color 0x303030.
    em_mov_eax_imm(13);
    em_mov_reg_imm(187, 31326220);
    em_mov_reg_imm(185, 2621850);
    em_mov_reg_imm(186, 3158064);
    em_int(64);
    // Si lineCount <= 41, el pulgar llena el
    // carril (jbe lleno).
    em_mov_eax_mem(1);
    em_cmp_eax_imm(41);
    p_lleno = em_jbe_hueco();
    // alto = 410 * 41 / lineCount.
    em_mov_eax_imm(16810);
    em_byte(49);
    em_byte(210);
    em_div_mem(1);
    em_mov_mem_eax(6);
    // posicion = 40 + (410 - alto) * firstVisible
    // / (lineCount - 41).
    em_mov_eax_imm(410);
    em_sub_eax_mem(6);
    em_mul_mem(3);
    em_mov_ecx_mem(1);
    em_byte(131);
    em_byte(233);
    em_byte(41);
    em_byte(247);
    em_byte(241);
    em_add_eax_imm(40);
    em_mov_mem_eax(5);
    // jmp dibuja.
    p_dibuja = em_jmp_hueco();
    // lleno: alto = 410, posicion = 40.
    parche32(p_lleno,
        bytebuffer_get_size(dcod) - (p_lleno + 4));
    em_mov_eax_imm(410);
    em_mov_mem_eax(6);
    em_mov_eax_imm(40);
    em_mov_mem_eax(5);
    // dibuja: el pulgar, con la geometria
    // guardada en thumbTop y thumbHeight.
    parche32(p_dibuja,
        bytebuffer_get_size(dcod) - (p_dibuja + 4));
    em_mov_eax_imm(13);
    em_mov_reg_imm(187, 31326220);
    em_mov_ecx_mem(5);
    em_byte(193);
    em_byte(225);
    em_byte(16);
    em_add_ecx_mem(6);
    em_mov_reg_imm(186, 9474192);
    em_int(64);
    em_ret();
}


void emite_raton()
{
    int p_pulsado;
    int p_arrastra;
    int p_arriba;
    int p_abajo;
    int p_techo;
    int p_top;
    int p_rango;
    int f_soltado;
    int f_banda1;
    int f_banda2;
    int f_agarre;
    int f_rango1;
    int f_rango2;
    int f_cambio;
    int a_1;
    int a_2;
    int a_3;
    int a_4;
    int a_5;
    int p;
    int destino;
    // BOTONES (funcion 37.2): test eax, 1 (boton
    // izquierdo); si no esta pulsado, el arrastre
    // se cancela y se vuelve al bucle.
    em_mov_eax_imm(37);
    em_mov_reg_imm(187, 2);
    em_int(64);
    em_byte(169);
    em_dword(1);
    p_pulsado = em_jne_hueco();
    em_mov_eax_imm(0);
    em_mov_mem_eax(7);
    f_soltado = em_jmp_hueco();
    parche32(p_pulsado,
        bytebuffer_get_size(dcod) - (p_pulsado + 4));
    // COORDENADAS (funcion 37.1): EDX = y,
    // ECX = x.
    em_mov_eax_imm(37);
    em_mov_reg_imm(187, 1);
    em_int(64);
    em_byte(137);
    em_byte(194);
    em_byte(137);
    em_byte(209);
    em_byte(193);
    em_byte(233);
    em_byte(16);
    em_byte(129);
    em_byte(226);
    em_dword(65535);
    // Arrastrando? El agarre manda sobre la banda.
    em_mov_eax_mem(7);
    em_cmp_eax_imm(0);
    p_arrastra = em_jne_hueco();
    // La banda X de la barra: 478..490.
    em_byte(129);
    em_byte(249);
    em_dword(478);
    f_banda1 = em_jb_hueco();
    em_byte(129);
    em_byte(249);
    em_dword(490);
    f_banda2 = em_ja_hueco();
    // Encima del pulgar: pagina arriba. Debajo:
    // pagina abajo. Sobre el pulgar: agarre
    // (dragGrab = y - thumbTop, dragState = 1).
    em_mov_eax_mem(5);
    em_byte(59);
    em_byte(208);
    p_arriba = em_jb_hueco();
    em_mov_eax_mem(5);
    em_add_eax_mem(6);
    em_byte(59);
    em_byte(208);
    p_abajo = em_jae_hueco();
    em_byte(137);
    em_byte(208);
    em_sub_eax_mem(5);
    em_mov_mem_eax(8);
    em_mov_eax_imm(1);
    em_mov_mem_eax(7);
    f_agarre = em_jmp_hueco();
    // PAGINA ARRIBA: firstVisible - 41, suelo 0.
    parche32(p_arriba,
        bytebuffer_get_size(dcod) - (p_arriba + 4));
    em_mov_eax_mem(3);
    em_byte(131);
    em_byte(232);
    em_byte(41);
    a_1 = em_jge_hueco();
    em_mov_eax_imm(0);
    a_2 = em_jmp_hueco();
    // PAGINA ABAJO: firstVisible + 41, techo en
    // lineCount - 41 (suelo 0 si no hay pagina).
    parche32(p_abajo,
        bytebuffer_get_size(dcod) - (p_abajo + 4));
    em_mov_eax_mem(3);
    em_add_eax_imm(41);
    em_mov_ecx_mem(1);
    em_byte(131);
    em_byte(233);
    em_byte(41);
    p_techo = em_jns_hueco();
    em_mov_reg_imm(185, 0);
    parche32(p_techo,
        bytebuffer_get_size(dcod) - (p_techo + 4));
    em_byte(59);
    em_byte(193);
    a_3 = em_jbe_hueco();
    em_byte(137);
    em_byte(200);
    a_4 = em_jmp_hueco();
    // ARRASTRE: nuevoTop = y - dragGrab, sujeto a
    // [40, 40 + 410 - thumbHeight]; firstVisible =
    // (nuevoTop - 40) * (lineCount - 41) /
    // (410 - thumbHeight).
    parche32(p_arrastra,
        bytebuffer_get_size(dcod) - (p_arrastra + 4));
    em_mov_reg_imm(187, 410);
    em_sub_ebx_mem(6);
    em_mov_ecx_mem(1);
    em_byte(131);
    em_byte(233);
    em_byte(41);
    em_byte(131);
    em_byte(251);
    em_byte(0);
    f_rango1 = em_jle_hueco();
    em_byte(131);
    em_byte(249);
    em_byte(0);
    f_rango2 = em_jle_hueco();
    em_byte(137);
    em_byte(208);
    em_sub_eax_mem(8);
    em_cmp_eax_imm(40);
    p_top = em_jae_hueco();
    em_mov_eax_imm(40);
    parche32(p_top,
        bytebuffer_get_size(dcod) - (p_top + 4));
    em_byte(137);
    em_byte(218);
    em_byte(131);
    em_byte(194);
    em_byte(40);
    em_byte(59);
    em_byte(194);
    p_rango = em_jbe_hueco();
    em_byte(137);
    em_byte(208);
    parche32(p_rango,
        bytebuffer_get_size(dcod) - (p_rango + 4));
    em_byte(131);
    em_byte(232);
    em_byte(40);
    em_byte(247);
    em_byte(225);
    em_byte(247);
    em_byte(243);
    em_byte(59);
    em_byte(193);
    a_5 = em_jbe_hueco();
    em_byte(137);
    em_byte(200);
    // APLICAR: solo si el valor cambia se guarda
    // y se llama al REFRESCO (registrada con
    // duena 3, como la parchea el oraculo).
    destino = bytebuffer_get_size(dcod);
    parche32(a_1, destino - (a_1 + 4));
    parche32(a_2, destino - (a_2 + 4));
    parche32(a_3, destino - (a_3 + 4));
    parche32(a_4, destino - (a_4 + 4));
    parche32(a_5, destino - (a_5 + 4));
    em_cmp_eax_mem(3);
    f_cambio = em_je_hueco();
    em_mov_mem_eax(3);
    p = em_call_hueco();
    registra_parche(p, 6, 3);
    // SALIDA: los saltos a fuera se cierran aqui
    // y el salto al bucle se registra con duena 3.
    destino = bytebuffer_get_size(dcod);
    parche32(f_soltado, destino - (f_soltado + 4));
    parche32(f_banda1, destino - (f_banda1 + 4));
    parche32(f_banda2, destino - (f_banda2 + 4));
    parche32(f_agarre, destino - (f_agarre + 4));
    parche32(f_rango1, destino - (f_rango1 + 4));
    parche32(f_rango2, destino - (f_rango2 + 4));
    parche32(f_cambio, destino - (f_cambio + 4));
    p = em_jmp_hueco();
    registra_parche(p, 1, 3);
}


void emite_isla_edit()
{
    // La isla del boton EDIT: si su menu esta
    // abierto lo cierra; si no, lo abre. En
    // ambos casos redibuja y vuelve al bucle
    // (las llamadas y el salto se registran
    // con duena 4).
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int cerrar = em_je_hueco();
    em_mov_eax_imm(1);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    registra_parche(em_jmp_hueco(), 1, 4);
    parche32(cerrar,
             bytebuffer_get_size(dcod) - (cerrar + 4));
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    registra_parche(em_jmp_hueco(), 1, 4);
}


void emite_isla_cortar()
{
    // CORTAR: con el menu EDIT abierto y la
    // seleccion activa, copia y vacia, cierra
    // el menu y redibuja; si la guarda falla,
    // vuelve al bucle sin actuar.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int g1 = em_jne_hueco();
    em_mov_eax_mem(10);
    em_cmp_eax_imm(0);
    int g2 = em_je_hueco();
    registra_parche(em_call_hueco(), 11, 4);
    registra_parche(em_call_hueco(), 13, 4);
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    parche32(g2, salir - (g2 + 4));
    registra_parche(em_jmp_hueco(), 1, 4);
}


void emite_isla_copiar()
{
    // COPIAR: la misma guarda; copia, cierra
    // el menu y redibuja.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int g1 = em_jne_hueco();
    em_mov_eax_mem(10);
    em_cmp_eax_imm(0);
    int g2 = em_je_hueco();
    registra_parche(em_call_hueco(), 11, 4);
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    parche32(g2, salir - (g2 + 4));
    registra_parche(em_jmp_hueco(), 1, 4);
}


void emite_isla_sel()
{
    // SELECCIONAR TODO: con el menu abierto,
    // seleccion = 1, menu cerrado y redibujo.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int g1 = em_jne_hueco();
    em_mov_eax_imm(1);
    em_mov_mem_eax(10);
    em_mov_eax_imm(0);
    em_mov_mem_eax(9);
    registra_parche(em_call_hueco(), 0, 4);
    int salir = bytebuffer_get_size(dcod);
    parche32(g1, salir - (g1 + 4));
    registra_parche(em_jmp_hueco(), 1, 4);
}


void emite_isla_pegar()
{
    // PEGAR: con el menu abierto, pega, cierra
    // el menu y redibuja.
    em_mov_eax_mem(9);
    em_cmp_eax_imm(1);
    int g1 = em_jne_hueco();
    registra_parche(em_call_hueco(), 12, 4);
    em_mov_eax_imm(0);
