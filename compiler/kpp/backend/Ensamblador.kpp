    em_byte(190);
    em_dword(4);
    em_int(64);
    // Renglon 2: y 51, boton 10, texto +73, largo 4.
    em_mov_eax_imm(8);
    em_mov_reg_imm(187, 983150);
    em_mov_reg_imm(185, 3342350);
    em_mov_reg_imm(186, 10);
    em_mov_reg_imm(190, 2631720);
    em_int(64);
