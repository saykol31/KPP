// LA TABLA DE LA SONDA 17: EL ARREGLO GLOBAL EN
// FILE_READ.
// ============================================================
//
// La fuente:
//
//   int datos[10];
//   int main()
//   {
//       int r = file_read("DATOS.TXT", datos);
//       return r;
//   }
//
// 25 tokens, 10 nodos. El Declare del global sale con su
// capacidad 10, pero el registro del generador solo mira
// ambitos locales: dentro de main, datos no esta
// registrado, su nombre se resuelve por la via de reserva
// y su capacidad da 0 — la misma ceguera que el
// resolveArraySize de Stage 0, que con capacidad 0
// aborta. Aqui el FileRead sale con valor 0 y, con G-3,
// errores_ir cierra en 1.

