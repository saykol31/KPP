// IRGenerator.kpp — Stage 1, backend.
// El generador de IR: traduce el AST del contrato a la
// corriente de instrucciones que el X86Backend consume.
// El enum IROpcode que sigue es su contrato de salida:
// los 57 codigos de include/kpp/IR.hpp en su orden
// exacto (una operacion nueva va AL FINAL, nunca en el
// medio). La traduccion vive mas abajo, tras el enum,
// en la seccion IRGENERATOR (rebanada IR-1).

enum IROpcode
{
    // ESTRUCTURA DEL PROGRAMA
    FunctionBegin,
    FunctionEnd,

    // CONSTANTES
    Const,
    StringConst,

    // VARIABLES Y MEMORIA
    Declare,
    Store,
    Load,
    ArrayLoad,
    ArrayStore,

    // FILE I/O
    FileRead,
    FileWrite,

    // ARITMETICA BASICA
    Add,
    Sub,
    Mul,
    Div,
    Mod,

    // POTENCIAS Y RAICES
    Pow,
    Sqrt,

    // LOGARITMOS Y EXPONENCIALES
    Log,
    Log10,
    Exp,

    // TRIGONOMETRIA
    Sin,
    Cos,
    Tan,
    Cot,
    Sec,
    Csc,

    // TRIGONOMETRIA INVERSA
    Asin,
    Acos,
    Atan,

    // FUNCIONES MATEMATICAS
    Abs,
    Floor,
    Ceil,
    Round,
    Min,
    Max,

    // MATEMATICA AVANZADA
    Factorial,
    Sum,
    Integral,

    // FUNCIONES
    Call,
    Return,

    // SALIDA
    Print,
    PrintInteger,
    PrintFloat,

    // COMPARACIONES
    CompareEqual,
    CompareNotEqual,
    CompareLess,
    CompareLessEqual,
    CompareGreater,
    CompareGreaterEqual,

    // LOGICA
    LogicalAnd,
    LogicalOr,
    LogicalNot,

    // CONTROL DE FLUJO
    Label,
    Jump,
    JumpIfZero,
    JumpIfNotZero
};


// ============================================================
// IRGENERATOR — Stage 1, backend. Rebanadas IR-1,
// IR-2 e IR-3: el generador completo.
// ============================================================
//
// Traduccion de src/backend/IRGenerator.cpp (Stage 0)
// a K++, por rebanadas. Su entrada es el AST del
// contrato (los ocho arreglos y las tablas
// laterales), el mismo que el Parser construye y el
// SemanticAnalyzer recorre; su salida es la
// corriente de instrucciones IR que el X86Backend
// consumira.
//
// LA INSTRUCCION EN STAGE 1: seis arreglos paralelos
// (iop, inombre, ioperando, iresultado, iaux,
// ivalor) de 2048 instrucciones. Los cuatro campos
// de texto de Stage 0 (name, operand, result,
// auxiliary) son referencias a UNA piscina de texto
// propia del generador (pool[], caracteres): una
// referencia es un solo entero, ini * 128 + largo,
// con el texto en pool[ini .. ini + largo). La
// piscina es escribible y es del generador, porque
// los textos del IR son sinteticos — x@0, p.campo,
// %12, L4, la lista "a, b" de parametros, la pareja
// "%0, %1" de una binaria — y no viven en fuente[].
// Los textos que si son de la fuente (nombres,
// literales de cadena) se copian de fuente[] a la
// piscina al emitir.
//
// LOS AMBITOS: como en Stage 0, el generador lleva
// sus propios ambitos de variables (no usa los del
// analizador): cada declaracion local recibe su
// nombre IR unico nombre@N, con N del contador de
// la funcion, y las capacidades de arreglo viajan
// con el registro. Una variable de struct se APLANA:
// un Declare por campo (nombre@N.campo), y el campo
// se registra con su token al lado del de la base.
// Los parametros y las globales no se registran:
// al resolver, el nombre original es el que vale
// (la regla de Stage 0). Temporales %N, etiquetas
// LN y contador de variables se reinician por
// funcion.
//
// COBERTURA DE LA IR-1:
//   - genera(): las globales como Declare en orden
//     y cada funcion con genera_funcion().
//   - genera_funcion(): FunctionBegin con la lista
//     de parametros, el cuerpo sin abrir ambito
//     (el ambito raiz es el de la funcion) y
//     FunctionEnd.
//   - genera_sentencia(): VariableDeclaration (con
//     el aplanado de structs y el inicializador) y
//     ReturnStatement (con su via rapida de literal
//     entero: RETURN con el valor, sin temporal).
//
// COBERTURA DE LA IR-2 (sentencias):
//   - Block (genera_bloque), AssignmentStatement
//     (plana, con indice — ArrayStore — y a campo),
//     IfStatement y WhileStatement con sus
//     etiquetas (en el if se crean siempre las dos,
//     fin primero; en el while, antes de la
//     condicion), PrintStatement y
//     PrintIntegerStatement.
//
// COBERTURA NUEVA DE LA IR-3 (expresiones) — con
// esto el generador queda COMPLETO, como su
// original de 1804 lineas:
//   - BinaryExpression: izquierdo, derecho y
//     temporal de resultado; el operando es la
//     pareja "%a, %b" construida en la piscina. El
//     mapa codigo de token -> opcode va en
//     op_binaria(). LogicalNot lleva solo el
//     operando derecho (el izquierdo, el 0
//     sintetico del Parser, se genera pero no se
//     usa), como en Stage 0.
//   - CallExpression: los argumentos en orden, sus
//     temporales unidos en el operando, el temporal
//     de resultado despues, y el nombre del llamado
//     al emitir — el orden de construccion de
//     Stage 0, que es el orden en que los textos
//     entran en la piscina.
//   - file_read y file_write: se reconocen por el
//     nombre del llamado (es_file_read y
//     es_file_write, por caracteres como el
//     es_print_int del Parser). El arreglo NO se
//     carga: viaja su identidad resuelta y su
//     capacidad (capacidad_de, del registro del
//     generador; un arreglo global da 0, la misma
//     ceguera que el resolveArraySize de Stage 0
//     fuera de los ambitos locales). En file_write
//     la cantidad se genera antes que el temporal
//     de resultado y viaja en el campo auxiliary.
//   - ArrayAccessExpression: ArrayLoad con el
//     indice generado primero.
//   - VariableExpression con campo: Load del
//     nombre aplanado (resuelve_campo).
// Las validaciones (aridades, clases de argumento)
// son del SemanticAnalyzer: el generador confia en
// el AST ya analizado, como confia en que el return
// trae expresion.
//
// LA SONDA (main): nueve programas cargados con
// tablas inicia_irN() generadas de sus fuentes
// reales. Por sonda se imprime la corriente en
// forma numerica: por instruccion, el nombre de
// la operacion y nueve enteros (las cuatro
// referencias desempaquetadas en inicio y largo,
// y el valor), y al final el largo de la piscina
// y sus caracteres en codigos.
// ============================================================
// ============================================================

enum NodeKind
{
    // DECLARACIONES
    Program,
    FunctionDeclaration,
    StructDeclaration,
    EnumDeclaration,

    // SENTENCIAS
    Block,
    VariableDeclaration,
    AssignmentStatement,
    IfStatement,
    WhileStatement,
    ReturnStatement,
    PrintStatement,
    PrintIntegerStatement,

    // EXPRESIONES
    IntegerLiteral,
    StringLiteral,
    VariableExpression,
    ArrayAccessExpression,
    CallExpression,
    BinaryExpression
};

// ============================================================
// ESTADO DEL GENERADOR.
// ============================================================

int tok_count;
int nnodos;
int nir;
int pool_len;
int ntemp;
int contvar;
int nvar;
int nivel;
int netiq;

// ============================================================
// LA PISCINA DE TEXTO.
// ============================================================

int agrega_car(int c)
{
    int pool[16384];
    if (pool_len < 16384)
    {
        pool[pool_len] = c;
        pool_len = pool_len + 1;
    }
    return 0;
}

int agrega_token(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int ini = tok_inicio[tok];
    int n = tok_largo[tok];
    int i = 0;
    while (i < n)
    {
        int c = fuente[ini + i];
        int a = agrega_car(c);
        i = i + 1;
    }
    return 0;
}

int agrega_tramo(int ini, int largo)
{
    int pool[16384];
    int i = 0;
    while (i < largo)
    {
        int c = pool[ini + i];
        int a = agrega_car(c);
        i = i + 1;
    }
    return 0;
}

int agrega_numero(int n)
{
    if (n >= 10)
    {
        int a = agrega_numero(n / 10);
    }
    int d = n - (n / 10) * 10;
    int b = agrega_car(48 + d);
    return 0;
}

int ref_token(int tok)
{
    int ini = pool_len;
    int a = agrega_token(tok);
    return ini * 128 + (pool_len - ini);
}

int ref_temp()
{
    int ini = pool_len;
    int a = agrega_car(37);
    int b = agrega_numero(ntemp);
    ntemp = ntemp + 1;
    return ini * 128 + (pool_len - ini);
}

// ============================================================
// MISMO TEXTO — la forma probada (sonda_mismo_texto):
// cada carga a una local antes de comparar.
// ============================================================

int mismo_texto(int a, int b)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int la = tok_largo[a];
    int lb = tok_largo[b];
    if (la != lb)
    {
        return 0;
    }
    int ia = tok_inicio[a];
    int ib = tok_inicio[b];
    int i = 0;
    while (i < la)
    {
        int ca = fuente[ia + i];
        int cb = fuente[ib + i];
        if (ca != cb)
        {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// ============================================================
// EMITIR UNA INSTRUCCION.
// ============================================================

int emite_ir(int op, int nombre, int operando, int resultado, int aux, int valor)
{
    int iop[2048];
    int inombre[2048];
    int ioperando[2048];
    int iresultado[2048];
    int iaux[2048];
    int ivalor[2048];
    if (nir < 2048)
    {
        iop[nir] = op;
        inombre[nir] = nombre;
        ioperando[nir] = operando;
        iresultado[nir] = resultado;
        iaux[nir] = aux;
        ivalor[nir] = valor;
        nir = nir + 1;
    }
    return 0;
}

// ============================================================
// AMBITOS DE VARIABLES DEL GENERADOR.
// ============================================================
//
// Una fila por nombre visible: el token de la base,
// el token del campo (-1 si es la variable misma),
// la referencia a su nombre IR en la piscina, su
// capacidad de arreglo y el sello de nivel.

int entra_ambito()
{
    nivel = nivel + 1;
    return 0;
}

int sale_ambito()
{
    int vscope_nivel[256];
    int sigue = 1;
    while (sigue == 1)
    {
        if (nvar == 0)
        {
            sigue = 0;
        }
        else
        {
            int u = vscope_nivel[nvar - 1];
            if (u != nivel)
            {
                sigue = 0;
            }
            else
            {
                nvar = nvar - 1;
            }
        }
    }
    nivel = nivel - 1;
    return 0;
}

int registra_var(int tok, int campo, int ref, int tam)
{
    int vscope_tok[256];
    int vscope_campo[256];
    int vscope_ref[256];
    int vscope_tam[256];
    int vscope_nivel[256];
    if (nvar < 256)
    {
        vscope_tok[nvar] = tok;
        vscope_campo[nvar] = campo;
        vscope_ref[nvar] = ref;
        vscope_tam[nvar] = tam;
        vscope_nivel[nvar] = nivel;
        nvar = nvar + 1;
    }
    return 0;
}

int busca_var(int tok, int campo)
{
    int vscope_tok[256];
    int vscope_campo[256];
    int i = nvar - 1;
    while (i >= 0)
    {
        int t = vscope_tok[i];
        if (mismo_texto(t, tok) == 1)
        {
            int c = vscope_campo[i];
            if (c == campo)
            {
                return i;
            }
            if (c >= 0)
            {
                if (campo >= 0)
                {
                    if (mismo_texto(c, campo) == 1)
                    {
                        return i;
                    }
                }
            }
        }
        i = i - 1;
    }
    return -1;
}

int resuelve(int tok)
{
    int vscope_ref[256];
    int f = busca_var(tok, -1);
    if (f >= 0)
    {
        int r = vscope_ref[f];
        return r;
    }
    return ref_token(tok);
}

// ============================================================
// LA DECLARACION DE STRUCT DE UN TIPO, o -1.
// ============================================================

int struct_de(int tipo)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int d = nhijo1[0];
    while (d >= 0)
    {
        int k = nkind[d];
        if (k == NodeKind::StructDeclaration)
        {
            int nt = nval[d];
            if (mismo_texto(nt, tipo) == 1)
            {
                return d;
            }
        }
        d = nsig[d];
    }
    return -1;
}

// ============================================================
// AYUDANTES DE LAS EXPRESIONES (IR-3).
// ============================================================

int agrega_ref(int ref)
{
    int ini = ref / 128;
    int largo = ref - ini * 128;
    int a = agrega_tramo(ini, largo);
    return 0;
}

int une_refs(int a, int b)
{
    int ini = pool_len;
    int x = agrega_ref(a);
    int c1 = agrega_car(44);
    int c2 = agrega_car(32);
    int y = agrega_ref(b);
    return ini * 128 + (pool_len - ini);
}

int op_binaria(int op)
{
    if (op == 14)
    {
        return IROpcode::Add;
    }
    if (op == 15)
    {
        return IROpcode::Sub;
    }
    if (op == 16)
    {
        return IROpcode::Mul;
    }
    if (op == 17)
    {
        return IROpcode::Div;
    }
    if (op == 18)
    {
        return IROpcode::Mod;
    }
    if (op == 19)
    {
        return IROpcode::Pow;
    }
    if (op == 20)
    {
        return IROpcode::CompareEqual;
    }
    if (op == 21)
    {
        return IROpcode::CompareNotEqual;
    }
    if (op == 22)
    {
        return IROpcode::CompareLess;
    }
    if (op == 23)
    {
        return IROpcode::CompareLessEqual;
    }
    if (op == 24)
    {
        return IROpcode::CompareGreater;
    }
    if (op == 25)
    {
        return IROpcode::CompareGreaterEqual;
    }
    if (op == 26)
    {
        return IROpcode::LogicalAnd;
    }
    if (op == 27)
    {
        return IROpcode::LogicalOr;
    }
    if (op == 28)
    {
        return IROpcode::LogicalNot;
    }
    return -1;
}

int capacidad_de(int tok)
{
    int vscope_tam[256];
    int f = busca_var(tok, -1);
    if (f >= 0)
    {
        int t = vscope_tam[f];
        return t;
    }
    return 0;
}

int es_file_read(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    if (tok_largo[tok] != 9)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    if (fuente[base + 0] != 102)
    {
        return 0;
    }
    if (fuente[base + 1] != 105)
    {
        return 0;
    }
    if (fuente[base + 2] != 108)
    {
        return 0;
    }
    if (fuente[base + 3] != 101)
    {
        return 0;
    }
    if (fuente[base + 4] != 95)
    {
        return 0;
    }
    if (fuente[base + 5] != 114)
    {
        return 0;
    }
    if (fuente[base + 6] != 101)
    {
        return 0;
    }
    if (fuente[base + 7] != 97)
    {
        return 0;
    }
    if (fuente[base + 8] != 100)
    {
        return 0;
    }
    return 1;
}

int es_file_write(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    if (tok_largo[tok] != 10)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    if (fuente[base + 0] != 102)
    {
        return 0;
    }
    if (fuente[base + 1] != 105)
    {
        return 0;
    }
    if (fuente[base + 2] != 108)
    {
        return 0;
    }
    if (fuente[base + 3] != 101)
    {
        return 0;
    }
    if (fuente[base + 4] != 95)
    {
        return 0;
    }
    if (fuente[base + 5] != 119)
    {
        return 0;
    }
    if (fuente[base + 6] != 114)
    {
        return 0;
    }
    if (fuente[base + 7] != 105)
    {
        return 0;
    }
    if (fuente[base + 8] != 116)
    {
        return 0;
    }
    if (fuente[base + 9] != 101)
    {
        return 0;
    }
    return 1;
}

// ============================================================
// GENERAR EXPRESION (completa, IR-3).
// ============================================================
//
// Devuelve la referencia al temporal que guarda el
// valor de la expresion.

int genera_expresion(int e)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int k = nkind[e];
    if (k == NodeKind::IntegerLiteral)
    {
        int t = ref_temp();
        int v = nval[e];
        int em = emite_ir(IROpcode::Const, 0, 0, t, 0, v);
        return t;
    }
    if (k == NodeKind::StringLiteral)
    {
        int t2 = ref_temp();
        int nt = nval[e];
        int nombre = ref_token(nt);
        int em2 = emite_ir(IROpcode::StringConst, nombre, 0, t2, 0, 0);
        return t2;
    }
    if (k == NodeKind::VariableExpression)
    {
        int h = nhijo1[e];
        int t3 = ref_temp();
        int nt3 = nval[e];
        if (h >= 0)
        {
            int nom3 = resuelve_campo(nt3, h);
            int em3 = emite_ir(IROpcode::Load, nom3, 0, t3, 0, 0);
            return t3;
        }
        int nom4 = resuelve(nt3);
        int em4 = emite_ir(IROpcode::Load, nom4, 0, t3, 0, 0);
        return t3;
    }
    if (k == NodeKind::ArrayAccessExpression)
    {
        int hi = nhijo1[e];
        int ti = genera_expresion(hi);
        int t4 = ref_temp();
        int nt4 = nval[e];
        int nom5 = resuelve(nt4);
        int em5 = emite_ir(IROpcode::ArrayLoad, nom5, ti, t4, 0, 0);
        return t4;
    }
    if (k == NodeKind::BinaryExpression)
    {
        int izq = nhijo1[e];
        int der = nsig[izq];
        int ti2 = genera_expresion(izq);
        int td = genera_expresion(der);
        int t5 = ref_temp();
        int op = nval[e];
        int iop2 = op_binaria(op);
        if (iop2 == IROpcode::LogicalNot)
        {
            int em6 = emite_ir(iop2, 0, td, t5, 0, 0);
            return t5;
        }
        int par = une_refs(ti2, td);
        int em7 = emite_ir(iop2, 0, par, t5, 0, 0);
        return t5;
    }
    if (k == NodeKind::CallExpression)
    {
        int ct = nval[e];
        int a1 = nhijo1[e];
        if (es_file_read(ct) == 1)
        {
            int a2 = nsig[a1];
            int t6 = ref_temp();
            int ruta1 = nval[a1];
            int nom6 = ref_token(ruta1);
            int arr1 = nval[a2];
            int ident1 = resuelve(arr1);
            int cap1 = capacidad_de(arr1);
            int em8 = emite_ir(IROpcode::FileRead, nom6, ident1, t6, 0, cap1);
            return t6;
        }
        if (es_file_write(ct) == 1)
        {
            int a2w = nsig[a1];
            int a3w = nsig[a2w];
            int tc = genera_expresion(a3w);
            int t7 = ref_temp();
            int ruta2 = nval[a1];
            int nom7 = ref_token(ruta2);
            int arr2 = nval[a2w];
            int ident2 = resuelve(arr2);
            int cap2 = capacidad_de(arr2);
            int em9 = emite_ir(IROpcode::FileWrite, nom7, ident2, t7, tc, cap2);
            return t7;
        }
        int temps[32];
        int narg = 0;
        int arg = a1;
        while (arg >= 0)
        {
            int ta = genera_expresion(arg);
            if (narg < 32)
            {
                temps[narg] = ta;
                narg = narg + 1;
            }
            arg = nsig[arg];
        }
        int unidos = 0;
        if (narg > 0)
        {
            int ini_u = pool_len;
            int j = 0;
            while (j < narg)
            {
                if (j > 0)
                {
                    int c1 = agrega_car(44);
                    int c2 = agrega_car(32);
                }
                int tj = temps[j];
                int aj = agrega_ref(tj);
                j = j + 1;
            }
            unidos = ini_u * 128 + (pool_len - ini_u);
        }
        int t8 = ref_temp();
        int nom8 = ref_token(ct);
        int em10 = emite_ir(IROpcode::Call, nom8, unidos, t8, 0, 0);
        return t8;
    }
    return 0;
}

int ref_etiqueta()
{
    int ini = pool_len;
    int a = agrega_car(76);
    int b = agrega_numero(netiq);
    netiq = netiq + 1;
    return ini * 128 + (pool_len - ini);
}

// ============================================================
// ES CAMPO — la lectura doble de hijo1 en la
// asignacion: si el token que sigue al nombre del
// destino es Dot (38), hijo1 es el token del campo;
// si es LBracket, hijo1 es el nodo del indice.
// ============================================================

int es_campo(int s)
{
    int nini[256];
    int tok_tipo[256];
    int ini = nini[s];
    int t = tok_tipo[ini + 1];
    if (t == 38)
    {
        return 1;
    }
    return 0;
}

// ============================================================
// RESOLVER UN CAMPO — el nombre aplanado registrado
// (base, campo); si no esta (una global de struct,
// que no se aplana), se compone el texto nombre.
// campo en la piscina, como hace Stage 0 al caer
// en el nombre original.
// ============================================================

int resuelve_campo(int tok, int campo)
{
    int vscope_ref[256];
    int f = busca_var(tok, campo);
    if (f >= 0)
    {
        int r = vscope_ref[f];
        return r;
    }
    int ini = pool_len;
    int a = agrega_token(tok);
    int b = agrega_car(46);
    int c = agrega_token(campo);
    return ini * 128 + (pool_len - ini);
}

// ============================================================
// GENERAR UN BLOQUE con su ambito: lo usan la
// sentencia Block y los bloques de if/while.
// ============================================================

int genera_bloque(int b)
{
    int nhijo1[256];
    int nsig[256];
    int ea = entra_ambito();
    int s = nhijo1[b];
    while (s >= 0)
    {
        int g = genera_sentencia(s);
        s = nsig[s];
    }
    int sa = sale_ambito();
    return 0;
}

// ============================================================
// GENERAR SENTENCIA (cobertura IR-1 e IR-2).
// ============================================================

int genera_sentencia(int s)
{
    int nkind[256];
    int nini[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int naux[256];
    int nsize[256];
    int campotok[256];
    int k = nkind[s];
    if (k == NodeKind::VariableDeclaration)
    {
        int nt = nval[s];
        int ini_m = pool_len;
        int a1 = agrega_token(nt);
        int a2 = agrega_car(64);
        int a3 = agrega_numero(contvar);
        int mangled = ini_m * 128 + (pool_len - ini_m);
        int largo_m = pool_len - ini_m;
        contvar = contvar + 1;
        int tam = nsize[s];
        int r1 = registra_var(nt, -1, mangled, tam);
        int e1 = emite_ir(IROpcode::Declare, mangled, 0, 0, 0, tam);
        int tipo = nini[s];
        int est = struct_de(tipo);
        if (est >= 0)
        {
            int ci = naux[est];
            int cc = nsize[est];
            int j = 0;
            while (j < cc)
            {
                int ct = campotok[ci + j];
                int ini_f = pool_len;
                int b1 = agrega_tramo(ini_m, largo_m);
                int b2 = agrega_car(46);
                int b3 = agrega_token(ct);
                int fmang = ini_f * 128 + (pool_len - ini_f);
                int r2 = registra_var(nt, ct, fmang, 0);
                int e2 = emite_ir(IROpcode::Declare, fmang, 0, 0, 0, 0);
                j = j + 1;
            }
        }
        int ini = nhijo1[s];
        if (ini >= 0)
        {
            int ki = nkind[ini];
            if (ki == NodeKind::IntegerLiteral)
            {
                int t = ref_temp();
                int v = nval[ini];
                int e3 = emite_ir(IROpcode::Const, 0, 0, t, 0, v);
                int e4 = emite_ir(IROpcode::Store, mangled, t, 0, 0, 0);
                return 0;
            }
            int t2 = genera_expresion(ini);
            int e5 = emite_ir(IROpcode::Store, mangled, t2, 0, 0, 0);
            return 0;
        }
        return 0;
    }
    if (k == NodeKind::AssignmentStatement)
    {
        int valor = naux[s];
        int h = nhijo1[s];
        int nt2 = nval[s];
        if (h >= 0)
        {
            if (es_campo(s) == 1)
            {
                int tv = genera_expresion(valor);
                int dest = resuelve_campo(nt2, h);
                int e6 = emite_ir(IROpcode::Store, dest, tv, 0, 0, 0);
                return 0;
            }
            int ti = genera_expresion(h);
            int tv2 = genera_expresion(valor);
            int arr = resuelve(nt2);
            int e7 = emite_ir(IROpcode::ArrayStore, arr, ti, tv2, 0, 0);
            return 0;
        }
        int tv3 = genera_expresion(valor);
        int dest2 = resuelve(nt2);
        int e8 = emite_ir(IROpcode::Store, dest2, tv3, 0, 0, 0);
        return 0;
    }
    if (k == NodeKind::Block)
    {
        int g = genera_bloque(s);
        return 0;
    }
    if (k == NodeKind::IfStatement)
    {
        int cond = nhijo1[s];
        int tc = genera_expresion(cond);
        int fin = ref_etiqueta();
        int els = ref_etiqueta();
        int entonces = nsig[cond];
        int sino = -1;
        if (entonces >= 0)
        {
            sino = nsig[entonces];
        }
        int destino = fin;
        if (sino >= 0)
        {
            destino = els;
        }
        int e9 = emite_ir(IROpcode::JumpIfZero, destino, tc, 0, 0, 0);
        if (entonces >= 0)
        {
            int g1 = genera_bloque(entonces);
        }
        if (sino >= 0)
        {
            int e10 = emite_ir(IROpcode::Jump, fin, 0, 0, 0, 0);
            int e11 = emite_ir(IROpcode::Label, els, 0, 0, 0, 0);
            int g2 = genera_bloque(sino);
        }
        int e12 = emite_ir(IROpcode::Label, fin, 0, 0, 0, 0);
        return 0;
    }
    if (k == NodeKind::WhileStatement)
    {
        int ini_e = ref_etiqueta();
        int fin_e = ref_etiqueta();
        int e13 = emite_ir(IROpcode::Label, ini_e, 0, 0, 0, 0);
        int cond2 = nhijo1[s];
        int tc2 = genera_expresion(cond2);
        int e14 = emite_ir(IROpcode::JumpIfZero, fin_e, tc2, 0, 0, 0);
        int cuerpo = nsig[cond2];
        if (cuerpo >= 0)
        {
            int g3 = genera_bloque(cuerpo);
        }
        int e15 = emite_ir(IROpcode::Jump, ini_e, 0, 0, 0, 0);
        int e16 = emite_ir(IROpcode::Label, fin_e, 0, 0, 0, 0);
        return 0;
    }
    if (k == NodeKind::PrintStatement)
    {
        int ep = nhijo1[s];
        int tp = genera_expresion(ep);
        int e17 = emite_ir(IROpcode::Print, 0, tp, 0, 0, 0);
        return 0;
    }
    if (k == NodeKind::PrintIntegerStatement)
    {
        int ei = nhijo1[s];
        int ti2 = genera_expresion(ei);
        int e18 = emite_ir(IROpcode::PrintInteger, 0, ti2, 0, 0, 0);
        return 0;
    }
    if (k == NodeKind::ReturnStatement)
    {
        int e = nhijo1[s];
        if (e < 0)
        {
            // Sin expresion: el analizador ya lo
            // acuso (codigo 13); aqui no se emite.
            return 0;
        }
        int ke = nkind[e];
        if (ke == NodeKind::IntegerLiteral)
        {
            int v = nval[e];
            int e19 = emite_ir(IROpcode::Return, 0, 0, 0, 0, v);
            return 0;
        }
        int t = genera_expresion(e);
        int e20 = emite_ir(IROpcode::Return, 0, t, 0, 0, 0);
        return 0;
    }
    return 0;
}

// ============================================================
// GENERAR FUNCION.
// ============================================================

int genera_funcion(int f)
{
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int naux[256];
    int nsize[256];
    int partok[256];
    ntemp = 0;
    contvar = 0;
    netiq = 0;
    int ea = entra_ambito();
    int nt = nval[f];
    int nombre = ref_token(nt);
    int params = 0;
    int inicio = naux[f];
    int cant = nsize[f];
    if (cant > 0)
    {
        int ini_p = pool_len;
        int j = 0;
        while (j < cant)
        {
            if (j > 0)
            {
                int c1 = agrega_car(44);
                int c2 = agrega_car(32);
            }
            int pt = partok[inicio + j];
            int a = agrega_token(pt);
            j = j + 1;
        }
        params = ini_p * 128 + (pool_len - ini_p);
    }
    int e1 = emite_ir(IROpcode::FunctionBegin, nombre, params, 0, 0, 0);
    int cuerpo = nhijo1[f];
    if (cuerpo >= 0)
    {
        int s = nhijo1[cuerpo];
        while (s >= 0)
        {
            int g = genera_sentencia(s);
            s = nsig[s];
        }
    }
    int e2 = emite_ir(IROpcode::FunctionEnd, 0, 0, 0, 0, 0);
    int sa = sale_ambito();
    return 0;
}

// ============================================================
// GENERAR EL PROGRAMA.
// ============================================================

int genera()
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int nsize[256];
    nir = 0;
    pool_len = 0;
    nvar = 0;
    nivel = 0;
    int d = nhijo1[0];
    while (d >= 0)
    {
        int k = nkind[d];
        if (k == NodeKind::VariableDeclaration)
        {
            int nt = nval[d];
            int nombre = ref_token(nt);
            int tam = nsize[d];
            int e = emite_ir(IROpcode::Declare, nombre, 0, 0, 0, tam);
        }
        d = nsig[d];
    }
    d = nhijo1[0];
    while (d >= 0)
    {
        int k2 = nkind[d];
        if (k2 == NodeKind::FunctionDeclaration)
        {
            int g = genera_funcion(d);
        }
        d = nsig[d];
    }
    return 0;
}

// ============================================================
// IMPRIMIR LA CORRIENTE (la sonda).
// ============================================================

int imprime_op(int op)
{
    if (op == IROpcode::FunctionBegin)
    {
        print("FUNCTION_BEGIN");
        return 0;
    }
    if (op == IROpcode::FunctionEnd)
    {
        print("FUNCTION_END");
        return 0;
    }
    if (op == IROpcode::Const)
    {
        print("CONST");
        return 0;
    }
    if (op == IROpcode::StringConst)
    {
        print("STRING_CONST");
        return 0;
    }
    if (op == IROpcode::Declare)
    {
        print("DECLARE");
        return 0;
    }
    if (op == IROpcode::Store)
    {
        print("STORE");
        return 0;
    }
    if (op == IROpcode::Load)
    {
        print("LOAD");
        return 0;
    }
    if (op == IROpcode::ArrayLoad)
    {
        print("ARRAY_LOAD");
        return 0;
    }
    if (op == IROpcode::ArrayStore)
    {
        print("ARRAY_STORE");
        return 0;
    }
    if (op == IROpcode::FileRead)
    {
        print("FILE_READ");
        return 0;
    }
    if (op == IROpcode::FileWrite)
    {
        print("FILE_WRITE");
        return 0;
    }
    if (op == IROpcode::Add)
    {
        print("ADD");
        return 0;
    }
    if (op == IROpcode::Sub)
    {
        print("SUB");
        return 0;
    }
    if (op == IROpcode::Mul)
    {
        print("MUL");
        return 0;
    }
    if (op == IROpcode::Div)
    {
        print("DIV");
        return 0;
    }
    if (op == IROpcode::Mod)
    {
        print("MOD");
        return 0;
    }
    if (op == IROpcode::Pow)
    {
        print("POW");
        return 0;
    }
    if (op == IROpcode::Call)
    {
        print("CALL");
        return 0;
    }
    if (op == IROpcode::Return)
    {
        print("RETURN");
        return 0;
    }
    if (op == IROpcode::Print)
    {
        print("PRINT");
        return 0;
    }
    if (op == IROpcode::PrintInteger)
    {
        print("PRINT_INTEGER");
        return 0;
    }
    if (op == IROpcode::CompareEqual)
    {
        print("COMPARE_EQUAL");
        return 0;
    }
    if (op == IROpcode::CompareNotEqual)
    {
        print("COMPARE_NOT_EQUAL");
        return 0;
    }
    if (op == IROpcode::CompareLess)
    {
        print("COMPARE_LESS");
        return 0;
    }
    if (op == IROpcode::CompareLessEqual)
    {
        print("COMPARE_LESS_EQUAL");
        return 0;
    }
    if (op == IROpcode::CompareGreater)
    {
        print("COMPARE_GREATER");
        return 0;
    }
    if (op == IROpcode::CompareGreaterEqual)
    {
        print("COMPARE_GREATER_EQUAL");
        return 0;
    }
    if (op == IROpcode::LogicalAnd)
    {
        print("LOGICAL_AND");
        return 0;
    }
    if (op == IROpcode::LogicalOr)
    {
        print("LOGICAL_OR");
        return 0;
    }
    if (op == IROpcode::LogicalNot)
    {
        print("LOGICAL_NOT");
        return 0;
    }
    if (op == IROpcode::Label)
    {
        print("LABEL");
        return 0;
    }
    if (op == IROpcode::Jump)
    {
        print("JUMP");
        return 0;
    }
    if (op == IROpcode::JumpIfZero)
    {
        print("JUMP_IF_ZERO");
        return 0;
    }
    print_int(op);
    return 0;
}

int imprime_ref(int ref)
{
    int ini = ref / 128;
    print_int(ini);
    int largo = ref - ini * 128;
    print_int(largo);
    return 0;
}

int imprime_ir()
{
    int iop[2048];
    int inombre[2048];
    int ioperando[2048];
    int iresultado[2048];
    int iaux[2048];
    int ivalor[2048];
    int pool[16384];
    int i = 0;
    while (i < nir)
    {
        int op = iop[i];
        int a = imprime_op(op);
        int n = inombre[i];
        int b = imprime_ref(n);
        int o = ioperando[i];
        int c = imprime_ref(o);
        int r = iresultado[i];
        int d = imprime_ref(r);
        int x = iaux[i];
        int e = imprime_ref(x);
        int v = ivalor[i];
        print_int(v);
        i = i + 1;
    }
    print_int(pool_len);
    i = 0;
    while (i < pool_len)
    {
        int ch = pool[i];
        print_int(ch);
        i = i + 1;
    }
    return 0;
}

