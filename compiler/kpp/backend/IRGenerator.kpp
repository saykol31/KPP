// ============================================================
// SONDA 10 — EL ECO DE VOID.
//
// void saluda() { print("HOLA"); return; }
// int main() { saluda(); return 0; }
//
// La corriente gana dos emisiones nuevas: el CALL de
// la llamada-sentencia de main y el RETURN de valor 0
// del return; pelado de saluda (antes de este eco un
// Return sin expresion no emita nada). Orden: BEGIN
// saluda, STRING_CONST, PRINT, RETURN, END, BEGIN
