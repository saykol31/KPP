        return;
    }
    if (op == IROpcode::ShiftRight)
    {
        print("SHIFT_RIGHT");
        return;
    }
    print_int(op);
}

void imprime_ref(int ref)
{
    int ini = ref / 128;
    print_int(ini);
    int largo = ref - ini * 128;
    print_int(largo);
}

void imprime_ir()
{
    int i = 0;
    for (i = 0; i < nir; i = i + 1)
    {
        int op = da_get(diop, i);
        imprime_op(op);
        int n = da_get(dinombre, i);
        imprime_ref(n);
        int o = da_get(dioperando, i);
        imprime_ref(o);
        int r = da_get(diresultado, i);
        imprime_ref(r);
        int x = da_get(diaux, i);
        imprime_ref(x);
        int v = da_get(divalor, i);
        print_int(v);
    }
    print_int(pool_len);
    for (i = 0; i < pool_len; i = i + 1)
    {
        int ch = string_pool_get_char(dpiscina, i, 0);
        print_int(ch);
    }
    if (errores_ir > 0)
    {
        print_int(errores_ir);
    }
}

