int main()
{
    inicia_ir1();
    genera();
    imprime_ir();

    inicia_ir2();
    genera();
    imprime_ir();

    inicia_ir3();
    genera();
    imprime_ir();

    inicia_ir4();
    genera();
    imprime_ir();

    inicia_ir5();
    genera();
    imprime_ir();

    inicia_ir6();
    genera();
    imprime_ir();

    inicia_ir7();
    genera();
    imprime_ir();

    inicia_ir8();
    genera();
    imprime_ir();

    inicia_ir9();
    genera();
    imprime_ir();

    inicia_ir10();
    genera();
    imprime_ir();

    inicia_ir11();
    genera();
    imprime_ir();

    inicia_ir12();
    genera();
    imprime_ir();

    inicia_ir13();
    genera();
    imprime_ir();

    inicia_ir14();
    genera();
    imprime_ir();
    inicia_ir15();
    genera();
    imprime_ir();
    inicia_ir16();
    genera();
    imprime_ir();
    inicia_ir17();
    genera();
    imprime_ir();
    inicia_ir18();
    genera();
    imprime_ir();

    inicia_ir19();
    genera();
    imprime_ir();

    // ========================================================
    // MOVIMIENTO DE CRECIMIENTO (M-6): las tres puertas
    // manejadas directamente, como la fuente sintetica
    // de M-3 — un crecimiento por generacion es
    // imposible, porque los programas nacen de AST que
    // viven a 256 nodos. Primero la piscina, que nacio
    // la ultima y crece en el sitio: 17000 caracteres
    // cruzan su viejo techo de 16384 y su capacidad
    // cierra en 32768. Despues el registro de ambitos:
    // 300 filas cruzan las 256 de nacimiento (capacidad
    // 512), sale_ambito las retira y cinco filas nuevas
    // reusan las celdas por da_set — la cuenta queda en
    // 300, su marca de agua. Al final el IR: 2600
    // instrucciones cruzan las 2048 (capacidad 4096) y
    // los enlaces de integridad se leen a ambos lados
    // de la frontera. El usado de Compiler cierra en
    // 73472: 13572 de nacimientos, 32764 de extension
    // de la piscina, 2560 de copias del registro y
    // 24576 de copias del IR.
    // ========================================================
    inicia_irgen();
    crea_ir();
    nir = 0;
    pool_len = 0;
    nvar = 0;
    nivel = 0;
    errores_ir = 0;
    int i = 0;
    for (i = 0; i < 17000; i = i + 1)
    {
        int a = agrega_car(65 + (i - (i / 26) * 26));
    }
    print_int(pool_len);
    print_int(da_capacity(dpiscina));
    print_int(string_pool_get_char(dpiscina, 0, 0));
    print_int(string_pool_get_char(dpiscina, 16383, 0));
    print_int(string_pool_get_char(dpiscina, 16384, 0));
    print_int(string_pool_get_char(dpiscina, 16999, 0));
    entra_ambito();
    for (i = 0; i < 300; i = i + 1)
    {
        registra_var(i, -1, 1000 + i * 7, i);
    }
    print_int(nvar);
    print_int(da_capacity(dvscope_tok));
    print_int(da_get(dvscope_ref, 0));
    print_int(da_get(dvscope_ref, 255));
    print_int(da_get(dvscope_ref, 256));
    print_int(da_get(dvscope_ref, 299));
    print_int(da_get(dvscope_tam, 299));
    sale_ambito();
    for (i = 0; i < 5; i = i + 1)
    {
        registra_var(500 + i, -1, 9000 + i, 0);
    }
    print_int(da_count(dvscope_tok));
    print_int(da_get(dvscope_ref, 0));
    print_int(da_get(dvscope_ref, 4));
    print_int(nvar);
    sale_ambito();
    print_int(nvar);
    for (i = 0; i < 2600; i = i + 1)
    {
        int em = emite_ir(i - (i / 61) * 61, i, i * 2, i * 3, i * 5, i * 7);
    }
    print_int(nir);
    print_int(da_count(diop));
    print_int(da_capacity(diop));
    print_int(da_get(diop, 2047));
    print_int(da_get(diop, 2048));
    print_int(da_get(dinombre, 2048));
    print_int(da_get(divalor, 2599));
    print_int(arena_get_used(region_compiler));
    print_int(errores_ir);
    print_int(errores_arena);

    // ========================================================
    // MOVIMIENTO DE ACUSACION (M-6): mundo nuevo con
    // Compiler de reserva 13572 — los doce nacimientos
    // caben justos (seis de 2048, cinco de 256 y la
    // piscina de 4) y el primer crecimiento no —;
    // emite_ir 2051 veces: 2048 instrucciones registran
    // y las tres siguientes acusan una vez cada una en
    // errores_ir y en errores_arena, sin escribir a
    // medias (el primer da_add es la guarda y los seis
    // arreglos llevan la misma cuenta).
    // ========================================================
    inicia_arena();
    region_source = arena_create(1024);
    region_frontend = arena_create(1024);
    region_compiler = arena_create(13572);
    crea_ir();
    nir = 0;
    pool_len = 0;
    nvar = 0;
    nivel = 0;
    errores_ir = 0;
    for (i = 0; i < 2051; i = i + 1)
    {
        int em2 = emite_ir(0, 0, 0, 0, 0, 0);
    }
    print_int(nir);
    print_int(da_count(diop));
    print_int(errores_ir);
    print_int(errores_arena);
    print_int(arena_get_used(region_compiler));
    print_int(arena_get_reserved(region_compiler));

    return 0;
}



