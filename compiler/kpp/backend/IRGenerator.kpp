//////////////////////////////////////////////////////////////////////

// IRGenerator.kpp — Stage 1, backend.
// Migracion M-6 (2026-11-21): las instrucciones IR
// (los seis arreglos de 2048) viven en seis
// DynamicArray de CompilerArena nacidos a 2048, la
// piscina de texto es el StringPool de la biblioteca
// en la misma region y las variables en ambito (los
// cinco arreglos vscope de 256) son cinco DynamicArray
// nacidos a 256: las viejas guardas de capacidad son
// hoy capacidades de nacimiento y las tres estructuras
// crecen. emite_ir y agrega_car conservan su papel de
// puertas unicas de registro, y el contador errores_ir
// acusa como siempre — sus causas G-2 de techo (una
// instruccion sobre 2048, un caracter sobre 16384, una
// fila sobre 256) pasan a dispararse cuando la arena
// no puede crecer: mismo contador, causa nueva, como
// el 50 del SA y el 51 del Parser. El formato de
// referencia ini * 128 + largo no cambia: ini es el
// offset del texto en la piscina, que ahora crece.
// Los ambitos siguen siendo de pico: sale_ambito baja
// nvar y la fila que nace despues reusa la celda por
// da_set — la cuenta del arreglo queda como marca de
// agua alta. Lo que no migra: fuente[1024], las
// tablas de tokens y de nodos y las laterales del
// Parser (las filas del Lexer y del Parser, migradas
// en sus piezas en M-3 y M-4) con los diecinueve
// cargadores inicia_irN, ni los dos scratches de la
// generacion — temps[256] de los temporales de
// argumento y fin_pila[256] de las etiquetas de fin
// de bucle —, que no estan en la enumeracion del
// mapa: el inventario medido de la sonda da picos de
// 32 y 1, y su tamano no depende del IR ni de la
// piscina. Inventario de capacidad, contra la
// leccion de la tabla 12 de M-4: la tabla 15 ES la
// sonda de la guarda de registra_var — un struct de
// 51 campos y cinco variables aplanadas son 260
// filas contra el techo de 256 — y se re-apunta: su
// corriente se conserva entera y solo pierde el
// renglon final, el 4 de errores_ir con que la
// guarda firmaba; bajo arena el registro crece a
// 260 y el 4 no se imprime. Las demas tablas no
// rozan ningun techo (picos medidos por el puerto:
// 263 instrucciones, 1754 caracteres de piscina) y
// conservan su corriente exacta. La sonda gana dos
// movimientos: el crecimiento directo de las tres
// puertas (la piscina a 17000 caracteres, el
// registro a 300 filas con su reuso, el IR a 2600
// instrucciones) y la acusacion con reserva diminuta
// de 13572 — los doce nacimientos justos —, donde
// emite_ir acusa tres veces en errores_ir y tres en
// errores_arena.
// El generador de IR: traduce el AST del contrato a la
// corriente de instrucciones que el X86Backend consume.
// El enum IROpcode que sigue es su contrato de salida:
// los 57 codigos de include/kpp/IR.hpp en su orden
// exacto (una operacion nueva va AL FINAL, nunca en el
// medio). La traduccion vive mas abajo, tras el enum,
// en la seccion IRGENERATOR (rebanada IR-1).

enum IROpcode
{
    // ESTRUCTURA DEL PROGRAMA
    FunctionBegin,
    FunctionEnd,

    // CONSTANTES
    Const,
    StringConst,

    // VARIABLES Y MEMORIA
    Declare,
    Store,
    Load,
    ArrayLoad,
    ArrayStore,

    // FILE I/O
    FileRead,
    FileWrite,

    // ARITMETICA BASICA
    Add,
    Sub,
    Mul,
    Div,
    Mod,

    // POTENCIAS Y RAICES
    Pow,
    Sqrt,

    // LOGARITMOS Y EXPONENCIALES
    Log,
    Log10,
    Exp,

    // TRIGONOMETRIA
    Sin,
    Cos,
    Tan,
    Cot,
    Sec,
    Csc,

    // TRIGONOMETRIA INVERSA
    Asin,
    Acos,
    Atan,

    // FUNCIONES MATEMATICAS
    Abs,
    Floor,
    Ceil,
    Round,
    Min,
    Max,

    // MATEMATICA AVANZADA
    Factorial,
    Sum,
    Integral,

    // FUNCIONES
    Call,
    Return,

    // SALIDA
    Print,
    PrintInteger,
    PrintFloat,

    // COMPARACIONES
    CompareEqual,
    CompareNotEqual,
    CompareLess,
    CompareLessEqual,
    CompareGreater,
    CompareGreaterEqual,

    // LOGICA
    LogicalAnd,
    LogicalOr,
    LogicalNot,

    // CONTROL DE FLUJO
    Label,
    Jump,
    JumpIfZero,
    JumpIfNotZero,

    // BITS (Ampliacion 4, al final)
    BitwiseAnd,
    BitwiseOr,
    ShiftLeft,
    ShiftRight
};


// ============================================================
// IRGENERATOR — Stage 1, backend. Rebanadas IR-1,
// IR-2 e IR-3: el generador completo.
// ============================================================
//
// Traduccion de src/backend/IRGenerator.cpp (Stage 0)
// a K++, por rebanadas. Su entrada es el AST del
// contrato (los ocho arreglos y las tablas
// laterales), el mismo que el Parser construye y el
// SemanticAnalyzer recorre; su salida es la
// corriente de instrucciones IR que el X86Backend
// consumira.
//
// LA INSTRUCCION EN STAGE 1: seis arreglos paralelos
// (iop, inombre, ioperando, iresultado, iaux,
// ivalor) de 2048 instrucciones. Los cuatro campos
// de texto de Stage 0 (name, operand, result,
// auxiliary) son referencias a UNA piscina de texto
// propia del generador (pool[], caracteres): una
// referencia es un solo entero, ini * 128 + largo,
// con el texto en pool[ini .. ini + largo). Toda
// referencia se empaqueta por empaqueta_ref: si el
// texto llega a 128 caracteres, errores_ir suma 1
// y la referencia sale 0 (texto vacio), nunca
// corrupta. La piscina es escribible y es del
// generador, porque
// los textos del IR son sinteticos — x@0, p.campo,
// %12, L4, la lista "a, b" de parametros, la pareja
// "%0, %1" de una binaria — y no viven en fuente[].
// Los textos que si son de la fuente (nombres,
// literales de cadena) se copian de fuente[] a la
// piscina al emitir.
//
// LOS AMBITOS: como en Stage 0, el generador lleva
// sus propios ambitos de variables (no usa los del
// analizador): cada declaracion local recibe su
// nombre IR unico nombre@N, con N del contador de
// la funcion, y las capacidades de arreglo viajan
// con el registro. Una variable de struct se APLANA:
// un Declare por campo (nombre@N.campo), y el campo
// se registra con su token al lado del de la base.
// Los parametros y las globales no se registran:
// al resolver, el nombre original es el que vale
// (la regla de Stage 0). Temporales %N, etiquetas
// LN y contador de variables se reinician por
// funcion.
//
// COBERTURA DE LA IR-1:
//   - genera(): las globales como Declare en orden
//     y cada funcion con genera_funcion().
//   - genera_funcion(): FunctionBegin con la lista
//     de parametros, el cuerpo sin abrir ambito
//     (el ambito raiz es el de la funcion) y
//     FunctionEnd.
//   - genera_sentencia(): VariableDeclaration (con
//     el aplanado de structs y el inicializador) y
//     ReturnStatement (con su via rapida de literal
//     entero: RETURN con el valor, sin temporal).
//
// COBERTURA DE LA IR-2 (sentencias):
//   - Block (genera_bloque), AssignmentStatement
//     (plana, con indice — ArrayStore — y a campo),
//     IfStatement y WhileStatement con sus
//     etiquetas (en el if se crean siempre las dos,
//     fin primero; en el while, antes de la
//     condicion), PrintStatement y
//     PrintIntegerStatement.
//
// COBERTURA NUEVA DE LA IR-3 (expresiones) — con
// esto el generador queda COMPLETO, como su
// original de 1804 lineas:
//   - BinaryExpression: izquierdo, derecho y
//     temporal de resultado; el operando es la
//     pareja "%a, %b" construida en la piscina. El
//     mapa codigo de token -> opcode va en
//     op_binaria(). LogicalNot lleva solo el
//     operando derecho (el izquierdo, el 0
//     sintetico del Parser, se genera pero no se
//     usa), como en Stage 0.
//   - CallExpression: los argumentos en orden, sus
//     temporales unidos en el operando, el temporal
//     de resultado despues, y el nombre del llamado
//     al emitir — el orden de construccion de
//     Stage 0, que es el orden en que los textos
//     entran en la piscina.
//   - file_read y file_write: se reconocen por el
//     nombre del llamado (es_file_read y
//     es_file_write, por caracteres como el
//     es_print_int del Parser). El arreglo NO se
//     carga: viaja su identidad resuelta y su
//     capacidad (capacidad_de, del registro del
//     generador; un arreglo global da 0, la misma
//     ceguera que el resolveArraySize de Stage 0
//     fuera de los ambitos locales). En file_write
//     la cantidad se genera antes que el temporal
//     de resultado y viaja en el campo auxiliary.
//   - ArrayAccessExpression: ArrayLoad con el
//     indice generado primero.
//   - VariableExpression con campo: Load del
//     nombre aplanado (resuelve_campo).
// Las validaciones (aridades, clases de argumento)
// son del SemanticAnalyzer: el generador confia en
// el AST ya analizado, como confia en que el return
// trae expresion.
//
// LA SONDA (main): nueve programas cargados con
// tablas inicia_irN() generadas de sus fuentes
// reales. Por sonda se imprime la corriente en
// forma numerica: por instruccion, el nombre de
// la operacion y nueve enteros (las cuatro
// referencias desempaquetadas en inicio y largo,
// y el valor), y al final el largo de la piscina
// y sus caracteres en codigos.
// ============================================================
// ============================================================

enum NodeKind
{
    // DECLARACIONES
    Program,
    FunctionDeclaration,
    StructDeclaration,
    EnumDeclaration,

    // SENTENCIAS
    Block,
    VariableDeclaration,
    AssignmentStatement,
    IfStatement,
    WhileStatement,
    ReturnStatement,
    PrintStatement,
    PrintIntegerStatement,

    // EXPRESIONES
    IntegerLiteral,
    StringLiteral,
    VariableExpression,
    ArrayAccessExpression,
    CallExpression,
    BinaryExpression,

    // AMPLIACIONES (al final, nunca en medio)
    CallStatement,
    BreakStatement,
    ForStatement
};

// ============================================================
// LA BIBLIOTECA ARENA, INCORPORADA.
//
// K++ no tiene includes: un archivo es un programa, y
// las piezas se componen por copia identica, como los
// enum que emisor y consumidor se reparten. Lo que
// sigue es la biblioteca de M-0 (compiler/kpp/runtime/
// Arena.kpp, sellada en campo 108/108) sin su sonda ni
// su main, con los ajustes de dimension para esta
// pieza, declarados: el bloque C se declara a 131072
// celdas (la reserva de CompilerArena de esta pieza;
// en la biblioteca de M-0 era de 512, dimension de su
// sonda), el bucle de cero de ese bloque llega a
// 131072, la tabla tam_bloque da C a 131072 y el
// comentario de tamanos dice los de esta pieza. El
// bloque C es el mayor de las piezas migradas porque
// aqui viven el IR y la piscina: el mundo sellado mas
// grande usa 18176 celdas y el movimiento de
// crecimiento de la sonda, 73472. Nada mas cambia: ni
// una firma, ni una mecanica.
// ============================================================

// ============================================================
// ESTADO COMPARTIDO.
//
// Los contadores de la biblioteca y los handles de las
// cinco regiones, compartidos por nombre como en las
// demas piezas. El driver guarda en region_source ..
// region_output el handle de cada region al crearla.
// errores_arena es la guarda comun: suma 1 por cada
// operacion que la biblioteca no pudo cumplir, y ninguna
// operacion fallida escribe fuera ni a medias.
// ============================================================

int errores_arena;
int nest;
int prov_nacq;
int region_source;
int region_frontend;
int region_compiler;
int region_backend;
int region_output;

// ============================================================
// INICIA LA BIBLIOTECA.
//
// Pone a cero la contabilidad y los tres bloques, y
// escribe el plan de solape: la region 1 (Source) vive
// en el bloque 0 (A), la 2 (Frontend) en el 1 (B), la 3
// (Compiler) en el 2 (C), la 4 (Backend) en el 1 (B, su
// segunda vida) y la 5 (Output) en el 0 (A, su segunda
// vida). Los tamanos de bloque de esta pieza: A y B con
// 1024 celdas, C con 131072.
// ============================================================

void inicia_arena()
{
    int bloque_a[1024];
    int bloque_b[1024];
    int bloque_c[131072];
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int i;
    i = 0;
    while (i < 1024)
    {
        bloque_a[i] = 0;
        bloque_b[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 131072)
    {
        bloque_c[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 6)
    {
        reg_bloque[i] = 0;
        reg_reserva[i] = 0;
        reg_usado[i] = 0;
        reg_viva[i] = 0;
        plan_bloque[i] = 0;
        i = i + 1;
    }
    plan_bloque[1] = 0;
    plan_bloque[2] = 1;
    plan_bloque[3] = 2;
    plan_bloque[4] = 1;
    plan_bloque[5] = 0;
    tam_bloque[0] = 1024;
    tam_bloque[1] = 1024;
    tam_bloque[2] = 131072;
    i = 0;
    while (i < 3)
    {
        bloque_dueno[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 129)
    {
        est_region[i] = 0;
        est_base[i] = 0;
        est_cuenta[i] = 0;
        est_cap[i] = 0;
        est_tipo[i] = 0;
        est_viva[i] = 0;
        i = i + 1;
    }
    errores_arena = 0;
    nest = 0;
    prov_nacq = 0;
    region_source = 0;
    region_frontend = 0;
    region_compiler = 0;
    region_backend = 0;
    region_output = 0;
}

// ============================================================
// MEMORY PROVIDER.
//
// La puerta entre la biblioteca y la memoria fisica.
// En V2 son subrutinas ordinarias: memory_acquire entrega
// el bloque fisico que el plan de solape asigna a la
// siguiente region por nacer (las regiones nacen en
// orden: Source, Frontend, Compiler, Backend, Output) y
// devuelve bloque + 1, o 0 si el bloque no alcanza o
// sigue ocupado por su vida anterior. Nunca un bloque
// invalido, nunca un valor a medias. memory_release
// devuelve el bloque; memory_available da el tamano del
// bloque libre mayor, en celdas.
// ============================================================

int memory_available()
{
    int tam_bloque[3];
    int bloque_dueno[3];
    int m;
    int b;
    m = 0;
    b = 0;
    while (b < 3)
    {
        if (bloque_dueno[b] == 0)
        {
            if (tam_bloque[b] > m)
            {
                m = tam_bloque[b];
            }
        }
        b = b + 1;
    }
    return m;
}

int memory_acquire(int size)
{
    int plan_bloque[6];
    int tam_bloque[3];
    int bloque_dueno[3];
    int n;
    int blk;
    n = prov_nacq + 1;
    if (n > 5)
    {
        return 0;
    }
    blk = plan_bloque[n];
    if (size > tam_bloque[blk])
    {
        return 0;
    }
    if (bloque_dueno[blk] != 0)
    {
        return 0;
    }
    bloque_dueno[blk] = n;
    prov_nacq = n;
    return blk + 1;
}

void memory_release(int block)
{
    int bloque_dueno[3];
    bloque_dueno[block - 1] = 0;
}

// ============================================================
// MEMORY MANAGER.
//
// arena_create reserva el bloque inicial de la region y
// devuelve su handle (0 = fallo, acusado en
// errores_arena). El handle de la region es su numero de
// nacimiento: 1 Source, 2 Frontend, 3 Compiler,
// 4 Backend, 5 Output.
// arena_alloc entrega un offset dentro de la region: el
// espacio se entrega por avance (bump) con la alineacion
// pedida en celdas; si no cabe en lo reservado, acusa y
// devuelve -1 sin tocar nada. Ningun offset ya entregado
// cambia jamas de significado.
// arena_reset devuelve la region a vacia sin liberarla:
// es la liberacion por fase, y de paso invalida las
// estructuras que vivian en ella. arena_destroy la
// libera del todo: el bloque vuelve al Provider y la
// region muerta acusa si la llaman (la disciplina del
// mapa contra handles de regiones muertas).
// ============================================================

int region_activa(int arena)
{
    int reg_viva[6];
    int r;
    r = 0;
    if (arena >= 1)
    {
        if (arena <= 5)
        {
            if (reg_viva[arena] == 1)
            {
                r = 1;
            }
        }
    }
    return r;
}

int arena_create(int initial_size)
{
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int reg_viva[6];
    int b;
    int r;
    if (initial_size < 1)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    b = memory_acquire(initial_size);
    if (b == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    r = prov_nacq;
    reg_bloque[r] = b - 1;
    reg_reserva[r] = initial_size;
    reg_usado[r] = 0;
    reg_viva[r] = 1;
    return r;
}

int arena_alloc(int arena, int size, int alignment)
{
    int reg_reserva[6];
    int reg_usado[6];
    int off;
    int resto;
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (size < 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (alignment < 1)
    {
        alignment = 1;
    }
    off = reg_usado[arena];
    resto = off - (off / alignment) * alignment;
    if (resto != 0)
    {
        off = off + (alignment - resto);
    }
    if (off + size > reg_reserva[arena])
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    reg_usado[arena] = off + size;
    return off;
}

void invalida_estructuras(int arena)
{
    int est_region[129];
    int est_viva[129];
    int e;
    e = 1;
    while (e <= nest)
    {
        if (est_region[e] == arena)
        {
            est_viva[e] = 0;
        }
        e = e + 1;
    }
}

void arena_reset(int arena)
{
    int reg_usado[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
}

void arena_destroy(int arena)
{
    int reg_bloque[6];
    int reg_usado[6];
    int reg_viva[6];
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    reg_usado[arena] = 0;
    invalida_estructuras(arena);
    reg_viva[arena] = 0;
    memory_release(reg_bloque[arena] + 1);
}

int arena_get_used(int arena)
{
    int reg_usado[6];
    if (region_activa(arena) == 0)
    {
        return -1;
    }
    return reg_usado[arena];
}

int arena_get_reserved(int arena)
{
    int reg_reserva[6];
    if (region_activa(arena) == 0)
    {
        return -1;
    }
    return reg_reserva[arena];
}

// ============================================================
// ACCESO A CELDAS.
//
// La capa de acceso interna de la via V2: cada bloque es
// un arreglo declarado y estas dos subrutinas son las
// unicas que lo indexan por numero de bloque. Si un dia
// se migra a la via V1, este es el interior que se
// reescribe por peek/poke; la API publica no se entera.
// ============================================================

int celda_get(int bloque, int off)
{
    int bloque_a[1024];
    int bloque_b[1024];
    int bloque_c[131072];
    int r;
    r = 0;
    if (bloque == 0)
    {
        r = bloque_a[off];
    }
    else
    {
        if (bloque == 1)
        {
            r = bloque_b[off];
        }
        else
        {
            r = bloque_c[off];
        }
    }
    return r;
}

void celda_set(int bloque, int off, int v)
{
    int bloque_a[1024];
    int bloque_b[1024];
    int bloque_c[131072];
    if (bloque == 0)
    {
        bloque_a[off] = v;
    }
    else
    {
        if (bloque == 1)
        {
            bloque_b[off] = v;
        }
        else
        {
            bloque_c[off] = v;
        }
    }
}

// ============================================================
// LA CONTABILIDAD DE ESTRUCTURAS.
//
// DynamicArray, StringPool y ByteBuffer comparten la
// misma contabilidad: por estructura, su region, la base
// (offset de su bloque actual en la region), la cuenta,
// la capacidad, el tipo (1 DynamicArray, 2 StringPool,
// 3 ByteBuffer) y si vive. Los arreglos van indexados por
// el handle de la estructura (1..128); el 0 es el fallo.
// est_crece es el crecimiento geometrico x2, el mismo
// para las tres clases: extension en el sitio si el
// bloque de la estructura es el ultimo asignado de su
// arena; si no, bloque nuevo al doble y copia, y el
// bloque viejo queda como hueco hasta el reset de la
// fase. La base puede cambiar al crecer con copia; los
// handles de los datos no, porque un dato se referencia
// por su indice dentro de la estructura, no por su
// offset en la arena.
// est_agrega es la unica puerta de registro: agrega al
// final y devuelve el indice del elemento, o -1 si la
// arena no pudo crecer (error ya acusado, una sola vez
// por operacion fallida).
// ============================================================

int est_crea(int arena, int tipo, int capini)
{
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int est_tipo[129];
    int est_viva[129];
    int off;
    int e;
    if (region_activa(arena) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (capini < 1)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (nest >= 128)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    off = arena_alloc(arena, capini, 1);
    if (off < 0)
    {
        return 0;
    }
    nest = nest + 1;
    e = nest;
    est_region[e] = arena;
    est_base[e] = off;
    est_cuenta[e] = 0;
    est_cap[e] = capini;
    est_tipo[e] = tipo;
    est_viva[e] = 1;
    return e;
}

int est_valida(int e, int tipo)
{
    int est_tipo[129];
    int est_viva[129];
    int r;
    r = 0;
    if (e >= 1)
    {
        if (e <= nest)
        {
            if (est_viva[e] == 1)
            {
                if (tipo == 0)
                {
                    r = 1;
                }
                else
                {
                    if (est_tipo[e] == tipo)
                    {
                        r = 1;
                    }
                }
            }
        }
    }
    return r;
}

int est_crece(int e)
{
    int reg_bloque[6];
    int reg_reserva[6];
    int reg_usado[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int region;
    int base;
    int cap;
    int nuevacap;
    int off;
    int blk;
    int i;
    region = est_region[e];
    base = est_base[e];
    cap = est_cap[e];
    nuevacap = cap * 2;
    if (base + cap == reg_usado[region])
    {
        if (reg_usado[region] + (nuevacap - cap) <= reg_reserva[region])
        {
            reg_usado[region] = reg_usado[region] + (nuevacap - cap);
            est_cap[e] = nuevacap;
            return 1;
        }
        errores_arena = errores_arena + 1;
        return 0;
    }
    off = arena_alloc(region, nuevacap, 1);
    if (off < 0)
    {
        return 0;
    }
    blk = reg_bloque[region];
    i = 0;
    while (i < est_cuenta[e])
    {
        celda_set(blk, off + i, celda_get(blk, base + i));
        i = i + 1;
    }
    est_base[e] = off;
    est_cap[e] = nuevacap;
    return 1;
}

int est_agrega(int e, int v)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int est_cap[129];
    int idx;
    if (est_valida(e, 0) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    if (est_cuenta[e] == est_cap[e])
    {
        if (est_crece(e) == 0)
        {
            return -1;
        }
    }
    idx = est_cuenta[e];
    celda_set(reg_bloque[est_region[e]], est_base[e] + idx, v);
    est_cuenta[e] = idx + 1;
    return idx;
}

// ============================================================
// DYNAMICARRAY.
//
// da_create nace con la capacidad inicial pedida (en
// elementos) y devuelve el handle del arreglo (0 = fallo
// acusado). da_add agrega al final creciendo como manda
// est_crece y devuelve el indice del elemento o -1.
// da_get / da_set leen y escriben por indice, con el
// intervalo validado antes de tocar memoria: fuera de la
// cuenta, acusan y no tocan nada. da_count, da_capacity
// y da_base consultan la contabilidad (valen para las
// tres clases de estructura); handle invalido da -1.
// ============================================================

int da_create(int arena, int initial_capacity)
{
    return est_crea(arena, 1, initial_capacity);
}

int da_add(int arr, int value)
{
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(arr, value);
}

int da_get(int arr, int index)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (index < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (index >= est_cuenta[arr])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[arr]], est_base[arr] + index);
}

void da_set(int arr, int index, int value)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(arr, 1) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (index < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (index >= est_cuenta[arr])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[arr]], est_base[arr] + index, value);
}

int da_count(int arr)
{
    int est_cuenta[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[arr];
}

int da_capacity(int arr)
{
    int est_cap[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_cap[arr];
}

int da_base(int arr)
{
    int est_base[129];
    if (est_valida(arr, 0) == 0)
    {
        return -1;
    }
    return est_base[arr];
}

// ============================================================
// STRINGPOOL.
//
// La piscina dinamica: un buffer de caracteres que crece
// en la region pedida. string_pool_add_char agrega un
// caracter (guardado como byte, 0..255) y devuelve su
// offset dentro de la piscina: ese offset es el ini de
// las referencias. El formato de la referencia no
// cambia: ini * 128 + largo, el de la piscina de hoy;
// string_pool_len desempaqueta el largo y
// string_pool_get_char lee el caracter ini + i. Los
// handles son offsets: estables hasta la muerte de la
// region, crezca lo que crezca la piscina.
// ============================================================

int string_pool_create(int arena)
{
    return est_crea(arena, 2, 4);
}

int string_pool_add_char(int pool, int ch)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(pool, ch & 255);
}

int string_pool_get_char(int pool, int ini, int i)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int idx;
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    idx = ini + i;
    if (idx < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (idx >= est_cuenta[pool])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[pool]], est_base[pool] + idx);
}

int string_pool_len(int pool, int ref)
{
    if (est_valida(pool, 2) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return ref - (ref / 128) * 128;
}

// ============================================================
// BYTEBUFFER.
//
// El buffer de bytes que crece: el codigo del Emitter y
// la imagen de los Writers. Una celda por byte, como
// hoy, y cada byte guardado en 0..255.
// bytebuffer_append agrega un byte al final y devuelve
// su offset — la semantica de los placeholders del
// Emitter, que ya devuelven el offset de su hueco.
// bytebuffer_patch escribe en un offset ya entregado y
// dentro de la cuenta: es el patch32 / patchRel32 de hoy
// sin guarda de 256. bytebuffer_write copia count bytes
// desde otro ByteBuffer (desde su src_offset) y los
// agrega al final de este: lo que los Writers hacen al
// ensamblar cabecera + codigo + datos; el intervalo de
// origen se valida entero antes de copiar, asi que una
// copia invalida acusa y no escribe nada.
// bytebuffer_get lee un byte por offset, validado.
// ============================================================

int bytebuffer_create(int arena)
{
    return est_crea(arena, 3, 8);
}

int bytebuffer_append(int bb, int byte)
{
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return -1;
    }
    return est_agrega(bb, byte & 255);
}

void bytebuffer_patch(int bb, int offset, int byte)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    celda_set(reg_bloque[est_region[bb]], est_base[bb] + offset, byte & 255);
}

void bytebuffer_write(int bb, int src, int src_offset, int count)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    int blk;
    int i;
    int v;
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (est_valida(src, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (src_offset < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (count < 0)
    {
        errores_arena = errores_arena + 1;
        return;
    }
    if (src_offset + count > est_cuenta[src])
    {
        errores_arena = errores_arena + 1;
        return;
    }
    blk = reg_bloque[est_region[src]];
    i = 0;
    while (i < count)
    {
        v = celda_get(blk, est_base[src] + src_offset + i);
        if (est_agrega(bb, v) < 0)
        {
            return;
        }
        i = i + 1;
    }
}

int bytebuffer_get(int bb, int offset)
{
    int reg_bloque[6];
    int est_region[129];
    int est_base[129];
    int est_cuenta[129];
    if (est_valida(bb, 3) == 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset < 0)
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    if (offset >= est_cuenta[bb])
    {
        errores_arena = errores_arena + 1;
        return 0;
    }
    return celda_get(reg_bloque[est_region[bb]], est_base[bb] + offset);
}

int bytebuffer_get_size(int bb)
{
    int est_cuenta[129];
    if (est_valida(bb, 0) == 0)
    {
        return -1;
    }
    return est_cuenta[bb];
}

// ============================================================
// HANDLES DE LA ARENA (M-6).
//
// Los seis DynamicArray del IR, los cinco del registro
// de ambitos y el StringPool de la piscina, todos en
// CompilerArena.
// ============================================================

int diop;
int dinombre;
int dioperando;
int diresultado;
int diaux;
int divalor;
int dvscope_tok;
int dvscope_campo;
int dvscope_ref;
int dvscope_tam;
int dvscope_nivel;
int dpiscina;

// ============================================================
// INICIA EL GENERADOR.
//
// El papel del driver en miniatura, como en las demas
// piezas migradas: inicia la biblioteca y hace nacer
// las regiones en el orden del plan de solape —
// Source sobre el bloque A (1024) y Frontend sobre el
// bloque B (1024), que esta pieza no usa (su fuente,
// sus tokens y sus nodos son las copias selladas de
// las filas del Lexer y del Parser, migradas en sus
// piezas en M-3 y M-4), y Compiler sobre el bloque C
// con la reserva entera del bloque (131072), donde
// viven el IR, el registro de ambitos y la piscina.
// Backend y Output nacen en sus fases, en las piezas
// que las gobiernan. No imprime nada: la corriente de
// la sonda queda intacta.
// ============================================================

void inicia_irgen()
{
    inicia_arena();
    region_source = arena_create(1024);
    region_frontend = arena_create(1024);
    region_compiler = arena_create(131072);
}

// ============================================================
// CREA LAS ESTRUCTURAS.
//
// Los seis DynamicArray del IR nacen a 2048 — la
// vieja guarda de emite_ir como capacidad de
// nacimiento — y los cinco del registro de ambitos a
// 256, la vieja guarda de registra_var. La piscina
// nace la ultima, con el literal de la biblioteca
// (4 celdas): es la estructura que mas crece, y
// naciendo la ultima sus crecimientos se extienden en
// el sitio. Los crea genera() al arrancar cada
// programa, y los movimientos de la sonda en los
// suyos.
// ============================================================

void crea_ir()
{
    diop = da_create(region_compiler, 2048);
    dinombre = da_create(region_compiler, 2048);
    dioperando = da_create(region_compiler, 2048);
    diresultado = da_create(region_compiler, 2048);
    diaux = da_create(region_compiler, 2048);
    divalor = da_create(region_compiler, 2048);
    dvscope_tok = da_create(region_compiler, 256);
    dvscope_campo = da_create(region_compiler, 256);
    dvscope_ref = da_create(region_compiler, 256);
    dvscope_tam = da_create(region_compiler, 256);
    dvscope_nivel = da_create(region_compiler, 256);
    dpiscina = string_pool_create(region_compiler);
}

// ============================================================
// ESTADO DEL GENERADOR.
// ============================================================

int tok_count;
int nnodos;
int nir;
int pool_len;
int ntemp;
int contvar;
int nvar;
int nivel;
int netiq;
// El contador de la Fase 2. G-1: suma 1 por cada texto
// que no cabe en su referencia. G-2: suma 1 por cada
// unidad que un techo descarta — una instruccion sobre
// 2048, un caracter sobre 16384, una fila sobre 256.
// G-3: suma 1 por cada capacidad 0 en file_read o
// file_write, por cada argumento de llamada que pasa
// de 32 y por cada operador binario fuera de 14 a 28
// — los tres casos en que Stage 0 aborta y este
// generador seguia emitiendo en silencio.
int errores_ir;
// El eco de la Ampliacion 1: 1 si la funcion que
// se esta generando es void.
int fun_es_void;
// El eco de la Ampliacion 2: el tope de la pila de
// etiquetas de fin de los while en generacion. La
// pila en si se declara dentro de genera_sentencia,
// como las demas tablas de la pieza (compartida
// por nombre); el tope es un escalar compartido.
int fin_tope;
// El tope de la arena de temporales de argumento de
// las llamadas en generacion. El arreglo temps se
// declara dentro de genera_expresion (compartido por
// nombre, como las demas tablas), y cada llamada
// colecciona sus temporales en las ranuras que
// empiezan en su base — un escalar local — para que
// una llamada anidada no pise los de la externa. El
// tope marca la primera ranura libre: es el mismo
// patron que fin_tope con su pila.
int temps_tope;

// ============================================================
// LA PISCINA DE TEXTO.
// ============================================================

int agrega_car(int c)
{
    int r = string_pool_add_char(dpiscina, c);
    if (r < 0)
    {
        errores_ir = errores_ir + 1;
    }
    else
    {
        pool_len = pool_len + 1;
    }
    return 0;
}

int agrega_token(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int ini = tok_inicio[tok];
    int n = tok_largo[tok];
    int i = 0;
    for (i = 0; i < n; i = i + 1)
    {
        int c = fuente[ini + i];
        int a = agrega_car(c);
    }
    return 0;
}

int agrega_tramo(int ini, int largo)
{
    int i = 0;
    for (i = 0; i < largo; i = i + 1)
    {
        int c = string_pool_get_char(dpiscina, ini, i);
        int a = agrega_car(c);
    }
    return 0;
}

int agrega_numero(int n)
{
    if (n >= 10)
    {
        int a = agrega_numero(n / 10);
    }
    int d = n - (n / 10) * 10;
    int b = agrega_car(48 + d);
    return 0;
}

int empaqueta_ref(int ini)
{
    int largo = pool_len - ini;
    if (largo >= 128)
    {
        errores_ir = errores_ir + 1;
        return 0;
    }
    return ini * 128 + largo;
}

int ref_token(int tok)
{
    int tok_largo[256];
    int largo_tok = tok_largo[tok];
    if (largo_tok >= 128)
    {
        errores_ir = errores_ir + 1;
        return 0;
    }
    int ini = pool_len;
    int a = agrega_token(tok);
    int r = empaqueta_ref(ini);
    return r;
}

int ref_temp()
{
    int ini = pool_len;
    int a = agrega_car(37);
    int b = agrega_numero(ntemp);
    ntemp = ntemp + 1;
    int r = empaqueta_ref(ini);
    return r;
}

// ============================================================
// MISMO TEXTO — la forma probada (sonda_mismo_texto):
// cada carga a una local antes de comparar.
// ============================================================

int mismo_texto(int a, int b)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    int la = tok_largo[a];
    int lb = tok_largo[b];
    if (la != lb)
    {
        return 0;
    }
    int ia = tok_inicio[a];
    int ib = tok_inicio[b];
    int i = 0;
    for (i = 0; i < la; i = i + 1)
    {
        int ca = fuente[ia + i];
        int cb = fuente[ib + i];
        if (ca != cb)
        {
            return 0;
        }
    }
    return 1;
}

// ============================================================
// EMITIR UNA INSTRUCCION.
// ============================================================

int emite_ir(int op, int nombre, int operando, int resultado, int aux, int valor)
{
    if (da_add(diop, op) < 0)
    {
        errores_ir = errores_ir + 1;
        return 0;
    }
    int a = da_add(dinombre, nombre);
    int b = da_add(dioperando, operando);
    int c = da_add(diresultado, resultado);
    int d = da_add(diaux, aux);
    int e = da_add(divalor, valor);
    nir = nir + 1;
    return 0;
}

// ============================================================
// AMBITOS DE VARIABLES DEL GENERADOR.
// ============================================================
//
// Una fila por nombre visible: el token de la base,
// el token del campo (-1 si es la variable misma),
// la referencia a su nombre IR en la piscina, su
// capacidad de arreglo y el sello de nivel.

void entra_ambito()
{
    nivel = nivel + 1;
}

void sale_ambito()
{
    while (1)
    {
        if (nvar == 0)
        {
            break;
        }
        int u = da_get(dvscope_nivel, nvar - 1);
        if (u != nivel)
        {
            break;
        }
        nvar = nvar - 1;
    }
    nivel = nivel - 1;
}

void registra_var(int tok, int campo, int ref, int tam)
{
    if (nvar < da_count(dvscope_tok))
    {
        da_set(dvscope_tok, nvar, tok);
        da_set(dvscope_campo, nvar, campo);
        da_set(dvscope_ref, nvar, ref);
        da_set(dvscope_tam, nvar, tam);
        da_set(dvscope_nivel, nvar, nivel);
        nvar = nvar + 1;
        return;
    }
    if (da_add(dvscope_tok, tok) < 0)
    {
        errores_ir = errores_ir + 1;
        return;
    }
    int a = da_add(dvscope_campo, campo);
    int b = da_add(dvscope_ref, ref);
    int c = da_add(dvscope_tam, tam);
    int d = da_add(dvscope_nivel, nivel);
    nvar = nvar + 1;
}

int busca_var(int tok, int campo)
{
    int i = nvar - 1;
    for (i = nvar - 1; i >= 0; i = i - 1)
    {
        int t = da_get(dvscope_tok, i);
        if (mismo_texto(t, tok) == 1)
        {
            int c = da_get(dvscope_campo, i);
            if (c == campo)
            {
                return i;
            }
            if (c >= 0)
            {
                if (campo >= 0)
                {
                    if (mismo_texto(c, campo) == 1)
                    {
                        return i;
                    }
                }
            }
        }
    }
    return -1;
}

int resuelve(int tok)
{
    int f = busca_var(tok, -1);
    if (f >= 0)
    {
        int r = da_get(dvscope_ref, f);
        return r;
    }
    return ref_token(tok);
}

// ============================================================
// LA DECLARACION DE STRUCT DE UN TIPO, o -1.
// ============================================================

int struct_de(int tipo)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int d = nhijo1[0];
    while (d >= 0)
    {
        int k = nkind[d];
        if (k == NodeKind::StructDeclaration)
        {
            int nt = nval[d];
            if (mismo_texto(nt, tipo) == 1)
            {
                return d;
            }
        }
        d = nsig[d];
    }
    return -1;
}

// ============================================================
// AYUDANTES DE LAS EXPRESIONES (IR-3).
// ============================================================

int agrega_ref(int ref)
{
    int ini = ref / 128;
    int largo = ref - ini * 128;
    int a = agrega_tramo(ini, largo);
    return 0;
}

int une_refs(int a, int b)
{
    int ini = pool_len;
    int x = agrega_ref(a);
    int c1 = agrega_car(44);
    int c2 = agrega_car(32);
    int y = agrega_ref(b);
    int r = empaqueta_ref(ini);
    return r;
}

int op_binaria(int op)
{
    if (op == 14)
    {
        return IROpcode::Add;
    }
    if (op == 15)
    {
        return IROpcode::Sub;
    }
    if (op == 16)
    {
        return IROpcode::Mul;
    }
    if (op == 17)
    {
        return IROpcode::Div;
    }
    if (op == 18)
    {
        return IROpcode::Mod;
    }
    if (op == 19)
    {
        return IROpcode::Pow;
    }
    if (op == 20)
    {
        return IROpcode::CompareEqual;
    }
    if (op == 21)
    {
        return IROpcode::CompareNotEqual;
    }
    if (op == 22)
    {
        return IROpcode::CompareLess;
    }
    if (op == 23)
    {
        return IROpcode::CompareLessEqual;
    }
    if (op == 24)
    {
        return IROpcode::CompareGreater;
    }
    if (op == 25)
    {
        return IROpcode::CompareGreaterEqual;
    }
    if (op == 26)
    {
        return IROpcode::LogicalAnd;
    }
    if (op == 27)
    {
        return IROpcode::LogicalOr;
    }
    if (op == 28)
    {
        return IROpcode::LogicalNot;
    }
    if (op == 42)
    {
        return IROpcode::BitwiseAnd;
    }
    if (op == 43)
    {
        return IROpcode::BitwiseOr;
    }
    if (op == 44)
    {
        return IROpcode::ShiftLeft;
    }
    if (op == 45)
    {
        return IROpcode::ShiftRight;
    }
    return -1;
}

int capacidad_de(int tok)
{
    int f = busca_var(tok, -1);
    if (f >= 0)
    {
        int t = da_get(dvscope_tam, f);
        return t;
    }
    return 0;
}

// La funcion es void si el texto de su token de
// tipo es "void" (Ampliacion 1): la misma forma
// de es_file_read — largo primero, caracteres
// despues (118, 111, 105, 100).
int es_void(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    if (tok_largo[tok] != 4)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    if (fuente[base + 0] != 118)
    {
        return 0;
    }
    if (fuente[base + 1] != 111)
    {
        return 0;
    }
    if (fuente[base + 2] != 105)
    {
        return 0;
    }
    if (fuente[base + 3] != 100)
    {
        return 0;
    }
    return 1;
}

int es_file_read(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    if (tok_largo[tok] != 9)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    if (fuente[base + 0] != 102)
    {
        return 0;
    }
    if (fuente[base + 1] != 105)
    {
        return 0;
    }
    if (fuente[base + 2] != 108)
    {
        return 0;
    }
    if (fuente[base + 3] != 101)
    {
        return 0;
    }
    if (fuente[base + 4] != 95)
    {
        return 0;
    }
    if (fuente[base + 5] != 114)
    {
        return 0;
    }
    if (fuente[base + 6] != 101)
    {
        return 0;
    }
    if (fuente[base + 7] != 97)
    {
        return 0;
    }
    if (fuente[base + 8] != 100)
    {
        return 0;
    }
    return 1;
}

int es_file_write(int tok)
{
    int tok_inicio[256];
    int tok_largo[256];
    int fuente[1024];
    if (tok_largo[tok] != 10)
    {
        return 0;
    }
    int base = tok_inicio[tok];
    if (fuente[base + 0] != 102)
    {
        return 0;
    }
    if (fuente[base + 1] != 105)
    {
        return 0;
    }
    if (fuente[base + 2] != 108)
    {
        return 0;
    }
    if (fuente[base + 3] != 101)
    {
        return 0;
    }
    if (fuente[base + 4] != 95)
    {
        return 0;
    }
    if (fuente[base + 5] != 119)
    {
        return 0;
    }
    if (fuente[base + 6] != 114)
    {
        return 0;
    }
    if (fuente[base + 7] != 105)
    {
        return 0;
    }
    if (fuente[base + 8] != 116)
    {
        return 0;
    }
    if (fuente[base + 9] != 101)
    {
        return 0;
    }
    return 1;
}

// ============================================================
// GENERAR EXPRESION (completa, IR-3).
// ============================================================
//
// Devuelve la referencia al temporal que guarda el
// valor de la expresion.

int genera_expresion(int e)
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int k = nkind[e];
    if (k == NodeKind::IntegerLiteral)
    {
        int t = ref_temp();
        int v = nval[e];
        int em = emite_ir(IROpcode::Const, 0, 0, t, 0, v);
        return t;
    }
    if (k == NodeKind::StringLiteral)
    {
        int t2 = ref_temp();
        int nt = nval[e];
        int nombre = ref_token(nt);
        int em2 = emite_ir(IROpcode::StringConst, nombre, 0, t2, 0, 0);
        return t2;
    }
    if (k == NodeKind::VariableExpression)
    {
        int h = nhijo1[e];
        int t3 = ref_temp();
        int nt3 = nval[e];
        if (h >= 0)
        {
            int nom3 = resuelve_campo(nt3, h);
            int em3 = emite_ir(IROpcode::Load, nom3, 0, t3, 0, 0);
            return t3;
        }
        int nom4 = resuelve(nt3);
        int em4 = emite_ir(IROpcode::Load, nom4, 0, t3, 0, 0);
        return t3;
    }
    if (k == NodeKind::ArrayAccessExpression)
    {
        int hi = nhijo1[e];
        int ti = genera_expresion(hi);
        int t4 = ref_temp();
        int nt4 = nval[e];
        int nom5 = resuelve(nt4);
        int em5 = emite_ir(IROpcode::ArrayLoad, nom5, ti, t4, 0, 0);
        return t4;
    }
    if (k == NodeKind::BinaryExpression)
    {
        int izq = nhijo1[e];
        int der = nsig[izq];
        int ti2 = genera_expresion(izq);
        int td = genera_expresion(der);
        int t5 = ref_temp();
        int op = nval[e];
        int iop2 = op_binaria(op);
        if (iop2 < 0)
        {
            errores_ir = errores_ir + 1;
        }
        if (iop2 == IROpcode::LogicalNot)
        {
            int em6 = emite_ir(iop2, 0, td, t5, 0, 0);
            return t5;
        }
        int par = une_refs(ti2, td);
        int em7 = emite_ir(iop2, 0, par, t5, 0, 0);
        return t5;
    }
    if (k == NodeKind::CallExpression)
    {
        int ct = nval[e];
        int a1 = nhijo1[e];
        if (es_file_read(ct) == 1)
        {
            int a2 = nsig[a1];
            int t6 = ref_temp();
            int ruta1 = nval[a1];
            int nom6 = ref_token(ruta1);
            int arr1 = nval[a2];
            int ident1 = resuelve(arr1);
            int cap1 = capacidad_de(arr1);
            if (cap1 == 0)
            {
                errores_ir = errores_ir + 1;
            }
            int em8 = emite_ir(IROpcode::FileRead, nom6, ident1, t6, 0, cap1);
            return t6;
        }
        if (es_file_write(ct) == 1)
        {
            int a2w = nsig[a1];
            int a3w = nsig[a2w];
            int tc = genera_expresion(a3w);
            int t7 = ref_temp();
            int ruta2 = nval[a1];
            int nom7 = ref_token(ruta2);
            int arr2 = nval[a2w];
            int ident2 = resuelve(arr2);
            int cap2 = capacidad_de(arr2);
            if (cap2 == 0)
            {
                errores_ir = errores_ir + 1;
            }
            int em9 = emite_ir(IROpcode::FileWrite, nom7, ident2, t7, tc, cap2);
            return t7;
        }
        int temps[256];
        int base = temps_tope;
        int narg = 0;
        int arg = a1;
        while (arg >= 0)
        {
            int ta = genera_expresion(arg);
            if (narg < 32)
            {
                int hueco = base + narg;
                if (hueco < 256)
                {
                    temps[hueco] = ta;
                    narg = narg + 1;
                    temps_tope = base + narg;
                }
            }
            else
            {
                errores_ir = errores_ir + 1;
            }
            arg = nsig[arg];
        }
        int unidos = 0;
        if (narg > 0)
        {
            int ini_u = pool_len;
            int j = 0;
            for (j = 0; j < narg; j = j + 1)
            {
                if (j > 0)
                {
                    int c1 = agrega_car(44);
                    int c2 = agrega_car(32);
                }
                int tj = temps[base + j];
                int aj = agrega_ref(tj);
            }
            unidos = empaqueta_ref(ini_u);
        }
        temps_tope = base;
        int t8 = ref_temp();
        int nom8 = ref_token(ct);
        int em10 = emite_ir(IROpcode::Call, nom8, unidos, t8, 0, 0);
        return t8;
    }
    return 0;
}

int ref_etiqueta()
{
    int ini = pool_len;
    int a = agrega_car(76);
    int b = agrega_numero(netiq);
    netiq = netiq + 1;
    int r = empaqueta_ref(ini);
    return r;
}

// ============================================================
// ES CAMPO — la lectura doble de hijo1 en la
// asignacion: si el token que sigue al nombre del
// destino es Dot (38), hijo1 es el token del campo;
// si es LBracket, hijo1 es el nodo del indice.
// ============================================================

int es_campo(int s)
{
    int nini[256];
    int tok_tipo[256];
    int ini = nini[s];
    int t = tok_tipo[ini + 1];
    if (t == 38)
    {
        return 1;
    }
    return 0;
}

// ============================================================
// RESOLVER UN CAMPO — el nombre aplanado registrado
// (base, campo); si no esta (una global de struct,
// que no se aplana), se compone el texto nombre.
// campo en la piscina, como hace Stage 0 al caer
// en el nombre original.
// ============================================================

int resuelve_campo(int tok, int campo)
{
    int f = busca_var(tok, campo);
    if (f >= 0)
    {
        int r = da_get(dvscope_ref, f);
        return r;
    }
    int ini = pool_len;
    int a = agrega_token(tok);
    int b = agrega_car(46);
    int c = agrega_token(campo);
    int r = empaqueta_ref(ini);
    return r;
}

// ============================================================
// GENERAR UN BLOQUE con su ambito: lo usan la
// sentencia Block y los bloques de if/while.
// ============================================================

void genera_bloque(int b)
{
    int nhijo1[256];
    int nsig[256];
    entra_ambito();
    int s = nhijo1[b];
    while (s >= 0)
    {
        genera_sentencia(s);
        s = nsig[s];
    }
    sale_ambito();
}

// ============================================================
// GENERAR SENTENCIA (cobertura IR-1 e IR-2).
// ============================================================

void genera_sentencia(int s)
{
    int nkind[256];
    int nini[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int naux[256];
    int nsize[256];
    int campotok[256];
    int fin_pila[256];
    int k = nkind[s];
    if (k == NodeKind::VariableDeclaration)
    {
        int nt = nval[s];
        int ini_m = pool_len;
        int a1 = agrega_token(nt);
        int a2 = agrega_car(64);
        int a3 = agrega_numero(contvar);
        int mangled = empaqueta_ref(ini_m);
        int largo_m = pool_len - ini_m;
        contvar = contvar + 1;
        int tam = nsize[s];
        registra_var(nt, -1, mangled, tam);
        int e1 = emite_ir(IROpcode::Declare, mangled, 0, 0, 0, tam);
        int tipo = nini[s];
        int est = struct_de(tipo);
        if (est >= 0)
        {
            int ci = naux[est];
            int cc = nsize[est];
            int j = 0;
            for (j = 0; j < cc; j = j + 1)
            {
                int ct = campotok[ci + j];
                int ini_f = pool_len;
                int b1 = agrega_tramo(ini_m, largo_m);
                int b2 = agrega_car(46);
                int b3 = agrega_token(ct);
                int fmang = empaqueta_ref(ini_f);
                registra_var(nt, ct, fmang, 0);
                int e2 = emite_ir(IROpcode::Declare, fmang, 0, 0, 0, 0);
            }
        }
        int ini = nhijo1[s];
        if (ini >= 0)
        {
            int ki = nkind[ini];
            if (ki == NodeKind::IntegerLiteral)
            {
                int t = ref_temp();
                int v = nval[ini];
                int e3 = emite_ir(IROpcode::Const, 0, 0, t, 0, v);
                int e4 = emite_ir(IROpcode::Store, mangled, t, 0, 0, 0);
                return;
            }
            int t2 = genera_expresion(ini);
            int e5 = emite_ir(IROpcode::Store, mangled, t2, 0, 0, 0);
            return;
        }
        return;
    }
    if (k == NodeKind::AssignmentStatement)
    {
        int valor = naux[s];
        int h = nhijo1[s];
        int nt2 = nval[s];
        if (h >= 0)
        {
            if (es_campo(s) == 1)
            {
                int tv = genera_expresion(valor);
                int dest = resuelve_campo(nt2, h);
                int e6 = emite_ir(IROpcode::Store, dest, tv, 0, 0, 0);
                return;
            }
            int ti = genera_expresion(h);
            int tv2 = genera_expresion(valor);
            int arr = resuelve(nt2);
            int e7 = emite_ir(IROpcode::ArrayStore, arr, ti, tv2, 0, 0);
            return;
        }
        int tv3 = genera_expresion(valor);
        int dest2 = resuelve(nt2);
        int e8 = emite_ir(IROpcode::Store, dest2, tv3, 0, 0, 0);
        return;
    }
    if (k == NodeKind::Block)
    {
        genera_bloque(s);
        return;
    }
    if (k == NodeKind::IfStatement)
    {
        int cond = nhijo1[s];
        int tc = genera_expresion(cond);
        int fin = ref_etiqueta();
        int els = ref_etiqueta();
        int entonces = nsig[cond];
        int sino = -1;
        if (entonces >= 0)
        {
            sino = nsig[entonces];
        }
        int destino = fin;
        if (sino >= 0)
        {
            destino = els;
        }
        int e9 = emite_ir(IROpcode::JumpIfZero, destino, tc, 0, 0, 0);
        if (entonces >= 0)
        {
            genera_bloque(entonces);
        }
        if (sino >= 0)
        {
            int e10 = emite_ir(IROpcode::Jump, fin, 0, 0, 0, 0);
            int e11 = emite_ir(IROpcode::Label, els, 0, 0, 0, 0);
            genera_bloque(sino);
        }
        int e12 = emite_ir(IROpcode::Label, fin, 0, 0, 0, 0);
        return;
    }
    if (k == NodeKind::WhileStatement)
    {
        int ini_e = ref_etiqueta();
        int fin_e = ref_etiqueta();
        int e13 = emite_ir(IROpcode::Label, ini_e, 0, 0, 0, 0);
        int cond2 = nhijo1[s];
        int tc2 = genera_expresion(cond2);
        int e14 = emite_ir(IROpcode::JumpIfZero, fin_e, tc2, 0, 0, 0);
        int cuerpo = nsig[cond2];
        if (cuerpo >= 0)
        {
            fin_pila[fin_tope] = fin_e;
            fin_tope = fin_tope + 1;
            genera_bloque(cuerpo);
            fin_tope = fin_tope - 1;
        }
        int e15 = emite_ir(IROpcode::Jump, ini_e, 0, 0, 0, 0);
        int e16 = emite_ir(IROpcode::Label, fin_e, 0, 0, 0, 0);
        return;
    }
    if (k == NodeKind::ForStatement)
    {
        // El for (Ampliacion 3): los hijos cuelgan en
        // cadena — el inicio (si lo hay), la condicion
        // (siempre: el Parser siembra el literal 1 si
        // venia vacia), el paso (si lo hay) y el
        // cuerpo. El inicio se genera una vez, antes de
        // la etiqueta de la condicion; el salto en
        // falso cae en la etiqueta de fin, que la pila
        // guarda durante el cuerpo (el break cae ahi);
        // el paso se genera tras el cuerpo y el salto
        // de vuelta cierra el ciclo. La forma de saltos
        // es la del while, con el inicio delante y el
        // paso detras.
        int pf = nhijo1[s];
        int iniciog = 0 - 1;
        if (nkind[pf] == NodeKind::VariableDeclaration)
        {
            iniciog = pf;
            pf = nsig[pf];
        }
        else
        {
            if (nkind[pf] == NodeKind::AssignmentStatement)
            {
                iniciog = pf;
                pf = nsig[pf];
            }
        }
        int condf = pf;
        pf = nsig[pf];
        int pasof = 0 - 1;
        int cuerpof = pf;
        if (nkind[pf] == NodeKind::AssignmentStatement)
        {
            pasof = pf;
            cuerpof = nsig[pf];
        }
        if (iniciog >= 0)
        {
            genera_sentencia(iniciog);
        }
        int in_e = ref_etiqueta();
        int fn_e = ref_etiqueta();
        int e23 = emite_ir(IROpcode::Label, in_e, 0, 0, 0, 0);
        int tcf = genera_expresion(condf);
        int e24 = emite_ir(IROpcode::JumpIfZero, fn_e, tcf, 0, 0, 0);
        if (cuerpof >= 0)
        {
            fin_pila[fin_tope] = fn_e;
            fin_tope = fin_tope + 1;
            genera_bloque(cuerpof);
            fin_tope = fin_tope - 1;
        }
        if (pasof >= 0)
        {
            genera_sentencia(pasof);
        }
        int e25 = emite_ir(IROpcode::Jump, in_e, 0, 0, 0, 0);
        int e26 = emite_ir(IROpcode::Label, fn_e, 0, 0, 0, 0);
        return;
    }
    if (k == NodeKind::BreakStatement)
    {
        // El break (Ampliacion 2): salta a la etiqueta
        // de fin del while mas interno, la de la cima
        // de la pila que mantiene la rama de while.
        int destino = fin_pila[fin_tope - 1];
        int eb = emite_ir(IROpcode::Jump, destino, 0, 0, 0, 0);
        return;
    }
    if (k == NodeKind::PrintStatement)
    {
        int ep = nhijo1[s];
        int tp = genera_expresion(ep);
        int e17 = emite_ir(IROpcode::Print, 0, tp, 0, 0, 0);
        return;
    }
    if (k == NodeKind::PrintIntegerStatement)
    {
        int ei = nhijo1[s];
        int ti2 = genera_expresion(ei);
        int e18 = emite_ir(IROpcode::PrintInteger, 0, ti2, 0, 0, 0);
        return;
    }
    if (k == NodeKind::ReturnStatement)
    {
        int e = nhijo1[s];
        if (e < 0)
        {
            // Sin expresion: en una funcion void es
            // el return; de la Ampliacion 1 y SI se
            // emite, como Return de valor 0 (el mismo
            // que emite el Stage 0). En una int el
            // analizador ya lo acuso (codigo 13) y
            // aqui no se emite.
            if (fun_es_void == 1)
            {
                int e0 = emite_ir(IROpcode::Return, 0, 0, 0, 0, 0);
            }
            return;
        }
        int ke = nkind[e];
        if (ke == NodeKind::IntegerLiteral)
        {
            int v = nval[e];
            int e19 = emite_ir(IROpcode::Return, 0, 0, 0, 0, v);
            return;
        }
        int t = genera_expresion(e);
        int e20 = emite_ir(IROpcode::Return, 0, t, 0, 0, 0);
        return;
    }
    if (k == NodeKind::CallStatement)
    {
        // La llamada como sentencia (Ampliacion 1):
        // la llamada se genera y su temporal queda
        // sin leer — descartado, como en el Stage 0.
        int tc = genera_expresion(nhijo1[s]);
        return;
    }
}

// ============================================================
// GENERAR FUNCION.
// ============================================================

void genera_funcion(int f)
{
    int nini[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int naux[256];
    int nsize[256];
    int partok[256];
    ntemp = 0;
    contvar = 0;
    netiq = 0;
    fun_es_void = es_void(nini[f]);
    fin_tope = 0;
    temps_tope = 0;
    entra_ambito();
    int nt = nval[f];
    int nombre = ref_token(nt);
    int params = 0;
    int inicio = naux[f];
    int cant = nsize[f];
    if (cant > 0)
    {
        int ini_p = pool_len;
        int j = 0;
        for (j = 0; j < cant; j = j + 1)
        {
            if (j > 0)
            {
                int c1 = agrega_car(44);
                int c2 = agrega_car(32);
            }
            int pt = partok[inicio + j];
            int a = agrega_token(pt);
        }
        params = empaqueta_ref(ini_p);
    }
    int e1 = emite_ir(IROpcode::FunctionBegin, nombre, params, 0, 0, 0);
    int cuerpo = nhijo1[f];
    if (cuerpo >= 0)
    {
        int s = nhijo1[cuerpo];
        while (s >= 0)
        {
            genera_sentencia(s);
            s = nsig[s];
        }
    }
    int e2 = emite_ir(IROpcode::FunctionEnd, 0, 0, 0, 0, 0);
    sale_ambito();
}

// ============================================================
// GENERAR EL PROGRAMA.
// ============================================================

void genera()
{
    int nkind[256];
    int nhijo1[256];
    int nsig[256];
    int nval[256];
    int nsize[256];
    // La puerta de la arena (M-6): cada programa
    // nace en un mundo nuevo — inicia_irgen y
    // crea_ir antes del reseteo de contadores de
    // siempre, como la puerta de analiza() en M-5.
    inicia_irgen();
    crea_ir();
    nir = 0;
    pool_len = 0;
    nvar = 0;
    nivel = 0;
    errores_ir = 0;
    int d = nhijo1[0];
    while (d >= 0)
    {
        int k = nkind[d];
        if (k == NodeKind::VariableDeclaration)
        {
            int nt = nval[d];
            int nombre = ref_token(nt);
            int tam = nsize[d];
            int e = emite_ir(IROpcode::Declare, nombre, 0, 0, 0, tam);
        }
        d = nsig[d];
    }
    d = nhijo1[0];
    while (d >= 0)
    {
        int k2 = nkind[d];
        if (k2 == NodeKind::FunctionDeclaration)
        {
            genera_funcion(d);
        }
        d = nsig[d];
    }
}

// ============================================================
// IMPRIMIR LA CORRIENTE (la sonda).
// ============================================================

void imprime_op(int op)
{
    if (op == IROpcode::FunctionBegin)
    {
        print("FUNCTION_BEGIN");
        return;
    }
    if (op == IROpcode::FunctionEnd)
    {
        print("FUNCTION_END");
        return;
